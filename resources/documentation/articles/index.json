    "chapters": {
        "overview": {
            "title": "Overview",
            "blocks": [
                {
                    "type": "text",
                    "text": "Firstlight is the app-shell layer for NativePHP. Install it with Laravel Boost, and you or your coding agent have what a standard forms app needs: lists and detail, search, forms with Laravel validation, settings, sheets and dialogs, and feedback."
                },
                {
                    "type": "text",
                    "text": "Every control is a genuine SwiftUI control on iOS and a Jetpack Compose Material 3 control on Android. One Blade API becomes the right pattern on each platform. Navigation chrome comes from NativePHP's own native chrome, and VoiceOver, TalkBack, larger text, right-to-left layout, and Reduce Motion reach every control the way they reach the platform's own apps."
                }
            ]
        },
        "start-with-a-recipe": {
            "title": "Start with a recipe",
            "blocks": [
                {
                    "type": "text",
                    "runs": [
                        {
                            "text": "Each recipe is a complete screen you can copy. Each one runs unchanged in the "
                        },
                        {
                            "text": "showcase app",
                            "link": 0
                        },
                        {
                            "text": ", whose Pest tests exercise it. Build the list and detail flow first: it is the app shell the other recipes run inside."
                        }
                    ]
                },
                {
                    "type": "item",
                    "marker": "•",
                    "depth": 0,
                    "runs": [
                        {
                            "text": "Build a list and detail flow",
                            "link": 1
                        },
                        {
                            "text": " — Give the app a native navigation shell with a list screen that pushes a detail screen."
                        }
                    ]
                },
                {
                    "type": "item",
                    "marker": "•",
                    "depth": 0,
                    "runs": [
                        {
                            "text": "Build a searchable list screen",
                            "link": 2
                        },
                        {
                            "text": " — Search, paginate, refresh, open, and delete records from one native List."
                        }
                    ]
                },
                {
                    "type": "item",
                    "marker": "•",
                    "depth": 0,
                    "runs": [
                        {
                            "text": "Build a large list screen",
                            "link": 3
                        },
                        {
                            "text": " — Scroll thousands of local records with a virtual list that builds only the visible rows."
                        }
                    ]
                },
                {
                    "type": "item",
                    "marker": "•",
                    "depth": 0,
                    "runs": [
                        {
                            "text": "Build a form screen",
                            "link": 4
                        },
                        {
                            "text": " — Validate with a Form Request, show field and form-level errors, and save with Feedback."
                        }
                    ]
                },
                {
                    "type": "item",
                    "marker": "•",
                    "depth": 0,
                    "runs": [
                        {
                            "text": "Build a settings screen",
                            "link": 5
                        },
                        {
                            "text": " — Group switches and pickers in native sections that save on change."
                        }
                    ]
                },
                {
                    "type": "item",
                    "marker": "•",
                    "depth": 0,
                    "runs": [
                        {
                            "text": "Build a photo upload screen",
                            "link": 6
                        },
                        {
                            "text": " — Crop, validate, and save a photo to a model only when the user taps Save."
                        }
                    ]
                }
            ]
        },
