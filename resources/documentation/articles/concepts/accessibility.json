{
    "id": "concepts/accessibility",
    "title": "Accessibility in Firstlight",
    "description": "What VoiceOver, TalkBack, Dynamic Type, font scaling, contrast, Reduce Motion, and right-to-left users get from Firstlight's real native controls, what is tested, what is not yet verified, and what remains your app's job.",
    "group": "Concepts",
    "anchors": {
        "accessibility-in-firstlight": "overview",
        "what-you-get-from-the-platform": "what-you-get-from-the-platform",
        "what-firstlight-adds": "what-firstlight-adds",
        "what-is-tested": "what-is-tested",
        "known-gaps": "known-gaps",
        "what-remains-your-apps-job": "what-remains-your-apps-job"
    },
    "chapters": {
        "overview": {
            "title": "Overview",
            "blocks": [
                {
                    "type": "text",
                    "text": "Accessibility is a headline feature of Firstlight, and it starts with one decision: every control is a real SwiftUI or Jetpack Compose control, not a drawing that imitates one. VoiceOver, TalkBack, Dynamic Type, Android font scaling, dark appearance, Increased Contrast, Reduce Motion, and right-to-left layout reach each control the same way they reach the platform's own apps."
                },
                {
                    "type": "text",
                    "text": "Firstlight then adds the parts a native control alone does not decide: whether something has a name, how many focus stops a row has, how large a target is, and what a screen reader hears when a form fails."
                },
                {
                    "type": "definition",
                    "term": {
                        "text": "VoiceOver and TalkBack"
                    },
                    "items": [
                        {
                            "label": "Get",
                            "text": "Required names on icon-only controls, development warnings for unnamed fields, one focus stop per row or field, and every swipe and context-menu action as a screen-reader action"
                        }
                    ]
                },
                {
                    "type": "definition",
                    "term": {
                        "text": "Spoken feedback on forms"
                    },
                    "items": [
                        {
                            "label": "Get",
                            "text": "Validation errors read aloud after a failed submit, with screen-reader focus on the first invalid field"
                        }
                    ]
                },
                {
                    "type": "definition",
                    "term": {
                        "text": "Larger text"
                    },
                    "items": [
                        {
                            "label": "Get",
                            "text": "Dynamic Type and Android font scaling, with labels that wrap instead of truncating"
                        }
                    ]
                },
                {
                    "type": "definition",
                    "term": {
                        "text": "Right-to-left languages"
                    },
                    "items": [
                        {
                            "label": "Get",
                            "text": "Mirrored native layout, with code kept left-to-right"
                        }
                    ]
                },
                {
                    "type": "definition",
                    "term": {
                        "text": "Reduce Motion"
                    },
                    "items": [
                        {
                            "label": "Get",
                            "text": "Platform motion settings, and Feedback that fades instead of moving on iOS"
                        }
                    ]
                },
                {
                    "type": "definition",
                    "term": {
                        "text": "Contrast and colour"
                    },
                    "items": [
                        {
                            "label": "Get",
                            "text": "Status named in words, and status colours below 4.5:1 corrected to black or white text"
                        }
                    ]
                },
                {
                    "type": "text",
                    "runs": [
                        {
                            "text": "Status.",
                            "strong": true
                        },
                        {
                            "text": " Firstlight 1.0.0 is a release candidate. The behaviour on this page is covered by contract, XCTest, and Robolectric tests, and validation focus was observed with TalkBack on the Android emulator. Spoken VoiceOver and TalkBack output has not been checked on physical devices. See "
                        },
                        {
                            "text": "Known gaps",
                            "link": 0
                        },
                        {
                            "text": "."
                        }
                    ]
                }
            ]
        },
        "what-you-get-from-the-platform": {
            "title": "What you get from the platform",
            "blocks": [
                {
                    "type": "text",
                    "text": "Because the controls are native, these work without any Firstlight code:"
                },
                {
                    "type": "definition",
                    "term": {
                        "text": "Screen reader"
                    },
                    "items": [
                        {
                            "label": "iOS",
                            "text": "VoiceOver roles, values, and states"
                        },
                        {
                            "label": "Android",
                            "text": "TalkBack roles, values, and states"
                        }
                    ]
                },
                {
                    "type": "definition",
                    "term": {
                        "text": "Larger text"
                    },
                    "items": [
                        {
                            "label": "iOS",
                            "text": "Dynamic Type, including accessibility sizes"
                        },
                        {
                            "label": "Android",
                            "text": "System font scale"
                        }
                    ]
                },
                {
                    "type": "definition",
                    "term": {
                        "text": "Appearance"
                    },
                    "items": [
                        {
                            "label": "iOS",
                            "text": "Light, dark, and Increased Contrast"
                        },
                        {
                            "label": "Android",
                            "text": "Light, dark, and high-contrast text"
                        }
                    ]
                },
                {
                    "type": "definition",
                    "term": {
                        "text": "Motion"
                    },
                    "items": [
                        {
                            "label": "iOS",
                            "text": "Reduce Motion"
                        },
                        {
                            "label": "Android",
                            "text": "Remove animations"
                        }
                    ]
                },
                {
                    "type": "definition",
                    "term": {
                        "text": "Reading direction"
                    },
                    "items": [
                        {
                            "label": "iOS",
                            "text": "Right-to-left layout"
                        },
                        {
                            "label": "Android",
                            "text": "Right-to-left layout"
                        }
                    ]
                },
                {
                    "type": "definition",
                    "term": {
                        "text": "Dialogs and sheets"
                    },
                    "items": [
                        {
                            "label": "iOS",
                            "text": "System focus trapping and action order"
                        },
                        {
                            "label": "Android",
                            "text": "System focus trapping and action order"
                        }
                    ]
                }
            ]
        },
        "what-firstlight-adds": {
            "title": "What Firstlight adds",
            "blocks": [
                {
                    "type": "text",
                    "runs": [
                        {
                            "text": "Every control has a name.",
                            "strong": true
                        },
                        {
                            "text": " Icon Button, Search Field, and Progress require "
                        },
                        {
                            "text": "a11y-label",
                            "code": true
                        },
                        {
                            "text": " and fail before publishing without it. Fields, choices, and pickers warn during development when neither "
                        },
                        {
                            "text": "label",
                            "code": true
                        },
                        {
                            "text": " nor "
                        },
                        {
                            "text": "a11y-label",
                            "code": true
                        },
                        {
                            "text": " is set. An icon name is never accepted as a substitute for a name."
                        }
                    ]
                },
                {
                    "type": "text",
                    "runs": [
                        {
                            "text": "One thing, one focus stop.",
                            "strong": true
                        },
                        {
                            "text": " A List Item row, a field with its label, helper, and error, or a Metric with its value and detail is one accessibility element. Decorative icons, avatars, monograms, checkmarks, and tone symbols are hidden, so screen-reader users do not hear the same thing twice."
                        }
                    ]
                },
                {
                    "type": "text",
                    "runs": [
                        {
                            "text": "Gestures have alternatives.",
                            "strong": true
                        },
                        {
                            "text": " Swipe actions and context-menu items on List Item are also VoiceOver actions and TalkBack custom actions, so nobody has to perform a swipe or long press. The Media crop sheet has zoom buttons as well as pinch. Stepper exposes named increase and decrease actions."
                        }
                    ]
                },
                {
                    "type": "text",
                    "runs": [
                        {
                            "text": "Targets are large enough.",
                            "strong": true
                        },
                        {
                            "text": " Actions Firstlight owns, such as icon buttons, field icon actions, the search clear button, Callout and Feedback actions, List Item rows, and Code Editor keys, are at least 44 points on iOS and 48 dp on Android."
                        }
                    ]
                },
                {
                    "type": "text",
                    "runs": [
                        {
                            "text": "Errors are spoken.",
                            "strong": true
                        },
                        {
                            "text": " When a submit fails validation, VoiceOver and TalkBack read a summary of the errors once, for example \"There are 2 errors. The name field is required. The email field is required.\", and screen-reader focus moves to the first invalid field. On iOS the keyboard does not open. On Android, Text Field, Text Area, and Code Editor take input focus while TalkBack is on; other fields announce without moving focus. When a single field fails on blur, only that message is read and focus stays put. Form-level errors appear in a Callout with "
                        },
                        {
                            "text": "error-for",
                            "code": true
                        },
                        {
                            "text": " or "
                        },
                        {
                            "text": "error-summary",
                            "code": true
                        },
                        {
                            "text": ". See "
                        },
                        {
                            "text": "Validate fields",
                            "link": 1
                        },
                        {
                            "text": "."
                        }
                    ]
                },
                {
                    "type": "text",
                    "runs": [
                        {
                            "text": "Status is not colour alone.",
                            "strong": true
                        },
                        {
                            "text": " Callout names its tone in the spoken text, for example \"Warning: Your changes have not been submitted.\" Badge, Status Label, Callout, and Feedback check theme colours as they render; a foreground and background pair below 4.5:1 contrast is corrected to black or white text."
                        }
                    ]
                },
                {
                    "type": "text",
                    "runs": [
                        {
                            "text": "Messages wait for the reader.",
                            "strong": true
                        },
                        {
                            "text": " Transient Feedback announces each new message once. On iOS it stays twice as long while VoiceOver or Switch Control is on and fades instead of moving under Reduce Motion. On Android it uses the system's recommended accessibility timeout."
                        }
                    ]
                },
                {
                    "type": "text",
                    "runs": [
                        {
                            "text": "Text grows instead of shrinking.",
                            "strong": true
                        },
                        {
                            "text": " Labels, rows, metrics, and messages wrap at large text sizes rather than truncating or shrinking. On iPhone the Date and Time picker sheets size to their content, so they grow with Dynamic Type."
                        }
                    ]
                },
                {
                    "type": "text",
                    "runs": [
                        {
                            "text": "Right-to-left layouts mirror.",
                            "strong": true
                        },
                        {
                            "text": " Native layout mirrors automatically. The Android Stepper row mirrors with its label, and Code Editor keeps code left-to-right inside right-to-left layouts."
                        }
                    ]
                },
                {
                    "type": "text",
                    "text": "Each component's reference page has an Accessibility section with its exact behaviour."
                }
            ]
        },
        "what-is-tested": {
            "title": "What is tested",
            "blocks": [
                {
                    "type": "definition",
                    "term": {
                        "text": "Accessible names"
                    },
                    "items": [
                        {
                            "label": "Automated evidence",
                            "text": "Contract tests reject missing required labels; iOS and Android renderer tests check the published label"
                        }
                    ]
                },
                {
                    "type": "definition",
                    "term": {
                        "text": "Larger text"
                    },
                    "items": [
                        {
                            "label": "Automated evidence",
                            "text": "iOS snapshot tests at accessibility Dynamic Type sizes and Android tests at large font scales for most controls"
                        }
                    ]
                },
                {
                    "type": "definition",
                    "term": {
                        "text": "Dark appearance"
                    },
                    "items": [
                        {
                            "label": "Automated evidence",
                            "text": "iOS snapshots in both appearances for most controls; Android tests for List Item, Status Label, Date Picker, and Time Picker"
                        }
                    ]
                },
                {
                    "type": "definition",
                    "term": {
                        "text": "Target sizes"
                    },
                    "items": [
                        {
                            "label": "Automated evidence",
                            "text": "iOS and Android tests for the controls that own extra actions"
                        }
                    ]
                },
                {
                    "type": "definition",
                    "term": {
                        "text": "Gesture alternatives"
                    },
                    "items": [
                        {
                            "label": "Automated evidence",
                            "text": "List Item swipe and context-menu actions on both platforms"
                        }
                    ]
                },
                {
                    "type": "definition",
                    "term": {
                        "text": "Announcements"
                    },
                    "items": [
                        {
                            "label": "Automated evidence",
                            "text": "Activity Indicator, Feedback, Code Editor follow mode, and validation errors on both platforms"
                        }
                    ]
                },
                {
                    "type": "definition",
                    "term": {
                        "text": "Right-to-left"
                    },
                    "items": [
                        {
                            "label": "Automated evidence",
                            "text": "Pill Group on iOS; List Item and Feedback on Android"
                        }
                    ]
                },
                {
                    "type": "definition",
                    "term": {
                        "text": "Your screens"
                    },
                    "items": [
                        {
                            "label": "Automated evidence",
                            "runs": [
                                {
                                    "text": "assertAccessible()",
                                    "code": true
                                },
                                {
                                    "text": " in every showcase screen test"
                                }
                            ]
                        }
                    ]
                },
                {
                    "type": "text",
                    "text": "Documentation screenshots for every component are captured on both platforms in light and dark appearance."
                }
            ]
        },
        "known-gaps": {
            "title": "Known gaps",
            "blocks": [
                {
                    "type": "text",
                    "text": "These are known gaps, stated plainly:"
                },
                {
                    "type": "item",
                    "marker": "•",
                    "depth": 0,
                    "text": "Spoken VoiceOver and TalkBack passes on physical devices have not been completed. VoiceOver does not run in the iOS Simulator, so iOS spoken output is covered by tests of the accessibility tree, not by listening. TalkBack focus moving to the first invalid field was observed on the Android emulator; spoken output was not captured on either platform."
                },
                {
                    "type": "item",
                    "marker": "•",
                    "depth": 0,
                    "text": "The error summary reads messages in rule order, not screen order. Declare rules in the order the fields appear."
                },
                {
                    "type": "item",
                    "marker": "•",
                    "depth": 0,
                    "text": "The app recipes were checked on an iOS simulator and an Android emulator, not with VoiceOver or TalkBack."
                },
                {
                    "type": "item",
                    "marker": "•",
                    "depth": 0,
                    "text": "Right-to-left layout is automated for only the components listed above. Other controls rely on native layout, which mirrors automatically."
                },
                {
                    "type": "item",
                    "marker": "•",
                    "depth": 0,
                    "text": "Text-scaling tests do not yet cover Activity Indicator, Badge, Bottom Sheet, Date Picker, and Slider on either platform, nor the iOS dialogs and Time Picker or Android Media and Search Field."
                },
                {
                    "type": "item",
                    "marker": "•",
                    "depth": 0,
                    "text": "Android dark-appearance tests cover only the components listed above; the documentation screenshots cover the rest."
                }
            ]
        },
        "what-remains-your-apps-job": {
            "title": "What remains your app's job",
            "blocks": [
                {
                    "type": "text",
                    "text": "Firstlight makes each control accessible. Your app still decides what the screen says and in what order."
                },
                {
                    "type": "item",
                    "marker": "•",
                    "depth": 0,
                    "text": "Write labels that name the thing, such as \"Delete post\", not \"Button\"."
                },
                {
                    "type": "item",
                    "marker": "•",
                    "depth": 0,
                    "runs": [
                        {
                            "text": "Give fields visible labels. Use "
                        },
                        {
                            "text": "a11y-label",
                            "code": true
                        },
                        {
                            "text": " only when a visible label would be wrong for the design."
                        }
                    ]
                },
                {
                    "type": "item",
                    "marker": "•",
                    "depth": 0,
                    "text": "Declare validation rules in the order the fields appear, so the error summary reads in screen order."
                },
                {
                    "type": "item",
                    "marker": "•",
                    "depth": 0,
                    "text": "Name the consequence in confirmation dialogs, such as \"Delete\" rather than \"OK\"."
                },
                {
                    "type": "item",
                    "marker": "•",
                    "depth": 0,
                    "runs": [
                        {
                            "text": "Use the theme for colour, and keep each "
                        },
                        {
                            "text": "on-*",
                            "code": true
                        },
                        {
                            "text": " pair at 4.5:1 or better. See "
                        },
                        {
                            "text": "Theme Firstlight components",
                            "link": 2
                        },
                        {
                            "text": "."
                        }
                    ]
                },
                {
                    "type": "item",
                    "marker": "•",
                    "depth": 0,
                    "runs": [
                        {
                            "text": "Check your own screens in tests. "
                        },
                        {
                            "text": "assertAccessible()",
                            "code": true
                        },
                        {
                            "text": " from NativePHP's test harness fails when an interactive element or image has no accessible name:"
                        }
                    ]
                },
                {
                    "type": "code",
                    "language": "php",
                    "text": "Native::visit('/posts')->assertAccessible();"
                },
                {
                    "type": "text",
                    "runs": [
                        {
                            "text": "See "
                        },
                        {
                            "text": "Test screens",
                            "link": 3
                        },
                        {
                            "text": " for the Firstlight checks that work alongside it."
                        }
                    ]
                }
            ]
        }
    },
