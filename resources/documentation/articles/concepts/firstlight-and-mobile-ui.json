{
    "id": "concepts/firstlight-and-mobile-ui",
    "title": "What Firstlight is",
    "description": "Firstlight is the app-shell layer for NativePHP. What it provides, what NativePHP and Mobile UI provide, and what Firstlight is not.",
    "group": "Concepts",
    "anchors": {
        "what-firstlight-is": "overview",
        "who-provides-what": "who-provides-what",
        "one-api-the-right-pattern-on-each-platform": "one-api-the-right-pattern-on-each-platform",
        "what-firstlight-is-not": "what-firstlight-is-not",
        "additional-dedicated-components": "additional-dedicated-components",
        "higher-level-components-over-existing-primitives": "higher-level-components-over-existing-primitives",
        "richer-contracts-around-familiar-controls": "richer-contracts-around-familiar-controls",
        "server-authoritative-application-state": "server-authoritative-application-state",
        "consistency-and-diagnostics": "consistency-and-diagnostics",
        "laravel-shaped-php-extensions": "laravel-shaped-php-extensions",
        "custom-tappable-content-and-accessibility": "laravel-shaped-php-extensions",
        "reusing-mobile-ui-when-it-already-fits": "reusing-mobile-ui-when-it-already-fits",
        "one-native-ecosystem": "one-native-ecosystem"
    },
    "chapters": {
        "overview": {
            "title": "Overview",
            "blocks": [
                {
                    "type": "text",
                    "text": "Firstlight is the app-shell layer for NativePHP. It covers what a standard forms app needs (lists and detail, search, forms with Laravel validation, settings, sheets and dialogs, and feedback) with genuine SwiftUI controls on iOS and Jetpack Compose Material 3 controls on Android, from one Blade API."
                },
                {
                    "type": "text",
                    "runs": [
                        {
                            "text": "It is built for agentic coding. Four "
                        },
                        {
                            "text": "recipes",
                            "link": 0
                        },
                        {
                            "text": " show each kind of screen end to end, and a Laravel Boost guideline and two skills point coding agents at them. See "
                        },
                        {
                            "text": "Build with a coding agent",
                            "link": 1
                        },
                        {
                            "text": "."
                        }
                    ]
                }
            ]
        },
        "who-provides-what": {
            "title": "Who provides what",
            "blocks": [
                {
                    "type": "text",
                    "text": "Firstlight builds on two NativePHP packages and replaces neither."
                },
                {
                    "type": "definition",
                    "term": {
                        "text": "NativePHP Mobile"
                    },
                    "items": [
                        {
                            "label": "Provides",
                            "runs": [
                                {
                                    "text": "EDGE, the Element Tree, the event lifecycle, and native navigation chrome: layouts that return "
                                },
                                {
                                    "text": "true",
                                    "code": true
                                },
                                {
                                    "text": " from "
                                },
                                {
                                    "text": "usesNativeChrome()",
                                    "code": true
                                },
                                {
                                    "text": " get SwiftUI "
                                },
                                {
                                    "text": "NavigationStack",
                                    "code": true
                                },
                                {
                                    "text": " and "
                                },
                                {
                                    "text": "TabView",
                                    "code": true
                                },
                                {
                                    "text": " on iOS and a Material 3 "
                                },
                                {
                                    "text": "Scaffold",
                                    "code": true
                                },
                                {
                                    "text": " and top app bar on Android"
                                }
                            ]
                        }
                    ]
                },
                {
                    "type": "definition",
                    "term": {
                        "text": "NativePHP Mobile UI"
                    },
                    "items": [
                        {
                            "label": "Provides",
                            "text": "Layout primitives such as columns, scroll views, and grouped lists, the semantic theme, and the native renderer foundation"
                        }
                    ]
                },
                {
                    "type": "definition",
                    "term": {
                        "text": "Firstlight UI"
                    },
                    "items": [
                        {
                            "label": "Provides",
                            "runs": [
                                {
                                    "text": "Form, list, selection, overlay, status, and feedback controls with one contract on both platforms; Laravel validation, submission, authorization, pagination, and deletion on screens; Pest screen assertions and a screen generator; recipes, a Boost guideline, skills, and "
                                },
                                {
                                    "text": "llms.txt",
                                    "code": true
                                }
                            ]
                        }
                    ]
                },
                {
                    "type": "text",
                    "text": "Firstlight depends on Mobile UI, follows its EDGE conventions, inherits its theme, and uses the same Element Tree and event lifecycle. Mobile UI is the broad native toolkit; Firstlight decides common form and list behaviour once so each application does not assemble it again."
                }
            ]
        },
        "one-api-the-right-pattern-on-each-platform": {
            "title": "One API, the right pattern on each platform",
            "blocks": [
                {
                    "type": "text",
                    "runs": [
                        {
                            "text": "A Firstlight tag means the same thing on both platforms, and each platform draws it its own way. Tabs are a segmented control on iOS and Material 3 tabs on Android. A Confirmation Dialog is a SwiftUI "
                        },
                        {
                            "text": "confirmationDialog",
                            "code": true
                        },
                        {
                            "text": " on iOS and a Material 3 "
                        },
                        {
                            "text": "AlertDialog",
                            "code": true
                        },
                        {
                            "text": " on Android. Date Picker opens the graphical SwiftUI "
                        },
                        {
                            "text": "DatePicker",
                            "code": true
                        },
                        {
                            "text": " on iOS and the Material 3 "
                        },
                        {
                            "text": "DatePickerDialog",
                            "code": true
                        },
                        {
                            "text": " on Android. Field errors appear under the field on iOS and as Material 3 supporting text in the error state on Android."
                        }
                    ]
                },
                {
                    "type": "text",
                    "text": "Every control is a real platform control. Firstlight draws nothing to imitate one, and there is no WebView."
                }
            ]
        },
        "what-firstlight-is-not": {
            "title": "What Firstlight is not",
            "blocks": [
                {
                    "type": "item",
                    "marker": "•",
                    "depth": 0,
                    "runs": [
                        {
                            "text": "Not navigation chrome.",
                            "strong": true
                        },
                        {
                            "text": " Stacks, title bars, back navigation, and tab bars come from NativePHP's native chrome. Firstlight runs inside them. Do not use the "
                        },
                        {
                            "text": "custom",
                            "code": true
                        },
                        {
                            "text": " attribute on top bars or bottom navs to draw your own."
                        }
                    ]
                },
                {
                    "type": "item",
                    "marker": "•",
                    "depth": 0,
                    "runs": [
                        {
                            "text": "Not a design system.",
                            "strong": true
                        },
                        {
                            "text": " Firstlight does not define a visual style. Controls take colours and fonts from the NativePHP theme and keep each platform's geometry, motion, and materials."
                        }
                    ]
                },
                {
                    "type": "item",
                    "marker": "•",
                    "depth": 0,
                    "runs": [
                        {
                            "text": "Not a catalogue of everything.",
                            "strong": true
                        },
                        {
                            "text": " There are no charts, carousels, or other custom-drawn controls. A new tag is added only for a semantic control with an equal native contract on iOS and Android."
                        }
                    ]
                },
                {
                    "type": "item",
                    "marker": "•",
                    "depth": 0,
                    "runs": [
                        {
                            "text": "Not a form builder.",
                            "strong": true
                        },
                        {
                            "text": " Screens are ordinary Blade views with PHP state, not schemas."
                        }
                    ]
                }
            ]
        },
        "additional-dedicated-components": {
            "title": "Additional dedicated components",
            "blocks": [
                {
                    "type": "text",
                    "text": "Mobile UI provides primitives from which many interfaces can be composed. Firstlight adds dedicated components where one reusable semantic contract is valuable:"
                },
                {
                    "type": "item",
                    "marker": "•",
                    "depth": 0,
                    "runs": [
                        {
                            "text": "Icon Button",
                            "strong": true
                        },
                        {
                            "text": " uses the compact native icon-button family, requires an accessible action name, guarantees minimum interaction targets, and supports disabled and loading states. Mobile UI provides capable Button and Icon primitives, but does not expose this complete contract as a standalone manifest component."
                        }
                    ]
                },
                {
                    "type": "item",
                    "marker": "•",
                    "depth": 0,
                    "runs": [
                        {
                            "text": "Search Field",
                            "strong": true
                        },
                        {
                            "text": " makes native search behaviour an invariant. It owns the platform search and clear affordances, submit flushing, focused query state, and accessible clear action instead of requiring an application to configure a general text input each time."
                        }
                    ]
                },
                {
                    "type": "item",
                    "marker": "•",
                    "depth": 0,
                    "runs": [
                        {
                            "text": "Stepper",
                            "strong": true
                        },
                        {
                            "text": " provides exact bounded increment and decrement over integer or floating-point grids. It uses SwiftUI "
                        },
                        {
                            "text": "Stepper",
                            "code": true
                        },
                        {
                            "text": " on iOS and an idiomatic Material 3 decrement/value/increment composition on Android."
                        }
                    ]
                },
                {
                    "type": "item",
                    "marker": "•",
                    "depth": 0,
                    "runs": [
                        {
                            "text": "Status Label",
                            "strong": true
                        },
                        {
                            "text": " provides a display-only status capsule with semantic tones, accessible static-text semantics, text scaling, and contrast protection. It avoids giving non-interactive status metadata the behaviour of a button or selectable chip."
                        }
                    ]
                }
            ]
        },
        "higher-level-components-over-existing-primitives": {
            "title": "Higher-level components over existing primitives",
            "blocks": [
                {
                    "type": "text",
                    "text": "Some Firstlight components package several Mobile UI capabilities into one stable application-facing value:"
                },
                {
                    "type": "item",
                    "marker": "•",
                    "depth": 0,
                    "runs": [
                        {
                            "text": "Choice Group",
                            "strong": true
                        },
                        {
                            "text": " presents single-choice radio rows or multiple-choice checkbox rows through one option-array API and one complete scalar-or-list value."
                        }
                    ]
                },
                {
                    "type": "item",
                    "marker": "•",
                    "depth": 0,
                    "runs": [
                        {
                            "text": "Pill Group",
                            "strong": true
                        },
                        {
                            "text": " composes native chip intents into one single- or multiple-selection field. The group publishes one stable scalar or list rather than requiring a separate Boolean model for every chip."
                        }
                    ]
                },
                {
                    "type": "item",
                    "marker": "•",
                    "depth": 0,
                    "runs": [
                        {
                            "text": "Text Area",
                            "strong": true
                        },
                        {
                            "text": " turns multiline editing into a dedicated, deliberately narrow field with native focused-state preservation, line bounds, validation feedback, and a genuine SwiftUI "
                        },
                        {
                            "text": "TextEditor",
                            "code": true
                        },
                        {
                            "text": " expression on iOS."
                        }
                    ]
                },
                {
                    "type": "item",
                    "marker": "•",
                    "depth": 0,
                    "runs": [
                        {
                            "text": "Time Picker",
                            "strong": true
                        },
                        {
                            "text": " separates nullable "
                        },
                        {
                            "text": "HH:mm",
                            "code": true
                        },
                        {
                            "text": " selection from a combined date/time/datetime API and gives it the same explicit draft, confirmation, validation, and accepted-value rules as the rest of Firstlight."
                        }
                    ]
                },
                {
                    "type": "text",
                    "text": "These are not claims that Mobile UI cannot build the corresponding interface. Firstlight supplies the reusable product contract so each consuming application does not need to design that contract independently."
                }
            ]
        },
        "richer-contracts-around-familiar-controls": {
            "title": "Richer contracts around familiar controls",
            "blocks": [
                {
                    "type": "text",
                    "text": "Firstlight also provides opinionated versions of controls that have clear Mobile UI counterparts:"
                },
                {
                    "type": "definition",
                    "term": {
                        "runs": [
                            {
                                "text": "Segmented",
                                "strong": true
                            }
                        ]
                    },
                    "items": [
                        {
                            "label": "Additional Firstlight contract",
                            "text": "Stable string or integer values instead of renderer indexes, nullable selection, rich options, individual disabled choices, field metadata, strict diagnostics, and PHP-authoritative acceptance."
                        }
                    ]
                },
                {
                    "type": "definition",
                    "term": {
                        "runs": [
                            {
                                "text": "Badge",
                                "strong": true
                            }
                        ]
                    },
                    "items": [
                        {
                            "label": "Additional Firstlight contract",
                            "runs": [
                                {
                                    "text": "Exactly one count or label, hidden zero, contextual accessibility for numeric counts, five semantic tones, strict authoring diagnostics, and a Material 3 "
                                },
                                {
                                    "text": "Badge",
                                    "code": true
                                },
                                {
                                    "text": " on Android."
                                }
                            ]
                        }
                    ]
                },
                {
                    "type": "definition",
                    "term": {
                        "runs": [
                            {
                                "text": "Text Field",
                                "strong": true
                            }
                        ]
                    },
                    "items": [
                        {
                            "label": "Additional Firstlight contract",
                            "text": "A single semantic field API with content and autofill hints, platform icon overrides, accessible trailing actions, clear and reveal affordances, and focused editing reconciliation that preserves selection and text composition."
                        }
                    ]
                },
                {
                    "type": "definition",
                    "term": {
                        "runs": [
                            {
                                "text": "Date Picker",
                                "strong": true
                            }
                        ]
                    },
                    "items": [
                        {
                            "label": "Additional Firstlight contract",
                            "runs": [
                                {
                                    "text": "A strict nullable "
                                },
                                {
                                    "text": "YYYY-MM-DD",
                                    "code": true
                                },
                                {
                                    "text": " value, inclusive bound validation, a temporary native draft, explicit confirmation, and a closed trigger that continues to display PHP's accepted value."
                                }
                            ]
                        }
                    ]
                },
                {
                    "type": "definition",
                    "term": {
                        "runs": [
                            {
                                "text": "Select",
                                "strong": true
                            }
                        ]
                    },
                    "items": [
                        {
                            "label": "Additional Firstlight contract",
                            "text": "Stable string or integer values, rich and individually disabled options, automatic searchable presentation for larger collections, field validation semantics, and PHP-authoritative selection."
                        }
                    ]
                },
                {
                    "type": "definition",
                    "term": {
                        "runs": [
                            {
                                "text": "Slider",
                                "strong": true
                            }
                        ]
                    },
                    "items": [
                        {
                            "label": "Additional Firstlight contract",
                            "text": "Strict finite-number and step-grid validation, helper and error treatment, an optional spoken accessibility value, and explicit live, blur, or debounce synchronisation."
                        }
                    ]
                },
                {
                    "type": "definition",
                    "term": {
                        "runs": [
                            {
                                "text": "Switch",
                                "strong": true
                            }
                        ]
                    },
                    "items": [
                        {
                            "label": "Additional Firstlight contract",
                            "text": "Consistent helper and error semantics, strict Boolean values, one accessible setting row, and visible state reconciled from the value accepted by PHP."
                        }
                    ]
                }
            ]
        },
        "server-authoritative-application-state": {
            "title": "Server-authoritative application state",
            "blocks": [
                {
                    "type": "text",
                    "text": "For discrete Firstlight controls, a native interaction proposes a semantic value and PHP publishes the accepted state. PHP may accept, transform, or reject the proposal. Reconciliation updates the control without echoing another event, and programmatic updates never masquerade as user interaction."
                },
                {
                    "type": "text",
                    "text": "This differs from treating a local optimistic change as accepted application state. It is useful when permissions, validation, dependent fields, or business rules can reject or replace a choice. Focused text and continuous gestures still retain the native draft state needed for responsive editing and movement; Firstlight applies the state model appropriate to each type of control."
                }
            ]
        },
        "consistency-and-diagnostics": {
            "title": "Consistency and diagnostics",
            "blocks": [
                {
                    "type": "text",
                    "text": "Across the catalogue, Firstlight applies the same rules:"
                },
                {
                    "type": "item",
                    "marker": "•",
                    "depth": 0,
                    "text": "selection binds stable domain strings or integers rather than display labels or renderer indexes;"
                },
                {
                    "type": "item",
                    "marker": "•",
                    "depth": 0,
                    "runs": [
                        {
                            "text": "null",
                            "code": true
                        },
                        {
                            "text": " consistently represents no selection;"
                        }
                    ]
                },
                {
                    "type": "item",
                    "marker": "•",
                    "depth": 0,
                    "text": "rich options can separate values, labels, and disabled state;"
                },
                {
                    "type": "item",
                    "marker": "•",
                    "depth": 0,
                    "text": "malformed options, duplicate or mixed values, impossible ranges, contradictory props, and unsupported sync modes fail before publication;"
                },
                {
                    "type": "item",
                    "marker": "•",
                    "depth": 0,
                    "text": "labels, helper text, errors, required metadata, accessibility hints, disabled state, and minimum interaction targets follow familiar conventions;"
                },
                {
                    "type": "item",
                    "marker": "•",
                    "depth": 0,
                    "text": "the same authored component works on iOS and Android while each platform retains its native geometry, motion, presentation, and accessibility behaviour."
                },
                {
                    "type": "text",
                    "text": "Firstlight deliberately exposes fewer visual escape hatches and platform-only options than a general-purpose primitive library. This narrower surface keeps application code portable and allows the components to behave consistently as the native platforms evolve."
                }
            ]
        },
        "laravel-shaped-php-extensions": {
            "title": "Laravel-shaped PHP extensions",
            "blocks": [
                {
                    "type": "text",
                    "runs": [
                        {
                            "text": "Some Firstlight behaviour is not a new control. Field validation ("
                        },
                        {
                            "text": "ValidatesFields",
                            "code": true
                        },
                        {
                            "text": ") runs Laravel's "
                        },
                        {
                            "text": "Validator",
                            "code": true
                        },
                        {
                            "text": " in PHP and publishes the first "
                        },
                        {
                            "text": "MessageBag",
                            "code": true
                        },
                        {
                            "text": " message into each field's existing "
                        },
                        {
                            "text": "error",
                            "code": true
                        },
                        {
                            "text": " slot. Form submission ("
                        },
                        {
                            "text": "SubmitsForms",
                            "code": true
                        },
                        {
                            "text": ") validates, runs a PHP callable once, and optionally sends success Feedback. Action authorization ("
                        },
                        {
                            "text": "AuthorizesActions",
                            "code": true
                        },
                        {
                            "text": ") evaluates Laravel Gate/Policy decisions for hide, disable, and action-time guards. List pagination ("
                        },
                        {
                            "text": "PaginatesLists",
                            "code": true
                        },
                        {
                            "text": ") binds Laravel paginators to List "
                        },
                        {
                            "text": "@refresh",
                            "code": true
                        },
                        {
                            "text": " and "
                        },
                        {
                            "text": "@endReached",
                            "code": true
                        },
                        {
                            "text": ". Destructive list actions ("
                        },
                        {
                            "text": "DestroysListItems",
                            "code": true
                        },
                        {
                            "text": ") authorize Confirmation Dialog deletion by stable keys and republish "
                        },
                        {
                            "text": "$listItems",
                            "code": true
                        },
                        {
                            "text": ". Package locale chrome publishes Firstlight-owned chrome strings from one Laravel language file, and Date/Time pickers inherit omitted locale and timezone from the application. Transient Feedback is an application-level outcome queue, not a Blade field. See "
                        },
                        {
                            "text": "Validate fields",
                            "link": 2
                        },
                        {
                            "text": ", "
                        },
                        {
                            "text": "Submit forms",
                            "link": 3
                        },
                        {
                            "text": ", "
                        },
                        {
                            "text": "Authorize actions",
                            "link": 4
                        },
                        {
                            "text": ", "
                        },
                        {
                            "text": "Paginate lists",
                            "link": 5
                        },
                        {
                            "text": ", "
                        },
                        {
                            "text": "Destroy list items",
                            "link": 6
                        },
                        {
                            "text": ", and "
                        },
                        {
                            "text": "Localize chrome",
                            "link": 7
                        },
                        {
                            "text": "."
                        }
                    ]
                },
                {
                    "type": "text",
                    "runs": [
                        {
                            "text": "Layout, typography, and generic media stay in Mobile UI, and navigation chrome stays in NativePHP Mobile. Firstlight does not ship columns, bottom tabs, a separate masked-input or currency control, or a schema/form builder; Text Field's "
                        },
                        {
                            "text": "mask",
                            "code": true
                        },
                        {
                            "text": " pattern formats structured codes. Compose screens with Blade, Mobile UI layout, and Firstlight fields."
                        }
                    ]
                },
                {
                    "type": "heading",
                    "text": "Custom tappable content and accessibility"
                },
                {
                    "type": "text",
                    "runs": [
                        {
                            "text": "NativePHP core owns arbitrary-content "
                        },
                        {
                            "text": "native:pressable",
                            "code": true
                        },
                        {
                            "text": " surfaces. In the supported Mobile 4.6 implementation, Blade preserves their authored accessibility labels, but the generic native renderers do not consume those labels/hints or explicitly map a button role and disabled/selected state. Android's clickable supplies implicit Compose grouping; iOS uses a tap gesture without explicit accessibility grouping. Adding "
                        },
                        {
                            "text": "a11y-label",
                            "code": true
                        },
                        {
                            "text": " to a "
                        },
                        {
                            "text": "native:column",
                            "code": true
                        },
                        {
                            "text": " does not turn it into one accessible measurement either. Do not assume a visual tap target is accessible."
                        }
                    ]
                },
                {
                    "type": "text",
                    "runs": [
                        {
                            "text": "Use "
                        },
                        {
                            "text": "Button",
                            "link": 8
                        },
                        {
                            "text": " for labelled actions and "
                        },
                        {
                            "text": "List Item",
                            "link": 9
                        },
                        {
                            "text": " for application rows when their content contracts fit. Use "
                        },
                        {
                            "text": "Metric",
                            "link": 10
                        },
                        {
                            "text": " for a static grouped statistic. There is no supported arbitrary-content accessible action wrapper in Firstlight; custom interactive banners need an upstream core accessibility fix. Panels, dividers and tile grids remain Mobile UI layout, not catalogue controls."
                        }
                    ]
                }
            ]
        },
        "reusing-mobile-ui-when-it-already-fits": {
            "title": "Reusing Mobile UI when it already fits",
            "blocks": [
                {
                    "type": "text",
                    "runs": [
                        {
                            "text": "Firstlight does not maintain duplicate native code merely to put every control under its own namespace. "
                        },
                        {
                            "text": "Button",
                            "strong": true
                        },
                        {
                            "text": " and "
                        },
                        {
                            "text": "Progress",
                            "strong": true
                        },
                        {
                            "text": " currently keep public Firstlight element types while delegating directly to the official Mobile UI SwiftUI and Material 3 renderers."
                        }
                    ]
                },
                {
                    "type": "text",
                    "text": "Firstlight adds strict authoring boundaries, documentation, tests, and catalogue consistency around those primitives, but does not claim new native rendering functionality. If a durable cross-platform requirement later outgrows an adapter, Firstlight can introduce paired renderers without changing consumer markup. Generally useful improvements remain good candidates for contribution to Mobile UI itself."
                }
            ]
        },
        "one-native-ecosystem": {
            "title": "One native ecosystem",
            "blocks": [
                {
                    "type": "text",
                    "text": "Firstlight components use ordinary NativePHP UI component extension points. They publish Element Tree data, receive standard semantic events, inherit Mobile UI theme tokens, and require no custom imperative bridge functions or WebView-backed control layer."
                },
                {
                    "type": "text",
                    "runs": [
                        {
                            "text": "The relationship is intentionally complementary: "
                        },
                        {
                            "text": "NativePHP provides the native foundation and chrome; Firstlight provides the app-shell layer of controls, Laravel contracts, and recipes on top of it.",
                            "strong": true
                        }
                    ]
                },
                {
                    "type": "text",
                    "runs": [
                        {
                            "text": "Review the current "
                        },
                        {
                            "text": "compatibility requirements",
                            "link": 11
                        },
                        {
                            "text": " before releasing an application, particularly where server-authoritative controls depend on unchanged-tree publication acknowledgements from NativePHP Mobile."
                        }
                    ]
                }
            ]
        }
