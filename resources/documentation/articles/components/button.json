    "chapters": {
        "overview": {
            "title": "Overview",
            "blocks": [
                {
                    "type": "text",
                    "runs": [
                        {
                            "text": "Button performs one immediate, labelled action. Firstlight includes it because a coherent UI library is expected to provide its foundational action control under the same "
                        },
                        {
                            "text": "<firstlight:...>",
                            "code": true
                        },
                        {
                            "text": " namespace and semantic conventions as the rest of the catalogue."
                        }
                    ]
                },
                {
                    "type": "text",
                    "runs": [
                        {
                            "text": "The current component deliberately wraps the adequate "
                        },
                        {
                            "text": "nativephp/mobile-ui",
                            "code": true
                        },
                        {
                            "text": " Button. It keeps a stable Firstlight API while reusing the official SwiftUI and Material 3 renderers instead of maintaining duplicate native code."
                        }
                    ]
                }
            ]
        },
        "complete-example": {
            "title": "Complete example",
            "blocks": [
                {
                    "type": "code",
                    "language": "blade",
                    "text": "<firstlight:button\n    variant=\"primary\"\n    size=\"md\"\n    icon=\"check\"\n    :loading=\"$saving\"\n    :disabled=\"! $canSave\"\n    a11y-hint=\"Saves the current form\"\n    @press=\"save\"\n>\n    Save changes\n</firstlight:button>"
                },
                {
                    "type": "text",
                    "runs": [
                        {
                            "text": "The same authored tag works on iOS and Android. A self-closing form with a "
                        },
                        {
                            "text": "label",
                            "code": true
                        },
                        {
                            "text": " prop is also accepted, but the text slot is preferred for ordinary Blade markup."
                        }
                    ]
                }
            ]
        },
