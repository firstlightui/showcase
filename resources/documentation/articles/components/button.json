        "events-and-values": {
            "title": "Events and values",
            "blocks": [
                {
                    "type": "text",
                    "runs": [
                        {
                            "text": "@press",
                            "code": true
                        },
                        {
                            "text": " invokes the named PHP action once for a native user press. Button has no bound value, options, "
                        },
                        {
                            "text": "native:model",
                            "code": true
                        },
                        {
                            "text": ", or "
                        },
                        {
                            "text": "@change",
                            "code": true
                        },
                        {
                            "text": " event."
                        }
                    ]
                }
            ]
        },
        "state-timing": {
            "title": "State timing",
            "blocks": [
                {
                    "type": "text",
                    "runs": [
                        {
                            "text": "A press emits immediately. The native button keeps only transient platform press feedback; PHP owns the action result and publishes any subsequent "
                        },
                        {
                            "text": "loading",
                            "code": true
                        },
                        {
                            "text": ", "
                        },
                        {
                            "text": "disabled",
                            "code": true
                        },
                        {
                            "text": ", label, or layout state. Programmatic publications do not emit a press."
                        }
                    ]
                }
            ]
        },
        "disabled-loading-and-failure-behaviour": {
            "title": "Disabled, loading, and failure behaviour",
            "blocks": [
                {
                    "type": "text",
                    "text": "Disabled and loading buttons do not emit. Loading replaces the ordinary content with native progress presentation while retaining the action's accessible context."
                },
                {
                    "type": "text",
                    "runs": [
                        {
                            "text": "A missing, "
                        },
                        {
                            "text": "null",
                            "code": true
                        },
                        {
                            "text": ", empty, or whitespace-only label throws an "
                        },
                        {
                            "text": "InvalidArgumentException",
                            "code": true
                        },
                        {
                            "text": ". "
                        },
                        {
                            "text": "disabled",
                            "code": true
                        },
                        {
                            "text": " and "
                        },
                        {
                            "text": "loading",
                            "code": true
                        },
                        {
                            "text": " require real booleans. Unsupported variants or sizes also throw. Attached menus, custom typography, Liquid Glass classes, navigation directives, field props or bindings, long press, double tap, press-down, and press-up callbacks are outside this component's contract and fail rather than silently widening the API."
                        }
                    ]
                }
            ]
        },
        "accessibility": {
            "title": "Accessibility",
            "blocks": [
                {
                    "type": "text",
                    "runs": [
                        {
                            "text": "The visible text is the accessible name by default. "
                        },
                        {
                            "text": "a11y-label",
                            "code": true
                        },
                        {
                            "text": " replaces it, and "
                        },
                        {
                            "text": "a11y-hint",
                            "code": true
                        },
                        {
                            "text": " adds context. The native renderers expose the button role, disabled state, press interaction, Dynamic Type or system font scaling, platform focus behaviour, and platform target sizing. Android also announces loading as a state description."
                        }
                    ]
                }
            ]
        },
        "platform-behaviour": {
            "title": "Platform behaviour",
            "blocks": [
                {
                    "type": "text",
                    "runs": [
                        {
                            "text": "iOS uses the official Mobile UI SwiftUI "
                        },
                        {
                            "text": "Button",
                            "code": true
                        },
                        {
                            "text": " renderer for every variant except "
                        },
                        {
                            "text": "ghost",
                            "code": true
                        },
                        {
                            "text": ", with native button styles, control sizes, progress presentation, icon layout, VoiceOver metadata, and semantic theme tokens. On iOS, "
                        },
                        {
                            "text": "ghost",
                            "code": true
                        },
                        {
                            "text": " uses a Firstlight renderer: the same plain, tinted SwiftUI "
                        },
                        {
                            "text": "Button",
                            "code": true
                        },
                        {
                            "text": ", with at least a 44-point touch target. Mobile UI's plain ghost button only responds to taps on its text. Android uses the official Mobile UI Material 3 "
                        },
                        {
                            "text": "Button",
                            "code": true
                        },
                        {
                            "text": ", "
                        },
                        {
                            "text": "FilledTonalButton",
                            "code": true
                        },
                        {
                            "text": ", or "
                        },
                        {
                            "text": "TextButton",
                            "code": true
                        },
                        {
                            "text": " renderer with native state layers, progress presentation, icon layout, TalkBack metadata, and semantic theme tokens."
                        }
                    ]
                },
                {
                    "type": "text",
                    "runs": [
                        {
                            "text": "The shared variants express the same intent without forcing pixel parity. "
                        },
                        {
                            "text": "destructive",
                            "code": true
                        },
                        {
                            "text": " is currently a semantic visual variant; Firstlight does not expose an Apple-only action-role prop."
                        }
                    ]
                }
            ]
        },
        "why-an-adapter": {
            "title": "Why an adapter?",
            "blocks": [
                {
                    "type": "text",
                    "runs": [
                        {
                            "text": "The official Mobile UI primitive already satisfies this contract. Firstlight therefore wraps it for catalogue and namespace consistency instead of rebuilding it. The public type remains "
                        },
                        {
                            "text": "firstlight.button",
                            "code": true
                        },
                        {
                            "text": ", so Firstlight can move to package-owned renderers later without changing consumer markup if a durable cross-platform requirement genuinely outgrows Mobile UI. Generally useful renderer improvements should be contributed upstream where practical."
                        }
                    ]
                }
            ]
        },
        "compatibility": {
            "title": "Compatibility",
            "blocks": [
                {
                    "type": "text",
                    "runs": [
                        {
                            "text": "Button supports the versions listed in the current "
                        },
                        {
                            "text": "compatibility reference",
                            "link": 0
                        },
                        {
                            "text": ". The host application must compile the installed "
                        },
                        {
                            "text": "nativephp/mobile-ui",
                            "code": true
                        },
                        {
                            "text": " iOS and Android renderers that the Firstlight adapter declares."
                        }
                    ]
                }
            ]
        },
