    "chapters": {
        "overview": {
            "title": "Overview",
            "blocks": [
                {
                    "type": "text",
                    "text": "Search Field enters and submits one query using each platform's native search, keyboard, selection, clear, focus, and accessibility behaviour."
                }
            ]
        },
        "complete-example": {
            "title": "Complete example",
            "blocks": [
                {
                    "type": "code",
                    "language": "blade",
                    "text": "<firstlight:search-field\n    placeholder=\"Search referrals\"\n    a11y-label=\"Search referrals\"\n    a11y-hint=\"Enter a patient, provider, or specialty\"\n    autocapitalize=\"words\"\n    :autocorrect=\"false\"\n    native:model.debounce.300ms=\"query\"\n    @submit=\"search\"\n/>"
                }
            ]
        },
