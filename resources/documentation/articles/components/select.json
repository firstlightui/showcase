        "options-and-values": {
            "title": "Options and values",
            "blocks": [
                {
                    "type": "text",
                    "text": "Simple strings use the same value and label:"
                },
                {
                    "type": "code",
                    "language": "php",
                    "text": "['Routine', 'Urgent']"
                },
                {
                    "type": "text",
                    "text": "A map separates stable values from labels and may use all-string or all-integer keys:"
                },
                {
                    "type": "code",
                    "language": "php",
                    "text": "['routine' => 'Routine', 'urgent' => 'Urgent']"
                },
                {
                    "type": "text",
                    "runs": [
                        {
                            "text": "Rich options accept only "
                        },
                        {
                            "text": "value",
                            "code": true
                        },
                        {
                            "text": ", "
                        },
                        {
                            "text": "label",
                            "code": true
                        },
                        {
                            "text": ", and optional "
                        },
                        {
                            "text": "disabled",
                            "code": true
                        },
                        {
                            "text": " fields:"
                        }
                    ]
                },
                {
                    "type": "code",
                    "language": "php",
                    "text": "[\n    ['value' => 10, 'label' => 'Routine'],\n    ['value' => 20, 'label' => 'Urgent', 'disabled' => true],\n]"
                },
                {
                    "type": "text",
                    "runs": [
                        {
                            "text": "Values in one collection must be unique and all strings or all integers. Matching is strict: integer "
                        },
                        {
                            "text": "10",
                            "code": true
                        },
                        {
                            "text": " does not match string "
                        },
                        {
                            "text": "'10'",
                            "code": true
                        },
                        {
                            "text": ". "
                        },
                        {
                            "text": "null",
                            "code": true
                        },
                        {
                            "text": " means no selection and displays the placeholder. Empty options accept only "
                        },
                        {
                            "text": "null",
                            "code": true
                        },
                        {
                            "text": " and produce an inert trigger."
                        }
                    ]
                }
            ]
        },
        "compact-and-searchable-presentation": {
            "title": "Compact and searchable presentation",
            "blocks": [
                {
                    "type": "text",
                    "runs": [
                        {
                            "text": "Set "
                        },
                        {
                            "text": "variant=\"chip\"",
                            "code": true
                        },
                        {
                            "text": " for an intrinsic-width picker trigger with the label and accepted value inline, for example a hospital or provider selector. The default is "
                        },
                        {
                            "text": "variant=\"field\"",
                            "code": true
                        },
                        {
                            "text": ". iOS uses a native bordered capsule trigger; Android uses a Material 3 AssistChip. This changes the closed trigger only: menus, search threshold, stable values, required/error/disabled metadata and state timing remain unchanged. Chips retain 44-point iOS / 48-dp Android targets rather than shrinking the touch area to the text."
                        }
                    ]
                },
                {
                    "type": "code",
                    "language": "blade",
                    "text": "<firstlight:select\n    variant=\"chip\"\n    :options=\"['north' => 'North', 'south' => 'South']\"\n    native:model=\"hospital\"\n    label=\"Hospital\"\n/>"
                },
                {
                    "type": "text",
                    "runs": [
                        {
                            "text": "Declare "
                        },
                        {
                            "text": "public ?string $hospital = 'north';",
                            "code": true
                        },
                        {
                            "text": " on the screen."
                        }
                    ]
                },
                {
                    "type": "text",
                    "runs": [
                        {
                            "text": "Select chooses its platform presentation from the option count. Up to 12 options use a compact menu or dropdown. Thirteen or more options use a searchable presentation automatically. Set "
                        },
                        {
                            "text": "searchable",
                            "code": true
                        },
                        {
                            "text": " to force search for a smaller collection."
                        }
                    ]
                },
                {
                    "type": "text",
                    "runs": [
                        {
                            "text": "Search filters labels locally in authored order. Typing, dismissing search, or selecting the accepted value does not publish an event. The iOS searchable sheet Done action is package chrome; see "
                        },
                        {
                            "text": "Localize chrome",
                            "link": 0
                        },
                        {
                            "text": "."
                        }
                    ]
                }
            ]
        },
        "events-and-state-timing": {
            "title": "Events and state timing",
            "blocks": [
                {
                    "type": "text",
                    "runs": [
                        {
                            "text": "@change",
                            "code": true
                        },
                        {
                            "text": " receives the proposed stable scalar with its authored PHP type. "
                        },
                        {
                            "text": "native:model",
                            "code": true
                        },
                        {
                            "text": " normally generates this callback for property synchronisation."
                        }
                    ]
                },
                {
                    "type": "text",
                    "runs": [
                        {
                            "text": "Select is "
                        },
                        {
                            "text": "server-authoritative",
                            "link": 1
                        },
                        {
                            "text": ". Choosing an enabled option emits immediately, but the trigger continues to show PHP's accepted value until the next publication. Further choices are ignored while that proposal is in flight. Rejected and programmatic publications do not emit."
                        }
                    ]
                },
                {
                    "type": "text",
                    "runs": [
                        {
                            "text": "An unchanged PHP response must also release the pending-interaction guard. Host the control in "
                        },
                        {
                            "text": "FirstlightUI\\NativeComponent",
                            "code": true
                        },
                        {
                            "text": " for the "
                        },
                        {
                            "text": "nonstreaming response-revision contract",
                            "link": 2
                        },
                        {
                            "text": ". Revisions are not per-event acknowledgements and do not prevent coalescing or serialize simultaneous proposals."
                        }
                    ]
                },
                {
                    "type": "text",
                    "runs": [
                        {
                            "text": "Use plain "
                        },
                        {
                            "text": "native:model",
                            "code": true
                        },
                        {
                            "text": " or "
                        },
                        {
                            "text": "native:model.live",
                            "code": true
                        },
                        {
                            "text": "; deferred "
                        },
                        {
                            "text": "blur",
                            "code": true
                        },
                        {
                            "text": " and "
                        },
                        {
                            "text": "debounce",
                            "code": true
                        },
                        {
                            "text": " modes are rejected."
                        }
                    ]
                }
            ]
        },
        "disabled-required-and-error-behaviour": {
            "title": "Disabled, required, and error behaviour",
            "blocks": [
                {
                    "type": "text",
                    "runs": [
                        {
                            "text": "disabled",
                            "code": true
                        },
                        {
                            "text": " prevents the trigger and every option from emitting. A rich option's "
                        },
                        {
                            "text": "disabled: true",
                            "code": true
                        },
                        {
                            "text": " affects only that choice. "
                        },
                        {
                            "text": "required",
                            "code": true
                        },
                        {
                            "text": " communicates state but does not add client-side validation. Publish "
                        },
                        {
                            "text": "error",
                            "code": true
                        },
                        {
                            "text": " from PHP when validation fails; it replaces helper text on both platforms."
                        }
                    ]
                }
            ]
        },
        "accessibility": {
            "title": "Accessibility",
            "blocks": [
                {
                    "type": "text",
                    "runs": [
                        {
                            "text": "Provide either a visible "
                        },
                        {
                            "text": "label",
                            "code": true
                        },
                        {
                            "text": " or an explicit "
                        },
                        {
                            "text": "a11y-label",
                            "code": true
                        },
                        {
                            "text": ". Firstlight warns during development when both are blank. The trigger exposes its accessible name, accepted value or placeholder, hint, required state, disabled state, and error. Option rows expose labels, selection, and disabled state. Native search retains editable-text semantics, labels wrap at accessibility sizes, and controls preserve platform minimum interaction targets."
                        }
                    ]
                }
            ]
        },
        "validation-and-failure-behaviour": {
            "title": "Validation and failure behaviour",
            "blocks": [
                {
                    "type": "text",
                    "runs": [
                        {
                            "text": "Contract exceptions still reject malformed options, type mismatches, and unsupported presentation props before publication. User validation is separate: screens that "
                        },
                        {
                            "text": "use ValidatesFields",
                            "code": true
                        },
                        {
                            "text": " auto-bind the first MessageBag message for the field's "
                        },
                        {
                            "text": "native:model",
                            "code": true
                        },
                        {
                            "text": " or "
                        },
                        {
                            "text": "error-for",
                            "code": true
                        },
                        {
                            "text": " name. An authored "
                        },
                        {
                            "text": "error",
                            "code": true
                        },
                        {
                            "text": " wins. "
                        },
                        {
                            "text": "required",
                            "code": true
                        },
                        {
                            "text": " is display metadata and does not run Laravel rules. See "
                        },
                        {
                            "text": "Validate fields",
                            "link": 3
                        },
                        {
                            "text": "."
                        }
                    ]
                }
            ]
        },
        "platform-behaviour": {
            "title": "Platform behaviour",
            "blocks": [
                {
                    "type": "text",
                    "runs": [
                        {
                            "text": "iOS uses a SwiftUI "
                        },
                        {
                            "text": "Menu",
                            "code": true
                        },
                        {
                            "text": " for compact collections and a native searchable sheet with checkmarked rows for searchable collections. Android uses a Material 3 exposed dropdown for compact collections and a searchable Material dialog with radio rows for searchable collections. Both preserve the same stable-value, disabled-option, threshold, publication, and stale-selection semantics."
                        }
                    ]
                }
            ]
        },
        "compatibility": {
            "title": "Compatibility",
            "blocks": [
                {
                    "type": "text",
                    "runs": [
                        {
                            "text": "Select supports the versions listed in the current "
                        },
                        {
                            "text": "compatibility reference",
                            "link": 4
                        },
                        {
                            "text": " and requires both native renderers in the host application plus Firstlight's screen response contract above. It does not require an unreleased runtime fix."
                        }
                    ]
                }
            ]
        },
