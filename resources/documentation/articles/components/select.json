    "chapters": {
        "overview": {
            "title": "Overview",
            "blocks": [
                {
                    "type": "text",
                    "text": "Select presents a collapsed, single-choice field and publishes one stable string or integer value."
                }
            ]
        },
        "complete-example": {
            "title": "Complete example",
            "blocks": [
                {
                    "type": "code",
                    "language": "php",
                    "text": "public ?string $priority = null;\n\npublic array $priorityOptions = [\n    ['value' => 'routine', 'label' => 'Routine'],\n    ['value' => 'urgent', 'label' => 'Urgent'],\n    ['value' => 'critical', 'label' => 'Critical', 'disabled' => true],\n];"
                },
                {
                    "type": "code",
                    "language": "blade",
                    "text": "<firstlight:select\n    :options=\"$priorityOptions\"\n    native:model=\"priority\"\n    label=\"Priority\"\n    placeholder=\"Select a priority\"\n    helper=\"Choose one priority.\"\n/>"
                }
            ]
        },
