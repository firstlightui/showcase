{
    "id": "components/alert-dialog",
    "title": "Alert Dialog",
    "description": "Present one native acknowledgement with a single action and server-controlled visibility.",
    "group": "Components",
    "anchors": {
        "alert-dialog": "overview",
        "props-and-events": "props-and-events",
        "behavior-and-accessibility": "behavior-and-accessibility",
        "screenshots": "screenshots"
    },
    "chapters": {
        "overview": {
            "title": "Overview",
            "blocks": [
                {
                    "type": "text",
                    "text": "Alert Dialog tells the user one fact they must acknowledge. It uses the platform's native one-button alert, not a custom full-screen overlay."
                },
                {
                    "type": "text",
                    "runs": [
                        {
                            "text": "Use "
                        },
                        {
                            "text": "Confirmation Dialog",
                            "link": 0
                        },
                        {
                            "text": " when the user must choose between confirm and cancel. Use "
                        },
                        {
                            "text": "Transient Feedback",
                            "link": 1
                        },
                        {
                            "text": " for a non-blocking toast. Use "
                        },
                        {
                            "text": "Modal",
                            "link": 2
                        },
                        {
                            "text": " only when the surface needs authored child content."
                        }
                    ]
                },
                {
                    "type": "code",
                    "language": "blade",
                    "text": "<firstlight:alert-dialog\n    :visible=\"$showingSaved\"\n    title=\"Changes saved\"\n    message=\"Your profile was updated.\"\n    action-label=\"OK\"\n    @dismiss=\"acknowledgeSaved\"\n/>"
                },
                {
                    "type": "text",
                    "runs": [
                        {
                            "text": "The dismiss handler should set "
                        },
                        {
                            "text": "$showingSaved",
                            "code": true
                        },
                        {
                            "text": " to "
                        },
                        {
                            "text": "false",
                            "code": true
                        },
                        {
                            "text": ". The same handler runs for the action button, back, and outside dismissal."
                        }
                    ]
                }
            ]
        },
        "props-and-events": {
            "title": "Props and events",
            "blocks": [
                {
                    "type": "item",
                    "marker": "•",
                    "depth": 0,
                    "runs": [
                        {
                            "text": "visible",
                            "code": true
                        },
                        {
                            "text": ": server-controlled presentation request; defaults to "
                        },
                        {
                            "text": "false",
                            "code": true
                        },
                        {
                            "text": "."
                        }
                    ]
                },
                {
                    "type": "item",
                    "marker": "•",
                    "depth": 0,
                    "runs": [
                        {
                            "text": "title",
                            "code": true
                        },
                        {
                            "text": ": required visible heading and accessible dialog name."
                        }
                    ]
                },
                {
                    "type": "item",
                    "marker": "•",
                    "depth": 0,
                    "runs": [
                        {
                            "text": "message",
                            "code": true
                        },
                        {
                            "text": ": required explanation."
                        }
                    ]
                },
                {
                    "type": "item",
                    "marker": "•",
                    "depth": 0,
                    "runs": [
                        {
                            "text": "action-label",
                            "code": true
                        },
                        {
                            "text": ": acknowledgement action text; defaults to the package chrome string "
                        },
                        {
                            "text": "OK",
                            "code": true
                        },
                        {
                            "text": ". The "
                        },
                        {
                            "text": "actionLabel",
                            "code": true
                        },
                        {
                            "text": " alias is accepted. See "
                        },
                        {
                            "text": "Localize chrome",
                            "link": 3
                        },
                        {
                            "text": "."
                        }
                    ]
                },
                {
                    "type": "item",
                    "marker": "•",
                    "depth": 0,
                    "runs": [
                        {
                            "text": "@dismiss",
                            "code": true
                        },
                        {
                            "text": ": required callback for the action, back, or outside dismissal."
                        }
                    ]
                },
                {
                    "type": "item",
                    "marker": "•",
                    "depth": 0,
                    "runs": [
                        {
                            "text": "class",
                            "code": true
                        },
                        {
                            "text": ": external EDGE layout only."
                        }
                    ]
                },
                {
                    "type": "text",
                    "runs": [
                        {
                            "text": "The component always presents one action. It does not support "
                        },
                        {
                            "text": "@press",
                            "code": true
                        },
                        {
                            "text": ", a cancel action, tones, icons, loading or disabled states, "
                        },
                        {
                            "text": "native:model",
                            "code": true
                        },
                        {
                            "text": ", authored children, or an undismissable mode."
                        }
                    ]
                }
            ]
        },
        "behavior-and-accessibility": {
            "title": "Behavior and accessibility",
            "blocks": [
                {
                    "type": "text",
                    "runs": [
                        {
                            "text": "One user acknowledgement produces one "
                        },
                        {
                            "text": "@dismiss",
                            "code": true
                        },
                        {
                            "text": " callback. Programmatic closure produces none. After the user dismisses the dialog, copy-only publications do not reopen it; a later server transition from "
                        },
                        {
                            "text": "false",
                            "code": true
                        },
                        {
                            "text": " to "
                        },
                        {
                            "text": "true",
                            "code": true
                        },
                        {
                            "text": " presents it again."
                        }
                    ]
                },
                {
                    "type": "text",
                    "runs": [
                        {
                            "text": "iOS uses SwiftUI "
                        },
                        {
                            "text": "alert",
                            "code": true
                        },
                        {
                            "text": ". Android uses Material 3 "
                        },
                        {
                            "text": "AlertDialog",
                            "code": true
                        },
                        {
                            "text": " with a single confirm button. Native chrome owns modal focus, action placement, Dynamic Type or font scaling, dark appearance, contrast, reduced motion, and right-to-left behavior. The title is the accessible name."
                        }
                    ]
                }
            ]
        },
        "screenshots": {
            "title": "Screenshots",
            "blocks": [
                {
                    "type": "image",
                    "src": "documentation/screenshots/alert-dialog/ios-light.png",
                    "text": "Alert Dialog on iOS in light mode"
                },
                {
                    "type": "image",
                    "src": "documentation/screenshots/alert-dialog/ios-dark.png",
                    "text": "Alert Dialog on iOS in dark mode"
                },
                {
                    "type": "image",
                    "src": "documentation/screenshots/alert-dialog/android-light.png",
                    "text": "Alert Dialog on Android in light mode"
                },
                {
                    "type": "image",
                    "src": "documentation/screenshots/alert-dialog/android-dark.png",
                    "text": "Alert Dialog on Android in dark mode"
                }
            ]
        }
    },
