    "chapters": {
        "overview": {
            "title": "Overview",
            "blocks": [
                {
                    "type": "text",
                    "text": "Text Area enters and edits plain multiline text using each platform's native selection, composition, focus, scrolling, autocapitalization, and autocorrection behaviour."
                }
            ]
        },
        "complete-example": {
            "title": "Complete example",
            "blocks": [
                {
                    "type": "code",
                    "language": "blade",
                    "text": "<firstlight:text-area\n    label=\"Clinical notes\"\n    placeholder=\"Add relevant history and observations\"\n    helper=\"Do not include information that is not required.\"\n    :required=\"true\"\n    :min-lines=\"4\"\n    :max-lines=\"10\"\n    autocapitalize=\"sentences\"\n    native:model.debounce.500ms=\"notes\"\n/>"
                }
            ]
        },
