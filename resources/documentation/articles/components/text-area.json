        "events-and-synchronisation": {
            "title": "Events and synchronisation",
            "blocks": [
                {
                    "type": "text",
                    "runs": [
                        {
                            "text": "@change",
                            "code": true
                        },
                        {
                            "text": " receives the complete current string, including newline characters. Plain "
                        },
                        {
                            "text": "native:model",
                            "code": true
                        },
                        {
                            "text": " and "
                        },
                        {
                            "text": ".live",
                            "code": true
                        },
                        {
                            "text": " publish while editing. "
                        },
                        {
                            "text": ".blur",
                            "code": true
                        },
                        {
                            "text": " and "
                        },
                        {
                            "text": ".lazy",
                            "code": true
                        },
                        {
                            "text": " publish on focus loss. "
                        },
                        {
                            "text": ".debounce.500ms",
                            "code": true
                        },
                        {
                            "text": " publishes after the quiet period and flushes on blur. Durations below 50 milliseconds are rejected."
                        }
                    ]
                },
                {
                    "type": "text",
                    "runs": [
                        {
                            "text": "On iOS, pressing a "
                        },
                        {
                            "text": "<firstlight:button>",
                            "code": true
                        },
                        {
                            "text": " while the editor is focused publishes its pending "
                        },
                        {
                            "text": ".blur",
                            "code": true
                        },
                        {
                            "text": " or "
                        },
                        {
                            "text": ".debounce",
                            "code": true
                        },
                        {
                            "text": " change before the press, so the handler reads the current value. Icon Button and List Item presses do not flush the editor first. On Android, blur/debounce changes are not yet guaranteed to reach PHP before a button press, so for forms submitted by a separate button use "
                        },
                        {
                            "text": "native:model.live=\"notes\"",
                            "code": true
                        },
                        {
                            "text": " (or plain "
                        },
                        {
                            "text": "native:model",
                            "code": true
                        },
                        {
                            "text": "). Keyboard dismissal alone is not an ordering guarantee there."
                        }
                    ]
                },
                {
                    "type": "text",
                    "runs": [
                        {
                            "text": "Typing, selection, cursor position, marked text or IME composition, focus, keyboard, and scroll position remain native while focused. PHP acknowledgements therefore do not replace the active buffer. Different server publications wait for safe reconciliation, while unfocused programmatic updates replace the displayed string without emitting "
                        },
                        {
                            "text": "@change",
                            "code": true
                        },
                        {
                            "text": "."
                        }
                    ]
                },
                {
                    "type": "text",
                    "runs": [
                        {
                            "text": "Text Area intentionally has no "
                        },
                        {
                            "text": "@submit",
                            "code": true
                        },
                        {
                            "text": ", "
                        },
                        {
                            "text": "@press",
                            "code": true
                        },
                        {
                            "text": ", icons, secure mode, single-line keyboard or content hints, clear/reveal affordances, loading state, prefix, suffix, or styling escape props."
                        }
                    ]
                }
            ]
        },
        "validation-and-accessibility": {
            "title": "Validation and accessibility",
            "blocks": [
                {
                    "type": "text",
                    "runs": [
                        {
                            "text": "Contract exceptions still reject invalid types, unordered line bounds, and unsupported sync modes before publication. User validation is separate: screens that "
                        },
                        {
                            "text": "use ValidatesFields",
                            "code": true
                        },
                        {
                            "text": " auto-bind the first MessageBag message for the field's "
                        },
                        {
                            "text": "native:model",
                            "code": true
                        },
                        {
                            "text": " or "
                        },
                        {
                            "text": "error-for",
                            "code": true
                        },
                        {
                            "text": " name. An authored "
                        },
                        {
                            "text": "error",
                            "code": true
                        },
                        {
                            "text": " wins. "
                        },
                        {
                            "text": "required",
                            "code": true
                        },
                        {
                            "text": " is display metadata and does not run Laravel rules. See "
                        },
                        {
                            "text": "Validate fields",
                            "link": 0
                        },
                        {
                            "text": "."
                        }
                    ]
                },
                {
                    "type": "text",
                    "runs": [
                        {
                            "text": "A visible "
                        },
                        {
                            "text": "label",
                            "code": true
                        },
                        {
                            "text": " or explicit "
                        },
                        {
                            "text": "a11y-label",
                            "code": true
                        },
                        {
                            "text": " is required during development. Error text replaces helper text while preserving the current accessible name and value. Disabled and read-only states remain distinct. Native type scaling, light and dark appearance, increased contrast, Reduced Motion, and RTL remain platform-owned."
                        }
                    ]
                }
            ]
        },
        "platform-behaviour": {
            "title": "Platform behaviour",
            "blocks": [
                {
                    "type": "text",
                    "runs": [
                        {
                            "text": "iOS uses a genuine SwiftUI "
                        },
                        {
                            "text": "TextEditor",
                            "code": true
                        },
                        {
                            "text": " in Apple-native field composition. Android uses Material 3 "
                        },
                        {
                            "text": "OutlinedTextField",
                            "code": true
                        },
                        {
                            "text": " with "
                        },
                        {
                            "text": "TextFieldValue",
                            "code": true
                        },
                        {
                            "text": ", multiline line bounds, supporting and error slots, and Compose selection and composition."
                        }
                    ]
                }
            ]
        },
