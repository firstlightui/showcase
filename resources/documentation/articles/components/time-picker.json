{
    "id": "components/time-picker",
    "title": "Time Picker",
    "description": "Choose a wall-clock time with a native, server-authoritative picker.",
    "group": "Components",
    "anchors": {
        "time-picker": "overview",
        "values-and-props": "values-and-props",
        "validation-and-accessibility": "validation-and-accessibility",
        "screenshots": "screenshots"
    },
    "chapters": {
        "overview": {
            "title": "Overview",
            "blocks": [
                {
                    "type": "text",
                    "runs": [
                        {
                            "text": "Time Picker chooses an optional wall-clock time using the platform's native time control. The model value is always exact 24-hour "
                        },
                        {
                            "text": "HH:mm",
                            "code": true
                        },
                        {
                            "text": " or "
                        },
                        {
                            "text": "null",
                            "code": true
                        },
                        {
                            "text": ", even when the platform displays a localized 12-hour clock."
                        }
                    ]
                },
                {
                    "type": "code",
                    "language": "blade",
                    "text": "<firstlight:time-picker\n    native:model=\"appointmentTime\"\n    label=\"Appointment time\"\n    placeholder=\"Choose a time\"\n    helper=\"Clinic local time\"\n    locale=\"en-AU\"\n    timezone=\"Australia/Sydney\"\n/>"
                },
                {
                    "type": "text",
                    "runs": [
                        {
                            "text": "The user edits a temporary native draft. Cancel discards it and Confirm sends "
                        },
                        {
                            "text": "@change",
                            "code": true
                        },
                        {
                            "text": "; the closed trigger continues to show the server-accepted value until PHP republishes the tree."
                        }
                    ]
                }
            ]
        },
        "values-and-props": {
            "title": "Values and props",
            "blocks": [
                {
                    "type": "item",
                    "marker": "•",
                    "depth": 0,
                    "runs": [
                        {
                            "text": "value",
                            "code": true
                        },
                        {
                            "text": " / "
                        },
                        {
                            "text": "native:model",
                            "code": true
                        },
                        {
                            "text": ": exact "
                        },
                        {
                            "text": "HH:mm",
                            "code": true
                        },
                        {
                            "text": " or "
                        },
                        {
                            "text": "null",
                            "code": true
                        },
                        {
                            "text": "."
                        }
                    ]
                },
                {
                    "type": "item",
                    "marker": "•",
                    "depth": 0,
                    "runs": [
                        {
                            "text": "label",
                            "code": true
                        },
                        {
                            "text": ", "
                        },
                        {
                            "text": "placeholder",
                            "code": true
                        },
                        {
                            "text": ", "
                        },
                        {
                            "text": "helper",
                            "code": true
                        },
                        {
                            "text": ", and "
                        },
                        {
                            "text": "error",
                            "code": true
                        },
                        {
                            "text": ": field copy."
                        }
                    ]
                },
                {
                    "type": "item",
                    "marker": "•",
                    "depth": 0,
                    "runs": [
                        {
                            "text": "required",
                            "code": true
                        },
                        {
                            "text": " and "
                        },
                        {
                            "text": "disabled",
                            "code": true
                        },
                        {
                            "text": ": field state."
                        }
                    ]
                },
                {
                    "type": "item",
                    "marker": "•",
                    "depth": 0,
                    "runs": [
                        {
                            "text": "locale",
                            "code": true
                        },
                        {
                            "text": ": BCP-47 tag used only for display. Omission inherits the application translator locale."
                        }
                    ]
                },
                {
                    "type": "item",
                    "marker": "•",
                    "depth": 0,
                    "runs": [
                        {
                            "text": "timezone",
                            "code": true
                        },
                        {
                            "text": ": IANA identifier used only to seed a null draft with the current local minute. Omission inherits "
                        },
                        {
                            "text": "config('app.timezone')",
                            "code": true
                        },
                        {
                            "text": " when it is a valid IANA identifier."
                        }
                    ]
                },
                {
                    "type": "item",
                    "marker": "•",
                    "depth": 0,
                    "runs": [
                        {
                            "text": "a11y-label",
                            "code": true
                        },
                        {
                            "text": " and "
                        },
                        {
                            "text": "a11y-hint",
                            "code": true
                        },
                        {
                            "text": ": explicit accessibility copy."
                        }
                    ]
                },
                {
                    "type": "item",
                    "marker": "•",
                    "depth": 0,
                    "runs": [
                        {
                            "text": "class",
                            "code": true
                        },
                        {
                            "text": ": external EDGE layout."
                        }
                    ]
                },
                {
                    "type": "text",
                    "runs": [
                        {
                            "text": "Use plain "
                        },
                        {
                            "text": "native:model",
                            "code": true
                        },
                        {
                            "text": " or "
                        },
                        {
                            "text": "native:model.live",
                            "code": true
                        },
                        {
                            "text": ". Time Picker commits only on confirmation, so blur, lazy, and debounce modes are rejected. It deliberately does not expose min/max, seconds, steps, ranges, hour-format overrides, presentation styles, clear affordances, read-only state, icons, or colours. Sheet Confirm and Cancel labels are package chrome, not Blade attributes; see "
                        },
                        {
                            "text": "Localize chrome",
                            "link": 0
                        },
                        {
                            "text": "."
                        }
                    ]
                }
            ]
        },
        "validation-and-accessibility": {
            "title": "Validation and accessibility",
            "blocks": [
                {
                    "type": "text",
                    "runs": [
                        {
                            "text": "Contract exceptions still reject coerced or non-canonical time strings before publication. User validation is separate: screens that "
                        },
                        {
                            "text": "use ValidatesFields",
                            "code": true
                        },
                        {
                            "text": " auto-bind the first MessageBag message for the field's "
                        },
                        {
                            "text": "native:model",
                            "code": true
                        },
                        {
                            "text": " or "
                        },
                        {
                            "text": "error-for",
                            "code": true
                        },
                        {
                            "text": " name. An authored "
                        },
                        {
                            "text": "error",
                            "code": true
                        },
                        {
                            "text": " wins. "
                        },
                        {
                            "text": "required",
                            "code": true
                        },
                        {
                            "text": " is display metadata and does not run Laravel rules. See "
                        },
                        {
                            "text": "Validate fields",
                            "link": 1
                        },
                        {
                            "text": "."
                        }
                    ]
                },
                {
                    "type": "text",
                    "runs": [
                        {
                            "text": "Always provide either a visible "
                        },
                        {
                            "text": "label",
                            "code": true
                        },
                        {
                            "text": " or "
                        },
                        {
                            "text": "a11y-label",
                            "code": true
                        },
                        {
                            "text": ". Errors replace helper text visually and are announced by platform semantics. The native presentation retains standard VoiceOver or TalkBack traversal and Cancel/Confirm actions."
                        }
                    ]
                }
            ]
        },
