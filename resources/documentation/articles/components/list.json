        "composition-rules": "composition-rules",
        "platform-expression": "platform-expression",
        "adapter-note": "adapter-note",
        "screenshots": "screenshots"
    },
    "chapters": {
        "overview": {
            "title": "Overview",
            "blocks": [
                {
                    "type": "text",
                    "runs": [
                        {
                            "text": "List presents a finite vertical collection of application rows. Compose rows with "
                        },
                        {
                            "text": "List Item",
                            "link": 0
                        },
                        {
                            "text": " and optional grouped sections with "
                        },
                        {
                            "text": "List Section",
                            "link": 1
                        },
                        {
                            "text": "."
                        }
                    ]
                }
            ]
        },
        "complete-example": {
            "title": "Complete example",
            "blocks": [
                {
                    "type": "code",
                    "language": "blade",
                    "text": "<firstlight:list separator @refresh=\"reloadItems\" @endReached=\"loadMore\">\n    <firstlight:list-item headline=\"Account\" @press=\"openAccount\" />\n\n    <firstlight:list-section header=\"Preferences\" footer=\"Changes sync automatically\">\n        <firstlight:list-item headline=\"Notifications\" @press=\"openNotifications\" />\n        <firstlight:list-item headline=\"Privacy\" @press=\"openPrivacy\" />\n    </firstlight:list-section>\n</firstlight:list>"
                },
                {
                    "type": "text",
                    "text": "List is a paired container. Only List Item and List Section children are accepted."
                }
            ]
        },
        "props": {
            "title": "Props",
            "blocks": [
                {
                    "type": "definition",
                    "term": {
                        "runs": [
                            {
                                "text": "separator",
                                "code": true
                            }
                        ]
                    },
                    "items": [
                        {
                            "label": "Accepted type",
                            "runs": [
                                {
                                    "text": "bool",
                                    "code": true
                                }
                            ]
                        },
                        {
                            "label": "Purpose",
                            "runs": [
                                {
                                    "text": "Shows native dividers between rows. Defaults to "
                                },
                                {
                                    "text": "false",
                                    "code": true
                                },
                                {
                                    "text": "."
                                }
                            ]
                        }
                    ]
                },
                {
                    "type": "definition",
                    "term": {
                        "runs": [
                            {
                                "text": "plain",
                                "code": true
                            }
                        ]
                    },
                    "items": [
                        {
                            "label": "Accepted type",
                            "runs": [
                                {
                                    "text": "bool",
                                    "code": true
                                }
                            ]
                        },
                        {
                            "label": "Purpose",
                            "runs": [
                                {
                                    "text": "When sections are present, keeps flat rows with sticky headers instead of grouped inset cards. Defaults to "
                                },
                                {
                                    "text": "false",
                                    "code": true
                                },
                                {
                                    "text": "."
                                }
                            ]
                        }
                    ]
                },
                {
                    "type": "definition",
                    "term": {
                        "runs": [
                            {
                                "text": "shows-indicators",
                                "code": true
                            }
                        ]
                    },
                    "items": [
                        {
                            "label": "Accepted type",
                            "runs": [
                                {
                                    "text": "bool",
                                    "code": true
                                }
                            ]
                        },
                        {
                            "label": "Purpose",
                            "text": "Controls native scroll indicator visibility. Defaults to upstream platform behaviour when omitted."
                        }
                    ]
                },
                {
                    "type": "definition",
                    "term": {
                        "runs": [
                            {
                                "text": "class",
                                "code": true
                            }
                        ]
                    },
                    "items": [
                        {
                            "label": "Accepted type",
                            "runs": [
                                {
                                    "text": "string",
                                    "code": true
                                }
                            ]
                        },
                        {
                            "label": "Purpose",
                            "text": "External EDGE layout utilities."
                        }
                    ]
                }
            ]
        },
        "events": {
            "title": "Events",
            "blocks": [
                {
                    "type": "text",
                    "runs": [
                        {
                            "text": "@refresh",
                            "code": true
                        },
                        {
                            "text": " enables native pull-to-refresh and invokes the named PHP action when the user pulls to refresh."
                        }
                    ]
                },
                {
                    "type": "text",
                    "runs": [
                        {
                            "text": "@endReached",
                            "code": true
                        },
                        {
                            "text": " invokes the named PHP action when the viewport nears the final leaf row. It is intended for pagination rather than precise scroll offsets. See "
                        },
                        {
                            "text": "Paginate lists",
                            "link": 2
                        },
                        {
                            "text": " to bind Laravel paginators to these events. To delete a row through Confirmation Dialog authorization, see "
                        },
                        {
                            "text": "Destroy list items",
                            "link": 3
                        },
                        {
                            "text": "."
                        }
                    ]
                }
            ]
        },
        "composition-rules": {
            "title": "Composition rules",
            "blocks": [
                {
                    "type": "item",
                    "marker": "•",
                    "depth": 0,
                    "runs": [
                        {
                            "text": "Every row is a "
                        },
                        {
                            "text": "firstlight:list-item",
                            "code": true
                        },
                        {
                            "text": " with its own required "
                        },
                        {
                            "text": "@press",
                            "code": true
                        },
                        {
                            "text": " handler."
                        }
                    ]
                },
                {
                    "type": "item",
                    "marker": "•",
                    "depth": 0,
                    "runs": [
                        {
                            "text": "Rows may define "
                        },
                        {
                            "text": "leading and trailing swipe actions",
                            "link": 4
                        },
                        {
                            "text": ", including rows inside sections. Swiping reveals actions; it never deletes a row."
                        }
                    ]
                },
                {
                    "type": "item",
                    "marker": "•",
                    "depth": 0,
                    "runs": [
                        {
                            "text": "Group related rows with "
                        },
                        {
                            "text": "firstlight:list-section",
                            "code": true
                        },
                        {
                            "text": ". Sections require at least one List Item child."
                        }
                    ]
                },
                {
                    "type": "item",
                    "marker": "•",
                    "depth": 0,
                    "text": "Horizontal lists, virtualized windows, selectable collections, and arbitrary child components are outside the Firstlight List contract."
                }
            ]
        },
        "platform-expression": {
            "title": "Platform expression",
            "blocks": [
                {
                    "type": "text",
                    "text": "List delegates scrolling, separators, grouped section chrome, pull-to-refresh, and end-reached detection to the official Mobile UI list renderer on both platforms while retaining Firstlight List Item rows."
                }
            ]
        },
        "adapter-note": {
            "title": "Adapter note",
            "blocks": [
                {
                    "type": "text",
                    "runs": [
                        {
                            "text": "List is an adapter over Mobile UI "
                        },
                        {
                            "text": "list",
                            "code": true
                        },
                        {
                            "text": ". List Section publishes the upstream wire type "
                        },
                        {
                            "text": "list_section",
                            "code": true
                        },
                        {
                            "text": " so the delegated renderer recognizes grouped sections while the public tag remains "
                        },
                        {
                            "text": "<firstlight:list-section>",
                            "code": true
                        },
                        {
                            "text": "."
                        }
                    ]
                }
            ]
        },
