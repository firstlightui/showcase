{
    "id": "components/list",
    "title": "List",
    "description": "Finite vertical collections of List Item rows with optional grouped sections, separators, and refresh or pagination hooks.",
    "group": "Components",
    "anchors": {
        "list": "overview",
        "complete-example": "complete-example",
        "props": "props",
