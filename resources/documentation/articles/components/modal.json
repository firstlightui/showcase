{
    "id": "components/modal",
    "title": "Modal",
    "description": "Full-screen native overlay for authored content with server-controlled visibility and dismissal.",
    "group": "Components",
    "anchors": {
        "modal": "overview",
        "complete-example": "complete-example",
        "props": "props",
        "events": "events",
        "platform-expression": "platform-expression",
        "screenshots": "screenshots"
    },
    "chapters": {
        "overview": {
            "title": "Overview",
            "blocks": [
                {
                    "type": "text",
                    "text": "Modal presents authored content in a full-screen native overlay. PHP owns whether the overlay is requested; each platform owns cover or dialog chrome and motion."
                },
                {
                    "type": "text",
                    "runs": [
                        {
                            "text": "Use "
                        },
                        {
                            "text": "Alert Dialog",
                            "link": 0
                        },
                        {
                            "text": " for a single acknowledgement. Use "
                        },
                        {
                            "text": "Confirmation Dialog",
                            "link": 1
                        },
                        {
                            "text": " for a confirm/cancel decision. Use "
                        },
                        {
                            "text": "Bottom Sheet",
                            "link": 2
                        },
                        {
                            "text": " for a panel that slides up from the bottom."
                        }
                    ]
                }
            ]
        },
        "complete-example": {
            "title": "Complete example",
            "blocks": [
                {
                    "type": "code",
                    "language": "blade",
                    "text": "<firstlight:modal\n    :visible=\"$showingAccount\"\n    a11y-label=\"Account details\"\n    @dismiss=\"closeAccount\"\n>\n    <native:text class=\"text-lg font-semibold text-theme-on-surface\">Account details</native:text>\n</firstlight:modal>"
                },
                {
                    "type": "text",
                    "runs": [
                        {
                            "text": "The dismiss handler should set "
                        },
                        {
                            "text": "$showingAccount",
                            "code": true
                        },
                        {
                            "text": " to "
                        },
                        {
                            "text": "false",
                            "code": true
                        },
                        {
                            "text": "."
                        }
                    ]
                },
                {
                    "type": "text",
                    "runs": [
                        {
                            "text": "The visible title is ordinary text styled as a heading. Mobile UI text has no heading role yet, so screen readers announce the surface by its "
                        },
                        {
                            "text": "a11y-label",
                            "code": true
                        },
                        {
                            "text": "."
                        }
                    ]
                }
            ]
        },
        "props": {
            "title": "Props",
            "blocks": [
                {
                    "type": "definition",
                    "term": {
                        "runs": [
                            {
                                "text": "visible",
                                "code": true
                            }
                        ]
                    },
                    "items": [
                        {
                            "label": "Accepted type",
                            "runs": [
                                {
                                    "text": "bool",
                                    "code": true
                                }
                            ]
                        },
                        {
                            "label": "Purpose",
                            "text": "Server-controlled presentation request. Defaults to closed."
                        }
                    ]
                },
                {
                    "type": "definition",
                    "term": {
                        "runs": [
                            {
                                "text": "dismissible",
                                "code": true
                            }
                        ]
                    },
                    "items": [
                        {
                            "label": "Accepted type",
                            "runs": [
                                {
                                    "text": "bool",
                                    "code": true
                                }
                            ]
                        },
                        {
                            "label": "Purpose",
                            "runs": [
                                {
                                    "text": "When true, native close, back, and outside dismissal are enabled. Defaults to the upstream native default of "
                                },
                                {
                                    "text": "true",
                                    "code": true
                                },
                                {
                                    "text": ". The "
                                },
                                {
                                    "text": "dismissable",
                                    "code": true
                                },
                                {
                                    "text": " alias is accepted."
                                }
                            ]
                        }
                    ]
                },
                {
                    "type": "definition",
                    "term": {
                        "runs": [
                            {
                                "text": "a11y-label",
                                "code": true
                            }
                        ]
                    },
                    "items": [
                        {
                            "label": "Accepted type",
                            "runs": [
                                {
                                    "text": "non-empty "
                                },
                                {
                                    "text": "string",
                                    "code": true
                                }
                            ]
                        },
                        {
                            "label": "Purpose",
                            "text": "Accessible name for the presented surface."
                        }
                    ]
                },
                {
                    "type": "definition",
                    "term": {
                        "runs": [
                            {
                                "text": "a11y-hint",
                                "code": true
                            }
                        ]
                    },
                    "items": [
                        {
                            "label": "Accepted type",
                            "runs": [
                                {
                                    "text": "non-empty "
                                },
                                {
                                    "text": "string",
                                    "code": true
                                }
                            ]
                        },
                        {
                            "label": "Purpose",
                            "text": "Supplementary screen-reader guidance."
                        }
                    ]
                },
                {
                    "type": "definition",
                    "term": {
                        "runs": [
                            {
                                "text": "class",
                                "code": true
                            }
                        ]
                    },
                    "items": [
                        {
                            "label": "Accepted type",
                            "runs": [
                                {
                                    "text": "string",
                                    "code": true
                                }
                            ]
                        },
                        {
                            "label": "Purpose",
                            "text": "External EDGE layout utilities."
                        }
                    ]
                }
            ]
        },
        "events": {
            "title": "Events",
            "blocks": [
                {
                    "type": "text",
                    "runs": [
                        {
                            "text": "@dismiss",
                            "code": true
                        },
                        {
                            "text": " is required. It runs when the user closes the overlay. Set the bound visibility property to "
                        },
                        {
                            "text": "false",
                            "code": true
                        },
                        {
                            "text": " in that handler. Dismiss handlers must be safe to run more than once because the delegated iOS cover can also notify PHP when a programmatic close is published."
                        }
                    ]
                },
                {
                    "type": "text",
                    "runs": [
                        {
                            "text": "There is no overlay "
                        },
                        {
                            "text": "@press",
                            "code": true
                        },
                        {
                            "text": ", "
                        },
                        {
                            "text": "native:model",
                            "code": true
                        },
                        {
                            "text": ", or detent API. Actions belong on child controls."
                        }
                    ]
                }
            ]
        },
        "platform-expression": {
            "title": "Platform expression",
            "blocks": [
                {
                    "type": "text",
                    "runs": [
                        {
                            "text": "Modal is an adapter over Mobile UI "
                        },
                        {
                            "text": "modal",
                            "code": true
                        },
                        {
                            "text": ". iOS uses SwiftUI "
                        },
                        {
                            "text": ".fullScreenCover",
                            "code": true
                        },
                        {
                            "text": "; Android uses a Material full-screen dialog. Theme tokens own surface colour. Close controls, when shown, use the native Close name."
                        }
                    ]
                }
            ]
        },
        "screenshots": {
            "title": "Screenshots",
            "blocks": [
