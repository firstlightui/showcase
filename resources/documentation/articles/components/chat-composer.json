{
    "id": "components/chat-composer",
    "title": "Chat Composer",
    "description": "The message bar for Chat, with a growing text field, photo, camera and file attachments, a removable tray, send, and throttled typing events.",
    "group": "Components",
    "anchors": {
        "chat-composer": "overview",
        "complete-example": "complete-example",
        "props": "props",
        "events": "events",
        "state-timing": "state-timing",
        "accessibility": "accessibility",
        "platform-behaviour": "platform-behaviour",
        "host-application-setup": "host-application-setup",
        "compatibility": "compatibility",
        "screenshots": "screenshots"
    },
    "chapters": {
        "overview": {
            "title": "Overview",
            "blocks": [
                {
                    "type": "text",
                    "runs": [
                        {
                            "text": "Chat Composer is the bar people write messages in: an attach button, a text field that grows with its text, and a send button, with a tray of picked photos and files above. Put it in a "
                        },
                        {
                            "text": "<native:bottom-bar>",
                            "code": true
                        },
                        {
                            "text": " under a "
                        },
                        {
                            "text": "Chat",
                            "link": 0
                        },
                        {
                            "text": ", so it stays above the keyboard."
                        }
                    ]
                }
            ]
        },
        "complete-example": {
            "title": "Complete example",
            "blocks": [
                {
                    "type": "text",
                    "runs": [
                        {
                            "text": "See "
                        },
                        {
                            "text": "Chat",
                            "link": 1
                        },
                        {
                            "text": " for the screen class."
                        }
                    ]
                },
                {
                    "type": "code",
                    "language": "blade",
                    "text": "<native:bottom-bar>\n    <firstlight:chat-composer\n        native:model.debounce.300ms=\"draft\"\n        :attachments=\"$pending\"\n        placeholder=\"Message\"\n        attach=\"photos,camera,files\"\n        @send=\"send\"\n        @attach=\"addAttachment\"\n        @removeAttachment=\"removeAttachment\"\n        @typing=\"whisperTyping\"\n        label=\"Message to Sam\"\n    />\n</native:bottom-bar>"
                }
            ]
        },
        "props": {
            "title": "Props",
