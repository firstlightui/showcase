                                    "text": "string",
                                    "code": true
                                }
                            ]
                        },
                        {
                            "label": "Purpose",
                            "runs": [
                                {
                                    "text": "The draft text. "
                                },
                                {
                                    "text": "native:model",
                                    "code": true
                                },
                                {
                                    "text": " takes "
                                },
                                {
                                    "text": ".live",
                                    "code": true
                                },
                                {
                                    "text": " (default), "
                                },
                                {
                                    "text": ".blur",
                                    "code": true
                                },
                                {
                                    "text": ", "
                                },
                                {
                                    "text": ".lazy",
                                    "code": true
                                },
                                {
                                    "text": " and "
                                },
                                {
                                    "text": ".debounce.Nms",
                                    "code": true
                                },
                                {
                                    "text": "."
                                }
                            ]
                        }
                    ]
                },
                {
                    "type": "definition",
                    "term": {
                        "runs": [
                            {
                                "text": "label",
                                "code": true
                            }
                        ]
                    },
                    "items": [
                        {
                            "label": "Accepted type",
                            "runs": [
                                {
                                    "text": "string",
                                    "code": true
                                }
                            ]
                        },
                        {
                            "label": "Purpose",
                            "text": "Required. Accessible name of the field, such as \"Message to Sam\"."
                        }
                    ]
                },
                {
                    "type": "definition",
                    "term": {
                        "runs": [
                            {
                                "text": "placeholder",
                                "code": true
                            }
                        ]
                    },
                    "items": [
                        {
                            "label": "Accepted type",
                            "runs": [
                                {
                                    "text": "string",
                                    "code": true
                                }
                            ]
                        },
                        {
                            "label": "Purpose",
                            "text": "Hint text in the empty field."
                        }
                    ]
                },
                {
                    "type": "definition",
                    "term": {
                        "runs": [
                            {
                                "text": "attachments",
                                "code": true
                            }
                        ]
                    },
                    "items": [
                        {
                            "label": "Accepted type",
                            "runs": [
                                {
                                    "text": "list of "
                                },
                                {
                                    "text": "MediaValue",
                                    "code": true
                                },
                                {
                                    "text": ", at most 10"
                                }
                            ]
                        },
                        {
                            "label": "Purpose",
                            "text": "Files waiting to be sent, shown as a tray above the field."
                        }
                    ]
                },
                {
                    "type": "definition",
                    "term": {
                        "runs": [
                            {
                                "text": "attach",
                                "code": true
                            }
                        ]
                    },
                    "items": [
                        {
                            "label": "Accepted type",
                            "runs": [
                                {
                                    "text": "any of "
                                },
                                {
                                    "text": "photos",
                                    "code": true
                                },
                                {
                                    "text": ", "
                                },
                                {
                                    "text": "camera",
                                    "code": true
                                },
                                {
                                    "text": ", "
                                },
                                {
                                    "text": "files",
                                    "code": true
                                },
                                {
                                    "text": ", comma-separated or a list"
                                }
                            ]
                        },
                        {
                            "label": "Purpose",
                            "text": "Sources the attach button offers. Absent hides the button. With one source, the button opens it directly."
                        }
                    ]
                },
