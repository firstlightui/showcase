        "events": {
            "title": "Events",
            "blocks": [
                {
                    "type": "definition",
                    "term": {
                        "runs": [
                            {
                                "text": "@send",
                                "code": true
                            }
                        ]
                    },
                    "items": [
                        {
                            "label": "Receives",
                            "text": "nothing"
                        },
                        {
                            "label": "When",
                            "runs": [
                                {
                                    "text": "The person pressed Send. Send is enabled when the draft has non-whitespace text or the tray has an attachment, and not while "
                                },
                                {
                                    "text": "disabled",
                                    "code": true
                                },
                                {
                                    "text": ". The draft is flushed to "
                                },
                                {
                                    "text": "native:model",
                                    "code": true
                                },
                                {
                                    "text": " first, whatever the sync mode, so PHP reads the text being sent. Clear the draft and tray by publishing."
                                }
                            ]
                        }
                    ]
                },
                {
                    "type": "definition",
                    "term": {
                        "runs": [
                            {
                                "text": "@attach",
                                "code": true
                            }
                        ]
                    },
                    "items": [
                        {
                            "label": "Receives",
                            "text": "temporary absolute path"
                        },
                        {
                            "label": "When",
                            "runs": [
                                {
                                    "text": "Once for each picked file, in pick order. Commit it with "
                                },
                                {
                                    "text": "MediaStorage::commit()",
                                    "code": true
                                },
                                {
                                    "text": " and add the "
                                },
                                {
                                    "text": "MediaValue",
                                    "code": true
                                },
                                {
                                    "text": " to "
                                },
                                {
                                    "text": "attachments",
                                    "code": true
                                },
                                {
                                    "text": ". Required when "
                                },
                                {
                                    "text": "attach",
                                    "code": true
                                },
                                {
                                    "text": " is set."
                                }
                            ]
                        }
                    ]
                },
                {
                    "type": "definition",
                    "term": {
                        "runs": [
                            {
                                "text": "@removeAttachment",
                                "code": true
                            }
                        ]
                    },
                    "items": [
                        {
                            "label": "Receives",
                            "text": "tray index"
                        },
                        {
                            "label": "When",
                            "text": "The person removed a tray item. The tile hides until the next publication."
                        }
                    ]
                },
                {
                    "type": "definition",
                    "term": {
                        "runs": [
                            {
                                "text": "@typing",
                                "code": true
                            }
                        ]
                    },
                    "items": [
                        {
                            "label": "Receives",
                            "text": "nothing"
                        },
                        {
                            "label": "When",
                            "text": "At most once every 3 seconds while the person edits a non-empty draft. Use it to tell others someone is typing without sending every keystroke."
                        }
                    ]
                },
                {
                    "type": "definition",
                    "term": {
                        "runs": [
                            {
                                "text": "@change",
                                "code": true
                            }
                        ]
                    },
                    "items": [
                        {
                            "label": "Receives",
                            "text": "the draft text"
                        },
                        {
                            "label": "When",
                            "runs": [
                                {
                                    "text": "As "
                                },
                                {
                                    "text": "native:model",
                                    "code": true
                                },
                                {
                                    "text": " syncs it."
                                }
                            ]
                        }
                    ]
                },
                {
                    "type": "text",
                    "runs": [
                        {
                            "text": "Photos are stored as JPEG. Picked files are copied to the app's temporary directory before "
                        },
                        {
                            "text": "@attach",
                            "code": true
                        },
                        {
                            "text": " receives the path."
                        }
                    ]
                }
            ]
        },
        "state-timing": {
            "title": "State timing",
            "blocks": [
                {
                    "type": "text",
                    "runs": [
                        {
                            "text": "The draft is native focused text, as on "
                        },
                        {
                            "text": "Text Area",
                            "link": 2
                        },
                        {
                            "text": ": typing, selection and composition stay native while the field is focused, and a publication doesn't replace text the person typed after the last sync. A publication that clears the sent draft clears the field, even while it keeps focus. The tray is PHP's: removals hide a tile only until PHP publishes the tray again."
                        }
                    ]
                },
                {
                    "type": "text",
                    "runs": [
                        {
                            "text": "A screen using "
                        },
                        {
                            "text": "KeepsDrafts",
                            "code": true
                        },
                        {
                            "text": " keeps the draft text, but not the tray."
                        }
                    ]
                }
            ]
        },
        "accessibility": {
            "title": "Accessibility",
            "blocks": [
                {
                    "type": "text",
                    "runs": [
                        {
                            "text": "The field uses "
                        },
                        {
                            "text": "label",
                            "code": true
                        },
                        {
                            "text": " as its accessible name. Attach, Send and Remove for each tray item are labelled buttons with 44-point (iOS) and 48-dp (Android) touch targets. Send, Attach, Remove, Photo Library, Camera and Browse Files are package chrome; see "
                        },
                        {
                            "text": "Localize chrome",
                            "link": 3
                        },
                        {
                            "text": "."
                        }
                    ]
                }
            ]
        },
        "platform-behaviour": {
            "title": "Platform behaviour",
            "blocks": [
                {
                    "type": "text",
                    "runs": [
                        {
                            "text": "iOS uses a vertical SwiftUI "
                        },
                        {
                            "text": "TextField",
                            "code": true
                        },
                        {
                            "text": ", a menu of sources, PhotosPicker for up to 10 photos, the system camera and "
                        },
                        {
                            "text": "fileImporter",
                            "code": true
                        },
                        {
                            "text": " for several files. Android uses a Material 3 "
                        },
                        {
                            "text": "OutlinedTextField",
                            "code": true
                        },
                        {
                            "text": ", a bottom sheet of sources, the system photo picker for up to 10 photos, the system camera app and the system document picker for several files."
                        }
                    ]
                }
            ]
        },
        "host-application-setup": {
            "title": "Host application setup",
            "blocks": [
                {
                    "type": "text",
                    "runs": [
                        {
                            "text": "The Camera source needs the same camera usage description as "
                        },
                        {
                            "text": "Media",
                            "link": 4
                        },
                        {
                            "text": "; Firstlight's manifest supplies a generic one."
                        }
                    ]
                }
            ]
        },
        "compatibility": {
            "title": "Compatibility",
            "blocks": [
                {
                    "type": "text",
                    "runs": [
