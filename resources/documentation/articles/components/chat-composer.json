                            "runs": [
                                {
                                    "text": "string",
                                    "code": true
                                }
                            ]
                        },
                        {
                            "label": "Purpose",
                            "text": "Additional VoiceOver and TalkBack guidance."
                        }
                    ]
                },
                {
                    "type": "definition",
                    "term": {
                        "runs": [
                            {
                                "text": "class",
                                "code": true
                            }
                        ]
                    },
                    "items": [
                        {
                            "label": "Accepted type",
                            "runs": [
                                {
                                    "text": "string",
                                    "code": true
                                }
                            ]
                        },
                        {
                            "label": "Purpose",
                            "text": "External EDGE layout."
                        }
                    ]
                },
                {
                    "type": "text",
                    "runs": [
                        {
                            "text": "disk",
                            "code": true
                        },
                        {
                            "text": ", "
                        },
                        {
                            "text": "directory",
                            "code": true
                        },
                        {
                            "text": ", "
                        },
                        {
                            "text": "@submit",
                            "code": true
                        },
                        {
                            "text": " and "
                        },
                        {
                            "text": "@press",
                            "code": true
                        },
                        {
                            "text": " are rejected: "
                        },
                        {
                            "text": "@attach",
                            "code": true
                        },
                        {
                            "text": " receives the picked file's temporary path, and the screen decides where to store it."
                        }
                    ]
