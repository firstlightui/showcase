        "sizes": {
            "title": "Sizes",
            "blocks": [
                {
                    "type": "text",
                    "runs": [
                        {
                            "text": "md",
                            "code": true
                        },
                        {
                            "text": " is the default. Use "
                        },
                        {
                            "text": "lg",
                            "code": true
                        },
                        {
                            "text": " when the control sits with "
                        },
                        {
                            "text": "size=\"lg\"",
                            "code": true
                        },
                        {
                            "text": " Buttons, so the row of controls shares one height:"
                        }
                    ]
                },
                {
                    "type": "code",
                    "language": "blade",
                    "text": "<firstlight:segmented :options=\"$viewOptions\" native:model=\"view\" a11y-label=\"View\" size=\"lg\" />\n<firstlight:button label=\"Admit patient\" icon=\"add\" size=\"lg\" />"
                },
                {
                    "type": "definition",
                    "term": {
                        "runs": [
                            {
                                "text": "md",
                                "code": true
                            }
                        ]
                    },
                    "items": [
                        {
                            "label": "iOS",
                            "text": "At least 44 pt, footnote-sized titles."
                        },
                        {
                            "label": "Android",
                            "text": "At least 48 dp, Material label titles."
                        }
                    ]
                },
                {
                    "type": "definition",
                    "term": {
                        "runs": [
                            {
                                "text": "lg",
                                "code": true
                            }
                        ]
                    },
                    "items": [
                        {
                            "label": "iOS",
                            "text": "Button lg's height: 54 pt at the default text size, subheadline-sized titles."
                        },
                        {
                            "label": "Android",
                            "text": "Button lg's height: 48 dp at the default text size, Material title-sized labels."
                        }
                    ]
                },
                {
                    "type": "text",
                    "runs": [
                        {
                            "text": "Both sizes grow with Dynamic Type and Android font scaling; "
                        },
                        {
                            "text": "lg",
                            "code": true
                        },
                        {
                            "text": " grows with the text the same way a "
                        },
                        {
                            "text": "size=\"lg\"",
                            "code": true
                        },
                        {
                            "text": " Button does. "
                        },
                        {
                            "text": "size",
                            "code": true
                        },
                        {
                            "text": " changes only height and type size, not selection, state, or accessibility behaviour. Other values, including "
                        },
                        {
                            "text": "sm",
                            "code": true
                        },
                        {
                            "text": ", are rejected because they would fall below the platform interaction target."
                        }
                    ]
                }
            ]
        },
        "events": {
            "title": "Events",
            "blocks": [
                {
                    "type": "text",
                    "runs": [
                        {
                            "text": "@change",
                            "code": true
                        },
                        {
                            "text": " receives the selected stable value. "
                        },
                        {
                            "text": "native:model",
                            "code": true
                        },
                        {
                            "text": " normally generates this callback for property synchronisation. A user selection emits immediately; server reconciliation and programmatic updates do not emit."
                        }
                    ]
                }
            ]
        },
        "options-and-accepted-values": {
            "title": "Options and accepted values",
            "blocks": [
                {
                    "type": "text",
                    "text": "Simple string options use the same value and label:"
                },
                {
                    "type": "code",
                    "language": "php",
                    "text": "['Mine', 'All']"
                },
                {
                    "type": "text",
                    "text": "A map separates stable values from labels and may use all-string or all-integer keys:"
                },
                {
                    "type": "code",
                    "language": "php",
                    "text": "['mine' => 'Mine', 'all' => 'All']"
                },
                {
                    "type": "text",
                    "runs": [
                        {
                            "text": "Rich options accept only "
                        },
                        {
                            "text": "value",
                            "code": true
                        },
                        {
                            "text": ", "
                        },
                        {
                            "text": "label",
                            "code": true
                        },
                        {
                            "text": ", and optional "
                        },
                        {
                            "text": "disabled",
                            "code": true
                        },
                        {
                            "text": " fields:"
                        }
                    ]
                },
                {
                    "type": "code",
                    "language": "php",
                    "text": "[\n    ['value' => 'mine', 'label' => 'Mine'],\n    ['value' => 'all', 'label' => 'All', 'disabled' => true],\n]"
                },
                {
                    "type": "text",
                    "runs": [
                        {
                            "text": "All values in one control must be uniquely typed strings or uniquely typed integers. "
                        },
                        {
                            "text": "null",
                            "code": true
                        },
                        {
                            "text": " represents no selection; an empty string remains a distinct string value."
                        }
                    ]
                }
            ]
        },
        "state-timing": {
            "title": "State timing",
            "blocks": [
                {
                    "type": "text",
                    "runs": [
                        {
                            "text": "Segmented is "
                        },
                        {
                            "text": "server-authoritative",
                            "link": 1
                        },
                        {
                            "text": ". A tap emits immediately, while PHP's next published value determines the visible selection. Use plain "
                        },
                        {
                            "text": "native:model",
                            "code": true
                        },
                        {
                            "text": " or "
                        },
                        {
                            "text": "native:model.live",
                            "code": true
                        },
                        {
                            "text": "; deferred "
                        },
                        {
                            "text": "blur",
                            "code": true
                        },
                        {
                            "text": " and "
                        },
                        {
                            "text": "debounce",
                            "code": true
                        },
                        {
                            "text": " modes are rejected."
                        }
                    ]
                }
            ]
        },
        "disabled-behaviour": {
            "title": "Disabled behaviour",
            "blocks": [
                {
                    "type": "text",
                    "runs": [
                        {
                            "text": "disabled",
                            "code": true
                        },
                        {
                            "text": " prevents every choice from emitting. A rich option's "
                        },
                        {
                            "text": "disabled: true",
                            "code": true
                        },
                        {
                            "text": " prevents only that option from emitting. An empty option set becomes an inert disabled control. A disabled or already-selected choice does not emit a new change."
                        }
                    ]
                }
            ]
        },
        "accessibility": {
            "title": "Accessibility",
            "blocks": [
                {
                    "type": "text",
                    "runs": [
                        {
                            "text": "Provide either a visible "
                        },
                        {
                            "text": "label",
                            "code": true
                        },
                        {
                            "text": " or an explicit "
                        },
                        {
                            "text": "a11y-label",
                            "code": true
                        },
                        {
                            "text": ". Firstlight warns during development when both are blank. The renderers expose the label or explicit accessibility label, optional hint, selected state, disabled state, required indication, helper text, and error text through native platform semantics."
                        }
                    ]
                }
            ]
        },
        "validation-and-failure-behaviour": {
            "title": "Validation and failure behaviour",
            "blocks": [
                {
                    "type": "text",
                    "runs": [
                        {
                            "text": "Contract exceptions still reject mixed or duplicate option values, unsupported types, and sizes other than "
                        },
                        {
                            "text": "md",
                            "code": true
                        },
                        {
                            "text": " and "
                        },
                        {
                            "text": "lg",
                            "code": true
                        },
                        {
                            "text": " before publication. User validation is separate: screens that "
                        },
                        {
                            "text": "use ValidatesFields",
                            "code": true
                        },
                        {
                            "text": " auto-bind the first MessageBag message for the field's "
                        },
                        {
                            "text": "native:model",
                            "code": true
                        },
                        {
                            "text": " or "
                        },
                        {
                            "text": "error-for",
                            "code": true
                        },
                        {
                            "text": " name. An authored "
                        },
                        {
                            "text": "error",
                            "code": true
                        },
                        {
                            "text": " wins. "
                        },
                        {
                            "text": "required",
                            "code": true
                        },
                        {
                            "text": " is display metadata and does not run Laravel rules. See "
                        },
                        {
                            "text": "Validate fields",
                            "link": 2
                        },
                        {
                            "text": ". A same-typed value absent from "
                        },
                        {
                            "text": "options",
                            "code": true
                        },
                        {
                            "text": " remains visibly unselected rather than selecting the first option."
                        }
                    ]
                }
            ]
        },
        "platform-behaviour": {
            "title": "Platform behaviour",
            "blocks": [
                {
                    "type": "text",
                    "runs": [
                        {
                            "text": "iOS uses a native SwiftUI field backed by "
                        },
                        {
                            "text": "UISegmentedControl",
                            "code": true
                        },
                        {
                            "text": ". Android uses Material 3 "
                        },
                        {
                            "text": "SingleChoiceSegmentedButtonRow",
                            "code": true
                        },
                        {
                            "text": " and "
                        },
                        {
                            "text": "SegmentedButton",
                            "code": true
                        },
                        {
                            "text": ". The controls share behaviour and authored API while retaining platform-native styling, layout, and interaction."
                        }
                    ]
                },
                {
                    "type": "text",
                    "runs": [
                        {
                            "text": "On iOS 26 and later the selected segment is the system's Liquid Glass thumb, which turns into a glass lens while it is dragged. Before iOS 26 it is filled with the theme's primary colour, with "
                        },
                        {
                            "text": "on-primary",
                            "code": true
                        },
                        {
                            "text": " text or black or white when that contrast is too low."
                        }
                    ]
                },
                {
                    "type": "text",
                    "runs": [
                        {
                            "text": "On iOS, "
                        },
                        {
                            "text": "UISegmentedControl",
                            "code": true
                        },
                        {
                            "text": " plays its own selection haptic. On Android, Segmented plays "
                        },
                        {
                            "text": "selection",
                            "code": true
                        },
                        {
                            "text": " when the user picks another segment. "
                        },
                        {
                            "text": "haptic=\"none\"",
                            "code": true
                        },
                        {
                            "text": " silences the Android haptic. See "
                        },
                        {
                            "text": "Play haptics",
                            "link": 0
                        },
                        {
                            "text": "."
                        }
                    ]
                }
            ]
        },
        "compatibility": {
            "title": "Compatibility",
            "blocks": [
                {
                    "type": "text",
                    "runs": [
                        {
                            "text": "Segmented supports the versions listed in the current "
                        },
                        {
                            "text": "compatibility reference",
                            "link": 3
                        },
                        {
                            "text": " and requires both native renderers to be compiled into the host application."
                        }
                    ]
                }
            ]
        },
