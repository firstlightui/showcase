    "chapters": {
        "overview": {
            "title": "Overview",
            "blocks": [
                {
                    "type": "text",
                    "text": "Segmented presents a small set of mutually exclusive choices as a native segmented control."
                }
            ]
        },
        "complete-example": {
            "title": "Complete example",
            "blocks": [
                {
                    "type": "code",
                    "language": "php",
                    "text": "public int $priority = 10;\n\npublic array $priorityOptions = [\n    ['value' => 10, 'label' => 'Routine'],\n    ['value' => 20, 'label' => 'Urgent', 'disabled' => true],\n];"
                },
                {
                    "type": "code",
                    "language": "blade",
                    "text": "<firstlight:segmented\n    :options=\"$priorityOptions\"\n    native:model=\"priority\"\n    label=\"Priority\"\n    helper=\"Choose a response priority.\"\n    a11y-hint=\"Urgent may be unavailable.\"\n/>"
                }
            ]
        },
