        "accessibility": {
            "title": "Accessibility",
            "blocks": [
                {
                    "type": "text",
                    "text": "The field exposes a labelled control with helper or error text. Crop sheets include Confirm, Cancel, optional Skip, and explicit zoom in/out controls meeting 44-point (iOS) and 48-dp (Android) minima. Zoom is not pinch-only, and moving the region is not drag-only: the crop region is one labelled element with Move crop left, right, up, and down actions (VoiceOver actions rotor, TalkBack actions menu). Each action moves a tenth of the region."
                }
            ]
        },
        "platform-behaviour": {
            "title": "Platform behaviour",
            "blocks": [
                {
                    "type": "text",
                    "runs": [
                        {
                            "text": "iOS offers Photo Library (PhotosPicker) and Camera in a confirmation dialog, uses "
                        },
                        {
                            "text": "fileImporter",
                            "code": true
                        },
                        {
                            "text": " for documents, and shows a Firstlight SwiftUI crop sheet. Android offers Photo Library (the system photo picker) and Camera (the system camera app) in a Material bottom sheet, uses the system document picker, and shows a Firstlight Compose crop dialog. Picked files are copied to the app's temporary directory before "
                        },
                        {
                            "text": "@change",
                            "code": true
                        },
                        {
                            "text": " receives the path. Geometry and system pickers stay platform-native; crop semantics stay shared."
                        }
                    ]
                }
            ]
        },
        "host-application-setup": {
            "title": "Host application setup",
            "blocks": [
                {
                    "type": "text",
                    "runs": [
                        {
                            "text": "On iOS, image mode's Camera option requires a camera usage description, or iOS terminates the app when the camera opens. Firstlight's plugin manifest supplies a generic one (\"Used to take a photo for a form field.\"). Override it in "
                        },
                        {
                            "text": "config/nativephp.php",
                            "code": true
                        },
                        {
                            "text": " with wording specific to your app for App Store review; app entries win over plugin entries:"
                        }
                    ]
                },
                {
                    "type": "code",
                    "language": "php",
                    "text": "'permissions' => [\n    'NSCameraUsageDescription' => 'Used to take a photo for your profile.',\n],"
                },
                {
                    "type": "text",
                    "runs": [
                        {
                            "text": "The photo picker and document picker need no permission on either platform. Android needs no manifest change: the system camera app writes through the FileProvider that NativePHP's Android host already declares. If your app adds the "
                        },
                        {
                            "text": "CAMERA",
                            "code": true
                        },
                        {
                            "text": " permission for another feature, grant it before offering Camera."
                        }
                    ]
                }
            ]
        },
        "compatibility": {
            "title": "Compatibility",
            "blocks": [
