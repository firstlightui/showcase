    "chapters": {
        "overview": {
            "title": "Overview",
            "blocks": [
                {
                    "type": "text",
                    "runs": [
                        {
                            "text": "Media captures exactly one image or one document into Laravel Storage and binds a "
                        },
                        {
                            "text": "MediaValue",
                            "code": true
                        },
                        {
                            "text": " on your native component. Use it when you need a form field with preview, clear, optional crop, and the same "
                        },
                        {
                            "text": "error",
                            "code": true
                        },
                        {
                            "text": " slot as other Firstlight fields."
                        }
                    ]
                }
            ]
        },
        "complete-example": {
            "title": "Complete example",
            "blocks": [
                {
                    "type": "text",
                    "runs": [
                        {
                            "text": "Use "
                        },
                        {
                            "text": "FirstlightUI\\NativeComponent",
                            "code": true
                        },
                        {
                            "text": " for the full nonstreaming "
                        },
                        {
                            "text": "response-revision contract",
                            "link": 0
                        },
                        {
                            "text": "."
                        }
                    ]
                },
                {
                    "type": "code",
                    "language": "php",
                    "text": "<?php\n\nnamespace App\\NativeComponents;\n\nuse FirstlightUI\\Media\\MediaStorage;\nuse FirstlightUI\\Media\\MediaValue;\nuse Illuminate\\View\\View;\nuse FirstlightUI\\NativeComponent;\n\nclass Profile extends NativeComponent\n{\n    public ?MediaValue $avatar = null;\n\n    /** @var array<string, string> */\n    protected array $rules = [\n        'avatar' => 'required|image|max:2048',\n    ];\n\n    public function avatarChosen(string $tempPath): void\n    {\n        $previous = $this->avatar;\n        $this->avatar = MediaStorage::commit(\n            $tempPath,\n            'mobile_public',\n            'avatars',\n        );\n        MediaStorage::delete($previous);\n    }\n\n    public function avatarCleared(): void\n    {\n        MediaStorage::delete($this->avatar);\n        $this->avatar = null;\n    }\n\n    public function render(): View\n    {\n        return view('native.profile');\n    }\n}"
                },
                {
                    "type": "code",
                    "language": "blade",
                    "text": "<firstlight:media\n    mode=\"image\"\n    label=\"Profile photo\"\n    helper=\"Square crop required\"\n    aspect=\"1:1\"\n    disk=\"mobile_public\"\n    directory=\"avatars\"\n    native:model=\"avatar\"\n    @change=\"avatarChosen\"\n    @clear=\"avatarCleared\"\n/>"
                }
            ]
        },
