        "events": {
            "title": "Events",
            "blocks": [
                {
                    "type": "text",
                    "runs": [
                        {
                            "text": "@change",
                            "code": true
                        },
                        {
                            "text": " receives the temporary absolute file path after the user confirms a pick (and crop when required). Commit with "
                        },
                        {
                            "text": "MediaStorage::commit",
                            "code": true
                        },
                        {
                            "text": " before assigning "
                        },
                        {
                            "text": "MediaValue",
                            "code": true
                        },
                        {
                            "text": "."
                        }
                    ]
                },
                {
                    "type": "text",
                    "runs": [
                        {
                            "text": "@clear",
                            "code": true
                        },
                        {
                            "text": " fires when the user clears a present value. Delete the previous object with "
                        },
                        {
                            "text": "MediaStorage::delete",
                            "code": true
                        },
                        {
                            "text": " and set the model to "
                        },
                        {
                            "text": "null",
                            "code": true
                        },
                        {
                            "text": "."
                        }
                    ]
                }
            ]
        },
        "mediavalue": {
            "title": "MediaValue",
            "blocks": [
                {
                    "type": "code",
                    "language": "php",
                    "text": "new MediaValue(\n    disk: 'mobile_public',\n    path: 'avatars/a.jpg',\n    mime: 'image/jpeg',\n    size: 1200,\n    width: 100,\n    height: 100,\n);"
                },
                {
                    "type": "text",
                    "runs": [
                        {
                            "text": "In image mode the field shows a thumbnail of the stored file. It is decoded from the file's local path, so it appears only for disks with a local driver, such as the default "
                        },
                        {
                            "text": "mobile_public",
                            "code": true
                        },
                        {
                            "text": "; other disks show a photo icon. Document mode always shows a document icon and the file name."
                        }
                    ]
                },
                {
                    "type": "text",
                    "runs": [
                        {
                            "text": "To show the image elsewhere in a native view, use the file's local path, "
                        },
                        {
                            "text": "Storage::disk($value->disk)->path($value->path)",
                            "code": true
                        },
                        {
                            "text": ". The disk's "
                        },
                        {
                            "text": "url()",
                            "code": true
                        },
                        {
                            "text": " is served only to WebViews."
                        }
                    ]
                }
            ]
        },
