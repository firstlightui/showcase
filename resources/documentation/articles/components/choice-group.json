        "options-and-values": {
            "title": "Options and values",
            "blocks": [
                {
                    "type": "text",
                    "text": "Simple strings use the same value and label:"
                },
                {
                    "type": "code",
                    "language": "php",
                    "text": "['Routine', 'Urgent']"
                },
                {
                    "type": "text",
                    "text": "A map separates stable values from labels and may use all-string or all-integer keys:"
                },
                {
                    "type": "code",
                    "language": "php",
                    "text": "['routine' => 'Routine', 'urgent' => 'Urgent']"
                },
                {
                    "type": "text",
                    "runs": [
                        {
                            "text": "Rich options accept only "
                        },
                        {
                            "text": "value",
                            "code": true
                        },
                        {
                            "text": ", "
                        },
                        {
                            "text": "label",
                            "code": true
                        },
                        {
                            "text": ", and optional "
                        },
                        {
                            "text": "disabled",
                            "code": true
                        },
                        {
                            "text": " fields:"
                        }
                    ]
                },
                {
                    "type": "code",
                    "language": "php",
                    "text": "[\n    ['value' => 'routine', 'label' => 'Routine'],\n    ['value' => 'urgent', 'label' => 'Urgent', 'disabled' => true],\n]"
                },
                {
                    "type": "text",
                    "text": "All option labels must contain visible text. Values in one group must be unique and must all be strings or all be integers."
                },
                {
                    "type": "text",
                    "runs": [
                        {
                            "text": "In single mode, tapping an unselected row proposes its value. Tapping the selected row does nothing, matching radio-choice semantics. PHP can publish "
                        },
                        {
                            "text": "null",
                            "code": true
                        },
                        {
                            "text": " to clear the field programmatically."
                        }
                    ]
                },
                {
                    "type": "text",
                    "runs": [
                        {
                            "text": "In multiple mode, tapping toggles that stable value while preserving the order of the other values. "
                        },
                        {
                            "text": "null",
                            "code": true
                        },
                        {
                            "text": " and "
                        },
                        {
                            "text": "[]",
                            "code": true
                        },
                        {
                            "text": " both mean no selection."
                        }
                    ]
                }
            ]
        },
        "events-and-state-timing": {
            "title": "Events and state timing",
            "blocks": [
                {
                    "type": "text",
                    "runs": [
                        {
                            "text": "@change",
                            "code": true
                        },
                        {
                            "text": " receives the complete proposed selection: a scalar in single mode and a list in multiple mode. "
                        },
                        {
                            "text": "native:model",
                            "code": true
                        },
                        {
                            "text": " normally generates this callback for property synchronisation."
                        }
                    ]
                },
                {
                    "type": "text",
                    "runs": [
                        {
                            "text": "Choice Group is "
                        },
                        {
                            "text": "server-authoritative",
                            "link": 0
                        },
                        {
                            "text": ". A tap emits immediately, but selected visuals wait for PHP's next publication. Further taps are ignored while that proposal is in flight so a second proposal cannot be calculated from stale state. Rejected and programmatic publications do not emit."
                        }
                    ]
                },
                {
                    "type": "text",
                    "runs": [
                        {
                            "text": "An unchanged PHP response must also release the pending-interaction guard. Host the control in "
                        },
                        {
                            "text": "FirstlightUI\\NativeComponent",
                            "code": true
                        },
                        {
                            "text": " for the "
                        },
                        {
                            "text": "nonstreaming response-revision contract",
                            "link": 1
                        },
                        {
                            "text": ". Revisions are not per-event acknowledgements and do not prevent coalescing or serialize simultaneous proposals."
                        }
                    ]
                },
                {
                    "type": "text",
                    "runs": [
                        {
                            "text": "Use plain "
                        },
                        {
                            "text": "native:model",
                            "code": true
                        },
                        {
                            "text": " or "
                        },
                        {
                            "text": "native:model.live",
                            "code": true
                        },
                        {
                            "text": "; deferred "
                        },
                        {
                            "text": "blur",
                            "code": true
                        },
                        {
                            "text": " and "
                        },
                        {
                            "text": "debounce",
                            "code": true
                        },
                        {
                            "text": " modes are rejected."
                        }
                    ]
                }
            ]
        },
        "disabled-and-required-behaviour": {
            "title": "Disabled and required behaviour",
            "blocks": [
                {
                    "type": "text",
                    "runs": [
                        {
                            "text": "disabled",
                            "code": true
                        },
                        {
                            "text": " prevents every row from emitting. A rich option's "
                        },
                        {
                            "text": "disabled: true",
                            "code": true
                        },
                        {
                            "text": " affects only that row. An empty option set becomes an inert disabled group."
                        }
                    ]
                },
                {
                    "type": "text",
                    "runs": [
                        {
                            "text": "required",
                            "code": true
                        },
                        {
                            "text": " is metadata rather than client-side enforcement. Validate the value in PHP and publish "
                        },
                        {
                            "text": "error",
                            "code": true
                        },
                        {
                            "text": " when needed. Error text replaces helper text on both platforms."
                        }
                    ]
                }
            ]
        },
        "accessibility": {
            "title": "Accessibility",
            "blocks": [
                {
                    "type": "text",
                    "runs": [
                        {
                            "text": "Provide either a visible "
                        },
                        {
                            "text": "label",
                            "code": true
                        },
                        {
                            "text": " or an explicit "
                        },
                        {
                            "text": "a11y-label",
                            "code": true
                        },
                        {
                            "text": ". Firstlight warns during development when both are blank. Each complete row is one accessibility target with its label, selected or checked state, and disabled state. Selection is also shown with a native indicator, so it does not depend on colour alone. Rows support wrapping labels and retain at least a 44-point iOS or 48-dp Android interaction target."
                        }
                    ]
                }
            ]
        },
        "validation-and-failure-behaviour": {
            "title": "Validation and failure behaviour",
            "blocks": [
                {
                    "type": "text",
                    "runs": [
                        {
                            "text": "Contract exceptions still reject malformed options, mixed selections, and unsupported presentation props before publication. User validation is separate: screens that "
                        },
                        {
                            "text": "use ValidatesFields",
                            "code": true
                        },
                        {
                            "text": " auto-bind the first MessageBag message for the field's "
                        },
                        {
                            "text": "native:model",
                            "code": true
                        },
                        {
                            "text": " or "
                        },
                        {
                            "text": "error-for",
                            "code": true
                        },
                        {
                            "text": " name. An authored "
                        },
                        {
                            "text": "error",
                            "code": true
                        },
                        {
                            "text": " wins. "
                        },
                        {
                            "text": "required",
                            "code": true
                        },
                        {
                            "text": " is display metadata and does not run Laravel rules. See "
                        },
                        {
                            "text": "Validate fields",
                            "link": 2
                        },
                        {
                            "text": ". A same-typed selected value absent from "
                        },
                        {
                            "text": "options",
                            "code": true
                        },
                        {
                            "text": " remains unselected rather than choosing a fallback."
                        }
                    ]
                }
            ]
        },
        "platform-behaviour": {
            "title": "Platform behaviour",
            "blocks": [
                {
                    "type": "text",
                    "text": "iOS uses native SwiftUI option rows with trailing checkmarks. Android renders one Material 3 radio-row set for single choice and one homogeneous checkbox-row set for multiple choice. Both inherit NativePHP semantic theme tokens and preserve native focus, selection, disabled, and accessibility behaviour without exposing platform-widget props."
                }
            ]
        },
        "compatibility": {
            "title": "Compatibility",
            "blocks": [
                {
                    "type": "text",
                    "runs": [
                        {
                            "text": "Choice Group supports the versions listed in the current "
                        },
                        {
                            "text": "compatibility reference",
                            "link": 3
                        },
                        {
                            "text": " and requires both native renderers in the host application plus Firstlight's screen response contract above. It does not require an unreleased runtime fix."
                        }
                    ]
                }
            ]
        },
