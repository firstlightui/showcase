    "chapters": {
        "overview": {
            "title": "Overview",
            "blocks": [
                {
                    "type": "text",
                    "text": "Choice Group presents a visible list of labelled options for selecting zero or one value, or zero or more values."
                }
            ]
        },
        "complete-examples": {
            "title": "Complete examples",
            "blocks": [
                {
                    "type": "text",
                    "text": "Single choice is the default:"
                },
                {
                    "type": "code",
                    "language": "php",
                    "text": "public ?string $priority = 'routine';\n\npublic array $priorityOptions = [\n    ['value' => 'routine', 'label' => 'Routine'],\n    ['value' => 'urgent', 'label' => 'Urgent'],\n    ['value' => 'critical', 'label' => 'Critical', 'disabled' => true],\n];"
                },
                {
                    "type": "code",
                    "language": "blade",
                    "text": "<firstlight:choice-group\n    :options=\"$priorityOptions\"\n    native:model=\"priority\"\n    label=\"Priority\"\n    helper=\"Choose one priority.\"\n/>"
                },
                {
                    "type": "text",
                    "runs": [
                        {
                            "text": "Use "
                        },
                        {
                            "text": "multiple",
                            "code": true
                        },
                        {
                            "text": " with a list-valued property:"
                        }
                    ]
                },
                {
                    "type": "code",
                    "language": "php",
                    "text": "public array $notifications = ['email'];"
                },
                {
                    "type": "code",
                    "language": "blade",
                    "text": "<firstlight:choice-group\n    :options=\"['email' => 'Email', 'sms' => 'SMS', 'push' => 'Push notification']\"\n    native:model=\"notifications\"\n    label=\"Notifications\"\n    helper=\"Choose any that apply.\"\n    multiple\n/>"
                }
            ]
        },
