        "events-and-state-timing": {
            "title": "Events and state timing",
            "blocks": [
                {
                    "type": "text",
                    "runs": [
                        {
                            "text": "@press",
                            "code": true
                        },
                        {
                            "text": " is the one optional standard action event. It must be paired with "
                        },
                        {
                            "text": "action-label",
                            "code": true
                        },
                        {
                            "text": " and fires once for each completed native button activation."
                        }
                    ]
                },
                {
                    "type": "text",
                    "text": "Callout has no value or model. PHP controls whether it is present and may publish new message, tone, action, or accessibility metadata. Native reconciliation updates the existing stable node without emitting an event."
                }
            ]
        },
        "persistence-and-dismissal": {
            "title": "Persistence and dismissal",
            "blocks": [
                {
                    "type": "text",
                    "runs": [
                        {
                            "text": "Callout remains in its authored position until the next Element Tree omits it. It has no timeout, close button, swipe gesture, "
                        },
                        {
                            "text": "dismissible",
                            "code": true
                        },
                        {
                            "text": " prop, or dismissal event. Use Transient Feedback for brief queued outcomes, Alert Dialog when the user must acknowledge one message, and Confirmation Dialog when work must pause for a confirm/cancel decision."
                        }
                    ]
                }
            ]
        },
        "disabled-loading-and-error-behaviour": {
            "title": "Disabled, loading, and error behaviour",
            "blocks": [
                {
                    "type": "text",
                    "runs": [
                        {
                            "text": "Disabled and loading states do not apply. Render or omit the action according to application state, and publish the semantic tone that describes the message. Although "
                        },
                        {
                            "text": "danger",
                            "code": true
                        },
                        {
                            "text": " can communicate an error outcome, Callout is not a field-validation control and does not accept "
                        },
                        {
                            "text": "error",
                            "code": true
                        },
                        {
                            "text": ", "
                        },
                        {
                            "text": "helper",
                            "code": true
                        },
                        {
                            "text": ", or "
                        },
                        {
                            "text": "required",
                            "code": true
                        },
                        {
                            "text": "."
                        }
                    ]
                },
                {
                    "type": "text",
                    "text": "For form-level validation messages, bind the screen's error bag instead of a static message:"
                },
                {
                    "type": "code",
                    "language": "blade",
                    "text": "<firstlight:callout error-for=\"form\" />\n<firstlight:callout error-summary />"
                },
                {
                    "type": "text",
                    "runs": [
                        {
                            "text": "A bound Callout defaults to "
                        },
                        {
                            "text": "danger",
                            "code": true
                        },
                        {
                            "text": ", rejects "
                        },
                        {
                            "text": "message",
                            "code": true
                        },
                        {
                            "text": ", and renders nothing while its key (or, for a summary, the whole bag) has no message. See "
                        },
                        {
                            "text": "Validate fields",
                            "link": 0
                        },
                        {
                            "text": "."
                        }
                    ]
                }
            ]
        },
        "accessibility": {
            "title": "Accessibility",
            "blocks": [
                {
                    "type": "text",
                    "runs": [
                        {
                            "text": "Tone is conveyed by a distinct native symbol and by the generated accessible name, such as "
                        },
                        {
                            "text": "Warning: Your changes have not been submitted.",
                            "code": true
                        },
                        {
                            "text": " The icon is decorative to VoiceOver and TalkBack. "
                        },
                        {
                            "text": "a11y-label",
                            "code": true
                        },
                        {
                            "text": " replaces the generated name, while "
                        },
                        {
                            "text": "a11y-hint",
                            "code": true
                        },
                        {
                            "text": " adds context."
                        }
                    ]
                },
                {
                    "type": "text",
                    "runs": [
                        {
                            "text": "The optional action is a separate native button whose visible text is its accessible name. Its target is at least 44 points on iOS and 48 dp on Android. Message text wraps and surfaces grow for Dynamic Type, Android font scaling, and long localisation. Callout is not a live region; persistent content does not automatically interrupt the screen reader. An error-bound Callout may carry the one-time validation announcement after a failed submit, described in "
                        },
                        {
                            "text": "Validate fields",
                            "link": 1
                        },
                        {
                            "text": "."
                        }
                    ]
                }
            ]
        },
        "validation-and-failure-behaviour": {
            "title": "Validation and failure behaviour",
            "blocks": [
                {
                    "type": "text",
                    "runs": [
                        {
                            "text": "A missing, empty, whitespace-only, or non-string "
                        },
                        {
                            "text": "message",
                            "code": true
                        },
                        {
                            "text": " throws an "
                        },
                        {
                            "text": "InvalidArgumentException",
                            "code": true
                        },
                        {
                            "text": ". Unsupported or non-string tones fail and list the accepted values. "
                        },
                        {
                            "text": "action-label",
                            "code": true
                        },
                        {
                            "text": " without "
                        },
                        {
                            "text": "@press",
                            "code": true
                        },
                        {
                            "text": ", "
                        },
                        {
                            "text": "@press",
                            "code": true
                        },
                        {
                            "text": " without "
                        },
                        {
                            "text": "action-label",
                            "code": true
                        },
                        {
                            "text": ", and blank action labels fail before publication."
                        }
                    ]
                },
                {
                    "type": "text",
                    "runs": [
                        {
                            "text": "Firstlight also rejects model, change, dismissal, title, icon, disabled, loading, validation, navigation, long-press, and visual escape attributes instead of silently inventing behavior. If malformed data reaches a native renderer, it falls back to "
                        },
                        {
                            "text": "info",
                            "code": true
                        },
                        {
                            "text": " and suppresses an incomplete action without crashing."
                        }
                    ]
                }
            ]
        },
        "platform-behaviour": {
            "title": "Platform behaviour",
            "blocks": [
                {
                    "type": "text",
                    "runs": [
                        {
                            "text": "iOS composes SwiftUI "
                        },
                        {
                            "text": "Image",
                            "code": true
                        },
                        {
                            "text": ", "
                        },
                        {
                            "text": "Text",
                            "code": true
                        },
                        {
                            "text": ", and "
                        },
                        {
                            "text": "Button",
                            "code": true
                        },
                        {
                            "text": " with platform typography, a continuous rounded rectangle, VoiceOver containment, and native Dynamic Type. Android composes a Material 3 "
                        },
                        {
                            "text": "Surface",
                            "code": true
                        },
                        {
                            "text": ", icon, text, and "
                        },
                        {
                            "text": "TextButton",
                            "code": true
                        },
                        {
                            "text": " with Material typography and TalkBack semantics."
                        }
                    ]
                },
                {
                    "type": "text",
                    "text": "Both inherit NativePHP semantic theme tokens and preserve native dark mode, increased contrast, focus, activation feedback, and right-to-left layout rather than forcing pixel parity."
                }
            ]
        },
        "compatibility": {
            "title": "Compatibility",
            "blocks": [
                {
                    "type": "text",
                    "runs": [
                        {
                            "text": "Callout supports the versions listed in the current "
                        },
                        {
                            "text": "compatibility reference",
                            "link": 2
                        },
                        {
                            "text": ". The host application must compile both Firstlight-owned native renderers declared by the package manifest."
                        }
                    ]
                }
            ]
        },
