    "chapters": {
        "overview": {
            "title": "Overview",
            "blocks": [
                {
                    "type": "text",
                    "text": "Reorder List lets people put a short list of items in their own order, optionally across named sections such as \"Tab bar\" and \"More\". Every move works by dragging and, equally, through VoiceOver and TalkBack actions."
                }
            ]
        },
        "complete-examples": {
            "title": "Complete examples",
            "blocks": [
                {
                    "type": "text",
                    "text": "A single list binds a list of item values:"
                },
                {
                    "type": "code",
                    "language": "php",
                    "text": "public array $favourites = ['inbox', 'calendar', 'reports'];"
                },
                {
                    "type": "code",
                    "language": "blade",
                    "text": "<firstlight:reorder-list\n    :items=\"[\n        ['value' => 'inbox', 'label' => 'Inbox', 'icon' => 'inbox'],\n        ['value' => 'calendar', 'label' => 'Calendar', 'icon' => 'calendar'],\n        ['value' => 'reports', 'label' => 'Reports', 'supporting' => 'Weekly'],\n    ]\"\n    native:model=\"favourites\"\n    label=\"Favourites\"\n/>"
                },
                {
                    "type": "text",
                    "runs": [
                        {
                            "text": "With "
                        },
                        {
                            "text": "sections",
                            "code": true
                        },
                        {
                            "text": ", the value maps every section key to a list:"
                        }
                    ]
                },
                {
                    "type": "code",
                    "language": "php",
                    "text": "public array $arrangement = [\n    'bar' => ['home', 'inbox', 'reports'],\n    'more' => ['files'],\n];"
                },
                {
                    "type": "code",
                    "language": "blade",
                    "text": "<firstlight:reorder-list\n    :items=\"$tabItems\"\n    :sections=\"['bar' => 'Tab bar', 'more' => 'More']\"\n    native:model=\"arrangement\"\n    label=\"Tabs\"\n    helper=\"Up to 5 tabs. Home stays first.\"\n/>"
                }
            ]
        },
