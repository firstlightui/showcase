        "items-and-values": {
            "title": "Items and values",
            "blocks": [
                {
                    "type": "text",
                    "text": "Item values must be unique and all strings or all integers. Labels must contain visible text. A list holds at most 20 items, because each possible move is published ahead of time."
                },
                {
                    "type": "text",
                    "text": "The bound value must contain every item value exactly once. Section keys in the value must be the declared keys; a missing section is an empty list."
                },
                {
                    "type": "text",
                    "text": "A locked item shows a lock instead of a drag handle and offers no move actions. Other items may still be dropped around it; PHP decides whether to accept the result."
                },
                {
                    "type": "text",
                    "text": "There is no add, delete or selection behaviour. To let people hide items, give the list a second section, such as \"Hidden\", and move them there."
                }
            ]
        },
        "events-and-state-timing": {
            "title": "Events and state timing",
            "blocks": [
                {
                    "type": "text",
                    "runs": [
                        {
                            "text": "@change",
                            "code": true
                        },
                        {
                            "text": " receives the complete proposed value in the bound shape. "
                        },
                        {
                            "text": "native:model",
                            "code": true
                        },
                        {
                            "text": " normally generates this callback."
                        }
                    ]
                },
                {
                    "type": "text",
                    "runs": [
                        {
                            "text": "Dragging is continuous, so the dropped order shows at once as a draft rather than snapping back. PHP stays "
                        },
                        {
                            "text": "server-authoritative",
                            "link": 0
                        },
                        {
                            "text": ": its next publication replaces the draft, whether it accepted the move, rewrote it (for example to enforce a section limit) or rejected it. Moves are ignored while a proposal is in flight. Programmatic publications never emit."
                        }
                    ]
                },
                {
                    "type": "text",
                    "runs": [
                        {
                            "text": "An unchanged PHP response must also release the pending-move guard. Host the control in "
                        },
                        {
                            "text": "FirstlightUI\\NativeComponent",
                            "code": true
                        },
                        {
                            "text": " for the "
                        },
                        {
                            "text": "nonstreaming response-revision contract",
                            "link": 1
                        },
                        {
                            "text": "."
                        }
                    ]
                },
                {
                    "type": "text",
                    "runs": [
                        {
                            "text": "Use plain "
                        },
                        {
                            "text": "native:model",
                            "code": true
                        },
                        {
                            "text": " or "
                        },
                        {
                            "text": "native:model.live",
                            "code": true
                        },
                        {
                            "text": "; deferred "
                        },
                        {
                            "text": "blur",
                            "code": true
                        },
                        {
                            "text": " and "
                        },
                        {
                            "text": "debounce",
                            "code": true
                        },
                        {
                            "text": " modes are rejected."
                        }
                    ]
                }
            ]
        },
        "accessibility": {
            "title": "Accessibility",
            "blocks": [
                {
                    "type": "text",
                    "runs": [
                        {
                            "text": "Provide either a visible "
                        },
                        {
                            "text": "label",
                            "code": true
                        },
                        {
                            "text": " or an explicit "
                        },
                        {
                            "text": "a11y-label",
                            "code": true
                        },
                        {
                            "text": ". Each row is one accessibility target that reads its label, its section and position (\"Inbox, Tab bar, 2 of 3\"), and \"Locked\" when locked. Unlocked rows offer Move up, Move down and Move to each other section (to its end). After a move, the new position is announced. Section headers are headings. Rows meet 44-point iOS and 48-dp Android targets and wrap long labels."
                        }
                    ]
                }
            ]
        },
        "validation-and-failure-behaviour": {
            "title": "Validation and failure behaviour",
            "blocks": [
                {
                    "type": "text",
                    "runs": [
                        {
                            "text": "Contract exceptions reject malformed items, blank labels, duplicate or mixed values, more than 20 items, fewer than two sections, a value that misses, repeats or adds item values, a value in the wrong shape, unknown section keys and deferred sync modes, before publication. Screens that "
                        },
                        {
                            "text": "use ValidatesFields",
                            "code": true
                        },
                        {
                            "text": " show the first MessageBag message for the field, as other fields do."
                        }
                    ]
                }
            ]
        },
        "platform-behaviour": {
            "title": "Platform behaviour",
            "blocks": [
                {
                    "type": "text",
                    "runs": [
                        {
                            "text": "iOS uses a SwiftUI "
                        },
                        {
                            "text": "List",
                            "code": true
                        },
                        {
                            "text": " in the inset-grouped style, held in edit mode so rows show the system reorder handles. Rows can be dragged across section headers."
                        }
                    ]
                },
                {
                    "type": "text",
                    "text": "Android draws Material 3 grouped rows with a drag handle. Dragging the handle moves the row at once; a long press anywhere on the row also lifts it. The row lifts with elevation, and a haptic tick marks each place it passes."
                }
            ]
        },
        "compatibility": {
            "title": "Compatibility",
            "blocks": [
                {
                    "type": "text",
                    "runs": [
                        {
                            "text": "Reorder List supports the versions listed in the current "
                        },
                        {
                            "text": "compatibility reference",
                            "link": 2
                        },
                        {
                            "text": " and requires both native renderers in the host application plus Firstlight's screen response contract above."
                        }
                    ]
                }
            ]
        }
