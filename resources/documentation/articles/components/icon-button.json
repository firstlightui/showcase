    "chapters": {
        "overview": {
            "title": "Overview",
            "blocks": [
                {
                    "type": "text",
                    "text": "Icon Button triggers one compact action represented by an icon. It renders as a genuine SwiftUI button on iOS and the Material 3 Icon Button family on Android while keeping one portable Firstlight API."
                }
            ]
        },
        "complete-example": {
            "title": "Complete example",
            "blocks": [
                {
                    "type": "code",
                    "language": "blade",
                    "text": "<firstlight:icon-button\n    icon=\"plus\"\n    icon-ios=\"plus.circle\"\n    icon-android=\"add_circle\"\n    a11y-label=\"Add item\"\n    a11y-hint=\"Adds a blank item\"\n    variant=\"primary\"\n    size=\"md\"\n    :loading=\"$adding\"\n    :disabled=\"! $canAdd\"\n    @press=\"addItem\"\n/>"
                },
                {
                    "type": "text",
                    "runs": [
                        {
                            "text": "Icon Button is self-closing and has no visible text slot. Use "
                        },
                        {
                            "text": "<firstlight:button>",
                            "code": true
                        },
                        {
                            "text": " when the action needs a visible label, or "
                        },
                        {
                            "text": "<native:icon>",
                            "code": true
                        },
                        {
                            "text": " for a decorative or display-only glyph."
                        }
                    ]
                }
            ]
        },
