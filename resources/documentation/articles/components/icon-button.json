        "events": {
            "title": "Events",
            "blocks": [
                {
                    "type": "text",
                    "runs": [
                        {
                            "text": "@press",
                            "code": true
                        },
                        {
                            "text": " is required and invokes the named PHP action once for a native user press:"
                        }
                    ]
                },
                {
                    "type": "code",
                    "language": "php",
                    "text": "public function addItem(): void\n{\n    // Persist the action and publish any resulting state.\n}"
                },
                {
                    "type": "text",
                    "runs": [
                        {
                            "text": "Icon Button has no "
                        },
                        {
                            "text": "value",
                            "code": true
                        },
                        {
                            "text": ", "
                        },
                        {
                            "text": "native:model",
                            "code": true
                        },
                        {
                            "text": ", or "
                        },
                        {
                            "text": "@change",
                            "code": true
                        },
                        {
                            "text": ". Disabled and loading buttons do not emit. Programmatic publications never emit a press."
                        }
                    ]
                }
            ]
        },
        "variants-and-sizes": {
            "title": "Variants and sizes",
            "blocks": [
                {
                    "type": "text",
                    "runs": [
                        {
                            "text": "The variants share the same semantic vocabulary as Firstlight Button. iOS uses Apple-native prominent or plain button expression and theme tints. Android uses "
                        },
                        {
                            "text": "FilledIconButton",
                            "code": true
                        },
                        {
                            "text": ", "
                        },
                        {
                            "text": "FilledTonalIconButton",
                            "code": true
                        },
                        {
                            "text": ", or "
                        },
                        {
                            "text": "IconButton",
                            "code": true
                        },
                        {
                            "text": " according to intent. "
                        },
                        {
                            "text": "sm",
                            "code": true
                        },
                        {
                            "text": ", "
                        },
                        {
                            "text": "md",
                            "code": true
                        },
                        {
                            "text": ", and "
                        },
                        {
                            "text": "lg",
                            "code": true
                        },
                        {
                            "text": " scale the visible glyph and native container without shrinking the accessible interaction target."
                        }
                    ]
                }
            ]
        },
        "loading-and-disabled-behaviour": {
            "title": "Loading and disabled behaviour",
            "blocks": [
                {
                    "type": "text",
                    "runs": [
                        {
                            "text": "loading",
                            "code": true
                        },
                        {
                            "text": " keeps the explicit accessible name, substitutes a native progress indicator, exposes a loading value or state description, and disables the action until PHP publishes a non-loading state. "
                        },
                        {
                            "text": "disabled",
                            "code": true
                        },
                        {
                            "text": " retains the icon and name while exposing native disabled appearance and semantics."
                        }
                    ]
                }
            ]
        },
        "accessibility": {
            "title": "Accessibility",
            "blocks": [
                {
                    "type": "text",
                    "runs": [
                        {
                            "text": "Every Icon Button requires "
                        },
                        {
                            "text": "a11y-label",
                            "code": true
                        },
                        {
                            "text": "; familiar-looking icon names are not accepted as an accessible-name substitute. The glyph is decorative inside one button accessibility node. Native renderers expose the button role, optional hint, disabled or loading state, focus and press feedback, and interaction targets of at least 44 points on iOS and 48 dp on Android."
                        }
                    ]
                }
            ]
        },
        "validation-and-excluded-apis": {
            "title": "Validation and excluded APIs",
            "blocks": [
                {
                    "type": "text",
                    "runs": [
                        {
                            "text": "Firstlight rejects missing or blank icons, missing or blank accessibility labels, missing "
                        },
                        {
                            "text": "@press",
                            "code": true
                        },
                        {
                            "text": ", non-boolean state props, invalid variants and sizes, unsupported platform icon values, visible labels or slots, trailing icons, menus, navigation directives, extra gesture callbacks, bindings, field props, and per-control colour or typography escape hatches."
                        }
                    ]
                }
            ]
        },
        "compatibility": {
            "title": "Compatibility",
            "blocks": [
                {
                    "type": "text",
                    "runs": [
                        {
                            "text": "Icon Button supports the versions listed in the current "
                        },
                        {
                            "text": "compatibility reference",
                            "link": 0
                        },
                        {
                            "text": " and requires both Firstlight native renderers to be compiled into the host application."
                        }
                    ]
                }
            ]
        },
