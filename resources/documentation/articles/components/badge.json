        "events-and-values": {
            "title": "Events and values",
            "blocks": [
                {
                    "type": "text",
                    "text": "Badge has no model binding or events. A later server publication may replace its count, label, tone, or accessibility metadata without producing a callback."
                },
                {
                    "type": "text",
                    "runs": [
                        {
                            "text": "Do not use "
                        },
                        {
                            "text": "native:model",
                            "code": true
                        },
                        {
                            "text": ", "
                        },
                        {
                            "text": "@change",
                            "code": true
                        },
                        {
                            "text": ", "
                        },
                        {
                            "text": "@press",
                            "code": true
                        },
                        {
                            "text": ", "
                        },
                        {
                            "text": "value",
                            "code": true
                        },
                        {
                            "text": ", "
                        },
                        {
                            "text": "disabled",
                            "code": true
                        },
                        {
                            "text": ", "
                        },
                        {
                            "text": "loading",
                            "code": true
                        },
                        {
                            "text": ", "
                        },
                        {
                            "text": "helper",
                            "code": true
                        },
                        {
                            "text": ", "
                        },
                        {
                            "text": "error",
                            "code": true
                        },
                        {
                            "text": ", "
                        },
                        {
                            "text": "required",
                            "code": true
                        },
                        {
                            "text": ", icons, variants, or colour escape props. Firstlight rejects those attributes instead of silently adding interactive or field semantics."
                        }
                    ]
                }
            ]
        },
        "count-behaviour": {
            "title": "Count behaviour",
            "blocks": [
                {
                    "type": "text",
                    "text": "Firstlight formats the visible count once in PHP so both platforms publish and render the same label:"
                },
                {
                    "type": "item",
                    "marker": "•",
                    "depth": 0,
                    "runs": [
                        {
                            "text": "0",
                            "code": true
                        },
                        {
                            "text": " publishes an empty display label and renders no badge."
                        }
                    ]
                },
                {
                    "type": "item",
                    "marker": "•",
                    "depth": 0,
                    "runs": [
                        {
                            "text": "1",
                            "code": true
                        },
                        {
                            "text": " through "
                        },
                        {
                            "text": "99",
                            "code": true
                        },
                        {
                            "text": " display the complete decimal count."
                        }
                    ]
                },
                {
                    "type": "item",
                    "marker": "•",
                    "depth": 0,
                    "runs": [
                        {
                            "text": "100",
                            "code": true
                        },
                        {
                            "text": " and above display "
                        },
                        {
                            "text": "99+",
                            "code": true
                        },
                        {
                            "text": "."
                        }
                    ]
                },
                {
                    "type": "text",
                    "runs": [
                        {
                            "text": "A count badge always requires a contextual "
                        },
                        {
                            "text": "a11y-label",
                            "code": true
                        },
                        {
                            "text": "; the formatted visual text alone is not a useful accessible name. A text badge uses its visible label as the accessible name unless "
                        },
                        {
                            "text": "a11y-label",
                            "code": true
                        },
                        {
                            "text": " replaces it."
                        }
                    ]
                }
            ]
        },
        "state-timing": {
            "title": "State timing",
            "blocks": [
                {
                    "type": "text",
                    "text": "Badge renders the latest published Element Tree metadata. It keeps no native selection, editing buffer, pending proposal, or animation state. Programmatic updates reconcile by the element's stable node ID and emit nothing."
                }
            ]
        },
        "accessibility": {
            "title": "Accessibility",
            "blocks": [
                {
                    "type": "text",
                    "text": "Both platforms expose static-text semantics without button, selected, disabled, or live-region traits. Hidden zero badges expose no element. Text follows Dynamic Type on iOS and system font scaling on Android."
                },
                {
                    "type": "text",
                    "runs": [
                        {
                            "text": "Warning badges use the shared "
                        },
                        {
                            "text": "warning",
                            "code": true
                        },
                        {
                            "text": " / "
                        },
                        {
                            "text": "on-warning",
                            "code": true
                        },
                        {
                            "text": " theme pair for the active native appearance, independently of brand accent. After "
                        },
                        {
                            "text": "Theme::merge()",
                            "code": true
                        },
                        {
                            "text": ", republish the component tree to refresh custom warning colours; see "
                        },
                        {
                            "text": "theming",
                            "link": 0
                        },
                        {
                            "text": "."
                        }
                    ]
                },
                {
                    "type": "text",
                    "text": "Semantic theme colours are checked at render time. When a customised foreground and background are below 4.5:1 contrast, Firstlight uses whichever of black or white provides the stronger contrast."
                }
            ]
        },
        "validation-and-failure-behaviour": {
            "title": "Validation and failure behaviour",
            "blocks": [
                {
                    "type": "text",
                    "runs": [
                        {
                            "text": "Missing both display sources, providing both, a negative or non-integer count, an empty label, or an unsupported tone throws an "
                        },
                        {
                            "text": "InvalidArgumentException",
                            "code": true
                        },
                        {
                            "text": " before publication. Malformed tone data that unexpectedly reaches a native renderer falls back defensively to "
                        },
                        {
                            "text": "neutral",
                            "code": true
                        },
                        {
                            "text": " rather than crashing the host."
                        }
                    ]
                }
            ]
        },
        "platform-behaviour": {
            "title": "Platform behaviour",
            "blocks": [
                {
                    "type": "text",
                    "runs": [
                        {
                            "text": "iOS composes SwiftUI "
                        },
                        {
                            "text": "Text",
                            "code": true
                        },
                        {
                            "text": " in a native capsule-style marker. Android composes Material 3 "
                        },
                        {
                            "text": "Badge",
                            "code": true
                        },
                        {
                            "text": ". Both inherit NativePHP semantic theme tokens while retaining platform-native typography, scaling, colour-scheme, and layout behaviour."
                        }
                    ]
                }
            ]
        },
        "compatibility": {
            "title": "Compatibility",
            "blocks": [
                {
                    "type": "text",
                    "runs": [
                        {
                            "text": "Badge supports the versions listed in the current "
                        },
                        {
                            "text": "compatibility reference",
                            "link": 1
                        },
                        {
                            "text": " and requires both native renderers to be compiled into the host application."
                        }
                    ]
                }
            ]
        },
