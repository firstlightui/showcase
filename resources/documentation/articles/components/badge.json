    "chapters": {
        "overview": {
            "title": "Overview",
            "blocks": [
                {
                    "type": "text",
                    "text": "Badge presents a compact display-only count or short marker. Use Status Label for longer status text and an interactive control when the interface must respond to a press."
                }
            ]
        },
        "complete-examples": {
            "title": "Complete examples",
            "blocks": [
                {
                    "type": "code",
                    "language": "blade",
                    "text": "<firstlight:badge\n    :count=\"$unreadCount\"\n    tone=\"danger\"\n    a11y-label=\"{{ $unreadCount }} unread messages\"\n    a11y-hint=\"Open the inbox to review them\"\n/>\n\n<firstlight:badge label=\"New\" tone=\"info\" />"
                },
                {
                    "type": "text",
                    "text": "The same authored tags render on iOS and Android."
                }
            ]
        },
