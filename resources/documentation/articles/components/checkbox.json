{
    "id": "components/checkbox",
    "title": "Checkbox",
    "description": "Strict Boolean form and checklist state, field metadata, server-authoritative proposals, accessibility, and native platform behaviour.",
    "group": "Components",
    "anchors": {
        "checkbox": "overview",
        "complete-example": "complete-example",
        "props": "props",
        "events": "events",
        "accepted-values": "accepted-values",
        "state-timing": "state-timing",
        "disabled-behaviour": "disabled-behaviour",
        "accessibility": "accessibility",
        "validation-and-failure-behaviour": "validation-and-failure-behaviour",
        "platform-behaviour": "platform-behaviour",
        "compatibility": "compatibility",
        "screenshots": "screenshots"
    },
    "chapters": {
        "overview": {
            "title": "Overview",
            "blocks": [
                {
                    "type": "text",
                    "runs": [
                        {
                            "text": "Checkbox represents one Boolean form or checklist value. Use it for explicit acknowledgements and selections that are normally saved with a form. Use "
                        },
                        {
                            "text": "Switch",
                            "link": 0
                        },
                        {
                            "text": " for a setting that takes effect immediately, or "
                        },
                        {
                            "text": "Choice Group",
                            "link": 1
                        },
                        {
                            "text": " for selection from a visible collection."
                        }
                    ]
                }
            ]
        },
        "complete-example": {
            "title": "Complete example",
            "blocks": [
                {
                    "type": "text",
                    "runs": [
                        {
                            "text": "Declare a Boolean property on the native component, then bind it with "
                        },
                        {
                            "text": "native:model",
                            "code": true
                        },
                        {
                            "text": ":"
                        }
                    ]
                },
                {
                    "type": "code",
                    "language": "php",
                    "text": "<?php\n\nnamespace App\\NativeComponents;\n\nuse Illuminate\\View\\View;\nuse FirstlightUI\\NativeComponent;\n\nclass Registration extends NativeComponent\n{\n    public bool $acceptedTerms = false;\n\n    public function render(): View\n    {\n        return view('native.registration');\n    }\n}"
                },
                {
                    "type": "code",
                    "language": "blade",
                    "text": "<firstlight:checkbox\n    native:model=\"acceptedTerms\"\n    label=\"I agree to the terms\"\n    helper=\"Required before continuing.\"\n    required\n    a11y-hint=\"Required before creating your account\"\n/>"
                }
            ]
        },
        "props": {
            "title": "Props",
            "blocks": [
                {
                    "type": "definition",
                    "term": {
                        "runs": [
                            {
                                "text": "value",
                                "code": true
                            }
                        ]
                    },
                    "items": [
                        {
                            "label": "Accepted type",
                            "runs": [
                                {
                                    "text": "bool",
                                    "code": true
                                }
                            ]
                        },
                        {
                            "label": "Purpose",
                            "runs": [
                                {
                                    "text": "Accepted value. Defaults to "
                                },
                                {
                                    "text": "false",
                                    "code": true
                                },
                                {
                                    "text": " when omitted."
                                }
                            ]
                        }
                    ]
                },
                {
                    "type": "definition",
                    "term": {
                        "runs": [
                            {
                                "text": "native:model",
                                "code": true
                            }
                        ]
                    },
                    "items": [
                        {
                            "label": "Accepted type",
                            "text": "a Boolean component property"
                        },
                        {
                            "label": "Purpose",
                            "runs": [
                                {
                                    "text": "Synchronises the accepted value through NativePHP. "
                                },
                                {
                                    "text": "native:model.live",
                                    "code": true
                                },
                                {
                                    "text": " is also accepted."
                                }
                            ]
                        }
                    ]
                },
                {
                    "type": "definition",
                    "term": {
                        "runs": [
                            {
                                "text": "label",
                                "code": true
                            }
                        ]
                    },
                    "items": [
                        {
                            "label": "Accepted type",
                            "runs": [
                                {
                                    "text": "string",
                                    "code": true
                                }
                            ]
                        },
                        {
                            "label": "Purpose",
                            "text": "Visible checkbox label."
                        }
                    ]
                },
                {
                    "type": "definition",
                    "term": {
                        "runs": [
                            {
                                "text": "helper",
                                "code": true
                            }
                        ]
                    },
                    "items": [
                        {
                            "label": "Accepted type",
                            "runs": [
                                {
                                    "text": "string",
                                    "code": true
                                }
                            ]
                        },
                        {
                            "label": "Purpose",
                            "text": "Supporting text below the label."
                        }
                    ]
                },
                {
                    "type": "definition",
                    "term": {
                        "runs": [
                            {
                                "text": "error",
                                "code": true
                            }
                        ]
                    },
                    "items": [
                        {
                            "label": "Accepted type",
                            "runs": [
                                {
                                    "text": "string",
                                    "code": true
                                }
                            ]
                        },
                        {
                            "label": "Purpose",
                            "runs": [
                                {
                                    "text": "Validation text and error semantics; shown instead of "
                                },
                                {
                                    "text": "helper",
                                    "code": true
                                },
                                {
                                    "text": " when non-empty."
                                }
                            ]
                        }
                    ]
                },
                {
                    "type": "definition",
                    "term": {
                        "runs": [
                            {
                                "text": "required",
                                "code": true
                            }
                        ]
                    },
                    "items": [
                        {
                            "label": "Accepted type",
                            "runs": [
                                {
                                    "text": "bool",
                                    "code": true
                                }
                            ]
                        },
                        {
                            "label": "Purpose",
                            "text": "Marks the field as required visually and for assistive technology."
                        }
                    ]
                },
                {
                    "type": "definition",
                    "term": {
                        "runs": [
                            {
                                "text": "disabled",
                                "code": true
                            }
                        ]
                    },
                    "items": [
                        {
                            "label": "Accepted type",
                            "runs": [
                                {
                                    "text": "bool",
                                    "code": true
                                }
                            ]
                        },
                        {
                            "label": "Purpose",
                            "text": "Prevents proposals and change events while retaining the accepted value."
                        }
                    ]
                },
                {
                    "type": "definition",
                    "term": {
                        "runs": [
                            {
