                                    "code": true
                                }
                            ]
                        },
                        {
                            "label": "Purpose",
                            "text": "Explicit accessible name when a visible label is inappropriate."
                        }
                    ]
                },
                {
                    "type": "definition",
                    "term": {
                        "runs": [
                            {
                                "text": "a11y-hint",
                                "code": true
                            }
                        ]
                    },
                    "items": [
                        {
                            "label": "Accepted type",
                            "runs": [
                                {
                                    "text": "string",
                                    "code": true
                                }
                            ]
                        },
                        {
                            "label": "Purpose",
                            "text": "Additional VoiceOver and TalkBack guidance."
                        }
                    ]
                },
                {
                    "type": "definition",
                    "term": {
                        "runs": [
                            {
                                "text": "class",
                                "code": true
                            }
                        ]
                    },
                    "items": [
                        {
                            "label": "Accepted type",
                            "runs": [
                                {
                                    "text": "string",
                                    "code": true
                                }
                            ]
                        },
                        {
                            "label": "Purpose",
                            "text": "External EDGE layout utilities."
                        }
                    ]
                },
                {
                    "type": "text",
                    "runs": [
                        {
                            "text": "The camel-case authoring aliases "
                        },
                        {
                            "text": "a11yLabel",
                            "code": true
                        },
                        {
                            "text": " and "
                        },
                        {
                            "text": "a11yHint",
                            "code": true
                        },
                        {
                            "text": " are accepted and publish the same native props."
                        }
                    ]
                }
            ]
        },
        "events": {
            "title": "Events",
            "blocks": [
                {
                    "type": "text",
                    "runs": [
                        {
                            "text": "@change",
                            "code": true
                        },
                        {
                            "text": " receives the proposed Boolean value. Use it when PHP decides whether to accept a change:"
                        }
                    ]
                },
                {
                    "type": "code",
                    "language": "php",
                    "text": "public bool $acceptedTerms = false;\n\npublic function updateAcceptedTerms(bool $value): void\n{\n    $this->acceptedTerms = $value;\n}"
                },
                {
                    "type": "code",
                    "language": "blade",
                    "text": "<firstlight:checkbox\n    :value=\"$acceptedTerms\"\n    @change=\"updateAcceptedTerms\"\n    label=\"I agree to the terms\"\n/>"
                },
                {
                    "type": "text",
                    "runs": [
                        {
                            "text": "native:model",
                            "code": true
                        },
                        {
                            "text": " normally supplies the same callback for property synchronisation."
                        }
                    ]
                }
            ]
        },
        "accepted-values": {
            "title": "Accepted values",
            "blocks": [
                {
                    "type": "text",
                    "runs": [
                        {
                            "text": "Checkbox accepts only strict PHP booleans: "
                        },
                        {
                            "text": "true",
                            "code": true
                        },
                        {
                            "text": " and "
                        },
                        {
                            "text": "false",
                            "code": true
                        },
                        {
                            "text": ". Bind a literal Boolean with "
                        },
                        {
                            "text": ":",
                            "code": true
                        },
                        {
                            "text": ":"
                        }
                    ]
                },
                {
                    "type": "code",
                    "language": "blade",
                    "text": "<firstlight:checkbox :value=\"false\" label=\"I agree to the terms\" />"
                },
                {
                    "type": "text",
                    "runs": [
                        {
                            "text": "value=\"false\"",
                            "code": true
                        },
                        {
                            "text": " is invalid because Blade passes it as a string. "
                        },
                        {
                            "text": "null",
                            "code": true
                        },
                        {
                            "text": ", integers, string booleans, arrays, and objects are also rejected. Checkbox has no nullable or indeterminate state."
                        }
                    ]
                }
            ]
        },
        "state-timing": {
            "title": "State timing",
            "blocks": [
                {
                    "type": "text",
                    "runs": [
                        {
                            "text": "Host the control in "
                        },
                        {
                            "text": "FirstlightUI\\NativeComponent",
                            "code": true
                        },
                        {
                            "text": " so unchanged full responses receive the "
                        },
                        {
                            "text": "response revision",
                            "link": 2
                        },
                        {
                            "text": "."
                        }
                    ]
                },
                {
                    "type": "text",
                    "runs": [
                        {
                            "text": "Checkbox is "
                        },
                        {
                            "text": "server-authoritative",
                            "link": 3
                        },
                        {
                            "text": ". A tap emits the inverse Boolean as one proposal, but the visible checkmark remains at the last value published by PHP. An accepted response changes the visible state; a rejected response republishes the previous state. Either response clears the pending proposal guard. Programmatic publications update the checkmark without emitting "
                        },
                        {
                            "text": "@change",
                            "code": true
                        },
                        {
                            "text": "."
                        }
                    ]
                },
                {
                    "type": "text",
                    "runs": [
                        {
                            "text": "Use "
                        },
                        {
                            "text": "native:model",
                            "code": true
                        },
                        {
                            "text": " or "
                        },
                        {
                            "text": "native:model.live",
                            "code": true
                        },
                        {
                            "text": ". Deferred "
                        },
                        {
                            "text": "blur",
                            "code": true
                        },
                        {
                            "text": ", "
                        },
                        {
                            "text": "lazy",
                            "code": true
                        },
                        {
                            "text": ", and "
                        },
                        {
                            "text": "debounce",
                            "code": true
                        },
                        {
                            "text": " synchronisation modes are rejected."
                        }
                    ]
                }
            ]
        },
        "disabled-behaviour": {
            "title": "Disabled behaviour",
            "blocks": [
                {
                    "type": "text",
                    "runs": [
                        {
                            "text": "When "
                        },
                        {
                            "text": "disabled",
                            "code": true
                        },
                        {
                            "text": " is "
                        },
                        {
                            "text": "true",
                            "code": true
                        },
                        {
                            "text": ", Checkbox stays visible with its accepted checked or unchecked state. It cannot emit a proposal or "
                        },
                        {
                            "text": "@change",
                            "code": true
                        },
                        {
                            "text": " event."
                        }
                    ]
                }
            ]
        },
        "accessibility": {
            "title": "Accessibility",
            "blocks": [
                {
                    "type": "text",
                    "runs": [
                        {
                            "text": "Provide a visible "
                        },
                        {
                            "text": "label",
                            "code": true
                        },
                        {
                            "text": " or an explicit "
                        },
                        {
                            "text": "a11y-label",
                            "code": true
                        },
                        {
                            "text": "; Firstlight warns during development when both are blank. Label, value, required state, hint, helper or error feedback, and the native checkbox role form one accessibility target. The visual checkmark is decorative to avoid a second focus stop."
                        }
                    ]
                },
                {
                    "type": "text",
                    "runs": [
                        {
                            "text": "iOS provides a minimum 44-point target and exposes a toggle trait with checked state. Android provides a minimum 48-dp target with "
                        },
                        {
                            "text": "Role.Checkbox",
                            "code": true
                        },
                        {
                            "text": " and one TalkBack focus stop. Both platforms support wrapping text and system text scaling."
                        }
                    ]
                }
            ]
        },
        "validation-and-failure-behaviour": {
            "title": "Validation and failure behaviour",
            "blocks": [
                {
                    "type": "text",
                    "runs": [
                        {
                            "text": "Contract exceptions still reject non-Boolean props and unsupported attributes before publication. User validation is separate: screens that "
                        },
                        {
                            "text": "use ValidatesFields",
                            "code": true
                        },
                        {
                            "text": " auto-bind the first MessageBag message for the field's "
                        },
                        {
                            "text": "native:model",
                            "code": true
                        },
                        {
                            "text": " or "
                        },
                        {
                            "text": "error-for",
                            "code": true
                        },
                        {
                            "text": " name. An authored "
                        },
                        {
                            "text": "error",
                            "code": true
                        },
                        {
                            "text": " wins. "
                        },
                        {
                            "text": "required",
                            "code": true
                        },
                        {
                            "text": " is display metadata and does not run Laravel rules. See "
                        },
                        {
                            "text": "Validate fields",
                            "link": 4
                        },
                        {
                            "text": ". Error text replaces helper text and is included in accessibility semantics."
                        }
                    ]
                }
            ]
        },
        "platform-behaviour": {
            "title": "Platform behaviour",
            "blocks": [
                {
                    "type": "text",
                    "runs": [
                        {
                            "text": "iOS uses an idiomatic SwiftUI checkmarked row built from a native "
                        },
                        {
                            "text": "Button",
                            "code": true
                        },
                        {
                            "text": " and SF Symbol state affordance. Android uses a genuine Material 3 "
                        },
                        {
                            "text": "Checkbox",
                            "code": true
                        },
                        {
                            "text": " inside a row-owned checkbox target. The public EDGE API and server-authoritative state contract are shared, while geometry and interaction presentation remain native to each platform."
                        }
                    ]
                }
            ]
        },
        "compatibility": {
            "title": "Compatibility",
            "blocks": [
                {
                    "type": "text",
                    "runs": [
                        {
                            "text": "Checkbox supports the versions listed in the current "
                        },
                        {
                            "text": "compatibility reference",
                            "link": 5
                        },
                        {
                            "text": ". The host application must compile both Firstlight-owned native renderers declared by the package manifest."
                        }
                    ]
                }
            ]
        },
