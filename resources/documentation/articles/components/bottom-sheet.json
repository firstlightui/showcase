{
    "id": "components/bottom-sheet",
    "title": "Bottom Sheet",
    "description": "Native bottom sheet for authored content with server-controlled visibility and dismissal.",
    "group": "Components",
    "anchors": {
        "bottom-sheet": "overview",
        "complete-example": "complete-example",
        "title": "title",
        "props": "props",
        "events": "events",
        "height": "height",
        "pinned-footer": "pinned-footer",
        "platform-expression": "platform-expression",
        "screenshots": "screenshots"
    },
    "chapters": {
        "overview": {
            "title": "Overview",
            "blocks": [
                {
                    "type": "text",
                    "text": "Bottom Sheet presents authored content in a panel that slides up from the bottom of the screen. PHP owns whether the sheet is requested; each platform owns sheet chrome and drag to dismiss. The sheet opens at the height of its content."
                },
                {
                    "type": "text",
                    "runs": [
                        {
                            "text": "Use "
                        },
                        {
                            "text": "Modal",
                            "link": 0
                        },
                        {
                            "text": " for a full-screen overlay. Use "
                        },
                        {
                            "text": "Alert Dialog",
                            "link": 1
                        },
                        {
                            "text": " for a single acknowledgement. Use "
                        },
                        {
                            "text": "Confirmation Dialog",
                            "link": 2
                        },
                        {
                            "text": " for a confirm/cancel decision."
                        }
                    ]
                }
            ]
        },
        "complete-example": {
            "title": "Complete example",
            "blocks": [
                {
                    "type": "code",
                    "language": "blade",
                    "text": "<firstlight:bottom-sheet\n    :visible=\"$showingFilters\"\n    title=\"Filters\"\n    a11y-label=\"Filters\"\n    @dismiss=\"closeFilters\"\n>\n    <native:column class=\"w-full p-4 gap-3\">\n        <firstlight:switch label=\"Unread only\" native:model=\"unreadOnly\" />\n    </native:column>\n</firstlight:bottom-sheet>"
                },
                {
                    "type": "text",
                    "runs": [
                        {
                            "text": "The dismiss handler should set "
                        },
                        {
                            "text": "$showingFilters",
                            "code": true
                        },
                        {
                            "text": " to "
                        },
                        {
                            "text": "false",
                            "code": true
                        },
                        {
                            "text": "."
                        }
                    ]
                }
            ]
        },
        "title": {
            "title": "Title",
            "blocks": [
                {
                    "type": "text",
                    "runs": [
                        {
                            "text": "title",
                            "code": true
                        },
                        {
                            "text": " gives the sheet the heading each platform draws for its own sheets, so don't author a title row of your own:"
                        }
                    ]
                },
                {
                    "type": "item",
                    "marker": "•",
                    "depth": 0,
                    "runs": [
                        {
                            "text": "iOS",
                            "strong": true
                        },
                        {
                            "text": " puts the content under an inline navigation bar with the title in the middle and the system close button on the leading edge, as Apple's sheets do. With Liquid Glass the close button is the system's glass button; before iOS 26 it is the filled circle sheets used then. Tapping it runs "
                        },
                        {
                            "text": "@dismiss",
                            "code": true
                        },
                        {
                            "text": ", like a swipe down."
                        }
                    ]
                },
                {
                    "type": "item",
                    "marker": "•",
                    "depth": 0,
                    "runs": [
                        {
                            "text": "Android",
                            "strong": true
                        },
                        {
                            "text": " shows the title as Material 3 "
                        },
                        {
                            "text": "titleLarge",
                            "code": true
                        },
                        {
                            "text": " heading text under the drag handle. Material's modal bottom sheet has no close button: it closes on a swipe down, a tap outside or back."
                        }
                    ]
                },
                {
                    "type": "text",
                    "runs": [
                        {
                            "text": "Screen readers announce the title as a heading on both platforms. VoiceOver reads the close button as Firstlight's translated \"Close\"; set "
                        },
                        {
                            "text": "close-label",
                            "code": true
                        },
                        {
                            "text": " to use your own wording. A sheet without "
                        },
                        {
                            "text": "title",
                            "code": true
                        },
                        {
                            "text": " has no bar or heading."
                        }
                    ]
                }
            ]
        },
        "props": {
            "title": "Props",
            "blocks": [
                {
                    "type": "definition",
                    "term": {
                        "runs": [
                            {
                                "text": "visible",
                                "code": true
                            }
                        ]
                    },
                    "items": [
                        {
                            "label": "Accepted type",
                            "runs": [
                                {
                                    "text": "bool",
                                    "code": true
                                }
                            ]
                        },
                        {
                            "label": "Purpose",
                            "text": "Server-controlled presentation request. Defaults to closed."
                        }
                    ]
                },
                {
                    "type": "definition",
                    "term": {
                        "runs": [
                            {
                                "text": "title",
                                "code": true
                            }
                        ]
                    },
                    "items": [
                        {
                            "label": "Accepted type",
                            "runs": [
                                {
                                    "text": "non-empty "
                                },
                                {
                                    "text": "string",
                                    "code": true
                                }
                            ]
                        },
                        {
                            "label": "Purpose",
                            "text": "The sheet's heading: an inline navigation bar with a close button on iOS, heading text under the drag handle on Android. Defaults to untitled."
                        }
                    ]
                },
                {
                    "type": "definition",
                    "term": {
                        "runs": [
                            {
                                "text": "close-label",
                                "code": true
                            }
                        ]
                    },
                    "items": [
                        {
                            "label": "Accepted type",
                            "runs": [
                                {
                                    "text": "non-empty "
                                },
                                {
                                    "text": "string",
                                    "code": true
                                }
                            ]
                        },
                        {
                            "label": "Purpose",
                            "runs": [
                                {
                                    "text": "What VoiceOver reads for the iOS close button. Defaults to Firstlight's translated \"Close\"; needs "
                                },
                                {
                                    "text": "title",
                                    "code": true
                                },
                                {
                                    "text": "."
                                }
                            ]
                        }
                    ]
                },
                {
                    "type": "definition",
                    "term": {
                        "runs": [
                            {
                                "text": "pinned-footer",
                                "code": true
                            }
                        ]
                    },
                    "items": [
                        {
                            "label": "Accepted type",
                            "runs": [
                                {
                                    "text": "bool",
                                    "code": true
                                }
                            ]
                        },
                        {
                            "label": "Purpose",
                            "runs": [
                                {
                                    "text": "Keeps the final direct child outside the scrolling body. Defaults to "
                                },
                                {
                                    "text": "false",
                                    "code": true
                                },
                                {
                                    "text": "; requires at least two direct children."
                                }
                            ]
                        }
                    ]
                },
                {
                    "type": "definition",
                    "term": {
                        "runs": [
                            {
                                "text": "a11y-label",
                                "code": true
                            }
                        ]
                    },
                    "items": [
                        {
                            "label": "Accepted type",
                            "runs": [
                                {
                                    "text": "non-empty "
                                },
                                {
                                    "text": "string",
                                    "code": true
                                }
                            ]
                        },
                        {
                            "label": "Purpose",
                            "text": "Accessible name for the sheet."
                        }
                    ]
                },
                {
                    "type": "definition",
                    "term": {
                        "runs": [
                            {
                                "text": "a11y-hint",
                                "code": true
                            }
                        ]
                    },
                    "items": [
                        {
                            "label": "Accepted type",
                            "runs": [
                                {
                                    "text": "non-empty "
                                },
                                {
                                    "text": "string",
                                    "code": true
                                }
                            ]
                        },
                        {
                            "label": "Purpose",
                            "text": "Supplementary screen-reader guidance."
                        }
                    ]
                },
                {
                    "type": "definition",
                    "term": {
                        "runs": [
                            {
                                "text": "class",
                                "code": true
                            }
                        ]
                    },
                    "items": [
                        {
                            "label": "Accepted type",
                            "runs": [
                                {
                                    "text": "string",
                                    "code": true
                                }
                            ]
                        },
                        {
                            "label": "Purpose",
                            "text": "External EDGE layout utilities."
                        }
                    ]
                }
            ]
        },
        "events": {
            "title": "Events",
            "blocks": [
                {
                    "type": "text",
                    "runs": [
                        {
                            "text": "@dismiss",
                            "code": true
                        },
                        {
                            "text": " is required. It runs when the user drags the sheet down, taps outside, uses system back, or taps a titled sheet's close button on iOS. Set the bound visibility property to "
                        },
                        {
                            "text": "false",
                            "code": true
                        },
                        {
                            "text": " in that handler."
                        }
                    ]
                },
                {
                    "type": "text",
                    "text": "When a Firstlight screen navigates away, its farewell response closes the sheet without changing that visibility property. This also covers sheets in nested children."
                },
                {
                    "type": "text",
                    "runs": [
                        {
                            "text": "There is no overlay "
                        },
                        {
                            "text": "@press",
                            "code": true
                        },
                        {
                            "text": ", "
                        },
                        {
                            "text": "native:model",
                            "code": true
                        },
                        {
                            "text": ", "
                        },
                        {
                            "text": "dismissible",
                            "code": true
                        },
                        {
                            "text": ", or "
                        },
                        {
                            "text": "detents",
                            "code": true
                        },
                        {
                            "text": " API. You don't set the height: the sheet measures its content."
                        }
                    ]
                }
            ]
        },
        "height": {
            "title": "Height",
            "blocks": [
                {
                    "type": "text",
                    "text": "The sheet opens at the height of its content on both platforms. A short sheet stays short, and a sheet taller than half the screen opens fully, so a button at the bottom is visible without dragging. The height follows the content when it changes, including for larger text sizes, up to a full-height sheet. Content taller than that scrolls on both platforms."
                }
            ]
        },
        "pinned-footer": {
            "title": "Pinned footer",
            "blocks": [
                {
                    "type": "text",
                    "runs": [
                        {
                            "text": "With "
                        },
                        {
                            "text": "pinned-footer",
                            "code": true
                        },
                        {
                            "text": ", the final "
                        },
                        {
                            "text": "direct child",
                            "strong": true
                        },
                        {
                            "text": " is the footer; every earlier child is scrolling content. Group multiple footer controls in an existing Mobile UI column. Do not wrap the body and footer in a single outer child."
                        }
                    ]
                },
                {
                    "type": "code",
                    "language": "blade",
                    "text": "<firstlight:bottom-sheet\n    :visible=\"$showingBill\"\n    pinned-footer\n    a11y-label=\"Review bill\"\n    @dismiss=\"closeBill\"\n>\n    <native:column class=\"w-full p-4 gap-3\">\n        @foreach ($items as $item)\n            <native:text class=\"text-theme-on-surface\">{{ $item['label'] }}</native:text>\n        @endforeach\n    </native:column>\n    <native:column class=\"w-full p-4 gap-3\">\n        <native:text class=\"text-theme-on-surface\">Total: {{ $formattedTotal }}</native:text>\n        <firstlight:button label=\"Save\" @press=\"saveBill\" />\n    </native:column>\n</firstlight:bottom-sheet>"
                },
                {
                    "type": "text",
                    "text": "The app supplies the items, formatted total and handlers. The footer needs no background: on iOS 26 and later the system blurs body content that scrolls under it, as under Apple's toolbars, and earlier iOS and Android give it the sheet's surface. Keep the footer compact; body content must have space to scroll. PHP owns Save and whether the sheet closes. Native dismissal and its callback remain unchanged."
                }
            ]
        },
        "platform-expression": {
            "title": "Platform expression",
            "blocks": [
                {
                    "type": "text",
                    "runs": [
                        {
                            "text": "iOS uses a SwiftUI "
                        },
                        {
                            "text": ".sheet",
                            "code": true
                        },
                        {
                            "text": " with a drag indicator and a height detent measured from the content. Android uses Material 3 "
                        },
                        {
                            "text": "ModalBottomSheet",
                            "code": true
                        },
                        {
                            "text": " sized to its content without the half-height stop. Both keep a band for the drag indicator above your content, so a sheet's top padding starts below the indicator, as its side padding starts at the sheet edge. On iOS 26 and later the sheet is the system's Liquid Glass, which turns opaque at full height, and Buttons and Icon Buttons in its footer take glass. Before iOS 26 and on Android, theme tokens own surface and scrim colour."
                        }
                    ]
                },
                {
                    "type": "text",
                    "text": "iOS places the footer in a bottom safe-area inset. Android keeps it below the bounded scrolling body. Both retain their native sheet chrome and insets. On Android, an authored vertical scroll view or list keeps ownership of body scrolling, including when nested in a layout column. The sheet supplies the scrolling viewport only when the body has no vertical scrolling container."
                }
            ]
        },
