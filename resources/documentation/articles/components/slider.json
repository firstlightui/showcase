        "accessibility-and-platform-behavior": "accessibility-and-platform-behavior",
        "screenshots": "screenshots"
    },
    "chapters": {
        "overview": {
            "title": "Overview",
            "blocks": [
                {
                    "type": "text",
                    "text": "Slider selects one numeric value from a finite, evenly spaced range using the native platform slider. PHP owns the accepted value; the platform owns a draft only while the user is interacting."
                }
            ]
        },
        "complete-example": {
            "title": "Complete example",
            "blocks": [
                {
                    "type": "code",
                    "language": "blade",
                    "text": "<firstlight:slider\n    native:model.blur=\"dose\"\n    :min=\"0\"\n    :max=\"10\"\n    :step=\"0.5\"\n    label=\"Dose\"\n    helper=\"Choose a dose in half-milligram increments.\"\n    a11y-value=\"5 milligrams\"\n/>"
                },
                {
                    "type": "text",
                    "runs": [
                        {
                            "text": "Use Blade's "
                        },
                        {
                            "text": ":",
                            "code": true
                        },
                        {
                            "text": " binding for numeric literals so PHP receives actual numbers, not numeric strings. The bound property receives a PHP "
                        },
                        {
                            "text": "float",
                            "code": true
                        },
                        {
                            "text": ", including when the authored range and step contain only whole numbers:"
                        }
                    ]
                },
                {
                    "type": "code",
                    "language": "php",
                    "text": "public float $dose = 5.0;"
                }
            ]
        },
