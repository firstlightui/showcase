                        },
                        {
                            "label": "Purpose",
                            "text": "External EDGE layout for the complete field."
                        }
                    ]
                },
                {
                    "type": "text",
                    "runs": [
                        {
                            "text": "min",
                            "code": true
                        },
                        {
                            "text": " must be less than "
                        },
                        {
                            "text": "max",
                            "code": true
                        },
                        {
                            "text": ". The accepted value must be inside the inclusive bounds, and both the accepted value and range width must lie on the "
                        },
                        {
                            "text": "step",
                            "code": true
                        },
                        {
                            "text": " grid originating at "
                        },
                        {
                            "text": "min",
                            "code": true
                        },
                        {
                            "text": ". Firstlight rejects numeric strings, booleans, null, non-finite values, values outside native Float range, off-grid values, and grids larger than Material's signed 32-bit interval limit. It never clamps or coerces authored props."
                        }
                    ]
                },
                {
                    "type": "text",
                    "runs": [
                        {
                            "text": "Decimal grid membership uses a "
                        },
                        {
                            "text": "1e-9",
                            "code": true
                        },
                        {
                            "text": " epsilon only to tolerate binary floating-point representation noise such as "
                        },
                        {
                            "text": "0.1 + 0.2",
                            "code": true
                        },
                        {
                            "text": ". It does not relax the public step grid."
                        }
                    ]
                }
            ]
        },
        "events-and-synchronisation": {
            "title": "Events and synchronisation",
            "blocks": [
                {
                    "type": "text",
                    "runs": [
                        {
                            "text": "@change",
                            "code": true
                        },
                        {
                            "text": " and "
                        },
                        {
                            "text": "native:model",
                            "code": true
                        },
                        {
                            "text": " deliver one standard PHP float proposal. Slider supports three policies:"
                        }
                    ]
                },
                {
                    "type": "item",
                    "marker": "•",
                    "depth": 0,
                    "runs": [
                        {
                            "text": "native:model",
                            "code": true
                        },
                        {
                            "text": " or "
                        },
                        {
                            "text": "native:model.live",
                            "code": true
                        },
                        {
                            "text": " publishes changed grid values while the gesture moves."
                        }
                    ]
                },
                {
                    "type": "item",
                    "marker": "•",
                    "depth": 0,
                    "runs": [
                        {
                            "text": "native:model.blur",
                            "code": true
                        },
                        {
                            "text": " keeps the draft native and publishes once when the gesture ends."
                        }
                    ]
                },
                {
                    "type": "item",
                    "marker": "•",
                    "depth": 0,
                    "runs": [
                        {
                            "text": "native:model.debounce.300ms",
                            "code": true
                        },
                        {
                            "text": " publishes after the configured quiet period and flushes the final change when the gesture ends. The minimum delay is 50 ms."
                        }
                    ]
                },
                {
                    "type": "text",
                    "text": "There is no parallel input, click, press, or submit event. Programmatic PHP publications emit nothing. A publication is authoritative and replaces the native draft, including when PHP rejects a proposal and keeps the prior value."
                },
                {
                    "type": "text",
                    "runs": [
                        {
                            "text": "Host the control in "
                        },
                        {
                            "text": "FirstlightUI\\NativeComponent",
                            "code": true
                        },
                        {
                            "text": " for the "
                        },
                        {
                            "text": "nonstreaming response-revision contract",
                            "link": 0
                        },
                        {
                            "text": ". It makes an unchanged full response observable to the renderers. Revisions are not per-event acknowledgements, do not prevent coalescing, and do not serialize simultaneous proposals. Wider release qualification remains pending."
                        }
                    ]
                }
            ]
        },
        "accessibility-and-platform-behavior": {
            "title": "Accessibility and platform behavior",
            "blocks": [
                {
                    "type": "text",
                    "runs": [
                        {
                            "text": "Contract exceptions still reject invalid numeric grids before publication. User validation is separate: screens that "
                        },
                        {
                            "text": "use ValidatesFields",
                            "code": true
                        },
                        {
                            "text": " auto-bind the first MessageBag message for the field's "
                        },
                        {
                            "text": "native:model",
                            "code": true
                        },
                        {
                            "text": " or "
                        },
                        {
                            "text": "error-for",
                            "code": true
                        },
                        {
                            "text": " name. An authored "
                        },
                        {
                            "text": "error",
                            "code": true
                        },
                        {
                            "text": " wins. See "
                        },
                        {
                            "text": "Validate fields",
                            "link": 1
                        },
                        {
                            "text": "."
                        }
                    ]
                },
                {
                    "type": "text",
                    "runs": [
                        {
                            "text": "A visible "
                        },
                        {
                            "text": "label",
                            "code": true
                        },
                        {
                            "text": " or explicit "
                        },
                        {
                            "text": "a11y-label",
                            "code": true
                        },
                        {
                            "text": " is required during development. Error text replaces helper text, without replacing the accessible name or current value. "
                        },
                        {
                            "text": "a11y-value",
                            "code": true
                        },
                        {
                            "text": " can add units or domain language; otherwise the native numeric value is announced. Both renderers expose disabled and error semantics and retain native adjustable-slider behavior."
                        }
                    ]
                },
                {
                    "type": "text",
                    "runs": [
                        {
                            "text": "iOS uses a genuine stepped SwiftUI "
                        },
                        {
                            "text": "Slider",
                            "code": true
                        },
                        {
                            "text": ". Android uses a genuine Material 3 "
                        },
                        {
                            "text": "Slider",
                            "code": true
                        },
                        {
                            "text": "; the validated interval count is translated to Material's count of interior steps. Both platforms snap native gesture noise back to the authored grid and send the standard Float slider event."
                        }
                    ]
                },
                {
                    "type": "text",
                    "text": "Slider deliberately has no range mode, vertical orientation, marks, ticks, visible value label, formatter, min/max captions, required metadata, size, variant, or colour/style escape props."
                }
            ]
        },
