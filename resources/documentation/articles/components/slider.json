{
    "id": "components/slider",
    "title": "Slider",
    "description": "Strict numeric grids, native draft synchronisation, accessibility, and paired platform behavior for Firstlight Slider.",
    "group": "Components",
    "anchors": {
        "slider": "overview",
        "complete-example": "complete-example",
        "props": "props",
