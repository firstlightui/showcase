{
    "id": "components/metric",
    "title": "Metric",
    "description": "Display one labelled value and optional detail as a single accessible native element.",
    "group": "Components",
    "anchors": {
        "metric": "overview",
        "props": "props",
        "events-values-and-state": "events-values-and-state",
        "accessibility-and-platforms": "accessibility-and-platforms",
        "validation-and-compatibility": "validation-and-compatibility",
        "screenshot-evidence": "screenshot-evidence"
    },
    "chapters": {
        "overview": {
            "title": "Overview",
            "blocks": [
                {
                    "type": "text",
                    "text": "Metric displays a named statistic, such as an event count or response time. Its label, value and optional detail form one screen-reader element, not three text fragments. It does not draw a tile, panel or grid; use Mobile UI for outer layout."
                },
                {
                    "type": "code",
                    "language": "blade",
                    "text": "<native:column class=\"w-full gap-4\">\n    <firstlight:metric label=\"Events\" value=\"5\" detail=\"last 10h ago\" />\n    <firstlight:metric label=\"Users\" value=\"0\" detail=\"affected\" />\n    <firstlight:metric label=\"Response\" value=\"234 ms\" detail=\"last check\" tone=\"success\" />\n</native:column>"
                }
            ]
        },
        "props": {
            "title": "Props",
            "blocks": [
                {
                    "type": "definition",
                    "term": {
                        "runs": [
                            {
                                "text": "label",
                                "code": true
                            }
                        ]
                    },
                    "items": [
                        {
                            "label": "Contract",
                            "text": "Required nonempty string naming the measurement."
                        }
                    ]
                },
                {
                    "type": "definition",
                    "term": {
                        "runs": [
                            {
                                "text": "value",
                                "code": true
                            }
                        ]
                    },
                    "items": [
                        {
                            "label": "Contract",
                            "runs": [
                                {
                                    "text": "Required nonempty "
                                },
                                {
                                    "text": "string",
                                    "strong": true
                                },
                                {
                                    "text": ", already formatted in PHP. "
                                },
                                {
                                    "text": "\"0\"",
                                    "code": true
                                },
                                {
                                    "text": " is valid."
                                }
                            ]
                        }
                    ]
                },
                {
                    "type": "definition",
                    "term": {
                        "runs": [
                            {
                                "text": "detail",
                                "code": true
                            }
                        ]
                    },
                    "items": [
                        {
                            "label": "Contract",
                            "text": "Optional string; omitted or empty means no supporting line."
                        }
                    ]
                },
                {
                    "type": "definition",
                    "term": {
                        "runs": [
                            {
                                "text": "tone",
                                "code": true
                            }
                        ]
                    },
                    "items": [
                        {
                            "label": "Contract",
                            "runs": [
                                {
                                    "text": "neutral",
                                    "code": true
                                },
                                {
                                    "text": " (default), "
                                },
                                {
                                    "text": "info",
                                    "code": true
                                },
                                {
                                    "text": ", "
                                },
                                {
                                    "text": "success",
                                    "code": true
                                },
                                {
                                    "text": ", "
                                },
                                {
                                    "text": "warning",
                                    "code": true
                                },
                                {
                                    "text": ", or "
                                },
                                {
                                    "text": "danger",
                                    "code": true
                                },
                                {
                                    "text": "; colours the value using semantic theme tokens."
                                }
                            ]
                        }
                    ]
                },
                {
                    "type": "definition",
                    "term": {
                        "runs": [
                            {
                                "text": "a11y-label",
                                "code": true
                            }
                        ]
                    },
                    "items": [
                        {
                            "label": "Contract",
                            "runs": [
                                {
                                    "text": "Optional nonempty name replacing the default "
                                },
                                {
                                    "text": "label: value, detail",
                                    "code": true
                                },
                                {
                                    "text": ". Use it for localized full sentences or pronunciation."
                                }
                            ]
                        }
                    ]
                },
                {
                    "type": "definition",
                    "term": {
                        "runs": [
                            {
                                "text": "a11y-hint",
                                "code": true
                            }
                        ]
                    },
                    "items": [
                        {
                            "label": "Contract",
                            "text": "Optional nonempty supplementary description."
                        }
                    ]
                },
                {
                    "type": "definition",
                    "term": {
                        "runs": [
                            {
                                "text": "class",
                                "code": true
                            }
                        ]
                    },
                    "items": [
                        {
                            "label": "Contract",
                            "text": "External EDGE layout only. Do not impose a fixed height that clips large text."
                        }
                    ]
                },
                {
                    "type": "text",
                    "runs": [
                        {
                            "text": "CamelCase "
                        },
                        {
                            "text": "a11yLabel",
                            "code": true
                        },
                        {
                            "text": " and "
                        },
                        {
                            "text": "a11yHint",
                            "code": true
                        },
                        {
                            "text": " aliases are accepted. Format units, dates, numbers and relative times in the application; Metric does not parse them or run a timer. For bound numeric counts, format explicitly, for example "
                        },
                        {
                            "text": ":value=\"(string) $events\"",
                            "code": true
                        },
                        {
                            "text": "."
                        }
                    ]
                },
                {
                    "type": "text",
                    "runs": [
                        {
                            "text": "Programmatic roots can use "
                        },
                        {
                            "text": "Metric::make('Events', '5')",
                            "code": true
                        },
                        {
                            "text": " from "
                        },
                        {
                            "text": "FirstlightUI\\Elements\\Metric",
                            "code": true
                        },
                        {
                            "text": ". "
                        },
                        {
                            "text": "applyAttributes()",
                            "code": true
                        },
                        {
                            "text": " accepts the same props."
                        }
                    ]
                }
            ]
        },
        "events-values-and-state": {
            "title": "Events, values and state",
            "blocks": [
                {
                    "type": "text",
                    "runs": [
                        {
                            "text": "Metric is static: there is no "
                        },
                        {
                            "text": "native:model",
                            "code": true
                        },
                        {
                            "text": ", "
                        },
                        {
                            "text": "@change",
                            "code": true
                        },
                        {
                            "text": ", "
                        },
                        {
                            "text": "@press",
                            "code": true
                        },
                        {
                            "text": ", selected, disabled, loading or error state. New PHP publications update the text without emitting an event. It accepts no children. Put a labelled Button alongside a metric when an action is needed; it does not make a generic container accessible."
                        }
                    ]
                }
            ]
        },
        "accessibility-and-platforms": {
            "title": "Accessibility and platforms",
            "blocks": [
                {
                    "type": "text",
                    "runs": [
                        {
                            "text": "SwiftUI uses native text styles and monospaced digits. Compose uses Material text styles and tabular figures ("
                        },
                        {
                            "text": "tnum",
                            "code": true
                        },
                        {
                            "text": "). Values wrap at large Dynamic Type/font scales; they are not shrunk or ellipsized. Available width and font glyph support determine line wrapping. The component is a single static accessibility element, with no button role or duplicate child announcements. Android appends the hint to its content description; iOS supplies a separate accessibility hint."
                        }
                    ]
                },
                {
                    "type": "text",
                    "text": "All five tones inherit the application's theme, including package warning tokens. Tone is supplementary; always communicate the measurement in text as well."
                }
            ]
        },
        "validation-and-compatibility": {
            "title": "Validation and compatibility",
            "blocks": [
                {
                    "type": "text",
                    "runs": [
                        {
                            "text": "Missing/blank labels or values, non-string content, unsupported tones, empty explicit accessibility text and interaction/field-state attributes throw "
                        },
                        {
                            "text": "InvalidArgumentException",
                            "code": true
                        },
                        {
                            "text": ". Metric uses the ordinary Firstlight installation and the "
                        },
                        {
                            "text": "supported NativePHP versions",
                            "link": 0
                        },
                        {
                            "text": "."
                        }
                    ]
                }
            ]
        },
