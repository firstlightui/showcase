{
    "id": "components/progress",
    "title": "Progress",
    "description": "Determinate and indeterminate work progress, values, accessibility, validation, adapter behaviour, and platform evidence.",
    "group": "Components",
    "anchors": {
        "progress": "overview",
        "complete-examples": "complete-examples",
        "props": "props",
        "events-and-state-timing": "events-and-state-timing",
        "disabled-loading-and-failure-behaviour": "disabled-loading-and-failure-behaviour",
        "accessibility": "accessibility",
        "platform-behaviour": "platform-behaviour",
        "why-an-adapter": "why-an-adapter",
        "compatibility": "compatibility",
        "screenshots": "screenshots"
    },
    "chapters": {
        "overview": {
            "title": "Overview",
            "blocks": [
                {
                    "type": "text",
                    "text": "Progress communicates the completion of ongoing work. Publish a fraction when completion is measurable, or use indeterminate progress while the duration is unknown."
                },
                {
                    "type": "text",
                    "runs": [
                        {
                            "text": "Firstlight wraps the native progress component from "
                        },
                        {
                            "text": "nativephp/mobile-ui",
                            "code": true
                        },
                        {
                            "text": ". The public "
                        },
                        {
                            "text": "<firstlight:progress>",
                            "code": true
                        },
                        {
                            "text": " API adds strict values, reliable mode defaults, and actionable diagnostics while retaining the official SwiftUI and Material 3 renderers."
                        }
                    ]
                }
            ]
        },
        "complete-examples": {
            "title": "Complete examples",
            "blocks": [
                {
                    "type": "text",
                    "runs": [
                        {
                            "text": "Publish a determinate fraction from "
                        },
                        {
                            "text": "0.0",
                            "code": true
                        },
                        {
                            "text": " through "
                        },
                        {
                            "text": "1.0",
                            "code": true
                        },
                        {
                            "text": ":"
                        }
                    ]
                },
                {
                    "type": "code",
                    "language": "blade",
                    "text": "<firstlight:progress\n    :value=\"$completed / $total\"\n    a11y-label=\"Uploading documents\"\n    class=\"w-full\"\n/>"
                },
                {
                    "type": "text",
                    "text": "Use indeterminate progress when no meaningful fraction is available:"
                },
                {
                    "type": "code",
                    "language": "blade",
                    "text": "<firstlight:progress\n    indeterminate\n    a11y-label=\"Preparing documents\"\n    class=\"w-full\"\n/>"
                },
                {
                    "type": "text",
                    "runs": [
                        {
                            "text": "Omitting "
                        },
                        {
                            "text": "value",
                            "code": true
                        },
                        {
                            "text": " also selects indeterminate progress."
                        }
                    ]
                },
                {
                    "type": "text",
                    "runs": [
                        {
                            "text": "Add "
                        },
                        {
                            "text": "class=\"w-full\"",
                            "code": true
                        },
                        {
                            "text": " to span the container. Without it, Android keeps the Material default track width while iOS fills the available width."
                        }
                    ]
                }
            ]
        },
        "props": {
            "title": "Props",
            "blocks": [
                {
                    "type": "definition",
                    "term": {
                        "runs": [
                            {
                                "text": "value",
                                "code": true
                            }
                        ]
                    },
                    "items": [
                        {
                            "label": "Accepted type",
                            "runs": [
                                {
                                    "text": "finite "
                                },
                                {
                                    "text": "int",
                                    "code": true
                                },
                                {
                                    "text": ", "
                                },
                                {
                                    "text": "float",
                                    "code": true
                                },
                                {
                                    "text": ", or "
                                },
                                {
                                    "text": "null",
                                    "code": true
                                }
                            ]
                        },
                        {
                            "label": "Purpose",
                            "runs": [
                                {
                                    "text": "Published completion fraction from "
                                },
                                {
                                    "text": "0.0",
                                    "code": true
                                },
                                {
                                    "text": " through "
                                },
                                {
                                    "text": "1.0",
                                    "code": true
                                },
                                {
                                    "text": ". A non-null value selects determinate mode."
                                }
                            ]
                        }
                    ]
                },
                {
                    "type": "definition",
                    "term": {
                        "runs": [
                            {
                                "text": "indeterminate",
                                "code": true
                            }
                        ]
                    },
                    "items": [
                        {
                            "label": "Accepted type",
                            "runs": [
                                {
                                    "text": "bool",
                                    "code": true
                                }
                            ]
                        },
                        {
                            "label": "Purpose",
                            "runs": [
                                {
                                    "text": "Explicitly selects or rejects indeterminate mode. Normally inferred from "
                                },
                                {
                                    "text": "value",
                                    "code": true
                                },
                                {
                                    "text": "."
                                }
                            ]
                        }
                    ]
                },
                {
                    "type": "definition",
                    "term": {
                        "runs": [
                            {
                                "text": "a11y-label",
                                "code": true
                            }
                        ]
                    },
                    "items": [
                        {
                            "label": "Accepted type",
                            "runs": [
                                {
                                    "text": "non-empty "
                                },
                                {
                                    "text": "string",
                                    "code": true
                                }
                            ]
                        },
                        {
                            "label": "Purpose",
                            "text": "Required accessible name describing the work."
                        }
                    ]
                },
                {
                    "type": "definition",
                    "term": {
                        "runs": [
                            {
                                "text": "class",
                                "code": true
                            }
                        ]
                    },
                    "items": [
                        {
                            "label": "Accepted type",
                            "runs": [
                                {
                                    "text": "string",
                                    "code": true
                                }
                            ]
                        },
                        {
                            "label": "Purpose",
                            "text": "External EDGE layout utilities."
                        }
                    ]
                },
                {
                    "type": "text",
                    "runs": [
                        {
                            "text": "An integer value is published as a float. "
                        },
                        {
                            "text": "0",
                            "code": true
                        },
                        {
                            "text": " means determinate progress that has not advanced; it is different from an omitted or "
                        },
                        {
                            "text": "null",
                            "code": true
                        },
                        {
                            "text": " value. "
                        },
                        {
                            "text": "1",
                            "code": true
                        },
                        {
                            "text": " means the reported work is complete, but the application decides when to remove the indicator or present its result."
                        }
                    ]
                },
                {
                    "type": "text",
                    "runs": [
                        {
                            "text": "Explicit "
                        },
                        {
                            "text": "indeterminate=\"true\"",
                            "code": true
                        },
                        {
                            "text": " cannot be combined with a non-null "
                        },
                        {
                            "text": "value",
                            "code": true
                        },
                        {
                            "text": ". Explicit "
                        },
                        {
                            "text": "indeterminate=\"false\"",
                            "code": true
                        },
                        {
                            "text": " requires a non-null value."
                        }
                    ]
                }
            ]
        },
        "events-and-state-timing": {
            "title": "Events and state timing",
            "blocks": [
                {
                    "type": "text",
                    "text": "Progress has no event or model binding. PHP publishes the current value or mode through the ordinary Element Tree, and programmatic updates change the native presentation without producing a callback."
                },
                {
                    "type": "text",
                    "text": "Indeterminate animation stays within the native control. Firstlight does not run a timer, publish animation frames, or use a separate bridge."
                }
            ]
        },
        "disabled-loading-and-failure-behaviour": {
            "title": "Disabled, loading, and failure behaviour",
            "blocks": [
                {
                    "type": "text",
                    "runs": [
                        {
                            "text": "Progress already describes loading work, so it has no separate "
                        },
                        {
                            "text": "loading",
                            "code": true
                        },
                        {
                            "text": " state. It is display-only and therefore has no disabled, error, helper, required, selected, or pressed state."
                        }
                    ]
                },
                {
                    "type": "text",
                    "runs": [
                        {
                            "text": "Values must be actual finite PHP integers or floats within "
                        },
                        {
                            "text": "0.0...1.0",
                            "code": true
                        },
                        {
                            "text": ". Numeric strings, booleans, "
                        },
                        {
                            "text": "NaN",
                            "code": true
                        },
                        {
                            "text": ", infinities, negative values, and values above "
                        },
                        {
                            "text": "1.0",
                            "code": true
                        },
                        {
                            "text": " fail instead of being clamped. A missing, empty, or non-string "
                        },
                        {
                            "text": "a11y-label",
                            "code": true
                        },
                        {
                            "text": " also fails."
                        }
                    ]
                },
                {
                    "type": "text",
                    "runs": [
                        {
                            "text": "Firstlight does not expose Mobile UI's arbitrary "
                        },
                        {
                            "text": "color",
                            "code": true
                        },
                        {
                            "text": " or Android-only "
                        },
                        {
                            "text": "track-color",
                            "code": true
                        },
                        {
                            "text": " overrides. It also rejects "
                        },
                        {
                            "text": "label",
                            "code": true
                        },
                        {
                            "text": ", "
                        },
                        {
                            "text": "a11y-hint",
                            "code": true
                        },
                        {
                            "text": ", "
                        },
                        {
                            "text": "tone",
                            "code": true
                        },
                        {
                            "text": ", "
                        },
                        {
                            "text": "variant",
                            "code": true
                        },
                        {
                            "text": ", "
                        },
                        {
                            "text": "size",
                            "code": true
                        },
                        {
                            "text": ", icons, events, and field props. The installed native Progress renderers do not consume "
                        },
                        {
                            "text": "a11y-hint",
                            "code": true
                        },
                        {
                            "text": ", so Firstlight does not pretend that the metadata reaches assistive technology."
                        }
                    ]
                }
            ]
        },
        "accessibility": {
            "title": "Accessibility",
            "blocks": [
                {
                    "type": "text",
                    "runs": [
                        {
                            "text": "Progress has no visible text inside its bounds, so "
                        },
                        {
                            "text": "a11y-label",
                            "code": true
                        },
                        {
                            "text": " is required. VoiceOver and TalkBack combine that name with the native progress role and the system-formatted value for determinate progress. Indeterminate progress communicates ongoing activity without inventing a percentage."
                        }
                    ]
                },
                {
                    "type": "text",
                    "text": "The native controls retain platform contrast, right-to-left behaviour, Increased Contrast, and Reduced Motion or disabled-animation policy. Progress contains no text that needs a custom scaling treatment."
                }
            ]
        },
        "platform-behaviour": {
            "title": "Platform behaviour",
            "blocks": [
                {
                    "type": "text",
                    "runs": [
                        {
                            "text": "iOS uses SwiftUI "
                        },
                        {
                            "text": "ProgressView()",
                            "code": true
                        },
                        {
                            "text": ": the indeterminate initializer for unknown duration and "
                        },
                        {
                            "text": "ProgressView(value:)",
                            "code": true
                        },
                        {
                            "text": " for a published fraction. Android uses the corresponding indeterminate or determinate Material 3 "
                        },
                        {
                            "text": "LinearProgressIndicator",
                            "code": true
                        },
                        {
                            "text": " overload."
                        }
                    ]
                },
                {
                    "type": "text",
                    "text": "Both inherit the host Mobile UI semantic theme. The platforms retain their own geometry and motion; behavioural parity does not require identical pixels."
                }
            ]
        },
        "why-an-adapter": {
            "title": "Why an adapter?",
            "blocks": [
                {
                    "type": "text",
                    "text": "Mobile UI already provides genuine native linear indicators, determinate and indeterminate presentation, semantic theme colours, native animation, and accessible progress values on both platforms. Firstlight therefore keeps its own namespace and strict public contract while delegating rendering rather than duplicating those controls."
                },
                {
                    "type": "text",
                    "runs": [
                        {
                            "text": "The public Element Tree type remains "
                        },
                        {
                            "text": "firstlight.progress",
                            "code": true
                        },
                        {
                            "text": ". Firstlight can move to package-owned renderers later without changing consumer markup if a durable cross-platform requirement genuinely outgrows the official primitive."
                        }
                    ]
                }
            ]
        },
        "compatibility": {
            "title": "Compatibility",
            "blocks": [
                {
                    "type": "text",
                    "runs": [
                        {
                            "text": "Progress supports the versions in the current "
                        },
                        {
                            "text": "compatibility reference",
                            "link": 0
                        },
                        {
                            "text": ". The host application must compile the installed "
                        },
                        {
                            "text": "nativephp/mobile-ui",
                            "code": true
                        },
                        {
                            "text": " iOS and Android progress renderers declared by the Firstlight adapter."
                        }
                    ]
                }
            ]
        },
