    "chapters": {
        "overview": {
            "title": "Overview",
            "blocks": [
                {
                    "type": "text",
                    "text": "Tabs switches between sections of the same object within one screen, such as a server's Overview, Sites, Deployments, and Manage. Tabs draws only the selector; your component renders the active section, so inactive sections do no work until someone selects them."
                },
                {
                    "type": "text",
                    "runs": [
                        {
                            "text": "Use "
                        },
                        {
                            "text": "Segmented",
                            "link": 0
                        },
                        {
                            "text": " to choose a value or filter for the content already on screen. Use Tabs to choose which content is on screen."
                        }
                    ]
                }
            ]
        },
        "complete-example": {
            "title": "Complete example",
            "blocks": [
                {
                    "type": "code",
                    "language": "php",
                    "text": "public string $tab = 'overview';\n\npublic int $failedDeployments = 2;\n\npublic function render(): View\n{\n    return view('native.server', [\n        'sections' => [\n            ['value' => 'overview', 'label' => 'Overview'],\n            ['value' => 'sites', 'label' => 'Sites'],\n            [\n                'value' => 'deploys',\n                'label' => 'Deployments',\n                'badge' => $this->failedDeployments,\n                'badge-a11y-label' => \"{$this->failedDeployments} failed\",\n            ],\n            ['value' => 'manage', 'label' => 'Manage'],\n        ],\n    ]);\n}"
                },
                {
                    "type": "code",
                    "language": "blade",
                    "text": "<firstlight:tabs native:model=\"tab\" :tabs=\"$sections\" label=\"Server sections\" />\n\n@if ($tab === 'overview')\n    {{-- Overview rows --}}\n@elseif ($tab === 'sites')\n    {{-- Sites list --}}\n@elseif ($tab === 'deploys')\n    {{-- Deployments list --}}\n@else\n    {{-- Manage rows --}}\n@endif"
                },
                {
                    "type": "text",
                    "text": "A value-to-label map is enough when no tab needs a badge or availability:"
                },
                {
                    "type": "code",
                    "language": "blade",
                    "text": "<firstlight:tabs\n    native:model=\"tab\"\n    :tabs=\"['overview' => 'Overview', 'sites' => 'Sites', 'deploys' => 'Deployments', 'manage' => 'Manage']\"\n    label=\"Server sections\"\n/>"
                }
            ]
        },
