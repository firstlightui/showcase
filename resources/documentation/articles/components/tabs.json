        "events": {
            "title": "Events",
            "blocks": [
                {
                    "type": "text",
                    "runs": [
                        {
                            "text": "@change",
                            "code": true
                        },
                        {
                            "text": " receives the selected tab's stable value. "
                        },
                        {
                            "text": "native:model",
                            "code": true
                        },
                        {
                            "text": " normally generates this callback. Tapping the selected tab or a disabled tab emits nothing."
                        }
                    ]
                }
            ]
        },
        "state-timing": {
            "title": "State timing",
            "blocks": [
                {
                    "type": "text",
                    "runs": [
                        {
                            "text": "Tabs is "
                        },
                        {
                            "text": "server-authoritative",
                            "link": 1
                        },
                        {
                            "text": ". A tap emits immediately, but the selection moves only when PHP publishes the new value. To reject a change, bind "
                        },
                        {
                            "text": ":value",
                            "code": true
                        },
                        {
                            "text": " and decide in your handler:"
                        }
                    ]
                },
                {
                    "type": "code",
                    "language": "blade",
                    "text": "<firstlight:tabs :value=\"$tab\" @change=\"selectTab\" :tabs=\"$sections\" label=\"Server sections\" />"
                },
                {
                    "type": "code",
                    "language": "php",
                    "text": "public function selectTab(string $tab): void\n{\n    if ($tab === 'manage' && ! $this->canManage) {\n        return; // Overview stays selected.\n    }\n\n    $this->tab = $tab;\n}"
                },
                {
                    "type": "text",
                    "runs": [
                        {
                            "text": "Changing "
                        },
                        {
                            "text": "$tab",
                            "code": true
                        },
                        {
                            "text": " from PHP, including in "
                        },
                        {
                            "text": "mount()",
                            "code": true
                        },
                        {
                            "text": ", selects that tab without emitting "
                        },
                        {
                            "text": "@change",
                            "code": true
                        },
                        {
                            "text": ". Use plain "
                        },
                        {
                            "text": "native:model",
                            "code": true
                        },
                        {
                            "text": " or "
                        },
                        {
                            "text": "native:model.live",
                            "code": true
                        },
                        {
                            "text": "; deferred "
                        },
                        {
                            "text": "blur",
                            "code": true
                        },
                        {
                            "text": " and "
                        },
                        {
                            "text": "debounce",
                            "code": true
                        },
                        {
                            "text": " modes are rejected."
                        }
                    ]
                }
            ]
        },
        "open-a-specific-tab": {
            "title": "Open a specific tab",
            "blocks": [
                {
                    "type": "text",
                    "text": "NativePHP hydrates public properties from matching route parameters, so an optional route segment can open a tab directly, for example from a notification:"
                },
                {
                    "type": "code",
                    "language": "php",
                    "text": "Route::native('/servers/{server}/{tab?}', ServerScreen::class);"
                },
                {
                    "type": "code",
                    "language": "php",
                    "text": "public string $tab = 'overview';\n\npublic function mount(): void\n{\n    if (! in_array($this->tab, ['overview', 'sites', 'deploys', 'manage'], true)) {\n        $this->tab = 'overview';\n    }\n}"
                },
                {
                    "type": "text",
                    "runs": [
                        {
                            "text": "The NativePHP router passes route parameters, not query strings, so use "
                        },
                        {
                            "text": "/servers/12/deploys",
                            "code": true
                        },
                        {
                            "text": " rather than "
                        },
                        {
                            "text": "/servers/12?tab=deploys",
                            "code": true
                        },
                        {
                            "text": "."
                        }
                    ]
                }
            ]
        },
        "tabs-and-values": {
            "title": "Tabs and values",
            "blocks": [
                {
                    "type": "text",
                    "text": "A tab group has two to five tabs. Keep each hub to five sections and move anything else into rows on a Manage tab. An empty collection renders an inert disabled control, so a permission-filtered list never fails at runtime; one tab or more than five tabs fail with guidance."
                },
                {
                    "type": "text",
                    "runs": [
                        {
                            "text": "Values are non-empty strings and must be unique. PHP turns numeric-string array keys such as "
                        },
                        {
                            "text": "'1'",
                            "code": true
                        },
                        {
                            "text": " into integers, so integer values are rejected: use words such as "
                        },
                        {
                            "text": "'overview'",
                            "code": true
                        },
                        {
                            "text": ". A selected value that is not in "
                        },
                        {
                            "text": "tabs",
                            "code": true
                        },
                        {
                            "text": " leaves every tab unselected; Tabs never selects the first tab for you."
                        }
                    ]
                },
                {
                    "type": "text",
                    "text": "Per-tab icons are not supported yet. A native iOS segment shows a title or an image but not both, so Firstlight defers icons rather than ship them on one platform."
                }
            ]
        },
        "disabled-behaviour": {
            "title": "Disabled behaviour",
            "blocks": [
                {
                    "type": "text",
                    "runs": [
                        {
                            "text": "disabled",
                            "code": true
                        },
                        {
                            "text": " prevents every tab from emitting. A rich tab's "
                        },
                        {
                            "text": "disabled: true",
                            "code": true
                        },
                        {
                            "text": " prevents only that tab from emitting and dims it."
                        }
                    ]
                }
            ]
        },
        "accessibility": {
            "title": "Accessibility",
            "blocks": [
                {
                    "type": "text",
                    "runs": [
                        {
                            "text": "Provide "
                        },
                        {
                            "text": "label",
                            "code": true
                        },
                        {
                            "text": " or "
                        },
                        {
                            "text": "a11y-label",
                            "code": true
                        },
                        {
                            "text": "; Firstlight warns during development when both are blank. VoiceOver and TalkBack announce each tab with its label and badge text, its tab role, its selected or disabled state, and its position, such as \"Tab 2 of 4\". Selection is shown by the native indicator or segment fill, not by colour alone, and every tab meets the platform minimum target of 44 points on iOS and 48 dp on Android."
                        }
                    ]
                }
            ]
        },
        "validation-and-failure-behaviour": {
            "title": "Validation and failure behaviour",
            "blocks": [
                {
                    "type": "text",
                    "runs": [
                        {
                            "text": "Tabs fails before publication when "
                        },
                        {
                            "text": "tabs",
                            "code": true
                        },
                        {
                            "text": " is not an array, has one or more than five entries, has blank labels, duplicate or non-string values, unknown rich fields, a non-integer or negative "
                        },
                        {
                            "text": "badge",
                            "code": true
                        },
                        {
                            "text": ", a non-boolean "
                        },
                        {
                            "text": "disabled",
                            "code": true
                        },
                        {
                            "text": ", or icon fields. It also rejects "
                        },
                        {
                            "text": "options",
                            "code": true
                        },
                        {
                            "text": ", "
                        },
                        {
                            "text": "helper",
                            "code": true
                        },
                        {
                            "text": ", "
                        },
                        {
                            "text": "error",
                            "code": true
                        },
                        {
                            "text": ", "
                        },
                        {
                            "text": "required",
                            "code": true
                        },
                        {
                            "text": ", "
                        },
                        {
                            "text": "multiple",
                            "code": true
                        },
                        {
                            "text": ", "
                        },
                        {
                            "text": "icon",
                            "code": true
                        },
                        {
                            "text": ", "
                        },
                        {
                            "text": "variant",
                            "code": true
                        },
                        {
                            "text": ", and "
                        },
                        {
                            "text": "scrollable",
                            "code": true
                        },
                        {
                            "text": " because they do not belong to tab navigation, and a non-string selected value."
                        }
                    ]
                }
            ]
        },
        "platform-behaviour": {
            "title": "Platform behaviour",
            "blocks": [
                {
                    "type": "text",
                    "runs": [
                        {
                            "text": "iOS uses a native "
                        },
                        {
                            "text": "UISegmentedControl",
                            "code": true
                        },
                        {
                            "text": ". Place Tabs full width directly under the navigation bar: iOS insets the segmented control by the system margin, while the Android tab row spans the width. Segments size to their labels, and a visible count follows the label, such as "
                        },
                        {
                            "text": "Deployments (2)",
                            "code": true
                        },
                        {
                            "text": ". VoiceOver receives the group as a tab bar with one selectable tab per segment. Like Segmented, segment titles stop growing at accessibility text sizes and may truncate; VoiceOver still reads each full name."
                        }
                    ]
                },
                {
                    "type": "text",
                    "runs": [
                        {
                            "text": "Android uses Material 3 "
                        },
                        {
                            "text": "PrimaryTabRow",
                            "code": true
                        },
                        {
                            "text": " with its moving indicator and a Material 3 "
                        },
                        {
                            "text": "Badge",
                            "code": true
                        },
                        {
                            "text": " after the label. When a label does not fit its equal share of the width on one line, including at large font scales, the row switches to Material's "
                        },
                        {
                            "text": "PrimaryScrollableTabRow",
                            "code": true
                        },
                        {
                            "text": ", as "
                        },
                        {
                            "text": "TabLayout",
                            "code": true
                        },
                        {
                            "text": " does in its automatic mode."
                        }
                    ]
                },
                {
                    "type": "text",
                    "text": "Tabs does not pin itself under the top bar or animate between sections. Swiping between sections is not supported."
                }
            ]
        },
        "compatibility": {
            "title": "Compatibility",
            "blocks": [
                {
                    "type": "text",
                    "runs": [
