        "overview": {
            "title": "Overview",
            "blocks": [
                {
                    "type": "text",
                    "text": "Text Field enters and edits one line of text using the native field, keyboard, autofill, selection, and accessibility behaviour of each platform."
                }
            ]
        },
        "complete-example": {
            "title": "Complete example",
            "blocks": [
                {
                    "type": "code",
                    "language": "blade",
                    "text": "<firstlight:text-field\n    label=\"Email\"\n    placeholder=\"you@example.com\"\n    helper=\"Used for appointment updates.\"\n    keyboard=\"email\"\n    content-type=\"email\"\n    autocapitalize=\"none\"\n    :autocorrect=\"false\"\n    clearable\n    native:model.blur=\"email\"\n/>"
                }
