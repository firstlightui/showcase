        "events-and-synchronisation": {
            "title": "Events and synchronisation",
            "blocks": [
                {
                    "type": "text",
                    "runs": [
                        {
                            "text": "@change",
                            "code": true
                        },
                        {
                            "text": " receives the current string. "
                        },
                        {
                            "text": "@submit",
                            "code": true
                        },
                        {
                            "text": " flushes any pending change, then receives the same current string. An authored interactive trailing icon uses standard "
                        },
                        {
                            "text": "@press",
                            "code": true
                        },
                        {
                            "text": " and receives no text argument."
                        }
                    ]
                },
                {
                    "type": "text",
                    "runs": [
                        {
                            "text": "Plain "
                        },
                        {
                            "text": "native:model",
                            "code": true
                        },
                        {
                            "text": " and "
                        },
                        {
                            "text": ".live",
                            "code": true
                        },
                        {
                            "text": " publish while editing. "
                        },
                        {
                            "text": ".blur",
                            "code": true
                        },
                        {
                            "text": " and "
                        },
                        {
                            "text": ".lazy",
                            "code": true
                        },
                        {
                            "text": " publish on focus loss or submit. "
                        },
                        {
                            "text": ".debounce.500ms",
                            "code": true
                        },
                        {
                            "text": " publishes after the quiet period and flushes on blur or submit; durations below 50 ms are rejected. Native typing, selection, cursor position, and marked-text composition remain local while focused so PHP acknowledgements do not cause keyboard jumps."
                        }
                    ]
                },
                {
                    "type": "text",
                    "runs": [
                        {
                            "text": "On iOS, pressing a "
                        },
                        {
                            "text": "<firstlight:button>",
                            "code": true
                        },
                        {
                            "text": " while the field is focused publishes its pending "
                        },
                        {
                            "text": ".blur",
                            "code": true
                        },
                        {
                            "text": " or "
                        },
                        {
                            "text": ".debounce",
                            "code": true
                        },
                        {
                            "text": " change before the press, so the handler reads the current value. Icon Button and List Item presses do not flush the field first. On Android, blur/debounce changes are not yet guaranteed to reach PHP before a button press, so for forms submitted by a separate button use "
                        },
                        {
                            "text": "native:model.live=\"email\"",
                            "code": true
                        },
                        {
                            "text": " (or plain "
                        },
                        {
                            "text": "native:model",
                            "code": true
                        },
                        {
                            "text": "). A button press is not the field's "
                        },
                        {
                            "text": "@submit",
                            "code": true
                        },
                        {
                            "text": " event; for keyboard submission, the field's own "
                        },
                        {
                            "text": "@submit",
                            "code": true
                        },
                        {
                            "text": " handler receives the current string directly."
                        }
                    ]
                }
            ]
        },
        "icons-and-trailing-actions": {
            "title": "Icons and trailing actions",
            "blocks": [
                {
                    "type": "text",
                    "runs": [
                        {
                            "text": "The shared icon is the fallback; the active platform override wins. Blade uses the exact "
                        },
                        {
                            "text": "-ios",
                            "code": true
                        },
                        {
                            "text": " and "
                        },
                        {
                            "text": "-android",
                            "code": true
                        },
                        {
                            "text": " suffixes above, and typed Android symbols retain their filled or outlined variant on the wire. Decorative icons are silent."
                        }
                    ]
                },
                {
                    "type": "text",
                    "runs": [
                        {
                            "text": "An authored trailing action requires all of "
                        },
                        {
                            "text": "trailing-icon",
                            "code": true
                        },
                        {
                            "text": ", "
                        },
                        {
                            "text": "trailing-a11y-label",
                            "code": true
                        },
                        {
                            "text": ", and "
                        },
                        {
                            "text": "@press",
                            "code": true
                        },
                        {
                            "text": ". "
                        },
                        {
                            "text": "clearable",
                            "code": true
                        },
                        {
                            "text": " and "
                        },
                        {
                            "text": "revealable",
                            "code": true
                        },
                        {
                            "text": " instead own their platform-native icon and localized accessibility state. These semantic actions are mutually exclusive and cannot share the trailing slot with an authored action."
                        }
                    ]
                },
                {
                    "type": "text",
                    "runs": [
                        {
                            "text": "Clearing retains focus and immediately publishes "
                        },
                        {
                            "text": "''",
                            "code": true
                        },
                        {
                            "text": " through "
                        },
                        {
                            "text": "@change",
                            "code": true
                        },
                        {
                            "text": ", even under blur or debounce sync. Revealing changes presentation only and never publishes the password value."
                        }
                    ]
                }
            ]
        },
        "validation-and-accessibility": {
            "title": "Validation and accessibility",
            "blocks": [
                {
                    "type": "text",
                    "runs": [
                        {
                            "text": "Contract exceptions still reject invalid types, unsupported enums, incomplete trailing actions, and conflicting affordances before publication. User validation is separate: screens that "
                        },
                        {
                            "text": "use ValidatesFields",
                            "code": true
                        },
                        {
                            "text": " auto-bind the first MessageBag message for the field's "
                        },
