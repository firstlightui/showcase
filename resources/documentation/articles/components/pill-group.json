{
    "id": "components/pill-group",
    "title": "Pill Group",
    "description": "Public API, selection modes, state timing, accessibility, validation, and platform behaviour for Firstlight Pill Group.",
    "group": "Components",
    "anchors": {
        "pill-group": "overview",
        "complete-examples": "complete-examples",
        "scrolling-filter-row": "complete-examples",
        "props": "props",
        "options-and-values": "options-and-values",
        "events-and-state-timing": "events-and-state-timing",
        "disabled-and-required-behaviour": "disabled-and-required-behaviour",
        "accessibility": "accessibility",
        "validation-and-failure-behaviour": "validation-and-failure-behaviour",
        "platform-behaviour": "platform-behaviour",
        "compatibility": "compatibility",
        "screenshots": "screenshots"
    },
    "chapters": {
        "overview": {
            "title": "Overview",
            "blocks": [
                {
                    "type": "text",
                    "text": "Pill Group presents compact, individually shaped options for selecting zero or one value, or zero or more values. It can also be a scrolling filter row in which each option has an icon and only the selected pill shows its label."
                }
            ]
        },
        "complete-examples": {
            "title": "Complete examples",
            "blocks": [
                {
                    "type": "text",
                    "text": "Single selection is the default:"
                },
                {
                    "type": "code",
                    "language": "php",
                    "text": "public ?string $queue = 'mine';\n\npublic array $queueOptions = [\n    ['value' => 'mine', 'label' => 'Mine'],\n    ['value' => 'all', 'label' => 'All'],\n    ['value' => 'archived', 'label' => 'Archived', 'disabled' => true],\n];"
                },
                {
                    "type": "code",
                    "language": "blade",
                    "text": "<firstlight:pill-group\n    :options=\"$queueOptions\"\n    native:model=\"queue\"\n    label=\"Queue\"\n    helper=\"Choose the queue to include.\"\n/>"
                },
                {
                    "type": "heading",
                    "text": "Scrolling filter row"
                },
                {
                    "type": "text",
                    "runs": [
                        {
                            "text": "Give each option an icon, then add "
                        },
                        {
                            "text": "scrollable",
                            "code": true
                        },
                        {
                            "text": " and "
                        },
                        {
                            "text": "collapse-labels",
                            "code": true
                        },
                        {
                            "text": ". Unselected pills show only their icon; the selected pill shows its icon and label in the colour set by "
                        },
                        {
                            "text": "tone",
                            "code": true
                        },
                        {
                            "text": "."
                        }
                    ]
                },
                {
                    "type": "code",
                    "language": "php",
                    "text": "public ?string $filter = 'all';\n\npublic array $filterOptions = [\n    ['value' => 'all', 'label' => 'All', 'icon' => 'inbox'],\n    ['value' => 'unread', 'label' => 'Unread', 'icon' => 'mail'],\n    ['value' => 'starred', 'label' => 'Starred', 'icon' => 'star', 'icon-ios' => 'star.fill'],\n    ['value' => 'attachments', 'label' => 'Attachments', 'icon' => 'attach_file', 'icon-ios' => 'paperclip'],\n];"
                },
                {
                    "type": "code",
                    "language": "blade",
                    "text": "<firstlight:pill-group\n    :options=\"$filterOptions\"\n    native:model=\"filter\"\n    a11y-label=\"Filter\"\n    scrollable\n    collapse-labels\n    tone=\"success\"\n/>"
                },
                {
                    "type": "text",
                    "runs": [
                        {
                            "text": "Use "
                        },
                        {
                            "text": "multiple",
                            "code": true
                        },
                        {
                            "text": " with an array-valued property:"
                        }
                    ]
                },
                {
                    "type": "code",
                    "language": "php",
                    "text": "public array $queues = ['mine'];"
                },
                {
                    "type": "code",
                    "language": "blade",
                    "text": "<firstlight:pill-group\n    :options=\"$queueOptions\"\n    native:model=\"queues\"\n    label=\"Queues\"\n    helper=\"Choose any that apply.\"\n    multiple\n/>"
                }
            ]
        },
