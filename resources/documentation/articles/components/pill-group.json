        "options-and-values": {
            "title": "Options and values",
            "blocks": [
                {
                    "type": "text",
                    "text": "Simple strings use the same value and label:"
                },
                {
                    "type": "code",
                    "language": "php",
                    "text": "['Mine', 'All']"
                },
                {
                    "type": "text",
                    "text": "A map separates stable values from labels and may use all-string or all-integer keys:"
                },
                {
                    "type": "code",
                    "language": "php",
                    "text": "['mine' => 'Mine', 'all' => 'All']"
                },
                {
                    "type": "text",
                    "runs": [
                        {
                            "text": "Rich options accept "
                        },
                        {
                            "text": "value",
                            "code": true
                        },
                        {
                            "text": ", "
                        },
                        {
                            "text": "label",
                            "code": true
                        },
                        {
                            "text": ", and optional "
                        },
                        {
                            "text": "disabled",
                            "code": true
                        },
                        {
                            "text": ", "
                        },
                        {
                            "text": "icon",
                            "code": true
                        },
                        {
                            "text": ", "
                        },
                        {
                            "text": "icon-ios",
                            "code": true
                        },
                        {
                            "text": ", and "
                        },
                        {
                            "text": "icon-android",
                            "code": true
                        },
                        {
                            "text": " fields:"
                        }
                    ]
                },
                {
                    "type": "code",
                    "language": "php",
                    "text": "[\n    ['value' => 'mine', 'label' => 'Mine', 'icon' => 'person'],\n    ['value' => 'all', 'label' => 'All', 'icon' => 'groups', 'icon-ios' => 'person.3', 'disabled' => true],\n]"
                },
                {
                    "type": "text",
                    "runs": [
                        {
                            "text": "icon",
                            "code": true
                        },
                        {
                            "text": " is the shared fallback; "
                        },
                        {
                            "text": "icon-ios",
                            "code": true
                        },
                        {
                            "text": " and "
                        },
                        {
                            "text": "icon-android",
                            "code": true
                        },
                        {
                            "text": " override it per platform and also accept NativePHP "
                        },
                        {
                            "text": "IosSymbol",
                            "code": true
                        },
                        {
                            "text": " and "
                        },
                        {
                            "text": "AndroidSymbol",
                            "code": true
                        },
                        {
                            "text": " values. Option icons are decorative: VoiceOver and TalkBack announce the option label instead. Icons are set per option; "
                        },
                        {
                            "text": "icon",
                            "code": true
                        },
                        {
                            "text": " on the group itself is rejected."
                        }
                    ]
                },
                {
                    "type": "text",
                    "runs": [
                        {
                            "text": "All values in one group must be unique and must all be strings or all be integers. In single mode, tapping the selected pill proposes "
                        },
                        {
                            "text": "null",
                            "code": true
                        },
                        {
                            "text": ". In multiple mode, tapping toggles that stable value while preserving the order of the others. "
                        },
                        {
                            "text": "null",
                            "code": true
                        },
                        {
                            "text": " and "
                        },
                        {
                            "text": "[]",
                            "code": true
                        },
                        {
                            "text": " both mean no multiple selection."
                        }
                    ]
                }
            ]
        },
        "events-and-state-timing": {
            "title": "Events and state timing",
            "blocks": [
                {
                    "type": "text",
                    "runs": [
                        {
                            "text": "@change",
                            "code": true
                        },
                        {
                            "text": " receives the complete proposed selection: a scalar or "
                        },
                        {
                            "text": "null",
                            "code": true
                        },
                        {
                            "text": " in single mode and a list in multiple mode. "
                        },
                        {
                            "text": "native:model",
                            "code": true
                        },
                        {
                            "text": " normally generates this callback for property synchronisation."
                        }
                    ]
                },
                {
                    "type": "text",
                    "runs": [
                        {
                            "text": "Pill Group is "
                        },
                        {
                            "text": "server-authoritative",
                            "link": 0
                        },
                        {
                            "text": ". A tap emits immediately, but selected visuals wait for PHP's next publication. Further taps are ignored while that proposal is in flight so a rapid second tap cannot be calculated from stale state. Programmatic updates and reconciliation do not emit."
                        }
                    ]
                },
                {
                    "type": "text",
                    "runs": [
                        {
                            "text": "Use plain "
                        },
                        {
                            "text": "native:model",
                            "code": true
                        },
                        {
                            "text": " or "
                        },
                        {
                            "text": "native:model.live",
                            "code": true
                        },
                        {
                            "text": "; deferred "
                        },
                        {
                            "text": "blur",
                            "code": true
                        },
                        {
                            "text": " and "
                        },
                        {
                            "text": "debounce",
                            "code": true
                        },
                        {
                            "text": " modes are rejected."
                        }
                    ]
                }
            ]
        },
        "disabled-and-required-behaviour": {
            "title": "Disabled and required behaviour",
            "blocks": [
                {
                    "type": "text",
                    "runs": [
                        {
                            "text": "disabled",
                            "code": true
                        },
                        {
                            "text": " prevents every pill from emitting. A rich option's "
                        },
                        {
                            "text": "disabled: true",
                            "code": true
                        },
                        {
                            "text": " affects only that pill. An empty option set becomes an inert disabled group."
                        }
                    ]
                },
                {
                    "type": "text",
                    "runs": [
                        {
                            "text": "required",
                            "code": true
                        },
                        {
                            "text": " is metadata rather than client-side enforcement. It does not prevent clearing the final pill; validate the resulting value in PHP and publish "
                        },
                        {
                            "text": "error",
                            "code": true
                        },
                        {
                            "text": " when needed."
                        }
                    ]
                }
            ]
        },
        "accessibility": {
            "title": "Accessibility",
            "blocks": [
                {
                    "type": "text",
                    "runs": [
                        {
                            "text": "Provide either a visible "
                        },
                        {
                            "text": "label",
                            "code": true
                        },
                        {
                            "text": " or an explicit "
                        },
                        {
                            "text": "a11y-label",
                            "code": true
                        },
                        {
                            "text": ". Firstlight warns during development when both are blank. Each pill exposes its label, selected state, and disabled state through native platform semantics. Selection also has a visible checkmark, or with "
                        },
                        {
                            "text": "collapse-labels",
                            "code": true
                        },
                        {
                            "text": " a revealed label, so it does not depend on colour alone. Icon-only pills are announced by their option label. Pills wrap at larger text sizes, or scroll when "
                        },
                        {
                            "text": "scrollable",
                            "code": true
                        },
                        {
                            "text": ", and retain at least a 44-point iOS or 48-dp Android interaction target. The label reveal animation is removed when Reduce Motion or system animations are turned off."
                        }
                    ]
                },
                {
                    "type": "text",
                    "text": "Collapsed labels hide meaning until a pill is selected, so use them for short sets with recognisable icons."
                }
            ]
        },
        "validation-and-failure-behaviour": {
            "title": "Validation and failure behaviour",
            "blocks": [
                {
                    "type": "text",
                    "runs": [
                        {
                            "text": "Contract exceptions still reject malformed options, mixed selections, an unsupported "
                        },
                        {
                            "text": "tone",
                            "code": true
                        },
                        {
                            "text": ", blank or invalid option icons, "
                        },
                        {
                            "text": "collapse-labels",
                            "code": true
                        },
                        {
                            "text": " without an icon on every option, and unsupported presentation props before publication. User validation is separate: screens that "
                        },
                        {
                            "text": "use ValidatesFields",
                            "code": true
                        },
                        {
                            "text": " auto-bind the first MessageBag message for the field's "
                        },
                        {
                            "text": "native:model",
                            "code": true
                        },
                        {
                            "text": " or "
                        },
                        {
                            "text": "error-for",
                            "code": true
                        },
                        {
                            "text": " name. An authored "
                        },
                        {
                            "text": "error",
                            "code": true
                        },
                        {
                            "text": " wins. "
                        },
                        {
                            "text": "required",
                            "code": true
                        },
                        {
                            "text": " is display metadata and does not run Laravel rules. See "
                        },
                        {
                            "text": "Validate fields",
                            "link": 1
                        },
                        {
                            "text": ". A same-typed selected value absent from "
                        },
                        {
                            "text": "options",
                            "code": true
                        },
                        {
                            "text": " remains unselected rather than selecting a fallback."
                        }
                    ]
                }
            ]
        },
        "platform-behaviour": {
            "title": "Platform behaviour",
            "blocks": [
                {
                    "type": "text",
                    "runs": [
                        {
                            "text": "iOS uses native SwiftUI capsule buttons in a wrapping layout or a horizontal "
                        },
                        {
                            "text": "ScrollView",
                            "code": true
                        },
                        {
                            "text": ". Android uses Material 3 "
                        },
                        {
                            "text": "FilterChip",
                            "code": true
                        },
                        {
                            "text": " controls in a wrapping "
                        },
                        {
                            "text": "FlowRow",
                            "code": true
                        },
                        {
                            "text": " or a horizontally scrolling row. Both inherit NativePHP semantic theme tokens and preserve native press, focus, selection, disabled, and accessibility behaviour without exposing platform-widget props."
                        }
                    ]
                }
            ]
        },
        "compatibility": {
            "title": "Compatibility",
            "blocks": [
                {
                    "type": "text",
                    "runs": [
                        {
                            "text": "Pill Group supports the versions listed in the current "
                        },
                        {
                            "text": "compatibility reference",
                            "link": 2
                        },
                        {
                            "text": " and requires both native renderers to be compiled into the host application."
                        }
                    ]
                }
            ]
        },
        "screenshots": {
