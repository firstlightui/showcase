        },
        "events": {
            "title": "Events",
            "blocks": [
                {
                    "type": "text",
                    "runs": [
                        {
                            "text": "@change",
                            "code": true
                        },
                        {
                            "text": " receives the proposed boolean value. Use it when the server decides whether to accept a change:"
                        }
                    ]
                },
                {
                    "type": "code",
                    "language": "php",
                    "text": "public bool $notifications = false;\n\npublic function updateNotifications(bool $value): void\n{\n    $this->notifications = $value;\n}"
                },
                {
                    "type": "code",
                    "language": "blade",
                    "text": "<firstlight:switch\n    :value=\"$notifications\"\n    @change=\"updateNotifications\"\n    label=\"Notifications\"\n/>"
                },
                {
                    "type": "text",
                    "runs": [
                        {
                            "text": "native:model",
                            "code": true
                        },
                        {
                            "text": " normally supplies the same callback for property synchronisation."
                        }
                    ]
                }
            ]
        },
        "accepted-values": {
            "title": "Accepted values",
            "blocks": [
                {
                    "type": "text",
                    "runs": [
                        {
                            "text": "Switch accepts only strict PHP booleans: "
                        },
                        {
                            "text": "true",
                            "code": true
                        },
                        {
                            "text": " and "
                        },
                        {
                            "text": "false",
                            "code": true
                        },
                        {
                            "text": ". Bind a literal Boolean with "
                        },
                        {
                            "text": ":",
                            "code": true
                        },
                        {
                            "text": ":"
                        }
                    ]
                },
                {
                    "type": "code",
                    "language": "blade",
                    "text": "<firstlight:switch :value=\"false\" label=\"Notifications\" />"
                },
                {
                    "type": "text",
                    "runs": [
                        {
                            "text": "value=\"false\"",
                            "code": true
                        },
                        {
                            "text": " is invalid because Blade passes it as a string. "
                        },
                        {
                            "text": "null",
                            "code": true
                        },
                        {
                            "text": ", integers, string booleans, arrays, and objects are also rejected."
                        }
                    ]
                }
            ]
        },
        "state-timing": {
            "title": "State timing",
            "blocks": [
                {
                    "type": "text",
                    "runs": [
                        {
                            "text": "Host the control in "
                        },
                        {
                            "text": "FirstlightUI\\NativeComponent",
                            "code": true
                        },
                        {
                            "text": " so unchanged full responses receive the "
                        },
                        {
                            "text": "response revision",
                            "link": 0
                        },
                        {
                            "text": "."
                        }
                    ]
                },
                {
                    "type": "text",
                    "runs": [
                        {
                            "text": "Switch is "
                        },
                        {
                            "text": "server-authoritative",
                            "link": 1
                        },
                        {
                            "text": ". A native interaction immediately emits its proposed Boolean, but the visible on/off state remains the last value published by PHP. A response that accepts the proposal changes the visible state; a response that rejects it leaves the visible state unchanged. Every server publication clears a pending proposal, including one that republishes the same value. Programmatic publications update the accepted state without emitting "
                        },
                        {
                            "text": "@change",
                            "code": true
                        },
                        {
                            "text": "."
                        }
                    ]
                },
                {
                    "type": "text",
                    "runs": [
                        {
                            "text": "Use "
                        },
                        {
                            "text": "native:model",
                            "code": true
                        },
                        {
                            "text": " or "
                        },
                        {
                            "text": "native:model.live",
                            "code": true
                        },
                        {
                            "text": ". Deferred "
                        },
                        {
                            "text": "blur",
                            "code": true
                        },
                        {
                            "text": ", "
                        },
                        {
                            "text": "lazy",
                            "code": true
                        },
                        {
                            "text": ", and "
                        },
                        {
                            "text": "debounce",
                            "code": true
                        },
                        {
                            "text": " sync modes are rejected."
                        }
                    ]
                }
            ]
        },
        "disabled-behaviour": {
            "title": "Disabled behaviour",
            "blocks": [
                {
                    "type": "text",
                    "runs": [
                        {
                            "text": "When "
                        },
                        {
                            "text": "disabled",
                            "code": true
                        },
                        {
                            "text": " is "
                        },
                        {
                            "text": "true",
                            "code": true
                        },
                        {
                            "text": ", Switch stays visible with its accepted on/off state and cannot emit a proposal or "
                        },
                        {
                            "text": "@change",
                            "code": true
                        },
                        {
                            "text": " event."
                        }
                    ]
                }
            ]
        },
        "accessibility": {
            "title": "Accessibility",
            "blocks": [
                {
                    "type": "text",
                    "runs": [
                        {
                            "text": "Provide a visible "
                        },
                        {
                            "text": "label",
                            "code": true
                        },
                        {
                            "text": " or an explicit "
                        },
                        {
                            "text": "a11y-label",
                            "code": true
                        },
                        {
                            "text": "; Firstlight warns during development when both are blank. The native controls expose the setting name, on/off value, disabled state, optional hint, and error semantics. SwiftUI provides a minimum 44-point target; the Material 3 row provides a minimum 48-dp target and one TalkBack switch focus stop."
                        }
                    ]
                }
            ]
        },
        "validation-and-failure-behaviour": {
            "title": "Validation and failure behaviour",
            "blocks": [
                {
                    "type": "text",
                    "runs": [
                        {
                            "text": "Contract exceptions still reject non-Boolean values, unsupported "
                        },
                        {
                            "text": "required",
                            "code": true
                        },
                        {
                            "text": " or "
                        },
                        {
                            "text": "placement",
                            "code": true
                        },
                        {
                            "text": ", and deferred sync modes before publication. User validation is separate: screens that "
                        },
                        {
                            "text": "use ValidatesFields",
                            "code": true
                        },
                        {
                            "text": " auto-bind the first MessageBag message for the field's "
                        },
                        {
                            "text": "native:model",
                            "code": true
                        },
                        {
                            "text": " or "
                        },
                        {
                            "text": "error-for",
                            "code": true
                        },
                        {
                            "text": " name. An authored "
                        },
                        {
                            "text": "error",
                            "code": true
                        },
                        {
                            "text": " wins. See "
                        },
                        {
                            "text": "Validate fields",
                            "link": 2
                        },
                        {
                            "text": ". An error takes precedence over helper text and is included in accessibility semantics."
                        }
                    ]
                }
            ]
        },
        "platform-behaviour": {
            "title": "Platform behaviour",
            "blocks": [
                {
                    "type": "text",
                    "runs": [
                        {
                            "text": "iOS uses a genuine SwiftUI "
                        },
                        {
                            "text": "Toggle",
                            "code": true
                        },
                        {
                            "text": " with the native switch style and system motion. Android uses a genuine Material 3 "
                        },
                        {
                            "text": "Switch",
                            "code": true
                        },
                        {
                            "text": " inside a row-owned switch semantic target, preserving Material state layers and TalkBack behaviour. The public EDGE API and server-authoritative state contract are shared; native geometry, presentation, and interaction remain platform-specific."
                        }
                    ]
                }
            ]
        },
        "compatibility": {
            "title": "Compatibility",
            "blocks": [
                {
                    "type": "text",
                    "runs": [
                        {
                            "text": "Switch supports the versions listed in the current "
                        },
                        {
                            "text": "compatibility reference",
                            "link": 3
                        },
                        {
                            "text": " and requires both native renderers to be compiled into the host application."
                        }
                    ]
                }
            ]
        },
