    "chapters": {
        "overview": {
            "title": "Overview",
            "blocks": [
                {
                    "type": "text",
                    "text": "Switch presents one boolean setting as a native on/off control."
                }
            ]
        },
        "complete-example": {
            "title": "Complete example",
            "blocks": [
                {
                    "type": "text",
                    "runs": [
                        {
                            "text": "Declare a boolean property on the native component, then bind it with "
                        },
                        {
                            "text": "native:model",
                            "code": true
                        },
                        {
                            "text": ":"
                        }
                    ]
                },
                {
                    "type": "code",
                    "language": "php",
                    "text": "<?php\n\nnamespace App\\NativeComponents;\n\nuse Illuminate\\View\\View;\nuse FirstlightUI\\NativeComponent;\n\nclass NotificationSettings extends NativeComponent\n{\n    public bool $notifications = false;\n\n    public function render(): View\n    {\n        return view('native.notification-settings');\n    }\n}"
                },
                {
                    "type": "code",
                    "language": "blade",
                    "text": "<firstlight:switch\n    native:model=\"notifications\"\n    label=\"Notifications\"\n    helper=\"Receive account updates.\"\n    a11y-hint=\"Controls notification delivery\"\n/>"
                }
            ]
        },
        "props": {
            "title": "Props",
            "blocks": [
                {
                    "type": "definition",
                    "term": {
                        "runs": [
                            {
                                "text": "value",
                                "code": true
                            }
                        ]
                    },
                    "items": [
                        {
                            "label": "Accepted type",
                            "runs": [
                                {
                                    "text": "bool",
                                    "code": true
                                }
                            ]
                        },
                        {
                            "label": "Purpose",
                            "runs": [
                                {
                                    "text": "Accepted value. Defaults to "
                                },
                                {
                                    "text": "false",
                                    "code": true
                                },
                                {
                                    "text": " when omitted."
                                }
                            ]
                        }
                    ]
                },
                {
                    "type": "definition",
                    "term": {
                        "runs": [
                            {
                                "text": "native:model",
                                "code": true
                            }
                        ]
                    },
                    "items": [
                        {
                            "label": "Accepted type",
                            "text": "a boolean component property"
                        },
                        {
                            "label": "Purpose",
                            "runs": [
                                {
                                    "text": "Synchronises the accepted boolean value through NativePHP. "
                                },
                                {
                                    "text": "native:model.live",
                                    "code": true
                                },
                                {
                                    "text": " is also accepted."
                                }
                            ]
                        }
                    ]
                },
                {
                    "type": "definition",
                    "term": {
                        "runs": [
                            {
                                "text": "label",
                                "code": true
                            }
                        ]
                    },
                    "items": [
                        {
                            "label": "Accepted type",
                            "runs": [
                                {
                                    "text": "string",
                                    "code": true
                                }
                            ]
                        },
                        {
                            "label": "Purpose",
                            "text": "Visible setting label."
                        }
                    ]
                },
                {
                    "type": "definition",
                    "term": {
                        "runs": [
                            {
                                "text": "helper",
                                "code": true
                            }
                        ]
                    },
                    "items": [
                        {
                            "label": "Accepted type",
                            "runs": [
                                {
                                    "text": "string",
                                    "code": true
                                }
                            ]
                        },
                        {
                            "label": "Purpose",
                            "text": "Supporting text below the setting."
                        }
                    ]
                },
