                    "type": "definition",
                    "term": {
                        "runs": [
                            {
                                "text": "error",
                                "code": true
                            }
                        ]
                    },
                    "items": [
                        {
                            "label": "Accepted type",
                            "runs": [
                                {
                                    "text": "string",
                                    "code": true
                                }
                            ]
                        },
                        {
                            "label": "Purpose",
                            "runs": [
                                {
                                    "text": "Error text and error semantics; shown instead of "
                                },
                                {
                                    "text": "helper",
                                    "code": true
                                },
                                {
                                    "text": " when non-empty."
                                }
                            ]
                        }
                    ]
                },
                {
                    "type": "definition",
                    "term": {
                        "runs": [
                            {
