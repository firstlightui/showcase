        "events-and-synchronisation": {
            "title": "Events and synchronisation",
            "blocks": [
                {
                    "type": "text",
                    "runs": [
                        {
                            "text": "@change",
                            "code": true
                        },
                        {
                            "text": " receives a canonical date string only after the user confirms the native presentation. In normal use, "
                        },
                        {
                            "text": "native:model",
                            "code": true
                        },
                        {
                            "text": " registers this callback and updates the bound property."
                        }
                    ]
                },
                {
                    "type": "text",
                    "runs": [
                        {
                            "text": "Plain "
                        },
                        {
                            "text": "native:model",
                            "code": true
                        },
                        {
                            "text": " and "
                        },
                        {
                            "text": "native:model.live",
                            "code": true
                        },
                        {
                            "text": " are equivalent because a date is a discrete choice. Blur, lazy, and debounce modifiers are rejected."
                        }
                    ]
                },
                {
                    "type": "text",
                    "text": "Opening the picker, moving its draft, cancelling, confirming the already accepted date, and programmatic PHP updates emit nothing. The trigger never shows a draft optimistically. PHP may accept, reject, or replace a proposal; the next tree publication remains the source of truth."
                },
                {
                    "type": "text",
                    "runs": [
                        {
                            "text": "If accepted value, bounds, locale, timezone, or disabled state changes while the picker is open, Firstlight dismisses it and discards its draft. A null value initially drafts today in "
                        },
                        {
                            "text": "timezone",
                            "code": true
                        },
                        {
                            "text": ", clamped to the nearest bound when necessary, but does not publish until confirmation."
                        }
                    ]
                }
            ]
        },
        "validation-and-accessibility": {
            "title": "Validation and accessibility",
            "blocks": [
                {
                    "type": "text",
                    "runs": [
                        {
                            "text": "Invalid inherited application locale or timezone is omitted so the device calendar is used. Authored malformed locale or timezone still fail before publication. Sheet Confirm and Cancel labels are package chrome, not Blade attributes; see "
                        },
                        {
                            "text": "Localize chrome",
                            "link": 0
                        },
                        {
                            "text": "."
                        }
                    ]
                },
                {
                    "type": "text",
                    "runs": [
                        {
                            "text": "User validation is separate: screens that "
                        },
                        {
                            "text": "use ValidatesFields",
                            "code": true
                        },
                        {
                            "text": " auto-bind the first MessageBag message for the field's "
                        },
                        {
                            "text": "native:model",
                            "code": true
                        },
                        {
                            "text": " or "
                        },
                        {
                            "text": "error-for",
                            "code": true
                        },
                        {
                            "text": " name. An authored "
                        },
                        {
                            "text": "error",
                            "code": true
                        },
                        {
                            "text": " wins. "
                        },
                        {
                            "text": "required",
                            "code": true
                        },
                        {
                            "text": " is display metadata and does not run Laravel rules. See "
                        },
                        {
                            "text": "Validate fields",
                            "link": 1
                        },
                        {
                            "text": "."
                        }
                    ]
                },
                {
                    "type": "text",
                    "runs": [
                        {
                            "text": "A visible "
                        },
                        {
                            "text": "label",
                            "code": true
                        },
                        {
                            "text": " or explicit "
                        },
                        {
                            "text": "a11y-label",
                            "code": true
                        },
                        {
                            "text": " is required during development. Error text replaces helper text without replacing the control's accessible name or value. The field exposes its accepted localized value or placeholder, hint, disabled state, and platform error semantics."
                        }
                    ]
                },
                {
                    "type": "text",
                    "text": "The calendar keeps native traversal, focus, selection, today, cancel, and confirm behaviour. The field and actions retain at least a 44-point target on iOS and 48-dp target on Android, and support Dynamic Type or font scaling, dark mode, increased contrast, and right-to-left layout."
                }
            ]
        },
        "platform-behaviour": {
            "title": "Platform behaviour",
            "blocks": [
                {
                    "type": "text",
                    "runs": [
                        {
                            "text": "iOS presents a genuine graphical SwiftUI "
                        },
                        {
                            "text": "DatePicker",
                            "code": true
                        },
                        {
                            "text": " restricted to calendar dates, with explicit Cancel and Confirm actions. On iPhone it opens in a sheet sized to the calendar and actions, which grows with Dynamic Type; on iPad it opens in a popover anchored to the field. Android presents the Material 3 "
                        },
                        {
                            "text": "DatePickerDialog",
                            "code": true
                        },
                        {
                            "text": " from a read-only Material field. Android maps Material's selected UTC-midnight cell back to the same canonical date rather than treating it as a local instant."
                        }
                    ]
                },
                {
                    "type": "text",
                    "text": "Date Picker deliberately has no time or datetime mode, picker-style override, hour format, clear action, custom presentation labels or icons, range mode, or visual variant props."
                }
            ]
        },
