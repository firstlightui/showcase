                            "runs": [
                                {
                                    "text": "string",
                                    "code": true
                                }
                            ]
                        },
                        {
                            "label": "Purpose",
                            "text": "External EDGE layout for the complete field."
                        }
                    ]
                },
                {
                    "type": "text",
                    "runs": [
                        {
                            "text": "Omitted "
                        },
                        {
                            "text": "value",
                            "code": true
                        },
                        {
                            "text": " and explicit "
                        },
                        {
                            "text": "null",
                            "code": true
                        },
                        {
                            "text": " publish the same empty state. The component does not accept "
                        },
                        {
                            "text": "DateTimeInterface",
                            "code": true
                        },
                        {
                            "text": ", timestamps, whitespace, unpadded dates, or year zero. Years "
                        },
                        {
                            "text": "0001",
                            "code": true
                        },
                        {
                            "text": " through "
                        },
                        {
                            "text": "9999",
                            "code": true
                        },
                        {
                            "text": " use proleptic Gregorian leap-year rules."
                        }
                    ]
                },
                {
                    "type": "text",
                    "runs": [
                        {
                            "text": "min",
                            "code": true
                        },
                        {
                            "text": " and "
                        },
                        {
                            "text": "max",
                            "code": true
                        },
                        {
                            "text": " are inclusive, must be ordered, and must contain an accepted non-null value. Null bounds are omitted. Firstlight never silently clamps an authored value."
                        }
                    ]
                }
            ]
