{
    "id": "components/date-picker",
    "title": "Date Picker",
    "description": "Canonical nullable dates, inclusive bounds, native confirmation, localisation, and accessibility for Firstlight Date Picker.",
    "group": "Components",
    "anchors": {
        "date-picker": "overview",
        "complete-example": "complete-example",
        "props": "props",
        "events-and-synchronisation": "events-and-synchronisation",
        "validation-and-accessibility": "validation-and-accessibility",
        "platform-behaviour": "platform-behaviour",
        "screenshots": "screenshots"
    },
    "chapters": {
        "overview": {
            "title": "Overview",
            "blocks": [
                {
                    "type": "text",
                    "text": "Date Picker chooses one calendar date with the native date picker on each platform. PHP remains authoritative: the closed field always shows the value PHP most recently published."
                }
            ]
        },
        "complete-example": {
            "title": "Complete example",
            "blocks": [
                {
                    "type": "code",
                    "language": "blade",
                    "text": "<firstlight:date-picker\n    label=\"Appointment date\"\n    placeholder=\"Choose a date\"\n    helper=\"Dates use the clinic's local calendar.\"\n    min=\"2026-01-01\"\n    max=\"2026-12-31\"\n    locale=\"en-AU\"\n    timezone=\"Australia/Sydney\"\n    required\n    native:model=\"appointmentDate\"\n/>"
                },
                {
                    "type": "text",
                    "runs": [
                        {
                            "text": "The bound property must contain a canonical "
                        },
                        {
                            "text": "YYYY-MM-DD",
                            "code": true
                        },
                        {
                            "text": " string or "
                        },
                        {
                            "text": "null",
                            "code": true
                        },
                        {
                            "text": ":"
                        }
                    ]
                },
                {
                    "type": "code",
                    "language": "php",
                    "text": "public ?string $appointmentDate = null;"
                }
            ]
        },
