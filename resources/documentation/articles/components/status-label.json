        "icons": {
            "title": "Icons",
            "blocks": [
                {
                    "type": "text",
                    "runs": [
                        {
                            "text": "Icons use NativePHP's "
                        },
                        {
                            "text": "Native\\Mobile\\Icon\\IconResolver",
                            "code": true
                        },
                        {
                            "text": ". PHP also accepts "
                        },
                        {
                            "text": "iconIos",
                            "code": true
                        },
                        {
                            "text": " and "
                        },
                        {
                            "text": "iconAndroid",
                            "code": true
                        },
                        {
                            "text": " aliases. The fluent API is "
                        },
                        {
                            "text": "StatusLabel::make('Warning')->icon('warning', ios: 'exclamationmark.triangle', android: 'warning')",
                            "code": true
                        },
                        {
                            "text": "; typed symbols implement "
                        },
                        {
                            "text": "Native\\Mobile\\Icon\\IosSymbol",
                            "code": true
                        },
                        {
                            "text": " or "
                        },
                        {
                            "text": "AndroidSymbol",
                            "code": true
                        },
                        {
                            "text": ". Each platform uses its override when supplied, otherwise the shared name; tooling with no platform uses the shared name. Omitting icons keeps the text-only presentation. Android typed variants are retained in the published props; NativePHP's current Material icon-font helper renders the resolved name, not a separate variant font."
                        }
                    ]
                }
            ]
        },
        "events-and-values": {
            "title": "Events and values",
            "blocks": [
                {
                    "type": "text",
                    "text": "Status Label has no value, options, model binding, or events. It is static text from the user's perspective. A later server publication may replace its label, tone, or accessibility metadata without producing a callback."
                },
                {
                    "type": "text",
                    "runs": [
                        {
                            "text": "Do not use "
                        },
                        {
                            "text": "native:model",
                            "code": true
                        },
                        {
                            "text": ", "
                        },
                        {
                            "text": "@change",
                            "code": true
                        },
                        {
                            "text": ", "
                        },
                        {
                            "text": "@press",
                            "code": true
                        },
                        {
                            "text": ", "
                        },
                        {
                            "text": "value",
                            "code": true
                        },
                        {
                            "text": ", "
                        },
                        {
                            "text": "disabled",
                            "code": true
                        },
                        {
                            "text": ", "
                        },
                        {
                            "text": "loading",
                            "code": true
                        },
                        {
                            "text": ", "
                        },
                        {
                            "text": "error",
                            "code": true
                        },
                        {
                            "text": ", "
                        },
                        {
                            "text": "required",
                            "code": true
                        },
                        {
                            "text": ", or "
                        },
                        {
                            "text": "helper",
                            "code": true
                        },
                        {
                            "text": ". Firstlight rejects those attributes instead of silently adding interactive or field semantics."
                        }
                    ]
                }
            ]
        },
        "state-timing": {
            "title": "State timing",
            "blocks": [
                {
                    "type": "text",
                    "text": "The component renders the latest published Element Tree metadata. It keeps no native selection, editing buffer, pending proposal, or animation state. Programmatic updates reconcile by the element's stable node ID and do not emit events."
                }
            ]
        },
        "disabled-loading-and-error-behaviour": {
            "title": "Disabled, loading, and error behaviour",
            "blocks": [
                {
                    "type": "text",
                    "runs": [
                        {
                            "text": "Disabled, loading, and validation states do not apply to display-only status text. Choose the semantic "
                        },
                        {
                            "text": "tone",
                            "code": true
                        },
                        {
                            "text": " that describes the current metadata and publish a new label or tone when that status changes."
                        }
                    ]
                }
            ]
        },
        "accessibility": {
            "title": "Accessibility",
            "blocks": [
                {
                    "type": "text",
                    "runs": [
                        {
                            "text": "The visible "
                        },
                        {
                            "text": "label",
                            "code": true
                        },
                        {
                            "text": " is the accessible name by default. "
                        },
                        {
                            "text": "a11y-label",
                            "code": true
                        },
                        {
                            "text": " replaces that name, and "
                        },
                        {
                            "text": "a11y-hint",
                            "code": true
                        },
                        {
                            "text": " adds context. Both renderers expose static text semantics without a button, selected, disabled, or live-region role."
                        }
                    ]
                },
                {
                    "type": "text",
                    "text": "The optional icon is decorative and silent to VoiceOver and TalkBack. It uses the same contrast-checked tone foreground as the text in light and dark appearances; it never replaces the required label. Leading placement follows the native layout direction."
                },
                {
                    "type": "text",
                    "text": "Text follows Dynamic Type on iOS and system font scaling on Android. Long labels and accessibility sizes expand or wrap rather than truncating their meaning. Semantic theme colours are checked at render time; when a customised foreground and background are below 4.5:1 contrast, Firstlight uses whichever of black or white has the stronger ratio."
                }
            ]
        },
        "validation-and-failure-behaviour": {
            "title": "Validation and failure behaviour",
            "blocks": [
                {
                    "type": "text",
                    "runs": [
                        {
                            "text": "A missing, "
                        },
                        {
                            "text": "null",
                            "code": true
                        },
                        {
                            "text": ", empty, or whitespace-only "
                        },
                        {
                            "text": "label",
                            "code": true
                        },
                        {
                            "text": " throws an "
                        },
                        {
                            "text": "InvalidArgumentException",
                            "code": true
                        },
                        {
                            "text": ". An unsupported tone also throws and lists the accepted values. Malformed tone data that reaches a native renderer unexpectedly falls back defensively to "
                        },
                        {
                            "text": "neutral",
                            "code": true
                        },
                        {
                            "text": " instead of crashing the host."
                        }
                    ]
                },
                {
                    "type": "text",
                    "runs": [
                        {
                            "text": "Non-string shared icons and platform overrides other than strings, matching platform symbol types, or "
                        },
                        {
                            "text": "null",
                            "code": true
                        },
                        {
                            "text": " throw with the public prop name."
                        }
                    ]
                }
            ]
        },
        "platform-behaviour": {
            "title": "Platform behaviour",
            "blocks": [
                {
                    "type": "text",
                    "runs": [
                        {
                            "text": "iOS composes SwiftUI "
                        },
                        {
                            "text": "Text",
                            "code": true
                        },
                        {
                            "text": " with native text accessibility. A single line keeps its pill shape; for wrapped labels, the corner radius is capped at half the scaled single-line height plus vertical padding so all text remains on the contrasting background. Android composes Material 3 "
                        },
                        {
                            "text": "Text",
                            "code": true
                        },
                        {
                            "text": " in a capsule-shaped "
                        },
                        {
                            "text": "Surface",
                            "code": true
                        },
                        {
                            "text": " with merged TalkBack semantics. Both use NativePHP semantic theme tokens while retaining platform-native typography, scaling, colour-scheme, and layout behaviour."
                        }
                    ]
                }
            ]
        },
        "compatibility": {
            "title": "Compatibility",
            "blocks": [
                {
                    "type": "text",
                    "runs": [
                        {
                            "text": "Status Label supports the versions listed in the current "
                        },
                        {
                            "text": "compatibility reference",
                            "link": 0
                        },
                        {
                            "text": " and requires both native renderers to be compiled into the host application."
                        }
                    ]
                }
            ]
        },
