    "chapters": {
        "overview": {
            "title": "Overview",
            "blocks": [
                {
                    "type": "text",
                    "text": "Stepper moves a numeric model by one bounded step at a time. PHP remains the accepted source of truth: a tap proposes the adjacent value and the native control continues showing the accepted value until PHP publishes again."
                },
                {
                    "type": "code",
                    "language": "blade",
                    "text": "<firstlight:stepper\n    native:model=\"quantity\"\n    :min=\"0\"\n    :max=\"10\"\n    :step=\"1\"\n    label=\"Quantity\"\n    helper=\"Adjust one item at a time\"\n/>"
                },
                {
                    "type": "text",
                    "runs": [
                        {
                            "text": "Use Blade's "
                        },
                        {
                            "text": ":",
                            "code": true
                        },
                        {
                            "text": " binding for numbers. Literal HTML attributes such as "
                        },
                        {
                            "text": "min=\"0\"",
                            "code": true
                        },
                        {
                            "text": " are strings and are rejected deliberately."
                        }
                    ]
                }
            ]
        },
