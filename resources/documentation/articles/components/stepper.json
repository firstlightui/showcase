        "exact-php-number-types": {
            "title": "Exact PHP number types",
            "blocks": [
                {
                    "type": "text",
                    "runs": [
                        {
                            "text": "Stepper preserves intentional PHP number kinds. If "
                        },
                        {
                            "text": "value",
                            "code": true
                        },
                        {
                            "text": ", "
                        },
                        {
                            "text": "min",
                            "code": true
                        },
                        {
                            "text": ", "
                        },
                        {
                            "text": "max",
                            "code": true
                        },
                        {
                            "text": ", and "
                        },
                        {
                            "text": "step",
                            "code": true
                        },
                        {
                            "text": " are all integers, proposals are integers. If any one is a float, all numeric tree props and proposals are floats, even an integral value such as "
                        },
                        {
                            "text": "5.0",
                            "code": true
                        },
                        {
                            "text": ". An omitted step defaults to integer "
                        },
                        {
                            "text": "1",
                            "code": true
                        },
                        {
                            "text": " for an otherwise integer model."
                        }
                    ]
                },
                {
                    "type": "code",
                    "language": "php",
                    "text": "public int $quantity = 5;\npublic float $dose = 5.0;"
                },
                {
                    "type": "text",
                    "runs": [
                        {
                            "text": "Decimal grid comparisons tolerate only normal binary floating-point noise such as "
                        },
                        {
                            "text": "0.1 + 0.2",
                            "code": true
                        },
                        {
                            "text": "; the public value still has to be on the authored grid."
                        }
                    ]
                }
            ]
        },
        "events-and-server-authority": {
            "title": "Events and server authority",
            "blocks": [
                {
                    "type": "text",
                    "runs": [
                        {
                            "text": "Use "
                        },
                        {
                            "text": "@change",
                            "code": true
                        },
                        {
                            "text": ", plain "
                        },
                        {
                            "text": "native:model",
                            "code": true
                        },
                        {
                            "text": ", or "
                        },
                        {
                            "text": "native:model.live",
                            "code": true
                        },
                        {
                            "text": ". A decrement or increment sends one adjacent precomputed value through the standard callback. Blur and debounce modes are rejected because a step is already an immediate, discrete action."
                        }
                    ]
                },
                {
                    "type": "text",
                    "text": "After a proposal, another tap is ignored until the server publishes the node again. This prevents stale rapid taps from calculating against an old accepted value. The control does not change optimistically and performs no arithmetic on the device."
                },
                {
                    "type": "text",
                    "runs": [
                        {
                            "text": "Host the control in "
                        },
                        {
                            "text": "FirstlightUI\\NativeComponent",
                            "code": true
                        },
                        {
                            "text": " for the "
                        },
                        {
                            "text": "nonstreaming response-revision contract",
                            "link": 0
                        },
                        {
                            "text": ". It makes an unchanged full response observable to the renderers. Revisions are not per-event acknowledgements, do not prevent coalescing, and do not serialize simultaneous proposals. Wider release qualification remains pending."
                        }
                    ]
                }
            ]
        },
        "accessibility-and-platform-behavior": {
            "title": "Accessibility and platform behavior",
            "blocks": [
                {
                    "type": "text",
                    "runs": [
                        {
                            "text": "Contract exceptions still reject invalid numeric grids before publication. User validation is separate: screens that "
                        },
                        {
                            "text": "use ValidatesFields",
                            "code": true
                        },
                        {
                            "text": " auto-bind the first MessageBag message for the field's "
                        },
                        {
                            "text": "native:model",
                            "code": true
                        },
                        {
                            "text": " or "
                        },
                        {
                            "text": "error-for",
                            "code": true
                        },
                        {
                            "text": " name. An authored "
                        },
                        {
                            "text": "error",
                            "code": true
                        },
                        {
                            "text": " wins. See "
                        },
                        {
                            "text": "Validate fields",
                            "link": 1
                        },
                        {
                            "text": "."
                        }
                    ]
                },
                {
                    "type": "text",
                    "runs": [
                        {
                            "text": "Provide a visible "
                        },
                        {
                            "text": "label",
                            "code": true
                        },
                        {
                            "text": " or an explicit "
                        },
                        {
                            "text": "a11y-label",
                            "code": true
                        },
                        {
                            "text": ". VoiceOver and TalkBack receive the accepted value, hint, helper or error, disabled state, and named decrease/increase actions. At a boundary, only the unavailable direction is disabled."
                        }
                    ]
                },
                {
                    "type": "text",
                    "text": "iOS uses the genuine SwiftUI Stepper. Android uses Material 3 outlined icon buttons with the label on the same row and the minus/value/plus controls at its trailing end. Stepper deliberately has no custom icons, formatter, min/max captions, wraparound, orientation, long-press acceleration, required state, size, variant, colour, or style escape props."
                }
            ]
        },
