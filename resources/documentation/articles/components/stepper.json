                        },
                        {
                            "text": "min",
                            "code": true
                        },
                        {
                            "text": ". Numeric strings, booleans, null, non-finite values, native Float overflow, off-grid values, and grids larger than the signed 32-bit interval limit are rejected. Values are never clamped or coerced."
                        }
