        "overview": {
            "title": "Overview",
            "blocks": [
                {
                    "type": "text",
                    "runs": [
                        {
                            "text": "List Section groups related "
                        },
                        {
                            "text": "List Item",
                            "link": 0
                        },
                        {
                            "text": " rows under an optional header and footer inside a parent "
                        },
                        {
                            "text": "List",
                            "link": 1
                        },
                        {
                            "text": "."
                        }
                    ]
                }
            ]
        },
        "complete-example": {
            "title": "Complete example",
            "blocks": [
                {
                    "type": "code",
                    "language": "blade",
                    "text": "<firstlight:list>\n    <firstlight:list-section header=\"Account\" footer=\"Signed in as Alex\">\n        <firstlight:list-item headline=\"Profile\" @press=\"openProfile\" />\n        <firstlight:list-item headline=\"Security\" @press=\"openSecurity\" />\n    </firstlight:list-section>\n</firstlight:list>"
                },
                {
                    "type": "text",
                    "text": "List Section is a paired container and must live inside List. A section authored on its own does not render application content."
                }
            ]
        },
        "props": {
            "title": "Props",
            "blocks": [
                {
                    "type": "definition",
                    "term": {
                        "runs": [
                            {
                                "text": "header",
                                "code": true
                            }
                        ]
                    },
                    "items": [
                        {
                            "label": "Accepted type",
                            "runs": [
                                {
                                    "text": "non-empty "
                                },
                                {
                                    "text": "string",
                                    "code": true
                                }
                            ]
                        },
                        {
                            "label": "Purpose",
                            "text": "Optional section title."
                        }
                    ]
                },
                {
                    "type": "definition",
                    "term": {
                        "runs": [
                            {
                                "text": "footer",
                                "code": true
                            }
                        ]
                    },
                    "items": [
                        {
                            "label": "Accepted type",
                            "runs": [
                                {
                                    "text": "non-empty "
                                },
                                {
                                    "text": "string",
                                    "code": true
                                }
                            ]
                        },
                        {
                            "label": "Purpose",
                            "text": "Optional section footnote."
                        }
                    ]
                },
                {
                    "type": "text",
                    "text": "At least one List Item child is required."
                }
            ]
        },
        "composition-rules": {
            "title": "Composition rules",
            "blocks": [
                {
                    "type": "item",
                    "marker": "•",
                    "depth": 0,
                    "runs": [
                        {
                            "text": "Child slot accepts only "
                        },
                        {
                            "text": "firstlight:list-item",
                            "code": true
                        },
                        {
                            "text": "."
                        }
                    ]
                },
                {
                    "type": "item",
                    "marker": "•",
                    "depth": 0,
                    "text": "Nested sections, refresh hooks, separators, and field props belong on the parent List instead."
                }
            ]
        },
        "platform-expression": {
            "title": "Platform expression",
            "blocks": [
                {
                    "type": "text",
                    "text": "The parent List renderer consumes List Section inline:"
                },
                {
                    "type": "item",
                    "marker": "•",
                    "depth": 0,
                    "text": "iOS renders SwiftUI section headers and footers."
                },
                {
                    "type": "item",
                    "marker": "•",
                    "depth": 0,
                    "text": "Android renders sticky headers, grouped card rows, and footer text."
                }
            ]
        },
        "adapter-note": {
            "title": "Adapter note",
            "blocks": [
                {
                    "type": "text",
                    "runs": [
                        {
                            "text": "The public tag is "
                        },
                        {
                            "text": "<firstlight:list-section>",
                            "code": true
                        },
                        {
                            "text": ", but the published wire type remains "
                        },
                        {
                            "text": "list_section",
                            "code": true
                        },
                        {
                            "text": " so the delegated Mobile UI list renderer can apply grouped section styling."
                        }
                    ]
                }
            ]
        },
