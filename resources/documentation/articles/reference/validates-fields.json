{
    "id": "reference/validates-fields",
    "title": "ValidatesFields",
    "description": "Public contract for Firstlight Laravel field validation, MessageBag binding, and validate() timing.",
    "group": "Reference",
    "anchors": {
        "validatesfields": "overview",
        "methods": "methods",
        "field-binding": "field-binding",
        "form-level-callouts": "form-level-callouts",
        "announcements-and-focus": "announcements-and-focus",
        "participating-fields": "participating-fields",
        "current-limitations": "current-limitations"
    },
    "chapters": {
        "overview": {
            "title": "Overview",
            "blocks": [
                {
                    "type": "text",
                    "runs": [
                        {
                            "text": "FirstlightUI\\Concerns\\ValidatesFields",
                            "code": true
                        },
                        {
                            "text": " is a Livewire-shaped Laravel Validator layer for NativePHP EDGE screens. "
                        },
                        {
                            "text": "FirstlightUI\\NativeComponent",
                            "code": true
                        },
                        {
                            "text": " includes the trait. See "
                        },
                        {
                            "text": "Validate fields",
                            "link": 0
                        },
                        {
                            "text": " for a complete working screen."
                        }
                    ]
                },
                {
                    "type": "text",
                    "runs": [
                        {
                            "text": "Do not place "
                        },
                        {
                            "text": "@nativeError",
                            "code": true
                        },
                        {
                            "text": " next to Firstlight fields. That directive emits a sibling text node and skips native field error colour, helper replacement, and accessibility."
                        }
                    ]
                }
            ]
        },
        "methods": {
            "title": "Methods",
            "blocks": [
                {
                    "type": "definition",
                    "term": {
                        "runs": [
                            {
                                "text": "validate($rules = null, $messages = [], $attributes = [])",
                                "code": true
                            }
                        ]
                    },
                    "items": [
                        {
                            "label": "Contract",
                            "runs": [
                                {
                                    "text": "Validates public properties. Returns the validated array. On failure, stores the exception bag and rethrows "
                                },
                                {
                                    "text": "ValidationException",
                                    "code": true
                                },
                                {
                                    "text": ". On success, clears messages for the validated keys."
                                }
                            ]
                        }
                    ]
                },
                {
                    "type": "definition",
                    "term": {
                        "runs": [
                            {
                                "text": "validateOnly($field, $rules = null, $messages = [], $attributes = [])",
                                "code": true
                            }
                        ]
                    },
                    "items": [
                        {
                            "label": "Contract",
                            "text": "Validates one key. On failure, replaces only that key. On success, forgets that key. Other bag keys stay put."
                        }
                    ]
                },
                {
                    "type": "definition",
                    "term": {
                        "runs": [
                            {
                                "text": "addError($field, $message)",
                                "code": true
                            }
                        ]
                    },
                    "items": [
                        {
                            "label": "Contract",
                            "text": "Appends one message without throwing."
                        }
                    ]
                },
                {
                    "type": "definition",
                    "term": {
                        "runs": [
                            {
                                "text": "resetValidation($field = null)",
                                "code": true
                            }
                        ]
                    },
                    "items": [
                        {
                            "label": "Contract",
                            "text": "Forgets one key, an array of keys, or the whole bag."
                        }
                    ]
                },
                {
                    "type": "definition",
                    "term": {
                        "runs": [
                            {
                                "text": "getErrorBag()",
                                "code": true
                            }
                        ]
                    },
                    "items": [
                        {
                            "label": "Contract",
                            "runs": [
                                {
                                    "text": "Returns the current "
                                },
                                {
                                    "text": "Illuminate\\Support\\MessageBag",
                                    "code": true
                                },
                                {
                                    "text": "."
                                }
                            ]
                        }
                    ]
                },
                {
                    "type": "definition",
                    "term": {
                        "runs": [
                            {
                                "text": "hasError($field)",
                                "code": true
                            }
                        ]
                    },
                    "items": [
                        {
                            "label": "Contract",
                            "text": "Whether that key currently has messages."
                        }
                    ]
                },
                {
                    "type": "text",
                    "runs": [
                        {
                            "text": "$rules",
                            "code": true
                        },
                        {
                            "text": " may be an array, "
                        },
                        {
                            "text": "null",
                            "code": true
                        },
                        {
                            "text": " (use the screen's rules), or a class name. A class name is resolved through the container when possible, then "
                        },
                        {
                            "text": "$source->rules()",
                            "code": true
                        },
                        {
                            "text": ", and optionally "
                        },
                        {
                            "text": "messages()",
                            "code": true
                        },
                        {
                            "text": " and "
                        },
                        {
                            "text": "attributes()",
                            "code": true
                        },
                        {
                            "text": ". This is the Form Request path: Firstlight does not perform an HTTP redirect."
                        }
                    ]
                },
                {
                    "type": "text",
                    "runs": [
                        {
                            "text": "When "
                        },
                        {
                            "text": "$messages",
                            "code": true
                        },
                        {
                            "text": " or "
                        },
                        {
                            "text": "$attributes",
                            "code": true
                        },
                        {
                            "text": " are empty, the trait reads the screen's "
                        },
                        {
                            "text": "messages()",
                            "code": true
                        },
                        {
                            "text": " / "
                        },
                        {
                            "text": "$messages",
                            "code": true
                        },
                        {
                            "text": " and "
                        },
                        {
                            "text": "validationAttributes()",
                            "code": true
                        },
                        {
                            "text": " / "
                        },
                        {
                            "text": "$validationAttributes",
                            "code": true
                        },
                        {
                            "text": "."
                        }
                    ]
                },
                {
                    "type": "text",
                    "runs": [
                        {
                            "text": "Action dispatch catches "
                        },
                        {
                            "text": "ValidationException",
                            "code": true
                        },
                        {
                            "text": " from "
                        },
                        {
                            "text": "@press",
                            "code": true
                        },
                        {
                            "text": ", "
                        },
                        {
                            "text": "@change",
                            "code": true
                        },
                        {
                            "text": ", "
                        },
                        {
                            "text": "@submit",
                            "code": true
                        },
                        {
                            "text": ", and "
                        },
                        {
                            "text": "updated{Property}",
                            "code": true
                        },
                        {
                            "text": " handlers, stores the bag, and republishes the screen. Other exceptions still propagate."
                        }
                    ]
                }
            ]
        },
        "field-binding": {
            "title": "Field binding",
            "blocks": [
                {
                    "type": "text",
                    "runs": [
                        {
                            "text": "During the screen's view pass, participating fields read the current bag and set their native "
                        },
                        {
                            "text": "error",
                            "code": true
                        },
                        {
                            "text": " slot from the first message for the resolved name:"
                        }
                    ]
                },
                {
                    "type": "item",
                    "marker": "1.",
                    "depth": 0,
                    "runs": [
                        {
                            "text": "A non-empty authored "
                        },
                        {
                            "text": "error",
                            "code": true
                        },
                        {
                            "text": " attribute wins and skips the bag."
                        }
                    ]
                },
                {
                    "type": "item",
                    "marker": "2.",
                    "depth": 0,
                    "runs": [
                        {
                            "text": "Otherwise "
                        },
                        {
                            "text": "error-for",
                            "code": true
                        },
                        {
                            "text": " (or "
                        },
                        {
                            "text": "errorFor",
                            "code": true
                        },
                        {
                            "text": ") selects the bag key."
                        }
                    ]
                },
                {
                    "type": "item",
                    "marker": "3.",
                    "depth": 0,
                    "runs": [
                        {
                            "text": "Otherwise the "
                        },
                        {
                            "text": "native:model",
                            "code": true
                        },
                        {
                            "text": " / "
                        },
                        {
                            "text": "native:model.*",
                            "code": true
                        },
                        {
                            "text": " property name is used."
                        }
                    ]
                },
                {
                    "type": "item",
                    "marker": "4.",
                    "depth": 0,
                    "runs": [
                        {
                            "text": "Otherwise a compiled "
                        },
                        {
                            "text": "__syncProperty('name')",
                            "code": true
                        },
                        {
                            "text": " change callback is used."
                        }
                    ]
                },
                {
                    "type": "text",
                    "runs": [
                        {
                            "text": "An empty authored "
                        },
                        {
                            "text": "error",
                            "code": true
                        },
                        {
                            "text": " is treated as unset. Fields without a resolvable name stay empty. Only the first message for a key is published."
                        }
                    ]
                },
                {
                    "type": "text",
                    "runs": [
                        {
                            "text": "The view also receives "
                        },
                        {
                            "text": "$errorBag",
                            "code": true
                        },
                        {
                            "text": " for explicit "
                        },
                        {
                            "text": ":error=\"$errorBag->first('email')\"",
                            "code": true
                        },
                        {
                            "text": " bindings."
                        }
                    ]
                }
            ]
        },
        "form-level-callouts": {
            "title": "Form-level Callouts",
            "blocks": [
                {
                    "type": "text",
                    "runs": [
                        {
                            "text": "Callout",
                            "link": 1
                        },
                        {
                            "text": " displays bag messages that belong to no field:"
                        }
                    ]
                },
                {
                    "type": "definition",
                    "term": {
                        "runs": [
                            {
                                "text": "error-for=\"key\"",
                                "code": true
                            }
                        ]
                    },
                    "items": [
                        {
                            "label": "Shows",
                            "runs": [
                                {
                                    "text": "MessageBag::first('key')",
                                    "code": true
                                }
                            ]
                        },
                        {
                            "label": "Publishes nothing when",
                            "text": "the key has no message"
                        }
                    ]
                },
                {
                    "type": "definition",
                    "term": {
                        "runs": [
                            {
                                "text": "error-summary",
                                "code": true
                            }
                        ]
                    },
                    "items": [
                        {
                            "label": "Shows",
                            "runs": [
                                {
                                    "text": "every key's first message, in bag order; a "
                                },
                                {
                                    "text": "firstlight::validation.summary",
                                    "code": true
                                },
                                {
                                    "text": " heading when there are two or more"
                                }
                            ]
                        },
                        {
                            "label": "Publishes nothing when",
                            "text": "the bag is empty"
                        }
                    ]
                },
                {
                    "type": "text",
                    "runs": [
                        {
                            "text": "Both default to "
                        },
                        {
                            "text": "danger",
                            "code": true
                        },
                        {
                            "text": ", reject "
                        },
                        {
                            "text": "message",
                            "code": true
                        },
                        {
                            "text": ", and are mutually exclusive. They never receive field focus. The summary follows bag order, which is the order of your rules, so list rules in screen order."
                        }
                    ]
                }
            ]
        },
        "announcements-and-focus": {
            "title": "Announcements and focus",
            "blocks": [
                {
                    "type": "definition",
                    "term": {
                        "runs": [
                            {
                                "text": "@press",
                                "code": true
                            },
                            {
                                "text": " or "
                            },
                            {
                                "text": "@submit",
                                "code": true
                            },
                            {
                                "text": " that adds messages"
                            }
                        ]
                    },
                    "items": [
                        {
                            "label": "Spoken once",
                            "text": "the summary of the whole bag"
                        },
                        {
                            "label": "Screen-reader focus",
                            "text": "first invalid field in render order"
                        }
                    ]
                },
                {
                    "type": "definition",
                    "term": {
                        "runs": [
                            {
                                "text": "any other event (model sync, "
                            },
                            {
                                "text": "@change",
                                "code": true
                            },
                            {
                                "text": ", "
                            },
                            {
                                "text": "updated{Property}",
                                "code": true
                            },
                            {
                                "text": ") that adds messages"
                            }
                        ]
                    },
                    "items": [
                        {
                            "label": "Spoken once",
                            "text": "only the messages it added"
                        },
                        {
                            "label": "Screen-reader focus",
                            "text": "unchanged"
                        }
                    ]
                },
                {
                    "type": "definition",
                    "term": {
                        "text": "an interaction that adds no message"
                    },
                    "items": [
                        {
                            "label": "Spoken once",
                            "text": "nothing"
                        },
                        {
                            "label": "Screen-reader focus",
                            "text": "unchanged"
                        }
                    ]
                },
                {
                    "type": "text",
                    "runs": [
                        {
                            "text": "\"Adds messages\" means a failed "
                        },
                        {
                            "text": "validate()",
                            "code": true
                        },
                        {
                            "text": " or "
                        },
                        {
                            "text": "validateOnly()",
                            "code": true
                        },
                        {
                            "text": ", or "
                        },
                        {
                            "text": "addError()",
                            "code": true
                        },
                        {
                            "text": ". Frames republished before the next interaction carry the same alert, and the platforms act on it once. iOS moves VoiceOver focus and posts an announcement. Android acts while TalkBack is on: Text Field, Text Area, and Code Editor take input focus, and every field announces."
                        }
                    ]
                }
            ]
        },
