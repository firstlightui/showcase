                        {
                            "text": " on those fields is display metadata and does not run Laravel rules."
                        }
                    ]
                }
            ]
        },
        "current-limitations": {
            "title": "Current limitations",
            "blocks": [
                {
                    "type": "item",
                    "marker": "•",
                    "depth": 0,
                    "text": "Only public instance properties are validated. Nested and wildcard rule keys are not supported."
                },
                {
                    "type": "item",
                    "marker": "•",
                    "depth": 0,
                    "runs": [
                        {
                            "text": "Call "
                        },
                        {
                            "text": "validate()",
                            "code": true
                        },
                        {
                            "text": " and "
                        },
                        {
                            "text": "validateOnly()",
                            "code": true
                        },
                        {
                            "text": " from actions and property hooks, not from "
                        },
                        {
                            "text": "mount()",
                            "code": true
                        },
                        {
                            "text": " or "
                        },
                        {
                            "text": "render()",
                            "code": true
                        },
                        {
                            "text": ". Those lifecycle methods still sit on NativePHP's generic "
                        },
                        {
                            "text": "Throwable",
                            "code": true
                        },
                        {
                            "text": " overlay path, so a "
                        },
                        {
                            "text": "ValidationException",
                            "code": true
                        },
                        {
                            "text": " paints the red overlay instead of field messages."
                        }
                    ]
                },
                {
                    "type": "item",
                    "marker": "•",
                    "depth": 0,
                    "runs": [
                        {
                            "text": "addError()",
                            "code": true
                        },
                        {
                            "text": " does not throw and may run from "
                        },
                        {
                            "text": "render()",
                            "code": true
                        },
                        {
                            "text": " when a fixture needs a stable failed frame."
                        }
                    ]
                }
            ]
        }
