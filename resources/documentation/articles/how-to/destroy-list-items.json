{
    "id": "how-to/destroy-list-items",
    "title": "Destroy Firstlight list items",
    "description": "Authorize Confirmation Dialog deletion of List rows by stable keys, then Feedback and list republish.",
    "group": "Guides",
    "anchors": {
        "destroy-firstlight-list-items": "overview",
        "declare-the-screen": "declare-the-screen",
        "keep-denied-rows-visible": "keep-denied-rows-visible",
        "custom-keys-or-database-resolve": "custom-keys-or-database-resolve"
    },
    "chapters": {
        "overview": {
            "title": "Overview",
            "blocks": [
                {
                    "type": "text",
                    "runs": [
                        {
                            "text": "Firstlight deletes list rows in PHP. Pass a stable domain key into the helper, confirm with Confirmation Dialog, authorize again, destroy the model, and let "
                        },
                        {
                            "text": "$listItems",
                            "code": true
                        },
                        {
                            "text": " republish without that row."
                        }
                    ]
                },
                {
                    "type": "text",
                    "runs": [
                        {
                            "text": "An optional labelled "
                        },
                        {
                            "text": "List Item swipe action",
                            "link": 0
                        },
                        {
                            "text": " can invoke the same request helper. There is no automatic swipe deletion or renderer index. See "
                        },
                        {
                            "text": "Authorize actions",
                            "link": 1
                        },
                        {
                            "text": " for hide-versus-disable rules and "
                        },
                        {
                            "text": "Paginate lists",
                            "link": 2
                        },
                        {
                            "text": " for "
                        },
                        {
                            "text": "$listItems",
                            "code": true
                        },
                        {
                            "text": "."
                        }
                    ]
                }
            ]
        },
        "declare-the-screen": {
            "title": "Declare the screen",
            "blocks": [
                {
                    "type": "text",
                    "runs": [
                        {
                            "text": "Extend "
                        },
                        {
                            "text": "FirstlightUI\\NativeComponent",
                            "code": true
                        },
                        {
                            "text": " (or use "
                        },
                        {
                            "text": "AuthorizesActions",
                            "code": true
                        },
                        {
                            "text": ", "
                        },
                        {
                            "text": "DestroysListItems",
                            "code": true
                        },
                        {
                            "text": ", and a "
                        },
                        {
                            "text": "$listItems",
                            "code": true
                        },
                        {
                            "text": " array):"
                        }
                    ]
                },
                {
                    "type": "code",
                    "language": "php",
                    "text": "<?php\n\nnamespace App\\Native;\n\nuse App\\Models\\Post;\nuse FirstlightUI\\NativeComponent;\n\nclass PostsScreen extends NativeComponent\n{\n    public function requestDeletion(int $id): void\n    {\n        $this->requestDestructiveListAction($id, 'delete');\n    }\n\n    public function cancelDeletion(): void\n    {\n        $this->cancelDestructiveListAction();\n    }\n\n    public function deletePost(): void\n    {\n        $this->confirmDestructiveListAction(\n            destroy: fn (Post $post) => $post->delete(),\n            ability: 'delete',\n            successMessage: 'Post deleted',\n        );\n    }\n}"
                },
                {
                    "type": "text",
                    "runs": [
                        {
                            "text": "requestDestructiveListAction()",
                            "code": true
                        },
                        {
                            "text": " resolves the row by key from "
                        },
                        {
                            "text": "$listItems",
                            "code": true
                        },
                        {
                            "text": ", calls "
                        },
                        {
                            "text": "authorize()",
                            "code": true
                        },
                        {
                            "text": ", and sets "
                        },
                        {
                            "text": "$confirmingListDestruction",
                            "code": true
                        },
                        {
                            "text": " when allowed. "
                        },
                        {
                            "text": "confirmDestructiveListAction()",
                            "code": true
                        },
                        {
                            "text": " closes the dialog, authorizes again, runs the destroy callable, removes the row from "
                        },
                        {
                            "text": "$listItems",
                            "code": true
                        },
                        {
                            "text": ", and optionally sends success Feedback."
                        }
                    ]
                },
                {
                    "type": "text",
                    "text": "Keys must be stable identities such as model ids. Do not pass loop indexes."
                }
            ]
        },
        "keep-denied-rows-visible": {
            "title": "Keep denied rows visible",
            "blocks": [
                {
                    "type": "code",
                    "language": "blade",
                    "text": "<firstlight:list separator>\n    @foreach ($this->listItems as $post)\n        <firstlight:list-item\n            :headline=\"$post->title\"\n            supporting=\"Delete permanently\"\n            :disabled=\"$this->denies('delete', $post)\"\n            @press=\"requestDeletion({{ $post->id }})\"\n        />\n    @endforeach\n</firstlight:list>\n\n<firstlight:confirmation-dialog\n    :visible=\"$confirmingListDestruction\"\n    title=\"Delete post?\"\n    message=\"This action cannot be undone.\"\n    confirm-label=\"Delete\"\n    cancel-label=\"Keep post\"\n    tone=\"destructive\"\n    @press=\"deletePost\"\n    @dismiss=\"cancelDeletion\"\n/>"
                },
                {
                    "type": "text",
                    "text": "Never omit a destructive List Item when the Policy denies it. Disable the row and keep supporting copy that explains the unavailable action when the surrounding interface does not already make that clear."
                },
                {
                    "type": "text",
                    "text": "To offer deletion from a swipe, add the following binding to the List Item above. It opens the same confirmation dialog and does not remove the row:"
                },
                {
                    "type": "code",
                    "language": "blade",
                    "text": ":trailing-actions=\"[\n    ['method' => 'requestDeletion('.$post->id.')', 'label' => 'Delete', 'role' => 'destructive'],\n]\""
                },
                {
                    "type": "text",
                    "runs": [
                        {
                            "text": "Swipe callbacks use stable keys just like "
                        },
                        {
                            "text": "@press",
                            "code": true
                        },
                        {
                            "text": ". A disabled row exposes no swipe actions; authorization still runs in PHP when the action is requested and again when deletion is confirmed."
                        }
                    ]
                }
            ]
        },
        "custom-keys-or-database-resolve": {
            "title": "Custom keys or database resolve",
            "blocks": [
                {
                    "type": "text",
                    "runs": [
                        {
                            "text": "Override "
                        },
                        {
                            "text": "destructiveListItemKey()",
                            "code": true
                        },
                        {
                            "text": " when rows do not expose "
                        },
                        {
                            "text": "getKey()",
                            "code": true
                        },
                        {
                            "text": ", "
                        },
                        {
                            "text": "id",
                            "code": true
                        },
                        {
                            "text": ", or an "
                        },
                        {
                            "text": "id",
                            "code": true
                        },
                        {
                            "text": " array key. Override "
                        },
                        {
                            "text": "resolveDestructiveListItem()",
                            "code": true
                        },
                        {
                            "text": " to reload the model from the database instead of trusting the in-memory "
                        },
                        {
                            "text": "$listItems",
                            "code": true
                        },
                        {
                            "text": " copy:"
                        }
                    ]
                },
                {
                    "type": "code",
                    "language": "php",
                    "text": "protected function resolveDestructiveListItem(mixed $key): mixed\n{\n    return Post::query()->find($key);\n}"
                },
                {
                    "type": "text",
                    "runs": [
                        {
                            "text": "When you resolve from the database, "
                        },
                        {
                            "text": "$listItems",
                            "code": true
                        },
                        {
                            "text": " is still updated after a successful destroy so the published List matches the mutation."
                        }
                    ]
                }
            ]
        }
    },
