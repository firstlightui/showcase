{
    "id": "how-to/build-a-form-screen",
    "title": "Build a form screen",
    "description": "Recipe for a create form with a Form Request, native field errors, a form-level error, a loading Save button, success Feedback, and return navigation.",
    "group": "Guides",
    "anchors": {
        "build-a-form-screen": "overview",
        "1-register-the-route": "1-register-the-route",
        "2-write-the-form-request": "2-write-the-form-request",
        "3-write-the-screen": "3-write-the-screen",
        "4-write-the-view": "4-write-the-view",
        "what-each-platform-shows": "what-each-platform-shows",
        "rules-to-keep": "rules-to-keep",
        "adapt-the-recipe": "adapt-the-recipe"
    },
    "chapters": {
        "overview": {
            "title": "Overview",
            "blocks": [
                {
                    "type": "text",
                    "text": "This recipe builds the create screen most apps need: labelled fields, Laravel validation through a Form Request, errors shown by each native field, an error for problems that belong to the whole form, a Save button with a loading state, and a return to the previous screen with success Feedback."
                },
                {
                    "type": "text",
                    "runs": [
                        {
                            "text": "This recipe runs unchanged in the "
                        },
                        {
                            "text": "showcase app",
                            "link": 0
                        },
                        {
                            "text": ", where "
                        },
                        {
                            "text": "FormRecipeTest",
                            "link": 1,
                            "code": true
                        },
                        {
                            "text": " exercises it."
                        }
                    ]
                },
                {
                    "type": "text",
                    "runs": [
                        {
                            "text": "Use it when several values are checked and saved together. Use the "
                        },
                        {
                            "text": "settings recipe",
                            "link": 2
                        },
                        {
                            "text": " when each value saves on its own."
                        }
                    ]
                }
            ]
        },
        "1-register-the-route": {
            "title": "1. Register the route",
            "blocks": [
                {
                    "type": "code",
                    "language": "php",
                    "text": "use App\\NativeComponents\\CreatePostScreen;\nuse Illuminate\\Support\\Facades\\Route;\n\nRoute::native('/posts/create', CreatePostScreen::class)->name('posts.create');"
                },
                {
                    "type": "text",
                    "runs": [
                        {
                            "text": "Register it before any "
                        },
                        {
                            "text": "/posts/{post}",
                            "code": true
                        },
                        {
                            "text": " route so "
                        },
                        {
                            "text": "create",
                            "code": true
                        },
                        {
                            "text": " is not read as an id."
                        }
                    ]
                }
            ]
        },
        "2-write-the-form-request": {
            "title": "2. Write the Form Request",
            "blocks": [
                {
                    "type": "code",
                    "language": "php",
                    "text": "<?php\n\nnamespace App\\Http\\Requests;\n\nuse Illuminate\\Foundation\\Http\\FormRequest;\n\nclass StorePostRequest extends FormRequest\n{\n    public function rules(): array\n    {\n        return [\n            'title' => 'required|min:3|max:80',\n            'body' => 'required|min:10',\n        ];\n    }\n\n    public function messages(): array\n    {\n        return [\n            'body.min' => 'Write at least a sentence.',\n        ];\n    }\n}"
                },
                {
                    "type": "text",
                    "text": "Declare rules in the order the fields appear. The error summary lists messages in rule order."
                }
            ]
        },
        "3-write-the-screen": {
            "title": "3. Write the screen",
            "blocks": [
                {
                    "type": "code",
                    "language": "php",
                    "text": "<?php\n\nnamespace App\\NativeComponents;\n\nuse App\\Http\\Requests\\StorePostRequest;\nuse App\\Models\\Post;\nuse FirstlightUI\\NativeComponent;\nuse Illuminate\\Validation\\ValidationException;\nuse Illuminate\\View\\View;\n\nclass CreatePostScreen extends NativeComponent\n{\n    public string $title = '';\n\n    public string $body = '';\n\n    public function save(): void\n    {\n        $saved = $this->submit(\n            action: function (): void {\n                $this->validate(StorePostRequest::class);\n\n                if (Post::query()->where('title', $this->title)->exists()) {\n                    throw ValidationException::withMessages([\n                        'form' => 'A post with this title already exists.',\n                    ]);\n                }\n\n                Post::query()->create([\n                    'title' => $this->title,\n                    'excerpt' => str($this->body)->limit(60)->toString(),\n                    'body' => $this->body,\n                ]);\n            },\n            successMessage: 'Post created',\n            validate: false,\n        );\n\n        if ($saved) {\n            $this->back();\n        }\n    }\n\n    public function navTitle(): string\n    {\n        return 'New post';\n    }\n\n    public function render(): View\n    {\n        return view('native.create-post');\n    }\n}"
                },
                {
                    "type": "text",
                    "runs": [
                        {
                            "text": "validate: false",
                            "code": true
                        },
                        {
                            "text": " stops "
                        },
                        {
                            "text": "submit()",
                            "code": true
                        },
                        {
                            "text": " from running "
                        },
                        {
                            "text": "$rules",
                            "code": true
                        },
                        {
                            "text": " first, because the Form Request supplies them inside the action. Any "
                        },
                        {
                            "text": "ValidationException",
                            "code": true
                        },
                        {
                            "text": " thrown inside the action, from the Form Request or from your own check, is shown on the screen and "
                        },
                        {
                            "text": "submit()",
                            "code": true
                        },
                        {
                            "text": " returns "
                        },
                        {
                            "text": "false",
                            "code": true
                        },
                        {
                            "text": "."
                        }
                    ]
                }
            ]
        },
        "4-write-the-view": {
            "title": "4. Write the view",
            "blocks": [
                {
                    "type": "text",
                    "runs": [
                        {
                            "text": "Save this as "
                        },
                        {
                            "text": "resources/views/native/create-post.blade.php",
                            "code": true
                        },
                        {
                            "text": ":"
                        }
                    ]
                },
                {
                    "type": "code",
                    "language": "blade",
                    "text": "<native:scroll-view class=\"w-full flex-1\">\n    <native:column class=\"w-full p-4 gap-4\">\n        <firstlight:callout error-for=\"form\" />\n\n        <firstlight:text-field\n            label=\"Title\"\n            autocapitalize=\"sentences\"\n            submit-label=\"next\"\n            native:model=\"title\"\n            required\n        />\n\n        <firstlight:text-area\n            label=\"Body\"\n            native:model=\"body\"\n            required\n        />\n\n        <firstlight:button variant=\"primary\" :loading=\"$submitting\" @press=\"save\">\n            Save post\n        </firstlight:button>\n    </native:column>\n</native:scroll-view>"
                },
                {
                    "type": "text",
                    "runs": [
                        {
                            "text": "No "
                        },
                        {
                            "text": ":error",
                            "code": true
                        },
                        {
                            "text": " wiring is needed. After a failed save, each field shows its first message in its native error slot, and the Callout shows the "
                        },
                        {
                            "text": "form",
                            "code": true
                        },
                        {
                            "text": " message. For long forms, add "
                        },
                        {
                            "text": "<firstlight:callout error-summary />",
                            "code": true
                        },
                        {
                            "text": " above the fields to list every message in one place."
                        }
                    ]
                }
            ]
        },
        "what-each-platform-shows": {
            "title": "What each platform shows",
            "blocks": [
                {
                    "type": "definition",
                    "term": {
                        "text": "Field errors"
                    },
                    "items": [
                        {
                            "label": "iOS",
                            "text": "Error text under the field with error colouring"
                        },
                        {
                            "label": "Android",
                            "text": "Material 3 supporting text in the error state"
                        }
                    ]
                },
                {
                    "type": "definition",
                    "term": {
                        "text": "Form error"
                    },
                    "items": [
                        {
                            "label": "iOS",
                            "text": "Danger Callout"
                        },
                        {
                            "label": "Android",
                            "text": "Danger Callout"
                        }
                    ]
                },
                {
                    "type": "definition",
                    "term": {
                        "text": "Screen reader"
                    },
                    "items": [
                        {
                            "label": "iOS",
                            "text": "VoiceOver reads the errors and moves to the first invalid field"
                        },
                        {
                            "label": "Android",
                            "text": "TalkBack reads the errors and moves to the first invalid field"
                        }
                    ]
                },
                {
                    "type": "definition",
                    "term": {
                        "text": "Success"
                    },
                    "items": [
                        {
                            "label": "iOS",
                            "text": "Returns to the previous screen and shows \"Post created\""
                        },
                        {
                            "label": "Android",
                            "text": "Returns to the previous screen and shows \"Post created\""
                        }
                    ]
                }
            ]
        },
        "rules-to-keep": {
            "title": "Rules to keep",
            "blocks": [
                {
                    "type": "item",
                    "marker": "•",
                    "depth": 0,
                    "runs": [
                        {
                            "text": "Do not wrap "
                        },
                        {
                            "text": "save()",
                            "code": true
                        },
                        {
                            "text": " in "
                        },
                        {
                            "text": "try",
                            "code": true
                        },
                        {
                            "text": "/"
                        },
                        {
                            "text": "catch",
                            "code": true
                        },
                        {
                            "text": ". Firstlight shows validation errors for you."
                        }
                    ]
                },
                {
                    "type": "item",
                    "marker": "•",
                    "depth": 0,
                    "runs": [
                        {
                            "text": "Do not place "
                        },
                        {
                            "text": "@nativeError",
                            "code": true
                        },
                        {
                            "text": " next to Firstlight fields. It skips native error colouring and screen-reader announcements."
                        }
                    ]
                },
                {
                    "type": "item",
                    "marker": "•",
                    "depth": 0,
                    "runs": [
                        {
                            "text": "Use a key that is not a field name, such as "
                        },
                        {
                            "text": "form",
                            "code": true
                        },
                        {
                            "text": ", for errors that belong to the whole form."
                        }
                    ]
                },
                {
                    "type": "item",
                    "marker": "•",
                    "depth": 0,
                    "runs": [
                        {
                            "text": "required",
                            "code": true
                        },
                        {
                            "text": " on a field is display only. The Form Request enforces it."
                        }
                    ]
                }
            ]
        },
        "adapt-the-recipe": {
            "title": "Adapt the recipe",
            "blocks": [
                {
                    "type": "item",
                    "marker": "•",
                    "depth": 0,
                    "runs": [
                        {
                            "text": "Edit instead of create:",
                            "strong": true
                        },
                        {
                            "text": " load the model in "
                        },
                        {
                            "text": "mount()",
                            "code": true
                        },
                        {
                            "text": ", copy its values into the properties, and call "
                        },
                        {
                            "text": "update()",
                            "code": true
                        },
                        {
                            "text": " instead of "
                        },
                        {
                            "text": "create()",
                            "code": true
                        },
                        {
                            "text": "."
                        }
                    ]
                },
                {
                    "type": "item",
                    "marker": "•",
                    "depth": 0,
                    "runs": [
                        {
                            "text": "Validate as the user leaves a field:",
                            "strong": true
                        },
                        {
                            "text": " add "
                        },
                        {
                            "text": "public function updatedTitle(): void { $this->validateOnly('title', StorePostRequest::class); }",
                            "code": true
                        },
                        {
                            "text": "."
                        }
                    ]
                },
                {
                    "type": "item",
                    "marker": "•",
                    "depth": 0,
                    "runs": [
                        {
                            "text": "Test it:",
                            "strong": true
                        },
                        {
                            "text": " see "
                        },
                        {
                            "text": "Test screens",
                            "link": 3
                        },
                        {
                            "text": "."
                        }
                    ]
                }
            ]
        }
    },
