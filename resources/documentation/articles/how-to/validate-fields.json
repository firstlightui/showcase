{
    "id": "how-to/validate-fields",
    "title": "Validate Firstlight fields",
    "description": "Show Laravel validation messages on Firstlight fields with validate(), validateOnly(), and Form Requests.",
    "group": "Guides",
    "anchors": {
        "validate-firstlight-fields": "overview",
        "opt-in": "opt-in",
        "declare-rules-and-bind-fields": "declare-rules-and-bind-fields",
        "validate-one-field-on-blur-or-live": "validate-one-field-on-blur-or-live",
        "use-a-form-request": "use-a-form-request",
        "bind-a-different-messagebag-key": "bind-a-different-messagebag-key",
        "let-an-authored-error-win": "let-an-authored-error-win",
        "add-and-clear-messages": "add-and-clear-messages",
        "show-form-level-errors": "show-form-level-errors",
        "screen-reader-announcements": "screen-reader-announcements",
        "do-not-validate-during-mount-or-render": "do-not-validate-during-mount-or-render",
        "screenshots": "screenshots"
    },
    "chapters": {
        "overview": {
            "title": "Overview",
            "blocks": [
                {
                    "type": "text",
                    "runs": [
                        {
                            "text": "Firstlight extends NativePHP Mobile's "
                        },
                        {
                            "text": "ValidatesInput",
                            "code": true
                        },
                        {
                            "text": " with Form Request sources, Media conversion, error summaries, and accessibility announcements. Call "
                        },
                        {
                            "text": "$this->validate()",
                            "code": true
                        },
                        {
                            "text": " or "
                        },
                        {
                            "text": "$this->validateOnly()",
                            "code": true
                        },
                        {
                            "text": "; participating fields show the first "
                        },
                        {
                            "text": "MessageBag",
                            "code": true
                        },
                        {
                            "text": " message in the native "
                        },
                        {
                            "text": "error",
                            "code": true
                        },
                        {
                            "text": " slot. Firstlight and Mobile UI controls share the upstream "
                        },
                        {
                            "text": "FieldErrors",
                            "code": true
                        },
                        {
                            "text": " bag on the same screen."
                        }
                    ]
                },
                {
                    "type": "text",
                    "runs": [
                        {
                            "text": "Do not place "
                        },
                        {
                            "text": "@nativeError",
                            "code": true
                        },
                        {
                            "text": " next to Firstlight fields. That directive emits a sibling text node and skips native field error colour, helper replacement, and accessibility. Use "
                        },
                        {
                            "text": "ValidatesFields",
                            "code": true
                        },
                        {
                            "text": ", "
                        },
                        {
                            "text": "error-for",
                            "code": true
                        },
                        {
                            "text": ", or an authored "
                        },
                        {
                            "text": "error",
                            "code": true
                        },
                        {
                            "text": " instead."
                        }
                    ]
                },
                {
                    "type": "text",
                    "runs": [
                        {
                            "text": "The method contract, participating fields, and current limitations are listed in the "
                        },
                        {
                            "text": "ValidatesFields reference",
                            "link": 0
                        },
                        {
                            "text": "."
                        }
                    ]
                }
            ]
        },
        "opt-in": {
            "title": "Opt in",
            "blocks": [
                {
                    "type": "text",
                    "runs": [
                        {
                            "text": "Extend "
                        },
                        {
                            "text": "FirstlightUI\\NativeComponent",
                            "code": true
                        },
                        {
                            "text": ", which includes "
                        },
                        {
                            "text": "ValidatesFields",
                            "code": true
                        },
                        {
                            "text": " and the full nonstreaming response-revision contract:"
                        }
                    ]
                },
                {
                    "type": "code",
                    "language": "php",
                    "text": "use FirstlightUI\\NativeComponent;\n\nclass SignupScreen extends NativeComponent\n{\n}"
                },
                {
                    "type": "text",
                    "runs": [
                        {
                            "text": "The trait remains usable separately, but adding it to the upstream EDGE base does not provide the publication contract. Blade render paths are automatic; programmatic Element roots must return "
                        },
                        {
                            "text": "$this->response($element)",
                            "code": true
                        },
                        {
                            "text": " to add normal chrome and the revision. Nested children are untouched, partials are unstamped, and streaming cannot be opted into. Repeated validation responses use this same contract, not a per-event acknowledgement. See "
                        },
                        {
                            "text": "Compatibility",
                            "link": 1
                        },
                        {
                            "text": "."
                        }
                    ]
                }
            ]
        },
        "declare-rules-and-bind-fields": {
            "title": "Declare rules and bind fields",
            "blocks": [
                {
                    "type": "text",
                    "runs": [
                        {
                            "text": "Rule keys must match public property names ("
                        },
                        {
                            "text": "email",
                            "code": true
                        },
                        {
                            "text": " ↔ "
                        },
                        {
                            "text": "native:model=\"email\"",
                            "code": true
                        },
                        {
                            "text": "). Nested and wildcard keys are not supported."
                        }
                    ]
                },
                {
                    "type": "code",
                    "language": "php",
                    "text": "public string $name = '';\n\npublic string $email = '';\n\npublic bool $accepted = false;\n\n/** @var array<string, string> */\nprotected array $rules = [\n    'name' => 'required|min:2',\n    'email' => 'required|email',\n    'accepted' => 'accepted',\n];\n\n/** @var array<string, string> */\nprotected array $validationAttributes = [\n    'accepted' => 'terms',\n];\n\npublic function updatedEmail(): void\n{\n    $this->validateOnly('email');\n}\n\npublic function save(): void\n{\n    $this->validate();\n}"
                },
                {
                    "type": "code",
                    "language": "blade",
                    "text": "<firstlight:text-field label=\"Name\" native:model.blur=\"name\" />\n<firstlight:text-field\n    label=\"Email\"\n    keyboard=\"email\"\n    content-type=\"email\"\n    autocapitalize=\"none\"\n    :autocorrect=\"false\"\n    native:model.blur=\"email\"\n/>\n<firstlight:checkbox label=\"I agree to the terms\" native:model=\"accepted\" />\n<firstlight:button label=\"Continue\" @press=\"save\" />"
                },
                {
                    "type": "text",
                    "runs": [
                        {
                            "text": "No "
                        },
                        {
                            "text": ":error",
                            "code": true
                        },
                        {
                            "text": " wiring is required. After a failed "
                        },
                        {
                            "text": "validate()",
                            "code": true
                        },
                        {
                            "text": " or "
                        },
                        {
                            "text": "validateOnly()",
                            "code": true
                        },
                        {
                            "text": ", the next published frame fills each field's "
                        },
                        {
                            "text": "error",
                            "code": true
                        },
                        {
                            "text": " from "
                        },
                        {
                            "text": "MessageBag::first($field)",
                            "code": true
                        },
                        {
                            "text": ". "
                        },
                        {
                            "text": "required",
                            "code": true
                        },
                        {
                            "text": " on a field is display metadata only; Laravel "
                        },
                        {
                            "text": "required",
                            "code": true
                        },
                        {
                            "text": ", "
                        },
                        {
                            "text": "accepted",
                            "code": true
                        },
                        {
                            "text": ", and other rules remain the enforcement."
                        }
                    ]
                },
                {
                    "type": "text",
                    "runs": [
                        {
                            "text": "You do not wrap "
                        },
                        {
                            "text": "@press",
                            "code": true
                        },
                        {
                            "text": " handlers in "
                        },
                        {
                            "text": "try",
                            "code": true
                        },
                        {
                            "text": "/"
                        },
                        {
                            "text": "catch",
                            "code": true
                        },
                        {
                            "text": ". Firstlight stores the exception's bag and republishes the screen with field messages."
                        }
                    ]
                }
            ]
        },
        "validate-one-field-on-blur-or-live": {
            "title": "Validate one field on blur or live",
            "blocks": [
                {
                    "type": "text",
                    "runs": [
                        {
                            "text": "updated{Property}",
                            "code": true
                        },
                        {
                            "text": " runs when PHP accepts that property. Pair it with the sync mode that should trigger the check."
                        }
                    ]
                },
                {
                    "type": "text",
                    "text": "Blur publishes on focus loss, then validates only that key:"
                },
                {
                    "type": "code",
                    "language": "blade",
                    "text": "<firstlight:text-field label=\"Email\" native:model.blur=\"email\" />"
                },
                {
                    "type": "code",
                    "language": "php",
                    "text": "public function updatedEmail(): void\n{\n    $this->validateOnly('email');\n}"
                },
                {
                    "type": "text",
                    "text": "Live publishes while editing:"
                },
                {
                    "type": "code",
                    "language": "blade",
                    "text": "<firstlight:text-field label=\"Email\" native:model.live=\"email\" />"
                },
                {
                    "type": "text",
                    "runs": [
                        {
                            "text": "validateOnly('email')",
                            "code": true
                        },
                        {
                            "text": " replaces only the "
                        },
                        {
                            "text": "email",
                            "code": true
                        },
                        {
                            "text": " messages. Other keys already in the bag stay put. A passing "
                        },
                        {
                            "text": "validateOnly()",
                            "code": true
                        },
                        {
                            "text": " clears that key."
                        }
                    ]
                },
                {
                    "type": "text",
                    "runs": [
                        {
                            "text": "You can call "
                        },
                        {
                            "text": "validateOnly()",
                            "code": true
                        },
                        {
                            "text": " from "
                        },
                        {
                            "text": "@change",
                            "code": true
                        },
                        {
                            "text": " or "
                        },
                        {
                            "text": "@submit",
                            "code": true
                        },
                        {
                            "text": " instead of "
                        },
                        {
                            "text": "updated{Property}",
                            "code": true
                        },
                        {
                            "text": " when the field should invoke a named method."
                        }
                    ]
                }
            ]
        },
        "use-a-form-request": {
            "title": "Use a Form Request",
            "blocks": [
                {
                    "type": "text",
                    "runs": [
                        {
                            "text": "Pass a class name to "
                        },
                        {
                            "text": "validate()",
                            "code": true
                        },
                        {
                            "text": " or "
                        },
                        {
                            "text": "validateOnly()",
                            "code": true
                        },
                        {
                            "text": ". Firstlight reads that object's "
                        },
                        {
                            "text": "rules()",
                            "code": true
                        },
                        {
                            "text": ", "
                        },
                        {
                            "text": "messages()",
                            "code": true
                        },
                        {
                            "text": ", and "
                        },
                        {
                            "text": "attributes()",
                            "code": true
                        },
                        {
                            "text": " and runs them against the screen's public properties. It does not perform an HTTP redirect."
                        }
                    ]
                },
                {
                    "type": "code",
                    "language": "php",
                    "text": "use Illuminate\\Foundation\\Http\\FormRequest;\n\nclass StoreSignupRequest extends FormRequest\n{\n    public function rules(): array\n    {\n        return [\n            'name' => 'required|min:2',\n            'email' => 'required|email',\n            'accepted' => 'accepted',\n        ];\n    }\n\n    public function messages(): array\n    {\n        return [\n            'email.required' => 'Need an email address.',\n        ];\n    }\n\n    public function attributes(): array\n    {\n        return [\n            'accepted' => 'terms',\n        ];\n    }\n}"
                },
                {
                    "type": "code",
                    "language": "php",
                    "text": "public function save(): void\n{\n    $this->validate(StoreSignupRequest::class);\n}"
                },
                {
                    "type": "text",
                    "runs": [
                        {
                            "text": "authorize()",
                            "code": true
                        },
                        {
                            "text": " and other Form Request HTTP behaviour are unused. You can also pass a plain class that implements those three methods."
                        }
                    ]
                }
            ]
        },
        "bind-a-different-messagebag-key": {
            "title": "Bind a different MessageBag key",
            "blocks": [
                {
                    "type": "text",
                    "runs": [
                        {
                            "text": "When the rule key differs from the model name, set "
                        },
                        {
                            "text": "error-for",
                            "code": true
                        },
                        {
                            "text": ":"
                        }
                    ]
                },
                {
                    "type": "code",
                    "language": "blade",
                    "text": "<firstlight:text-field\n    label=\"Work email\"\n    native:model=\"email\"\n    error-for=\"contact_email\"\n/>"
                },
                {
                    "type": "code",
                    "language": "php",
                    "text": "protected array $rules = [\n    'contact_email' => 'required|email',\n];"
                },
                {
                    "type": "text",
                    "runs": [
                        {
                            "text": "error-for",
                            "code": true
                        },
                        {
                            "text": " wins over "
                        },
                        {
                            "text": "native:model",
                            "code": true
                        },
                        {
                            "text": " when both are present."
                        }
                    ]
                }
            ]
        },
        "let-an-authored-error-win": {
            "title": "Let an authored error win",
            "blocks": [
                {
                    "type": "text",
                    "runs": [
                        {
                            "text": "A non-empty authored "
                        },
                        {
                            "text": "error",
                            "code": true
                        },
                        {
                            "text": " attribute wins over the MessageBag. Use it for application-specific copy that should not come from Laravel rules:"
                        }
                    ]
                },
                {
                    "type": "code",
                    "language": "blade",
                    "text": "<firstlight:text-field\n    label=\"Email\"\n    native:model=\"email\"\n    error=\"This account is already registered.\"\n/>"
                },
                {
                    "type": "text",
                    "runs": [
                        {
                            "text": "An empty authored "
                        },
                        {
                            "text": "error",
                            "code": true
                        },
                        {
                            "text": " is treated as unset, so the bag can still fill the slot. You can also bind explicitly from the "
                        },
                        {
                            "text": "$errorBag",
                            "code": true
                        },
                        {
                            "text": " the trait shares with the view:"
                        }
                    ]
                },
                {
                    "type": "code",
                    "language": "blade",
                    "text": "<firstlight:text-field\n    label=\"Email\"\n    native:model.blur=\"email\"\n    :error=\"$errorBag->first('email')\"\n/>"
                }
            ]
        },
        "add-and-clear-messages": {
            "title": "Add and clear messages",
            "blocks": [
                {
                    "type": "text",
                    "text": "Use the same bag for server-side checks that are not Laravel rules:"
                },
                {
                    "type": "code",
                    "language": "php",
                    "text": "public function save(): void\n{\n    $this->validate();\n\n    if ($this->emailIsTaken()) {\n        $this->addError('email', 'This account is already registered.');\n\n        return;\n    }\n\n    $this->resetValidation();\n}"
                },
                {
                    "type": "text",
                    "runs": [
                        {
                            "text": "resetValidation('email')",
                            "code": true
                        },
                        {
                            "text": " forgets one key. "
                        },
                        {
                            "text": "resetValidation()",
                            "code": true
                        },
                        {
                            "text": " clears the bag. "
                        },
                        {
                            "text": "hasError('email')",
                            "code": true
                        },
                        {
                            "text": " and "
                        },
                        {
                            "text": "getErrorBag()",
                            "code": true
                        },
                        {
                            "text": " inspect the current messages."
                        }
                    ]
                }
            ]
        },
        "show-form-level-errors": {
            "title": "Show form-level errors",
            "blocks": [
                {
                    "type": "text",
                    "text": "Some failures belong to the form, not one field: wrong credentials, a declined card, a server conflict. Add them under a key no field uses and show that key with a Callout:"
                },
                {
                    "type": "code",
                    "language": "php",
                    "text": "public function signIn(): void\n{\n    $this->validate();\n\n    if (! Auth::attempt(['email' => $this->email, 'password' => $this->password])) {\n        $this->addError('form', 'These credentials do not match our records.');\n    }\n}"
                },
                {
                    "type": "code",
                    "language": "blade",
                    "text": "<firstlight:callout error-for=\"form\" />\n<firstlight:text-field label=\"Email\" native:model.blur=\"email\" />\n<firstlight:text-field label=\"Password\" secure native:model.blur=\"password\" />\n<firstlight:button label=\"Sign in\" @press=\"signIn\" />"
                },
                {
                    "type": "text",
                    "runs": [
                        {
                            "text": "To summarise every message above a long form, use "
                        },
                        {
                            "text": "error-summary",
                            "code": true
                        },
                        {
                            "text": ":"
                        }
                    ]
                },
                {
                    "type": "code",
                    "language": "blade",
                    "text": "<firstlight:callout error-summary />"
                },
                {
                    "type": "text",
                    "runs": [
                        {
                            "text": "The summary lists each key's first message in bag order, which follows your rules, so declare rules in the order the fields appear. One message is shown alone; two or more get a heading such as "
                        },
                        {
                            "text": "There are 3 errors.",
                            "code": true
                        },
                        {
                            "text": " and one message per line."
                        }
                    ]
                },
                {
                    "type": "text",
                    "runs": [
                        {
                            "text": "Both Callouts default to the "
                        },
                        {
                            "text": "danger",
                            "code": true
                        },
                        {
                            "text": " tone, take their text from the bag (so "
                        },
                        {
                            "text": "message",
                            "code": true
                        },
                        {
                            "text": " is rejected), and render nothing while there is nothing to show. You can still set "
                        },
                        {
                            "text": "tone",
                            "code": true
                        },
                        {
                            "text": " or add an "
                        },
                        {
                            "text": "action-label",
                            "code": true
                        },
                        {
                            "text": " with "
                        },
                        {
                            "text": "@press",
                            "code": true
                        },
                        {
                            "text": ". "
                        },
                        {
                            "text": "error-for",
                            "code": true
                        },
                        {
                            "text": " and "
                        },
                        {
                            "text": "error-summary",
                            "code": true
                        },
                        {
                            "text": " cannot be combined."
                        }
                    ]
                }
            ]
        },
        "screen-reader-announcements": {
            "title": "Screen-reader announcements",
            "blocks": [
                {
                    "type": "text",
                    "text": "After a failed interaction, Firstlight announces the errors once:"
                },
                {
                    "type": "item",
                    "marker": "•",
                    "depth": 0,
                    "runs": [
                        {
                            "text": "A press or keyboard submit",
                            "strong": true
                        },
                        {
                            "text": " (Button "
                        },
                        {
                            "text": "@press",
                            "code": true
                        },
                        {
                            "text": ", field "
                        },
                        {
                            "text": "@submit",
                            "code": true
                        },
                        {
                            "text": ") speaks the whole summary, for example "
                        },
                        {
                            "text": "There are 2 errors. The name field is required. The email field is required.",
                            "code": true
                        },
                        {
                            "text": ", and moves screen-reader focus to the first invalid field on the screen."
                        }
                    ]
                },
                {
                    "type": "item",
                    "marker": "•",
                    "depth": 0,
                    "runs": [
                        {
                            "text": "A field update",
                            "strong": true
                        },
                        {
                            "text": " ("
                        },
                        {
                            "text": "native:model.blur",
                            "code": true
                        },
                        {
                            "text": ", "
                        },
                        {
                            "text": ".live",
                            "code": true
                        },
                        {
                            "text": ", "
                        },
                        {
                            "text": "@change",
                            "code": true
                        },
                        {
                            "text": ", and "
                        },
                        {
                            "text": "updated{Property}",
                            "code": true
                        },
                        {
                            "text": " hooks) speaks only the message that update just added and leaves focus where it is."
                        }
                    ]
                },
                {
                    "type": "text",
                    "text": "On iOS, VoiceOver focus moves to the first invalid field and the announcement follows it; the keyboard does not open. On Android, while TalkBack is on, Text Field, Text Area, and Code Editor take input focus, which TalkBack follows and reads with the error, and the keyboard opens; other fields only announce, because Android moves focus only to editable text. Nothing is spoken when no message was added, and republishing the same screen does not repeat the announcement."
                },
                {
                    "type": "text",
                    "runs": [
                        {
                            "text": "The summary heading is package chrome. Translate it by publishing the language files (see "
                        },
                        {
                            "text": "Localize chrome",
                            "link": 2
                        },
                        {
                            "text": ") and editing "
                        },
                        {
                            "text": "lang/vendor/firstlight/{locale}/validation.php",
                            "code": true
                        },
                        {
                            "text": "."
                        }
                    ]
                },
                {
                    "type": "text",
                    "runs": [
                        {
                            "text": "The "
                        },
                        {
                            "text": "/captures/form-errors",
                            "code": true
                        },
                        {
                            "text": " showcase route shows a summary above failed fields:"
                        }
                    ]
                },
                {
                    "type": "image",
                    "src": "documentation/screenshots/form-errors/ios-light.png",
                    "text": "Form error summary on iOS in light mode"
                },
                {
                    "type": "image",
                    "src": "documentation/screenshots/form-errors/ios-dark.png",
                    "text": "Form error summary on iOS in dark mode"
                },
                {
                    "type": "image",
                    "src": "documentation/screenshots/form-errors/android-light.png",
                    "text": "Form error summary on Android in light mode"
                },
                {
                    "type": "image",
                    "src": "documentation/screenshots/form-errors/android-dark.png",
                    "text": "Form error summary on Android in dark mode"
                }
            ]
        },
        "do-not-validate-during-mount-or-render": {
            "title": "Do not validate during mount or render",
            "blocks": [
                {
                    "type": "text",
                    "runs": [
                        {
                            "text": "mount()",
                            "code": true
                        },
                        {
                            "text": " and "
                        },
                        {
                            "text": "render()",
                            "code": true
                        },
                        {
                            "text": " still sit on NativePHP's generic "
                        },
                        {
                            "text": "Throwable",
                            "code": true
                        },
                        {
                            "text": " overlay path. Throwing "
                        },
                        {
                            "text": "ValidationException",
                            "code": true
                        },
                        {
                            "text": " there paints the red error overlay instead of field messages. Call "
                        },
                        {
                            "text": "validate()",
                            "code": true
                        },
                        {
                            "text": " and "
                        },
                        {
                            "text": "validateOnly()",
                            "code": true
                        },
                        {
                            "text": " from actions, "
                        },
                        {
                            "text": "@submit",
                            "code": true
                        },
                        {
                            "text": " / "
                        },
                        {
                            "text": "@change",
                            "code": true
                        },
                        {
