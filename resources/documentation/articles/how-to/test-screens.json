{
    "id": "how-to/test-screens",
    "title": "Test Firstlight screens",
    "description": "Scaffold a screen with make:firstlight-screen and test its fields, lists, dialogs, and Feedback with Native::test().",
    "group": "Guides",
    "anchors": {
        "test-firstlight-screens": "overview",
        "scaffold-a-screen": "scaffold-a-screen",
        "register-the-checks": "register-the-checks",
        "test-a-form": "test-a-form",
        "test-a-list-and-its-destructive-action": "test-a-list-and-its-destructive-action"
    },
    "chapters": {
        "overview": {
            "title": "Overview",
            "blocks": [
                {
                    "type": "text",
                    "runs": [
                        {
                            "text": "Firstlight screens are tested with NativePHP's screen test harness, "
                        },
                        {
                            "text": "Native\\Mobile\\Testing\\Native::test()",
                            "code": true
                        },
                        {
                            "text": ". The harness mounts the screen, renders the Element Tree, and sends taps and input through the same callbacks a device uses. Firstlight adds checks for its own controls: field errors, List rows, Confirmation Dialog, and Feedback."
                        }
                    ]
                }
            ]
        },
        "scaffold-a-screen": {
            "title": "Scaffold a screen",
            "blocks": [
                {
                    "type": "code",
                    "language": "bash",
                    "text": "php artisan make:firstlight-screen Posts --form --destroy --test"
                },
                {
                    "type": "text",
                    "text": "This creates the following files:"
                },
                {
                    "type": "item",
                    "marker": "•",
                    "depth": 0,
                    "runs": [
                        {
                            "text": "app/NativeComponents/Posts.php",
                            "code": true
                        },
                        {
                            "text": ": a "
                        },
                        {
                            "text": "FirstlightUI\\NativeComponent",
                            "code": true
                        },
                        {
                            "text": " with a validated "
                        },
                        {
                            "text": "name",
                            "code": true
                        },
                        {
                            "text": " field and "
                        },
                        {
                            "text": "save()",
                            "code": true
                        },
                        {
                            "text": " ("
                        },
                        {
                            "text": "--form",
                            "code": true
                        },
                        {
                            "text": "), and paginated "
                        },
                        {
                            "text": "reload()",
                            "code": true
                        },
                        {
                            "text": ", "
                        },
                        {
                            "text": "loadMore()",
                            "code": true
                        },
                        {
                            "text": ", and "
                        },
                        {
                            "text": "listQuery()",
                            "code": true
                        },
                        {
                            "text": " ("
                        },
                        {
                            "text": "--list",
                            "code": true
                        },
                        {
                            "text": "). It also has "
                        },
                        {
                            "text": "requestDeletion()",
                            "code": true
                        },
                        {
                            "text": ", "
                        },
                        {
                            "text": "cancelDeletion()",
                            "code": true
                        },
                        {
                            "text": ", and "
                        },
                        {
                            "text": "deleteItem()",
                            "code": true
                        },
                        {
                            "text": " ("
                        },
                        {
                            "text": "--destroy",
                            "code": true
                        },
                        {
                            "text": ", which turns on "
                        },
                        {
                            "text": "--list",
                            "code": true
                        },
                        {
                            "text": ")."
                        }
                    ]
                },
                {
                    "type": "item",
                    "marker": "•",
                    "depth": 0,
                    "runs": [
                        {
                            "text": "resources/views/native/posts.blade.php",
                            "code": true
                        },
                        {
                            "text": ": the matching Text Field, Button, List, and Confirmation Dialog markup."
                        }
                    ]
                },
                {
                    "type": "item",
                    "marker": "•",
                    "depth": 0,
                    "runs": [
                        {
                            "text": "tests/Feature/NativeComponents/PostsTest.php",
                            "code": true
                        },
                        {
                            "text": ": a Pest test that uses the checks below ("
                        },
                        {
                            "text": "--test",
                            "code": true
                        },
                        {
                            "text": ")."
                        }
                    ]
                },
                {
                    "type": "text",
                    "runs": [
                        {
                            "text": "Nested names such as "
                        },
                        {
                            "text": "Settings/Notifications",
                            "code": true
                        },
                        {
                            "text": " create "
                        },
                        {
                            "text": "App\\NativeComponents\\Settings\\Notifications",
                            "code": true
                        },
                        {
                            "text": " and the view "
                        },
                        {
                            "text": "native.settings.notifications",
                            "code": true
                        },
                        {
                            "text": ". The command does not overwrite existing files unless you pass "
                        },
                        {
                            "text": "--force",
                            "code": true
                        },
                        {
                            "text": ". Register the route it prints in "
                        },
                        {
                            "text": "routes/mobile.php",
                            "code": true
                        },
                        {
                            "text": "."
                        }
                    ]
                },
                {
                    "type": "text",
                    "runs": [
                        {
                            "text": "Replace the body of "
                        },
                        {
                            "text": "listQuery()",
                            "code": true
                        },
                        {
                            "text": " with your paginator query, for example "
                        },
                        {
                            "text": "Post::query()->latest()->paginate(perPage: 20, page: $page->page)",
                            "code": true
                        },
                        {
                            "text": "."
                        }
                    ]
                }
            ]
        },
        "register-the-checks": {
            "title": "Register the checks",
            "blocks": [
                {
                    "type": "text",
                    "runs": [
                        {
                            "text": "Register the Firstlight checks once from "
                        },
                        {
                            "text": "tests/Pest.php",
                            "code": true
                        },
                        {
                            "text": ":"
                        }
                    ]
                },
                {
                    "type": "code",
                    "language": "php",
                    "text": "FirstlightUI\\Testing\\ScreenAssertions::register();"
                },
                {
                    "type": "text",
                    "runs": [
                        {
                            "text": "Calling it again has no effect. The generated test also calls it in "
                        },
                        {
                            "text": "beforeEach()",
                            "code": true
                        },
                        {
                            "text": "."
                        }
                    ]
                }
            ]
        },
        "test-a-form": {
            "title": "Test a form",
            "blocks": [
                {
                    "type": "code",
                    "language": "php",
                    "text": "use App\\NativeComponents\\EditProfile;\nuse FirstlightUI\\Facades\\Feedback;\nuse FirstlightUI\\Feedback\\FeedbackTone;\nuse Native\\Mobile\\Testing\\Native;\n\nit('validates and saves the profile', function () {\n    Feedback::fake();\n\n    Native::test(EditProfile::class)\n        ->input('email', 'not-an-email')\n        ->tap('Save')\n        ->assertFieldError('email', 'The email must be a valid email address.')\n        ->assertNoFeedbackSent()\n        ->input('email', 'ada@example.com')\n        ->tap('Save')\n        ->assertNoFieldError('email')\n        ->assertHasNoErrors()\n        ->assertFeedbackSent('Profile saved', FeedbackTone::Success);\n});"
                },
                {
                    "type": "text",
                    "runs": [
                        {
                            "text": "assertFieldError()",
                            "code": true
                        },
                        {
                            "text": " reads the "
                        },
                        {
                            "text": "error",
                            "code": true
                        },
                        {
                            "text": " value the field shows in the rendered tree, so it confirms the message reached the control, not only the MessageBag. Use "
                        },
                        {
                            "text": "assertHasErrors()",
                            "code": true
                        },
                        {
                            "text": " to check the bag directly."
                        }
                    ]
                },
                {
                    "type": "text",
                    "text": "Select a Select, Segmented, Pill Group, or Choice Group option by its stable value, never by its label or position:"
                },
                {
                    "type": "code",
                    "language": "php",
                    "text": "Native::test(EditProfile::class)\n    ->choose('plan', 'team')\n    ->assertSet('plan', 'team');"
                }
            ]
        },
        "test-a-list-and-its-destructive-action": {
            "title": "Test a list and its destructive action",
            "blocks": [
                {
                    "type": "code",
                    "language": "php",
                    "text": "it('deletes a post after confirmation', function () {\n    Feedback::fake();\n\n    Native::test(PostsScreen::class)\n        ->assertListItem('Draft', fn (array $row) => $row['props']['disabled'] === false)\n        ->pressListItem('Draft', 'Delete')\n        ->assertConfirmationDialog('Delete post?')\n        ->confirmDialog()\n        ->assertMissingListItem('Draft')\n        ->assertFeedbackSent('Post deleted');\n});"
                },
                {
                    "type": "text",
                    "runs": [
                        {
                            "text": "pressListItem('Draft')",
                            "code": true
                        },
                        {
                            "text": " presses the row. Pass a swipe action label as the second argument to press that action. Both fail when the row is disabled, as the device would ignore the press. "
                        },
                        {
                            "text": "cancelDialog()",
                            "code": true
                        },
                        {
                            "text": " sends the dismissal that both platforms send for Cancel and system dismissal."
                        }
                    ]
                },
                {
                    "type": "text",
                    "runs": [
                        {
                            "text": "See "
                        },
                        {
                            "text": "Screen assertions",
                            "link": 0
                        },
                        {
                            "text": " for every method."
                        }
                    ]
                }
            ]
        }
    },
    "links": [
        {
            "label": "Screen assertions",
            "url": "../reference/screen-assertions.md"
        }
    ]
}
