                            "code": true
                        },
                        {
                            "text": ", "
                        },
                        {
                            "text": "connectivity_offline_waiting",
                            "code": true
                        },
                        {
                            "text": ", "
                        },
                        {
                            "text": "connectivity_syncing",
                            "code": true
                        },
                        {
                            "text": ", "
                        },
                        {
                            "text": "connectivity_failed",
                            "code": true
                        },
                        {
                            "text": ", "
                        },
                        {
                            "text": "sync_succeeded",
                            "code": true
                        },
                        {
                            "text": ", "
                        },
                        {
                            "text": "sync_failed",
                            "code": true
                        },
                        {
                            "text": ", "
                        },
                        {
                            "text": "sync_review",
                            "code": true
                        },
                        {
                            "text": ", "
                        },
                        {
                            "text": "sync_waiting_label",
                            "code": true
                        },
                        {
                            "text": ", and "
                        },
                        {
                            "text": "sync_failed_label",
                            "code": true
                        },
                        {
                            "text": " in "
                        },
                        {
                            "text": "lang/vendor/firstlight/{locale}/chrome.php",
                            "code": true
                        },
                        {
                            "text": ", as described in "
                        },
                        {
                            "text": "Localize chrome",
                            "link": 2
                        },
                        {
                            "text": ". Counted strings use Laravel plural forms, such as "
                        },
                        {
                            "text": "Synced :count change.|Synced :count changes.",
                            "code": true
                        },
                        {
                            "text": "."
                        }
                    ]
                }
            ]
        },
        "test-it": {
            "title": "Test it",
            "blocks": [
                {
                    "type": "text",
                    "runs": [
                        {
                            "text": "Connectivity::fake()",
                            "code": true
                        },
                        {
                            "text": " starts online and drives the transitions:"
                        }
                    ]
                },
                {
                    "type": "code",
                    "language": "php",
                    "text": "use App\\NativeComponents\\ServersScreen;\nuse FirstlightUI\\Facades\\Connectivity;\nuse Illuminate\\Support\\Facades\\Http;\nuse Native\\Mobile\\Testing\\Native;\n\nit('loads the servers when the device comes back online', function () {\n    $online = false;\n    Http::fake(function () use (&$online) {\n        return $online\n            ? Http::response(['data' => [['id' => 1, 'name' => 'web-1']]])\n            : Http::failedConnection();\n    });\n\n    $connectivity = Connectivity::fake()->goOffline();\n    $screen = Native::test(ServersScreen::class)->assertSet('servers', []);\n\n    $online = true;\n    $connectivity->goOnline();\n\n    $screen->assertSet('servers', [['id' => 1, 'name' => 'web-1']]);\n});"
                },
                {
                    "type": "text",
                    "runs": [
                        {
                            "text": "goOffline()",
                            "code": true
                        },
                        {
                            "text": ", "
                        },
                        {
                            "text": "goOnline()",
                            "code": true
                        },
                        {
                            "text": ", "
                        },
                        {
                            "text": "goUnknown()",
                            "code": true
                        },
                        {
                            "text": ", and "
                        },
                        {
                            "text": "foreground($secondsAway)",
                            "code": true
                        },
                        {
                            "text": " mirror what the device sends. The fake keeps your "
                        },
                        {
                            "text": "pendingUsing()",
                            "code": true
                        },
                        {
                            "text": " queue."
                        }
                    ]
                }
            ]
        }
    },
