{
    "id": "how-to/paginate-lists",
    "title": "Paginate Firstlight lists",
    "description": "Bind Laravel paginators to List pull-to-refresh and end-reached without a new Firstlight tag.",
    "group": "Guides",
    "anchors": {
        "paginate-firstlight-lists": "overview",
        "declare-the-screen": "declare-the-screen",
        "render-the-rows": "render-the-rows",
        "cursor-pagination": "cursor-pagination"
    },
    "chapters": {
        "overview": {
            "title": "Overview",
            "blocks": [
                {
                    "type": "text",
                    "runs": [
                        {
                            "text": "Firstlight paginates lists in PHP. List already exposes "
                        },
                        {
                            "text": "@refresh",
                            "code": true
                        },
                        {
                            "text": " and "
                        },
                        {
                            "text": "@endReached",
                            "code": true
                        },
                        {
                            "text": ". The helper accumulates Laravel paginator pages into "
                        },
                        {
                            "text": "$this->listItems",
                            "code": true
                        },
                        {
                            "text": " so Blade can render ordinary List Item rows."
                        }
                    ]
                },
                {
                    "type": "text",
                    "runs": [
                        {
                            "text": "There is no "
                        },
                        {
                            "text": "<firstlight:empty>",
                            "code": true
                        },
                        {
                            "text": " tag and no second scroll-event API."
                        }
                    ]
                },
                {
                    "type": "text",
                    "runs": [
                        {
                            "text": "Paginate when rows come from a remote API with cursors or no known total. Every loaded page stays in the published tree, so for thousands of local records use a virtual list instead; see "
                        },
                        {
                            "text": "Build a large list screen",
                            "link": 0
                        },
                        {
                            "text": "."
                        }
                    ]
                }
            ]
        },
        "declare-the-screen": {
            "title": "Declare the screen",
            "blocks": [
                {
                    "type": "text",
                    "runs": [
                        {
                            "text": "Extend "
                        },
                        {
                            "text": "FirstlightUI\\NativeComponent",
                            "code": true
                        },
                        {
                            "text": " (or "
                        },
                        {
                            "text": "use PaginatesLists",
                            "code": true
                        },
                        {
                            "text": "):"
                        }
                    ]
                },
                {
                    "type": "code",
                    "language": "php",
                    "text": "<?php\n\nnamespace App\\Native;\n\nuse App\\Models\\Conversation;\nuse FirstlightUI\\NativeComponent;\nuse FirstlightUI\\Pagination\\ListPage;\n\nclass InboxScreen extends NativeComponent\n{\n    public function mount(): void\n    {\n        $this->reload();\n    }\n\n    public function reload(): void\n    {\n        $this->refreshList(\n            fn (ListPage $page) => Conversation::query()->latest()->paginate(\n                perPage: 20,\n                page: $page->page,\n            ),\n        );\n    }\n\n    public function loadMore(): void\n    {\n        $this->loadMoreList(\n            fn (ListPage $page) => Conversation::query()->latest()->paginate(\n                perPage: 20,\n                page: $page->page,\n            ),\n        );\n    }\n}"
                },
                {
                    "type": "text",
                    "runs": [
                        {
                            "text": "refreshList()",
                            "code": true
                        },
                        {
                            "text": " replaces "
                        },
                        {
                            "text": "$this->listItems",
                            "code": true
                        },
                        {
                            "text": " with the first page. "
                        },
                        {
                            "text": "loadMoreList()",
                            "code": true
                        },
                        {
                            "text": " appends the next page. Both return "
                        },
                        {
                            "text": "false",
                            "code": true
                        },
                        {
                            "text": " when a fetch is already running. "
                        },
                        {
                            "text": "loadMoreList()",
                            "code": true
                        },
                        {
                            "text": " also returns "
                        },
                        {
                            "text": "false",
                            "code": true
                        },
                        {
                            "text": " without querying when "
                        },
                        {
                            "text": "$this->listHasMore",
                            "code": true
                        },
                        {
                            "text": " is "
                        },
                        {
                            "text": "false",
                            "code": true
                        },
                        {
                            "text": "."
                        }
                    ]
                },
                {
                    "type": "text",
                    "runs": [
                        {
                            "text": "Pass the paginator's "
                        },
                        {
                            "text": "page",
                            "code": true
                        },
                        {
                            "text": " from "
                        },
                        {
                            "text": "ListPage",
                            "code": true
                        },
                        {
                            "text": ". NativePHP has no HTTP "
                        },
                        {
                            "text": "?page=",
                            "code": true
                        },
                        {
                            "text": " query string for these events."
                        }
                    ]
                }
            ]
        },
        "render-the-rows": {
            "title": "Render the rows",
            "blocks": [
                {
                    "type": "code",
                    "language": "blade",
                    "text": "@if (count($this->listItems) === 0)\n    <firstlight:status-label\n        label=\"No conversations yet\"\n        tone=\"neutral\"\n    />\n    <firstlight:callout\n        message=\"Pull to refresh after you add a conversation.\"\n        tone=\"info\"\n    />\n@endif\n\n<firstlight:list separator @refresh=\"reload\" @endReached=\"loadMore\">\n    @foreach ($this->listItems as $conversation)\n        <firstlight:list-item\n            :headline=\"$conversation->title\"\n            @press=\"openConversation\"\n        />\n    @endforeach\n</firstlight:list>"
                },
                {
                    "type": "text",
                    "runs": [
                        {
                            "text": "Keep "
                        },
                        {
                            "text": "@endReached",
                            "code": true
                        },
                        {
                            "text": " bound even on the last page. Extra events are ignored."
                        }
                    ]
                },
                {
                    "type": "text",
                    "text": "Empty copy is ordinary Blade around List. Compose Status Label, Callout, and Button when you need a retry action."
                }
            ]
        },
        "cursor-pagination": {
            "title": "Cursor pagination",
            "blocks": [
                {
                    "type": "text",
                    "runs": [
                        {
                            "text": "ListPage::$cursor",
                            "code": true
                        },
                        {
                            "text": " is "
                        },
                        {
                            "text": "null",
                            "code": true
                        },
                        {
                            "text": " on refresh and the previous paginator's next cursor afterward. Pass it through to "
                        },
                        {
                            "text": "cursorPaginate()",
                            "code": true
                        },
                        {
                            "text": ":"
                        }
                    ]
                },
                {
                    "type": "code",
                    "language": "php",
                    "text": "use Illuminate\\Pagination\\Cursor;\n\n$this->refreshList(\n    fn (ListPage $page) => Conversation::query()->latest()->cursorPaginate(\n        perPage: 20,\n        cursor: $page->cursor !== null ? Cursor::fromEncoded($page->cursor) : null,\n    ),\n);"
                },
                {
                    "type": "text",
                    "runs": [
                        {
                            "text": "Use the same callable with "
                        },
                        {
                            "text": "loadMoreList()",
                            "code": true
                        },
                        {
                            "text": "."
                        }
                    ]
                },
                {
                    "type": "text",
                    "runs": [
                        {
                            "text": "Unexpected exceptions from the query are not converted to Feedback. Screens that extend NativePHP's component directly can opt in with "
                        },
                        {
                            "text": "FirstlightUI\\Concerns\\PaginatesLists",
                            "code": true
                        },
                        {
                            "text": "."
                        }
                    ]
                },
                {
                    "type": "text",
                    "runs": [
                        {
                            "text": "To delete a row after Confirmation Dialog authorization, see "
                        },
                        {
                            "text": "Destroy list items",
                            "link": 1
                        },
                        {
                            "text": "."
                        }
                    ]
                }
            ]
        }
    },
