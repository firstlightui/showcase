{
    "id": "how-to/localize",
    "title": "Localize Firstlight chrome",
    "description": "Override Firstlight-owned chrome labels and inherit application locale and timezone for Date and Time pickers.",
    "group": "Guides",
    "anchors": {
        "localize-firstlight-chrome": "overview",
        "publish-the-language-files": "publish-the-language-files",
        "date-and-time-picker-locale-and-timezone": "date-and-time-picker-locale-and-timezone"
    },
    "chapters": {
        "overview": {
            "title": "Overview",
            "blocks": [
                {
                    "type": "text",
                    "runs": [
                        {
                            "text": "Firstlight-owned chrome (Confirm, Cancel, OK, dismiss, clear, skip, Done, crop, zoom, media source chooser, and password reveal) comes from one Laravel language file. Authored labels on Confirmation Dialog and Alert Dialog still win. Date Picker and Time Picker keep rejecting Blade "
                        },
                        {
                            "text": "confirm-label",
                            "code": true
                        },
                        {
                            "text": " and "
                        },
                        {
                            "text": "cancel-label",
                            "code": true
                        },
                        {
                            "text": "; their sheet buttons are package chrome only."
                        }
                    ]
                },
                {
                    "type": "text",
                    "text": "The package ships English. There is no translation UI. Applications add other locales through Laravel vendor language publishing."
                }
            ]
        },
        "publish-the-language-files": {
            "title": "Publish the language files",
            "blocks": [
                {
                    "type": "code",
                    "language": "bash",
                    "text": "php artisan vendor:publish --tag=firstlight-lang"
                },
                {
                    "type": "text",
                    "runs": [
                        {
                            "text": "Laravel copies the files to "
                        },
                        {
                            "text": "lang/vendor/firstlight",
                            "code": true
                        },
                        {
                            "text": ". "
                        },
                        {
                            "text": "validation.php",
                            "code": true
                        },
                        {
                            "text": " holds the pluralised error summary heading ("
                        },
                        {
                            "text": "'summary' => 'There is :count error.|There are :count errors.'",
                            "code": true
                        },
                        {
                            "text": ") used by "
                        },
                        {
                            "text": "error-summary",
                            "code": true
                        },
                        {
                            "text": " Callouts and screen-reader announcements. Add a locale next to English, for example "
                        },
                        {
                            "text": "lang/vendor/firstlight/fr/chrome.php",
                            "code": true
                        },
                        {
                            "text": ", and keep the same keys:"
                        }
                    ]
                },
                {
                    "type": "code",
                    "language": "php",
                    "text": "<?php\n\nreturn [\n    'confirm' => 'Confirmer',\n    'cancel' => 'Annuler',\n    'ok' => 'OK',\n    'dismiss' => 'Fermer',\n    'dismiss_feedback' => 'Fermer le message',\n    'clear' => 'Effacer',\n    'clear_search' => 'Effacer la recherche',\n    'clear_text' => 'Effacer le texte',\n    'skip' => 'Ignorer',\n    'done' => 'OK',\n    'crop' => 'Recadrer',\n    'zoom_in' => 'Zoom avant',\n    'zoom_out' => 'Zoom arrière',\n    'choose_media' => 'Choisir un média',\n    'photo_library' => 'Photothèque',\n    'camera' => 'Appareil photo',\n    'browse_files' => 'Parcourir les fichiers',\n    'show_password' => 'Afficher le mot de passe',\n    'hide_password' => 'Masquer le mot de passe',\n];"
                },
                {
                    "type": "text",
                    "text": "Missing keys fall back to the packaged English strings."
                }
            ]
        },
        "date-and-time-picker-locale-and-timezone": {
            "title": "Date and Time picker locale and timezone",
            "blocks": [
                {
                    "type": "text",
                    "runs": [
                        {
                            "text": "When "
                        },
                        {
                            "text": "locale",
                            "code": true
                        },
                        {
                            "text": " or "
                        },
                        {
                            "text": "timezone",
                            "code": true
                        },
                        {
                            "text": " is omitted, Date Picker and Time Picker inherit the application:"
                        }
                    ]
                },
                {
                    "type": "item",
                    "marker": "•",
                    "depth": 0,
                    "runs": [
                        {
                            "text": "locale from the translator ("
                        },
                        {
                            "text": "en_AU",
                            "code": true
                        },
                        {
                            "text": " and "
                        },
                        {
                            "text": "en_AU.UTF-8",
                            "code": true
                        },
                        {
                            "text": " become "
                        },
                        {
                            "text": "en-AU",
                            "code": true
                        },
                        {
                            "text": ")"
                        }
                    ]
                },
                {
                    "type": "item",
                    "marker": "•",
                    "depth": 0,
                    "runs": [
                        {
                            "text": "timezone from "
                        },
                        {
                            "text": "config('app.timezone')",
                            "code": true
                        },
                        {
                            "text": " when it is a real IANA identifier"
                        }
                    ]
                },
                {
                    "type": "text",
                    "runs": [
                        {
                            "text": "Explicit picker props still win. Invalid inherited values are omitted so the device calendar and clock are used; they do not throw. Authored malformed "
                        },
                        {
                            "text": "locale",
                            "code": true
                        },
                        {
                            "text": " or "
                        },
                        {
                            "text": "timezone",
                            "code": true
                        },
                        {
                            "text": " attributes still fail before publication."
                        }
                    ]
                },
                {
                    "type": "text",
                    "runs": [
                        {
                            "text": "Authored field labels, helpers, errors, dialog titles, and Feedback messages are ordinary Blade strings; translate those with "
                        },
                        {
                            "text": "__()",
                            "code": true
                        },
                        {
                            "text": " as you already would."
                        }
                    ]
                }
            ]
        }
    },
    "links": []
}
