{
    "id": "how-to/authorize-actions",
    "title": "Authorize Firstlight actions",
    "description": "Apply Laravel Gate and Policy decisions to Firstlight actions with explicit hide, disable, and destructive confirmation patterns.",
    "group": "Guides",
    "anchors": {
        "authorize-firstlight-actions": "overview",
        "choose-hide-or-disable": "choose-hide-or-disable",
        "keep-destructive-actions-visible": "keep-destructive-actions-visible"
    },
    "chapters": {
        "overview": {
            "title": "Overview",
            "blocks": [
                {
                    "type": "text",
                    "runs": [
                        {
                            "text": "Extend "
                        },
                        {
                            "text": "FirstlightUI\\NativeComponent",
                            "code": true
                        },
                        {
                            "text": " (or "
                        },
                        {
                            "text": "use AuthorizesActions",
                            "code": true
                        },
                        {
                            "text": ") so a screen can evaluate the current Laravel Gate or Policy before publishing or performing an action:"
                        }
                    ]
                },
                {
                    "type": "code",
                    "language": "php",
                    "text": "use App\\Models\\Post;\nuse FirstlightUI\\NativeComponent;\n\nclass PostScreen extends NativeComponent\n{\n    public Post $post;\n    public bool $confirmingDeletion = false;\n\n    public function updatePost(): void\n    {\n        if (! $this->authorize('update', $this->post)) {\n            return;\n        }\n\n        $this->post->save();\n    }\n}"
                },
                {
                    "type": "text",
                    "runs": [
                        {
                            "text": "allows()",
                            "code": true
                        },
                        {
                            "text": " and "
                        },
                        {
                            "text": "denies()",
                            "code": true
                        },
                        {
                            "text": " return booleans. "
                        },
                        {
                            "text": "authorize()",
                            "code": true
                        },
                        {
                            "text": " also returns a boolean; unlike Laravel's throwing Gate method, a denial publishes danger Feedback with "
                        },
                        {
                            "text": "This action is unauthorized.",
                            "code": true
                        },
                        {
                            "text": " and returns "
                        },
                        {
                            "text": "false",
                            "code": true
                        },
                        {
                            "text": ". Keep the guard at the start of every PHP action, even when the published control is already hidden or disabled, because authorization can change after a frame is published."
                        }
                    ]
                }
            ]
        },
        "choose-hide-or-disable": {
            "title": "Choose hide or disable",
            "blocks": [
                {
                    "type": "text",
                    "text": "Hide an ordinary action when its absence is unsurprising:"
                },
                {
                    "type": "code",
                    "language": "blade",
                    "text": "@if ($this->allows('edit', $post))\n    <firstlight:button @press=\"editPost\">\n        Edit post\n    </firstlight:button>\n@endif"
                },
                {
                    "type": "text",
                    "text": "Disable an action when preserving its location helps explain the available workflow:"
                },
                {
                    "type": "code",
                    "language": "blade",
                    "text": "<firstlight:list-item\n    headline=\"Publishing settings\"\n    supporting=\"Only editors can change publication access\"\n    :disabled=\"$this->denies('update', $post)\"\n    @press=\"openPublishingSettings\"\n/>"
                },
                {
                    "type": "text",
                    "runs": [
                        {
                            "text": "Button, Icon Button, and List Item all accept the existing "
                        },
                        {
                            "text": "disabled",
                            "code": true
                        },
                        {
                            "text": " prop. Firstlight does not add a "
                        },
                        {
                            "text": "can",
                            "code": true
                        },
                        {
                            "text": " attribute or evaluate authorization in a native renderer."
                        }
                    ]
                }
            ]
        },
        "keep-destructive-actions-visible": {
            "title": "Keep destructive actions visible",
            "blocks": [
                {
                    "type": "text",
                    "text": "Never silently omit a destructive action. Keep the Button, Icon Button, or List Item visible and disable it when denied. Supporting copy should explain why the action is unavailable when the surrounding interface does not make that clear."
                },
                {
                    "type": "code",
                    "language": "blade",
                    "text": "<firstlight:button\n    variant=\"destructive\"\n    :disabled=\"$this->denies('delete', $post)\"\n    @press=\"requestDeletion\"\n>\n    Delete post\n</firstlight:button>"
                },
                {
                    "type": "text",
                    "runs": [
                        {
                            "text": "Confirmation Dialog has no "
                        },
                        {
                            "text": "disabled",
                            "code": true
                        },
                        {
                            "text": " or "
                        },
                        {
                            "text": "loading",
                            "code": true
                        },
                        {
                            "text": " prop. Authorize before setting its "
                        },
                        {
                            "text": "visible",
                            "code": true
                        },
                        {
                            "text": " state, and authorize again when confirmation arrives:"
                        }
                    ]
                },
                {
                    "type": "code",
                    "language": "php",
                    "text": "public function requestDeletion(): void\n{\n    if (! $this->authorize('delete', $this->post)) {\n        $this->confirmingDeletion = false;\n\n        return;\n    }\n\n    $this->confirmingDeletion = true;\n}\n\npublic function deletePost(): void\n{\n    $this->confirmingDeletion = false;\n\n    if (! $this->authorize('delete', $this->post)) {\n        return;\n    }\n\n    $this->post->delete();\n}\n\npublic function cancelDeletion(): void\n{\n    $this->confirmingDeletion = false;\n}"
                },
                {
                    "type": "code",
                    "language": "blade",
                    "text": "<firstlight:confirmation-dialog\n    :visible=\"$confirmingDeletion\"\n    title=\"Delete post?\"\n    message=\"This action cannot be undone.\"\n    confirm-label=\"Delete\"\n    cancel-label=\"Keep post\"\n    tone=\"destructive\"\n    @press=\"deletePost\"\n    @dismiss=\"cancelDeletion\"\n/>"
                },
                {
                    "type": "text",
                    "runs": [
                        {
                            "text": "The denied request does not open the dialog, and "
                        },
                        {
                            "text": "authorize()",
                            "code": true
                        },
                        {
                            "text": " supplies danger Feedback instead of allowing an uncaught "
                        },
                        {
                            "text": "AuthorizationException",
                            "code": true
                        },
                        {
                            "text": " to reach NativePHP's error overlay."
                        }
                    ]
                },
                {
                    "type": "text",
                    "runs": [
                        {
                            "text": "For deleting rows from an accumulated "
                        },
                        {
                            "text": "$listItems",
                            "code": true
                        },
                        {
                            "text": " collection by stable key, use "
                        },
                        {
                            "text": "Destroy list items",
                            "link": 0
                        },
                        {
                            "text": "."
                        }
                    ]
                }
            ]
        }
    },
    "links": [
        {
            "label": "Destroy list items",
            "url": "destroy-list-items.md"
        }
    ]
}
