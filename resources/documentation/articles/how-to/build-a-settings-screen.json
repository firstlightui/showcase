{
    "id": "how-to/build-a-settings-screen",
    "title": "Build a settings screen",
    "description": "Recipe for a grouped settings screen with native section headers and footers, Switch and Select rows, and save-on-change.",
    "group": "Guides",
    "anchors": {
        "build-a-settings-screen": "overview",
        "how-the-pieces-fit": "how-the-pieces-fit",
        "1-register-the-route": "1-register-the-route",
        "2-write-the-screen": "2-write-the-screen",
        "3-write-the-view": "3-write-the-view",
        "what-each-platform-shows": "what-each-platform-shows",
        "rules-to-keep": "rules-to-keep"
    },
    "chapters": {
        "overview": {
            "title": "Overview",
            "blocks": [
                {
                    "type": "text",
                    "text": "This recipe builds a standard settings screen: grouped sections with headers and footers, switches and pickers that save as soon as they change, and rows that open other screens."
                },
                {
                    "type": "text",
                    "runs": [
                        {
                            "text": "This recipe runs unchanged in the "
                        },
                        {
                            "text": "showcase app",
                            "link": 0
                        },
                        {
                            "text": ", where "
                        },
                        {
                            "text": "SettingsRecipeTest",
                            "link": 1,
                            "code": true
                        },
                        {
                            "text": " exercises it."
                        }
                    ]
                },
                {
                    "type": "text",
                    "runs": [
                        {
                            "text": "Use it for preferences the user changes one at a time. Use the "
                        },
                        {
                            "text": "form recipe",
                            "link": 2
                        },
                        {
                            "text": " instead when several fields must be validated and saved together with a button."
                        }
                    ]
                }
            ]
        },
        "how-the-pieces-fit": {
            "title": "How the pieces fit",
            "blocks": [
                {
                    "type": "text",
                    "runs": [
                        {
                            "text": "Settings controls are not List Item rows, so the container is Mobile UI's "
                        },
                        {
                            "text": "native:list",
                            "code": true
                        },
                        {
                            "text": " with "
                        },
                        {
                            "text": "native:list-section",
                            "code": true
                        },
                        {
                            "text": ", not "
                        },
                        {
                            "text": "firstlight:list",
                            "code": true
                        },
                        {
                            "text": ". Mobile UI renders that container with a SwiftUI "
                        },
                        {
                            "text": "List",
                            "code": true
                        },
                        {
                            "text": " in the inset-grouped style on iOS and grouped Material sections on Android. There is no settings tag to learn."
                        }
                    ]
                },
                {
                    "type": "text",
                    "runs": [
                        {
                            "text": "Mobile UI gives each row no padding and, on iOS, no background. List Item pads itself, but Switch and Select do not, so their labels would touch the card edge and the first letter can be clipped. Wrap each row in a "
                        },
                        {
                            "text": "native:column",
                            "code": true
                        },
                        {
                            "text": " with "
                        },
                        {
                            "text": "px-4 py-3 bg-theme-surface",
                            "code": true
                        },
                        {
                            "text": ": the padding gives the native row insets, and the surface colour draws the grouped card on iOS and matches List Item's surface on Android. Add "
                        },
                        {
                            "text": "separator",
                            "code": true
                        },
                        {
                            "text": " to the list so iOS draws dividers between rows in a card; Android always does."
                        }
                    ]
                }
            ]
        },
        "1-register-the-route": {
            "title": "1. Register the route",
            "blocks": [
                {
                    "type": "code",
                    "language": "php",
                    "text": "use App\\NativeComponents\\SettingsScreen;\nuse Illuminate\\Support\\Facades\\Route;\n\nRoute::native('/settings', SettingsScreen::class)->name('settings');"
                }
            ]
        },
        "2-write-the-screen": {
            "title": "2. Write the screen",
            "blocks": [
                {
                    "type": "text",
                    "runs": [
                        {
                            "text": "Each setting is a public property. "
                        },
                        {
                            "text": "updated{Property}",
                            "code": true
                        },
                        {
                            "text": " runs when PHP accepts a new value, so it is where the value is saved. This example stores values with Laravel's cache; use your own model or storage instead."
                        }
                    ]
                },
                {
                    "type": "code",
                    "language": "php",
                    "text": "<?php\n\nnamespace App\\NativeComponents;\n\nuse FirstlightUI\\NativeComponent;\nuse Illuminate\\Support\\Facades\\Cache;\nuse Illuminate\\View\\View;\n\nclass SettingsScreen extends NativeComponent\n{\n    public bool $notifications = true;\n\n    public bool $marketing = false;\n\n    public string $digest = 'weekly';\n\n    /** @var array<string, string> */\n    public array $digestOptions = [\n        'daily' => 'Daily',\n        'weekly' => 'Weekly',\n        'never' => 'Never',\n    ];\n\n    public function mount(): void\n    {\n        $this->notifications = Cache::get('settings.notifications', true);\n        $this->marketing = Cache::get('settings.marketing', false);\n        $this->digest = Cache::get('settings.digest', 'weekly');\n    }\n\n    public function updatedNotifications(bool $value): void\n    {\n        Cache::forever('settings.notifications', $value);\n    }\n\n    public function updatedMarketing(bool $value): void\n    {\n        Cache::forever('settings.marketing', $value);\n    }\n\n    public function updatedDigest(string $value): void\n    {\n        Cache::forever('settings.digest', $value);\n    }\n\n    public function openPrivacy(): void\n    {\n        $this->navigate('/settings/privacy');\n    }\n\n    public function navTitle(): string\n    {\n        return 'Settings';\n    }\n\n    public function render(): View\n    {\n        return view('native.settings');\n    }\n}"
                }
            ]
        },
        "3-write-the-view": {
            "title": "3. Write the view",
            "blocks": [
                {
                    "type": "text",
                    "runs": [
                        {
                            "text": "Save this as "
                        },
                        {
                            "text": "resources/views/native/settings.blade.php",
                            "code": true
                        },
                        {
                            "text": ":"
                        }
                    ]
                },
                {
                    "type": "code",
                    "language": "blade",
                    "text": "<native:list class=\"w-full flex-1\" separator>\n    <native:list-section header=\"Notifications\" footer=\"Alerts for replies and mentions.\">\n        <native:column class=\"w-full px-4 py-3 bg-theme-surface\">\n            <firstlight:switch label=\"Push notifications\" native:model=\"notifications\" />\n        </native:column>\n        <native:column class=\"w-full px-4 py-3 bg-theme-surface\">\n            <firstlight:switch label=\"Product news\" native:model=\"marketing\" />\n        </native:column>\n    </native:list-section>\n\n    <native:list-section header=\"Email\" footer=\"A summary of activity you missed.\">\n        <native:column class=\"w-full px-4 py-3 bg-theme-surface\">\n            <firstlight:select label=\"Digest\" :options=\"$digestOptions\" native:model=\"digest\" />\n        </native:column>\n    </native:list-section>\n\n    <native:list-section header=\"Account\">\n        <native:column class=\"w-full bg-theme-surface\">\n            <firstlight:list-item\n                headline=\"Privacy\"\n                trailing-icon=\"chevron-right\"\n                trailing-icon-ios=\"chevron.right\"\n                trailing-icon-android=\"chevron_right\"\n                @press=\"openPrivacy\"\n            />\n        </native:column>\n    </native:list-section>\n</native:list>"
                }
            ]
        },
        "what-each-platform-shows": {
            "title": "What each platform shows",
            "blocks": [
                {
                    "type": "definition",
                    "term": {
                        "text": "Grouping"
                    },
                    "items": [
                        {
                            "label": "iOS",
                            "runs": [
                                {
                                    "text": "SwiftUI "
                                },
                                {
                                    "text": "List",
                                    "code": true
                                },
                                {
                                    "text": " in the inset-grouped style; the row columns paint the cards"
                                }
                            ]
                        },
                        {
                            "label": "Android",
                            "text": "Rounded section cards with headers and footers, drawn by Mobile UI"
                        }
                    ]
                },
                {
                    "type": "definition",
                    "term": {
                        "text": "Row insets"
                    },
                    "items": [
                        {
                            "label": "iOS",
                            "runs": [
                                {
                                    "text": "The row column's "
                                },
                                {
                                    "text": "px-4 py-3",
                                    "code": true
                                }
                            ]
                        },
                        {
                            "label": "Android",
                            "runs": [
                                {
                                    "text": "The row column's "
                                },
                                {
                                    "text": "px-4 py-3",
                                    "code": true
                                },
                                {
                                    "text": " inside the card's 16 dp margin"
                                }
                            ]
                        }
                    ]
                },
                {
                    "type": "definition",
                    "term": {
                        "text": "Dividers"
                    },
                    "items": [
                        {
                            "label": "iOS",
                            "runs": [
                                {
                                    "text": "Between rows when the list sets "
                                },
                                {
                                    "text": "separator",
                                    "code": true
                                }
                            ]
                        },
                        {
                            "label": "Android",
                            "text": "Always between rows in a card"
                        }
                    ]
                },
                {
                    "type": "definition",
                    "term": {
                        "text": "Switches"
                    },
                    "items": [
                        {
                            "label": "iOS",
                            "runs": [
                                {
                                    "text": "SwiftUI "
                                },
                                {
                                    "text": "Toggle",
                                    "code": true
                                }
                            ]
                        },
                        {
                            "label": "Android",
                            "runs": [
                                {
                                    "text": "Material 3 "
                                },
                                {
                                    "text": "Switch",
                                    "code": true
                                }
                            ]
                        }
                    ]
                },
                {
                    "type": "definition",
                    "term": {
                        "text": "Digest"
                    },
                    "items": [
                        {
                            "label": "iOS",
                            "text": "Native menu picker"
                        },
                        {
                            "label": "Android",
                            "text": "Material 3 exposed dropdown"
                        }
                    ]
                },
                {
                    "type": "definition",
                    "term": {
                        "text": "Privacy row"
                    },
                    "items": [
                        {
                            "label": "iOS",
                            "text": "List Item row with a chevron"
                        },
                        {
                            "label": "Android",
                            "text": "Material list item with a chevron"
                        }
                    ]
                }
            ]
        },
        "rules-to-keep": {
            "title": "Rules to keep",
            "blocks": [
                {
                    "type": "item",
                    "marker": "•",
                    "depth": 0,
                    "runs": [
                        {
                            "text": "Save in "
                        },
                        {
                            "text": "updated{Property}",
                            "code": true
                        },
                        {
                            "text": ", not in a Save button. Settings screens apply each change immediately."
                        }
                    ]
                },
                {
                    "type": "item",
                    "marker": "•",
                    "depth": 0,
                    "runs": [
                        {
                            "text": "Wrap every control row in a padded "
                        },
                        {
                            "text": "native:column",
                            "code": true
                        },
                        {
                            "text": " with "
                        },
                        {
                            "text": "bg-theme-surface",
                            "code": true
                        },
                        {
                            "text": ". Rows placed straight in a section have no insets."
                        }
                    ]
                },
                {
                    "type": "item",
                    "marker": "•",
                    "depth": 0,
                    "text": "Keep a section footer short. It explains the section, not each control."
                },
                {
                    "type": "item",
                    "marker": "•",
                    "depth": 0,
                    "runs": [
                        {
                            "text": "Use "
                        },
                        {
                            "text": "firstlight:list",
                            "code": true
                        },
                        {
                            "text": " only when every row is a List Item, such as a list of records. Settings mix controls, so they use "
                        },
                        {
                            "text": "native:list",
                            "code": true
                        },
                        {
                            "text": "."
                        }
                    ]
                },
                {
                    "type": "item",
                    "marker": "•",
                    "depth": 0,
                    "runs": [
                        {
                            "text": "Put the screen under a layout that uses native chrome, as described in "
                        },
                        {
                            "text": "Build a list and detail flow",
                            "link": 3
                        },
                        {
                            "text": ", so the title and back navigation come from the platform."
                        }
                    ]
                }
            ]
        }
    },
