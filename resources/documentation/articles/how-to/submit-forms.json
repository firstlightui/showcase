{
    "id": "how-to/submit-forms",
    "title": "Submit Firstlight forms",
    "description": "Validate Firstlight fields, run a PHP action once, and publish success Feedback.",
    "group": "Guides",
    "anchors": {
        "submit-firstlight-forms": "overview",
        "declare-the-screen": "declare-the-screen",
        "bind-the-fields-and-button": "bind-the-fields-and-button",
        "loading-and-duplicate-submissions": "loading-and-duplicate-submissions"
    },
    "chapters": {
        "overview": {
            "title": "Overview",
            "blocks": [
                {
                    "type": "text",
                    "runs": [
                        {
                            "text": "Firstlight submits forms through an ordinary Button press and a PHP screen method. There is no "
                        },
                        {
                            "text": "<firstlight:form>",
                            "code": true
                        },
                        {
                            "text": " container, client-side validator, or form schema."
                        }
                    ]
                }
            ]
        },
        "declare-the-screen": {
            "title": "Declare the screen",
            "blocks": [
                {
                    "type": "text",
                    "runs": [
                        {
                            "text": "Extend "
                        },
                        {
                            "text": "FirstlightUI\\NativeComponent",
                            "code": true
                        },
                        {
                            "text": " to use the form submission and field validation helpers. Declare Laravel rules against the public properties bound by your fields:"
                        }
                    ]
                },
                {
                    "type": "code",
                    "language": "php",
                    "text": "<?php\n\nnamespace App\\Native;\n\nuse App\\Models\\Profile;\nuse FirstlightUI\\NativeComponent;\n\nclass EditProfileScreen extends NativeComponent\n{\n    public string $name = '';\n\n    public string $email = '';\n\n    protected array $rules = [\n        'name' => 'required',\n        'email' => 'required|email',\n    ];\n\n    public function save(): void\n    {\n        $this->submit(\n            action: fn () => Profile::query()->updateOrCreate(\n                ['user_id' => auth()->id()],\n                ['name' => $this->name, 'email' => $this->email],\n            ),\n            successMessage: 'Profile saved',\n        );\n    }\n}"
                },
                {
                    "type": "text",
                    "runs": [
                        {
                            "text": "Screens that extend "
                        },
                        {
                            "text": "Native\\Mobile\\Edge\\NativeComponent",
                            "code": true
                        },
                        {
                            "text": " directly can opt in with both "
                        },
                        {
                            "text": "FirstlightUI\\Concerns\\ValidatesFields",
                            "code": true
                        },
                        {
                            "text": " and "
                        },
                        {
                            "text": "FirstlightUI\\Concerns\\SubmitsForms",
                            "code": true
                        },
                        {
                            "text": "."
                        }
                    ]
                }
            ]
        },
        "bind-the-fields-and-button": {
            "title": "Bind the fields and Button",
            "blocks": [
                {
                    "type": "text",
                    "runs": [
                        {
                            "text": "Use the existing fields, "
                        },
                        {
                            "text": "native:model",
                            "code": true
                        },
                        {
                            "text": ", and Button:"
                        }
                    ]
                },
                {
                    "type": "code",
                    "language": "blade",
                    "text": "<firstlight:text-field\n    label=\"Name\"\n    native:model.blur=\"name\"\n/>\n\n<firstlight:text-field\n    label=\"Email\"\n    native:model.blur=\"email\"\n/>\n\n<firstlight:button @press=\"save\">\n    Save profile\n</firstlight:button>"
                },
                {
                    "type": "text",
                    "runs": [
                        {
                            "text": "submit()",
                            "code": true
                        },
                        {
                            "text": " runs "
                        },
                        {
                            "text": "$this->validate()",
                            "code": true
                        },
                        {
                            "text": " first. A validation failure returns "
                        },
                        {
                            "text": "false",
                            "code": true
                        },
                        {
                            "text": ", skips the callable and success Feedback, and lets "
                        },
                        {
                            "text": "ValidatesFields",
                            "code": true
                        },
                        {
                            "text": " publish each first Laravel message through the matching field's native "
                        },
                        {
                            "text": "error",
                            "code": true
                        },
                        {
                            "text": " slot. Screen readers hear a summary and move to the first invalid field; add "
                        },
                        {
                            "text": "<firstlight:callout error-summary />",
                            "code": true
                        },
                        {
                            "text": " for a visible summary. See "
                        },
                        {
                            "text": "Validate Firstlight fields",
                            "link": 0
                        },
                        {
                            "text": " for rule sources, Form Requests, custom messages, and explicit error binding. The "
                        },
                        {
                            "text": "ValidatesFields reference",
                            "link": 1
                        },
                        {
                            "text": " lists the method contract and participating fields."
                        }
                    ]
                },
                {
                    "type": "text",
                    "runs": [
                        {
                            "text": "After successful validation, "
                        },
                        {
                            "text": "submit()",
                            "code": true
                        },
                        {
                            "text": " runs the callable and sends "
                        },
                        {
                            "text": "Feedback::success($successMessage)->send()",
                            "code": true
                        },
                        {
                            "text": " when the message is non-empty. It then returns "
                        },
                        {
                            "text": "true",
                            "code": true
                        },
                        {
                            "text": ". Pass "
                        },
                        {
                            "text": "validate: false",
                            "code": true
                        },
                        {
                            "text": " only when the action does not need field validation:"
                        }
                    ]
                },
                {
                    "type": "code",
                    "language": "php",
                    "text": "$sent = $this->submit(\n    action: fn () => $this->sendVerificationEmail(),\n    successMessage: 'Verification email sent',\n    validate: false,\n);"
                },
                {
                    "type": "text",
                    "runs": [
                        {
                            "text": "To fail the whole form from inside the action, throw Laravel's "
                        },
                        {
                            "text": "ValidationException",
                            "code": true
                        },
                        {
                            "text": ". Its messages replace the screen's error bag, "
                        },
                        {
                            "text": "submit()",
                            "code": true
                        },
                        {
                            "text": " returns "
                        },
                        {
                            "text": "false",
                            "code": true
                        },
                        {
                            "text": ", and no success Feedback is sent:"
                        }
                    ]
                },
                {
                    "type": "code",
                    "language": "php",
                    "text": "use Illuminate\\Validation\\ValidationException;\n\n$this->submit(\n    action: function (): void {\n        if (! Auth::attempt(['email' => $this->email, 'password' => $this->password])) {\n            throw ValidationException::withMessages([\n                'form' => 'These credentials do not match our records.',\n            ]);\n        }\n    },\n    successMessage: 'Signed in',\n);"
                },
                {
                    "type": "code",
                    "language": "blade",
                    "text": "<firstlight:callout error-for=\"form\" />"
                },
                {
                    "type": "text",
                    "text": "Other unexpected exceptions from the callable are not converted to Feedback or swallowed."
                }
            ]
        },
        "loading-and-duplicate-submissions": {
            "title": "Loading and duplicate submissions",
            "blocks": [
                {
                    "type": "text",
                    "runs": [
                        {
                            "text": "$submitting",
                            "code": true
                        },
                        {
                            "text": " is "
                        },
                        {
                            "text": "true",
                            "code": true
                        },
                        {
                            "text": " while validation and the callable run. Re-entering "
                        },
                        {
                            "text": "submit()",
                            "code": true
                        },
                        {
                            "text": " on the same PHP component during that interval returns "
                        },
                        {
                            "text": "false",
                            "code": true
                        },
                        {
                            "text": " without validating, calling the action, or sending Feedback. "
                        },
                        {
                            "text": "submit()",
                            "code": true
                        },
                        {
                            "text": " always clears "
                        },
                        {
                            "text": "$submitting",
                            "code": true
                        },
                        {
                            "text": " in "
                        },
                        {
                            "text": "finally",
                            "code": true
                        },
                        {
                            "text": ", so binding Button "
                        },
                        {
                            "text": "loading",
                            "code": true
                        },
                        {
                            "text": " or "
                        },
                        {
                            "text": "disabled",
                            "code": true
                        },
                        {
                            "text": " to "
                        },
                        {
                            "text": "$this->submitting",
                            "code": true
                        },
                        {
                            "text": " does not flash during the default one-request path."
                        }
                    ]
                },
                {
                    "type": "text",
                    "runs": [
                        {
                            "text": "NativePHP handles a press and then compiles one Element Tree afterward. A device-visible loading frame requires application code to set "
                        },
                        {
                            "text": "$this->submitting = true",
                            "code": true
                        },
                        {
                            "text": " outside "
                        },
                        {
                            "text": "submit()",
                            "code": true
                        },
                        {
                            "text": ", publish that tree, and clear the flag on a later request."
                        }
                    ]
                },
                {
                    "type": "text",
                    "runs": [
                        {
                            "text": "The helper does not publish an intermediate tree, call "
                        },
                        {
                            "text": "publishPlaceholder()",
                            "code": true
                        },
                        {
                            "text": ", or add a client-side loading mechanism. "
                        },
                        {
                            "text": "publishPlaceholder()",
                            "code": true
                        },
                        {
                            "text": " belongs to lazy screen mounting, not form submission."
                        }
                    ]
                }
            ]
        }
    },
    "links": [
        {
            "label": "Validate Firstlight fields",
            "url": "validate-fields.md"
        },
        {
            "label": "ValidatesFields reference",
            "url": "../reference/validates-fields.md"
        }
    ]
}
