{
    "id": "how-to/build-a-searchable-list-screen",
    "title": "Build a searchable list screen",
    "description": "Recipe for a complete screen with native search, a paginated List, pull-to-refresh, row navigation, and confirmed swipe deletion.",
    "group": "Guides",
    "anchors": {
        "build-a-searchable-list-screen": "overview",
        "1-register-the-route": "1-register-the-route",
        "2-write-the-screen": "2-write-the-screen",
        "3-write-the-view": "3-write-the-view",
        "what-each-platform-shows": "what-each-platform-shows",
        "rules-to-keep": "rules-to-keep",
        "adapt-the-recipe": "adapt-the-recipe"
    },
    "chapters": {
        "overview": {
            "title": "Overview",
            "blocks": [
                {
                    "type": "text",
                    "text": "This recipe builds the index screen most apps need: a search field above a list of records, with pull-to-refresh, infinite scrolling, a tap that opens the record, and a swipe action that deletes it after native confirmation."
                },
                {
                    "type": "text",
                    "runs": [
                        {
                            "text": "This recipe runs unchanged in the "
                        },
                        {
                            "text": "showcase app",
                            "link": 0
                        },
                        {
                            "text": ", where "
                        },
                        {
                            "text": "SearchableListRecipeTest",
                            "link": 1,
                            "code": true
                        },
                        {
                            "text": " exercises it."
                        }
                    ]
                },
                {
                    "type": "text",
                    "runs": [
                        {
                            "text": "Use it when a screen shows many records of one model and the user needs to find, open, or remove one. Use "
                        },
                        {
                            "text": "List",
                            "link": 2
                        },
                        {
                            "text": " without search for short, fixed collections, and a settings layout when rows change preferences instead of opening records."
                        }
                    ]
                },
                {
                    "type": "text",
                    "runs": [
                        {
                            "text": "Every piece is an existing Firstlight tag or "
                        },
                        {
                            "text": "NativeComponent",
                            "code": true
                        },
                        {
                            "text": " helper. There is no list-screen tag to learn."
                        }
                    ]
                }
            ]
        },
        "1-register-the-route": {
            "title": "1. Register the route",
            "blocks": [
                {
                    "type": "code",
                    "language": "php",
                    "text": "use App\\NativeComponents\\Layouts\\AppLayout;\nuse App\\NativeComponents\\PostsScreen;\nuse Illuminate\\Support\\Facades\\Route;\n\nRoute::native('/posts', PostsScreen::class)\n    ->name('posts')\n    ->layout(AppLayout::class);"
                },
                {
                    "type": "text",
                    "runs": [
                        {
                            "text": "AppLayout",
                            "code": true
                        },
                        {
                            "text": " gives the screen a native title bar and back navigation. It is defined in "
                        },
                        {
                            "text": "Build a list and detail flow",
                            "link": 3
                        },
                        {
                            "text": "."
                        }
                    ]
                }
            ]
        },
        "2-write-the-screen": {
            "title": "2. Write the screen",
            "blocks": [
                {
                    "type": "text",
                    "runs": [
                        {
                            "text": "Extend "
                        },
                        {
                            "text": "FirstlightUI\\NativeComponent",
                            "code": true
                        },
                        {
                            "text": ". It already includes "
                        },
                        {
                            "text": "PaginatesLists",
                            "link": 4
                        },
                        {
                            "text": ", "
                        },
                        {
                            "text": "DestroysListItems",
                            "link": 5
                        },
                        {
                            "text": ", and "
                        },
                        {
                            "text": "AuthorizesActions",
                            "link": 6
                        },
                        {
                            "text": "."
                        }
                    ]
                },
                {
                    "type": "code",
                    "language": "php",
                    "text": "<?php\n\nnamespace App\\NativeComponents;\n\nuse App\\Models\\Post;\nuse FirstlightUI\\NativeComponent;\nuse FirstlightUI\\Pagination\\ListPage;\nuse Illuminate\\View\\View;\n\nclass PostsScreen extends NativeComponent\n{\n    public string $query = '';\n\n    public function mount(): void\n    {\n        $this->reload();\n    }\n\n    public function updatedQuery(): void\n    {\n        $this->reload();\n    }\n\n    public function reload(): void\n    {\n        $this->refreshList(fn (ListPage $page) => $this->posts($page));\n    }\n\n    public function loadMore(): void\n    {\n        $this->loadMoreList(fn (ListPage $page) => $this->posts($page));\n    }\n\n    public function openPost(int $id): void\n    {\n        $this->navigate('/posts/'.$id);\n    }\n\n    public function requestDeletion(int $id): void\n    {\n        $this->requestDestructiveListAction($id, 'delete');\n    }\n\n    public function cancelDeletion(): void\n    {\n        $this->cancelDestructiveListAction();\n    }\n\n    public function deletePost(): void\n    {\n        $this->confirmDestructiveListAction(\n            destroy: fn (Post $post) => $post->delete(),\n            ability: 'delete',\n            successMessage: 'Post deleted',\n        );\n    }\n\n    public function navTitle(): string\n    {\n        return 'Posts';\n    }\n\n    public function render(): View\n    {\n        return view('native.posts');\n    }\n\n    private function posts(ListPage $page)\n    {\n        return Post::query()\n            ->when($this->query !== '', fn ($query) => $query->where('title', 'like', '%'.$this->query.'%'))\n            ->latest()\n            ->paginate(perPage: 20, page: $page->page);\n    }\n}"
                },
                {
                    "type": "text",
                    "runs": [
                        {
                            "text": "updatedQuery()",
                            "code": true
                        },
                        {
                            "text": " runs whenever PHP accepts a new query, so the list restarts from page one for each search. Keys passed to "
                        },
                        {
                            "text": "openPost()",
                            "code": true
                        },
                        {
                            "text": " and "
                        },
                        {
                            "text": "requestDeletion()",
                            "code": true
                        },
                        {
                            "text": " are model ids, never loop positions."
                        }
                    ]
                }
            ]
        },
        "3-write-the-view": {
            "title": "3. Write the view",
            "blocks": [
                {
                    "type": "text",
                    "runs": [
                        {
                            "text": "Save this as "
                        },
                        {
                            "text": "resources/views/native/posts.blade.php",
                            "code": true
                        },
                        {
                            "text": ":"
                        }
                    ]
                },
                {
                    "type": "code",
                    "language": "blade",
                    "text": "<native:column class=\"w-full flex-1 bg-theme-background\">\n    <firstlight:search-field\n        placeholder=\"Search posts\"\n        a11y-label=\"Search posts\"\n        native:model.debounce.300ms=\"query\"\n        class=\"mx-4 my-2\"\n    />\n\n    @if (count($listItems) === 0)\n        <firstlight:status-label\n            label=\"{{ $query === '' ? 'No posts yet' : 'No matching posts' }}\"\n            tone=\"neutral\"\n            class=\"mx-4\"\n        />\n    @endif\n\n    <firstlight:list separator @refresh=\"reload\" @endReached=\"loadMore\" class=\"flex-1 bg-theme-background\">\n        @foreach ($listItems as $post)\n            <firstlight:list-item\n                :headline=\"$post->title\"\n                :supporting=\"$post->excerpt\"\n                trailing-icon=\"chevron-right\"\n                trailing-icon-ios=\"chevron.right\"\n                trailing-icon-android=\"chevron_right\"\n                @press=\"openPost({{ $post->id }})\"\n                :trailing-actions=\"[\n                    ['method' => 'requestDeletion('.$post->id.')', 'label' => 'Delete', 'role' => 'destructive'],\n                ]\"\n            />\n        @endforeach\n    </firstlight:list>\n\n    <firstlight:confirmation-dialog\n        :visible=\"$confirmingListDestruction\"\n        title=\"Delete post?\"\n        message=\"This action cannot be undone.\"\n        confirm-label=\"Delete\"\n        cancel-label=\"Keep post\"\n        tone=\"destructive\"\n        @press=\"deletePost\"\n        @dismiss=\"cancelDeletion\"\n    />\n</native:column>"
                }
            ]
        },
        "what-each-platform-shows": {
            "title": "What each platform shows",
            "blocks": [
                {
                    "type": "definition",
                    "term": {
                        "text": "Search"
                    },
                    "items": [
                        {
                            "label": "iOS",
                            "runs": [
                                {
                                    "text": "UISearchTextField",
                                    "code": true
                                },
                                {
                                    "text": " with the system clear button"
                                }
                            ]
                        },
                        {
                            "label": "Android",
                            "text": "Material 3 search field with the search IME action"
                        }
                    ]
                },
                {
                    "type": "definition",
                    "term": {
                        "text": "Rows"
                    },
                    "items": [
                        {
                            "label": "iOS",
                            "runs": [
                                {
                                    "text": "SwiftUI "
                                },
                                {
                                    "text": "List",
                                    "code": true
                                },
                                {
                                    "text": " rows with dividers"
                                }
                            ]
                        },
                        {
                            "label": "Android",
                            "runs": [
                                {
                                    "text": "LazyColumn",
                                    "code": true
                                },
                                {
                                    "text": " Material list items with dividers"
                                }
                            ]
                        }
                    ]
                },
                {
                    "type": "definition",
                    "term": {
                        "text": "Refresh"
                    },
                    "items": [
                        {
                            "label": "iOS",
                            "text": "System pull-to-refresh"
                        },
                        {
                            "label": "Android",
                            "text": "Material pull-to-refresh"
                        }
                    ]
                },
                {
                    "type": "definition",
                    "term": {
                        "text": "Delete"
                    },
                    "items": [
                        {
                            "label": "iOS",
                            "text": "Trailing swipe action, then a native confirmation dialog"
                        },
                        {
                            "label": "Android",
                            "text": "Trailing swipe action, then a native confirmation dialog"
                        }
                    ]
                },
                {
                    "type": "definition",
                    "term": {
                        "text": "Feedback"
                    },
                    "items": [
                        {
                            "label": "iOS",
                            "text": "\"Post deleted\" through Transient Feedback"
                        },
                        {
                            "label": "Android",
                            "text": "\"Post deleted\" through Transient Feedback"
                        }
                    ]
                },
                {
                    "type": "text",
                    "text": "The same Blade works on both platforms. Swipe actions are also exposed as VoiceOver and TalkBack actions, so screen-reader users can delete without a swipe gesture."
                }
            ]
        },
        "rules-to-keep": {
            "title": "Rules to keep",
            "blocks": [
                {
                    "type": "item",
                    "marker": "•",
                    "depth": 0,
                    "runs": [
                        {
                            "text": "Keep "
                        },
                        {
                            "text": "@endReached",
                            "code": true
                        },
                        {
                            "text": " bound even on the last page; extra events are ignored."
                        }
                    ]
                },
                {
                    "type": "item",
                    "marker": "•",
                    "depth": 0,
                    "runs": [
                        {
                            "text": "Do not omit the Delete action for rows the Policy denies. Disable the row with "
                        },
                        {
                            "text": ":disabled",
                            "code": true
                        },
                        {
                            "text": " instead, as described in "
                        },
                        {
                            "text": "Authorize actions",
                            "link": 7
                        },
                        {
                            "text": "."
                        }
                    ]
                },
                {
                    "type": "item",
                    "marker": "•",
                    "depth": 0,
                    "text": "Full swipes never delete. The swipe only opens the confirmation dialog, and PHP authorizes again before deleting."
                },
                {
                    "type": "item",
                    "marker": "•",
                    "depth": 0,
                    "runs": [
                        {
                            "text": "Use "
                        },
                        {
                            "text": "native:model.debounce.300ms",
                            "code": true
                        },
                        {
                            "text": " for search so each keystroke does not query the database."
                        }
                    ]
                }
            ]
        },
        "adapt-the-recipe": {
            "title": "Adapt the recipe",
            "blocks": [
                {
                    "type": "item",
                    "marker": "•",
                    "depth": 0,
                    "runs": [
                        {
                            "text": "No deletion:",
                            "strong": true
                        },
                        {
                            "text": " remove "
                        },
                        {
                            "text": "trailing-actions",
                            "code": true
                        },
                        {
                            "text": ", the dialog, and the three deletion methods."
                        }
                    ]
                },
                {
                    "type": "item",
                    "marker": "•",
                    "depth": 0,
                    "runs": [
                        {
                            "text": "Cursor pagination:",
                            "strong": true
                        },
                        {
                            "text": " pass "
                        },
                        {
                            "text": "$page->cursor",
                            "code": true
                        },
                        {
                            "text": " to "
                        },
                        {
                            "text": "cursorPaginate()",
                            "code": true
                        },
                        {
                            "text": ", as shown in "
                        },
                        {
                            "text": "Paginate lists",
                            "link": 8
                        },
                        {
                            "text": "."
                        }
                    ]
                },
                {
                    "type": "item",
                    "marker": "•",
                    "depth": 0,
                    "runs": [
                        {
                            "text": "Search on submit instead of while typing:",
                            "strong": true
                        },
                        {
                            "text": " bind "
                        },
                        {
                            "text": "native:model.lazy=\"query\"",
                            "code": true
                        },
                        {
                            "text": "."
                        }
                    ]
                }
            ]
        }
    },
