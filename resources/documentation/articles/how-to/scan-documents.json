                        }
                    ]
                },
                {
                    "type": "definition",
                    "term": {
                        "runs": [
                            {
                                "text": "TextRecognitionFailed",
                                "code": true
                            }
                        ]
                    },
                    "items": [
                        {
                            "label": "Codes",
                            "runs": [
                                {
                                    "text": "INVALID_PARAMETERS",
                                    "code": true
                                },
                                {
                                    "text": ", "
                                },
                                {
                                    "text": "FILE_NOT_FOUND",
                                    "code": true
                                },
                                {
                                    "text": ", "
                                },
                                {
                                    "text": "DECODE_FAILED",
                                    "code": true
                                },
                                {
                                    "text": ", "
                                },
                                {
                                    "text": "RECOGNITION_FAILED",
                                    "code": true
                                }
                            ]
                        }
                    ]
                },
                {
                    "type": "text",
                    "text": "A failure on any page fails the whole recognition, and the message names the page. If Android ends the app while the scanner is open, which can happen on a device that is low on memory, that capture's event never arrives; the next scan starts fresh."
                }
            ]
        },
        "test-the-screen": {
            "title": "Test the screen",
            "blocks": [
                {
                    "type": "text",
                    "runs": [
                        {
                            "text": "Deliver the plugin's events with "
                        },
                        {
                            "text": "emitNative()",
                            "code": true
                        },
                        {
                            "text": " and check what the screen shows:"
                        }
                    ]
                },
                {
                    "type": "code",
                    "language": "php",
                    "text": "use App\\NativeComponents\\ScanScreen;\nuse FirstlightUI\\LocalOcr\\Events\\TextRecognized;\nuse Native\\Mobile\\Testing\\Native;\n\nit('shows the text it read', function () {\n    Native::test(ScanScreen::class)\n        ->set('requestId', 'scan-1')\n        ->set('working', true)\n        ->emitNative(TextRecognized::class, [\n            'id' => 'scan-1',\n            'result' => ['text' => 'Ward 4B', 'pages' => []],\n        ])\n        ->assertSet('text', 'Ward 4B')\n        ->assertSet('working', false)\n        ->assertSee('Ward 4B');\n});\n\nit('ignores a result for an earlier scan', function () {\n    Native::test(ScanScreen::class)\n        ->set('requestId', 'scan-2')\n        ->emitNative(TextRecognized::class, [\n            'id' => 'scan-1',\n            'result' => ['text' => 'Old page', 'pages' => []],\n        ])\n        ->assertSet('text', '')\n        ->assertDontSee('Old page');\n});"
                },
                {
                    "type": "text",
                    "runs": [
                        {
                            "text": "See "
                        },
                        {
                            "text": "Test screens",
                            "link": 1
                        },
                        {
                            "text": " for more of "
                        },
                        {
                            "text": "Native::test()",
                            "code": true
                        },
                        {
                            "text": "."
                        }
                    ]
                },
                {
                    "type": "text",
                    "runs": [
                        {
                            "text": "The plugin's "
                        },
                        {
                            "text": "README",
                            "link": 2
                        },
                        {
                            "text": " has the full capability report, the result contract, and the JavaScript library for Inertia apps."
                        }
                    ]
                }
            ]
