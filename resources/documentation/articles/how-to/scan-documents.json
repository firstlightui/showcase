{
    "id": "how-to/scan-documents",
    "title": "Scan documents and read their text",
    "description": "Recipe for a screen that scans paper documents with the system document scanner and reads their text on the device with Local OCR.",
    "group": "Guides",
    "anchors": {
        "scan-documents-and-read-their-text": "overview",
        "before-you-start": "before-you-start",
        "how-the-pieces-fit": "how-the-pieces-fit",
        "1-build-the-scan-screen": "1-build-the-scan-screen",
        "2-use-the-structure-not-just-the-text": "2-use-the-structure-not-just-the-text",
        "3-clean-up-the-pages": "3-clean-up-the-pages",
        "failures": "failures",
        "test-the-screen": "test-the-screen"
    },
    "chapters": {
        "overview": {
            "title": "Overview",
            "blocks": [
                {
                    "type": "text",
                    "text": "This recipe adds a screen that scans a paper document and shows its text. The user taps Scan, the system document scanner opens, and once they have scanned their pages the screen reads the text and shows it. The images and the text never leave the phone."
                }
            ]
        },
        "before-you-start": {
            "title": "Before you start",
            "blocks": [
                {
                    "type": "text",
                    "runs": [
                        {
                            "text": "The recipe uses "
                        },
                        {
                            "text": "firstlightui/local-ocr",
                            "link": 0,
                            "code": true
                        },
                        {
                            "text": " 1.0, free and MIT licensed:"
                        }
                    ]
                },
                {
                    "type": "code",
                    "language": "bash",
                    "text": "composer require firstlightui/local-ocr:^1.0\nphp artisan native:plugin:register firstlightui/local-ocr"
                },
                {
                    "type": "text",
                    "runs": [
                        {
                            "text": "Rebuild the app with "
                        },
                        {
                            "text": "php artisan native:run",
                            "code": true
                        },
                        {
                            "text": " after installing."
                        }
                    ]
                },
                {
                    "type": "definition",
                    "term": {
                        "text": "Scanner"
                    },
                    "items": [
                        {
                            "label": "iOS",
                            "text": "VisionKit's document camera"
                        },
                        {
                            "label": "Android",
                            "text": "ML Kit Document Scanner, which runs in Google Play services"
                        }
                    ]
                },
                {
                    "type": "definition",
                    "term": {
                        "text": "Text recognition"
                    },
                    "items": [
                        {
                            "label": "iOS",
                            "text": "Apple Vision, in many languages"
                        },
                        {
                            "label": "Android",
                            "text": "ML Kit Text Recognition, Latin-script text only"
                        }
                    ]
                },
                {
                    "type": "definition",
                    "term": {
                        "text": "Needs"
                    },
                    "items": [
                        {
                            "label": "iOS",
                            "text": "iOS 18 or later, on a real device: the scanner doesn't run in the Simulator"
                        },
                        {
                            "label": "Android",
                            "text": "Android 8 (API 26) or later, with Google Play services"
                        }
                    ]
                },
                {
                    "type": "definition",
                    "term": {
                        "text": "Permissions"
                    },
                    "items": [
                        {
                            "label": "iOS",
                            "text": "Camera, which the plugin adds"
                        },
                        {
                            "label": "Android",
                            "text": "None"
                        }
                    ]
                },
                {
                    "type": "text",
                    "runs": [
                        {
                            "text": "The plugin's camera purpose string is generic. Word it for your app in "
                        },
                        {
                            "text": "config/nativephp.php",
                            "code": true
                        },
                        {
                            "text": ", which overrides plugins:"
                        }
                    ]
                },
                {
                    "type": "code",
                    "language": "php",
                    "text": "'permissions' => [\n    'NSCameraUsageDescription' => 'Scan letters so their text can be read on this device.',\n],"
                }
            ]
        },
        "how-the-pieces-fit": {
            "title": "How the pieces fit",
            "blocks": [
                {
                    "type": "item",
                    "marker": "•",
                    "depth": 0,
                    "runs": [
                        {
                            "text": "LocalOcr::capture()",
                            "code": true
                        },
                        {
                            "text": " opens the scanner. The user scans as many pages as they need, and the pages are saved as JPEGs in the app's private temporary storage."
                        }
                    ]
                },
                {
                    "type": "item",
                    "marker": "•",
                    "depth": 0,
                    "runs": [
                        {
                            "text": "LocalOcr::recognize($pages)",
                            "code": true
                        },
                        {
                            "text": " reads the pages and returns their text, with blocks, lines, words, confidence scores and bounding boxes for each page."
                        }
                    ]
                },
                {
                    "type": "item",
                    "marker": "•",
                    "depth": 0,
                    "runs": [
                        {
                            "text": "LocalOcr::discard($pages)",
                            "code": true
                        },
                        {
                            "text": " deletes the page images once you are done with them."
                        }
                    ]
                },
                {
                    "type": "text",
                    "runs": [
                        {
                            "text": "Capture and recognition return straight away. Their outcome arrives later as an event carrying the request's "
                        },
                        {
                            "text": "id",
                            "code": true
                        },
                        {
                            "text": ", which the screen receives with "
                        },
                        {
                            "text": "#[On]",
                            "code": true
                        },
                        {
                            "text": "."
                        }
                    ]
                }
            ]
        },
        "1-build-the-scan-screen": {
            "title": "1. Build the scan screen",
            "blocks": [
                {
                    "type": "code",
                    "language": "php",
                    "text": "<?php\n\nnamespace App\\NativeComponents;\n\nuse FirstlightUI\\LocalOcr\\Events\\CaptureCancelled;\nuse FirstlightUI\\LocalOcr\\Events\\CaptureFailed;\nuse FirstlightUI\\LocalOcr\\Events\\PagesCaptured;\nuse FirstlightUI\\LocalOcr\\Events\\TextRecognitionFailed;\nuse FirstlightUI\\LocalOcr\\Events\\TextRecognized;\nuse FirstlightUI\\LocalOcr\\Facades\\LocalOcr;\nuse FirstlightUI\\NativeComponent;\nuse Illuminate\\View\\View;\nuse Native\\Mobile\\Attributes\\On;\n\nclass ScanScreen extends NativeComponent\n{\n    public bool $canScan = false;\n\n    public bool $working = false;\n\n    public string $text = '';\n\n    public ?string $error = null;\n\n    public ?string $requestId = null;\n\n    public function mount(): void\n    {\n        // null off the device, so the button stays disabled in a browser.\n        $this->canScan = LocalOcr::capabilities()['capture']['available'] ?? false;\n    }\n\n    public function navTitle(): string\n    {\n        return 'Scan';\n    }\n\n    public function scan(): void\n    {\n        $this->error = null;\n        $this->working = true;\n        $this->requestId = LocalOcr::capture()->getId();\n    }\n\n    #[On(PagesCaptured::class)]\n    public function pagesCaptured(string $id, array $pages): void\n    {\n        if ($id !== $this->requestId) {\n            return;\n        }\n\n        $this->requestId = LocalOcr::recognize($pages)->getId();\n    }\n\n    #[On(TextRecognized::class)]\n    public function textRecognized(string $id, array $result): void\n    {\n        if ($id !== $this->requestId) {\n            return;\n        }\n\n        $this->text = $result['text'];\n        $this->finish();\n\n        LocalOcr::discard(array_column($result['pages'], 'path'));\n    }\n\n    #[On(CaptureCancelled::class)]\n    public function captureCancelled(string $id): void\n    {\n        if ($id === $this->requestId) {\n            $this->finish();\n        }\n    }\n\n    #[On(CaptureFailed::class)]\n    #[On(TextRecognitionFailed::class)]\n    public function failed(string $id, string $code, string $message): void\n    {\n        if ($id === $this->requestId) {\n            $this->error = \"Couldn't read the document. {$message}\";\n            $this->finish();\n        }\n    }\n\n    public function render(): View\n    {\n        return view('native.scan');\n    }\n\n    private function finish(): void\n    {\n        $this->working = false;\n        $this->requestId = null;\n    }\n}"
                },
                {
                    "type": "text",
                    "runs": [
                        {
                            "text": "The builder from "
                        },
                        {
                            "text": "capture()",
                            "code": true
                        },
                        {
                            "text": " or "
                        },
                        {
                            "text": "recognize()",
                            "code": true
                        },
                        {
                            "text": " starts its request when it goes out of scope, so the screen only keeps its "
                        },
                        {
                            "text": "id",
                            "code": true
                        },
                        {
                            "text": ". Matching on the "
                        },
                        {
                            "text": "id",
                            "code": true
                        },
                        {
                            "text": " keeps a late result from an earlier scan from replacing the current one."
                        }
                    ]
                },
                {
                    "type": "text",
                    "runs": [
                        {
                            "text": "Save the view as "
                        },
                        {
                            "text": "resources/views/native/scan.blade.php",
                            "code": true
                        },
                        {
                            "text": ":"
                        }
                    ]
                },
                {
                    "type": "code",
                    "language": "blade",
                    "text": "<native:scroll-view class=\"w-full flex-1 bg-theme-background\">\n    <native:column class=\"w-full p-4 gap-4\">\n        @if (! $canScan)\n            <firstlight:callout message=\"Scanning needs a device with a camera and, on Android, Google Play services.\" tone=\"info\" />\n        @endif\n\n        @if ($error)\n            <firstlight:callout :message=\"$error\" tone=\"warning\" />\n        @endif\n\n        <firstlight:button :loading=\"$working\" :disabled=\"! $canScan\" @press=\"scan\">Scan a document</firstlight:button>\n\n        @if ($text !== '')\n            <native:text class=\"text-base text-theme-on-background\">{{ $text }}</native:text>\n        @endif\n    </native:column>\n</native:scroll-view>"
                }
            ]
        },
        "2-use-the-structure-not-just-the-text": {
            "title": "2. Use the structure, not just the text",
            "blocks": [
                {
                    "type": "text",
                    "runs": [
                        {
                            "text": "$result['text']",
                            "code": true
                        },
                        {
                            "text": " joins every page's text with blank lines. Each entry of "
                        },
                        {
                            "text": "$result['pages']",
                            "code": true
                        },
                        {
                            "text": " also has its "
                        },
                        {
                            "text": "blocks",
                            "code": true
                        },
                        {
                            "text": ", their "
                        },
                        {
                            "text": "lines",
                            "code": true
                        },
                        {
                            "text": " and "
                        },
                        {
                            "text": "words",
                            "code": true
                        },
                        {
                            "text": ", each with a "
                        },
                        {
                            "text": "confidence",
                            "code": true
                        },
                        {
                            "text": " from 0 to 1 and a "
                        },
                        {
                            "text": "boundingBox",
                            "code": true
                        },
                        {
                            "text": " normalised to the upright page, origin top-left. Use them to pick out a field by where it sits on the page, or to ignore low-confidence lines."
                        }
                    ]
                },
                {
                    "type": "text",
                    "text": "Two platform differences matter when you do:"
                },
                {
                    "type": "item",
                    "marker": "•",
                    "depth": 0,
                    "text": "iOS scores lines only, so each word repeats its line's confidence. Android scores words."
                },
                {
                    "type": "item",
                    "marker": "•",
                    "depth": 0,
                    "text": "iOS makes each line its own block. Android groups lines into blocks."
                },
                {
                    "type": "text",
                    "runs": [
                        {
                            "text": "Recognition is the same API on both platforms. On iOS you can pass "
                        },
                        {
                            "text": "->languages(['en-AU'])",
                            "code": true
                        },
                        {
                            "text": " to "
                        },
                        {
                            "text": "recognize()",
                            "code": true
                        },
                        {
                            "text": ", or "
                        },
                        {
                            "text": "->fast()",
                            "code": true
                        },
                        {
                            "text": " to trade accuracy for speed; in fast mode every line reports a confidence of 0.5, so don't filter on it there."
                        }
                    ]
                }
            ]
        },
        "3-clean-up-the-pages": {
            "title": "3. Clean up the pages",
            "blocks": [
                {
                    "type": "text",
                    "runs": [
                        {
                            "text": "Captured pages stay until you call "
                        },
                        {
                            "text": "discard()",
                            "code": true
                        },
                        {
                            "text": ". The screen above discards them once their text is read. Anything left over, for example because the app closed between capture and recognition, is deleted on the next capture after 24 hours, and iOS also clears its temporary directory when it needs space."
                        }
                    ]
                },
                {
                    "type": "text",
                    "runs": [
                        {
                            "text": "discard()",
                            "code": true
                        },
                        {
                            "text": " only deletes files the plugin captured. If you need to keep a page, copy it somewhere else first."
                        }
                    ]
                }
            ]
        },
