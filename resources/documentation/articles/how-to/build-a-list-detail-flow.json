{
    "id": "how-to/build-a-list-detail-flow",
    "title": "Build a list and detail flow",
    "description": "Recipe for an app layout with native navigation chrome, a list screen that pushes a detail screen, and native back navigation on iOS and Android.",
    "group": "Guides",
    "anchors": {
        "build-a-list-and-detail-flow": "overview",
        "1-write-the-layout": "1-write-the-layout",
        "2-register-the-routes": "2-register-the-routes",
        "3-write-the-list-screen": "3-write-the-list-screen",
        "4-write-the-detail-screen": "4-write-the-detail-screen",
        "rules-to-keep": "rules-to-keep",
        "known-limits": "known-limits"
    },
    "chapters": {
        "overview": {
            "title": "Overview",
            "blocks": [
                {
                    "type": "text",
                    "text": "This recipe gives an app its shell: a layout with the platform's own title bar and back navigation, a list screen, and a detail screen it pushes. Every other recipe runs inside this layout."
                },
                {
                    "type": "text",
                    "runs": [
                        {
                            "text": "This recipe runs unchanged in the "
                        },
                        {
                            "text": "showcase app",
                            "link": 0
                        },
                        {
                            "text": ", where "
                        },
                        {
                            "text": "ListDetailRecipeTest",
                            "link": 1,
                            "code": true
                        },
                        {
                            "text": " exercises it."
                        }
                    ]
                },
                {
                    "type": "text",
                    "runs": [
                        {
                            "text": "Firstlight does not draw navigation. NativePHP Mobile renders it natively when a layout opts in with "
                        },
                        {
                            "text": "usesNativeChrome()",
                            "code": true
                        },
                        {
                            "text": ":"
                        }
                    ]
                },
                {
                    "type": "definition",
                    "term": {
                        "text": "Stack"
                    },
                    "items": [
                        {
                            "label": "iOS",
                            "runs": [
                                {
                                    "text": "SwiftUI "
                                },
                                {
                                    "text": "NavigationStack",
                                    "code": true
                                }
                            ]
                        },
                        {
                            "label": "Android",
                            "runs": [
                                {
                                    "text": "Material 3 "
                                },
                                {
                                    "text": "Scaffold",
                                    "code": true
                                }
                            ]
                        }
                    ]
                },
                {
                    "type": "definition",
                    "term": {
                        "text": "Title"
                    },
                    "items": [
                        {
                            "label": "iOS",
                            "text": "Large title that collapses to inline on scroll"
                        },
                        {
                            "label": "Android",
                            "runs": [
                                {
                                    "text": "LargeTopAppBar",
                                    "code": true
                                },
                                {
                                    "text": " / "
                                },
                                {
                                    "text": "TopAppBar",
                                    "code": true
                                }
                            ]
                        }
                    ]
                },
                {
                    "type": "definition",
                    "term": {
                        "text": "Back"
                    },
                    "items": [
                        {
                            "label": "iOS",
                            "text": "System back button and edge swipe"
                        },
                        {
                            "label": "Android",
                            "text": "Top app bar back arrow and system back"
                        }
                    ]
                },
                {
                    "type": "text",
                    "runs": [
                        {
                            "text": "PHP stays in charge of the screen stack. A back swipe or back press pops PHP's stack, so "
                        },
                        {
                            "text": "mount()",
                            "code": true
                        },
                        {
                            "text": " and screen state behave the same on both platforms."
                        }
                    ]
                }
            ]
        },
        "1-write-the-layout": {
            "title": "1. Write the layout",
            "blocks": [
                {
                    "type": "text",
                    "runs": [
                        {
                            "text": "Save this as "
                        },
                        {
                            "text": "app/NativeComponents/Layouts/AppLayout.php",
                            "code": true
                        },
                        {
                            "text": ":"
                        }
                    ]
                },
                {
                    "type": "code",
                    "language": "php",
                    "text": "<?php\n\nnamespace App\\NativeComponents\\Layouts;\n\nuse FirstlightUI\\NativeComponent as FirstlightScreen;\nuse Native\\Mobile\\Edge\\Layouts\\Builders\\NavBar;\nuse Native\\Mobile\\Edge\\Layouts\\NativeLayout;\nuse Native\\Mobile\\Edge\\NativeComponent;\n\nclass AppLayout extends NativeLayout\n{\n    public function usesNativeChrome(): bool\n    {\n        return true;\n    }\n\n    public function navBar(NativeComponent $screen): ?NavBar\n    {\n        $isRoot = $screen instanceof FirstlightScreen && $screen->isRootScreen();\n\n        return NavBar::make()\n            ->title($screen->navTitle())\n            ->displayMode($isRoot ? 'large' : 'inline')\n            ->back(! $isRoot);\n    }\n}"
                },
                {
                    "type": "text",
                    "runs": [
                        {
                            "text": "isRootScreen()",
                            "code": true
                        },
                        {
                            "text": " is true when nothing is below the screen on PHP's stack. The first screen gets a large title and no back button; every pushed screen gets an inline title and a back button. Android shows a back arrow only when the bar asks for one, so pushed screens must pass "
                        },
                        {
                            "text": "back(true)",
                            "code": true
                        },
                        {
                            "text": ". Each screen supplies its title through "
                        },
                        {
                            "text": "navTitle()",
                            "code": true
                        },
                        {
                            "text": "."
                        }
                    ]
                }
            ]
        },
        "2-register-the-routes": {
            "title": "2. Register the routes",
            "blocks": [
                {
                    "type": "code",
                    "language": "php",
                    "text": "use App\\NativeComponents\\Layouts\\AppLayout;\nuse App\\NativeComponents\\PostScreen;\nuse App\\NativeComponents\\PostsScreen;\nuse Illuminate\\Support\\Facades\\Route;\n\nRoute::native('/posts', PostsScreen::class)->layout(AppLayout::class);\nRoute::native('/posts/{post}', PostScreen::class)->layout(AppLayout::class);"
                }
            ]
        },
        "3-write-the-list-screen": {
            "title": "3. Write the list screen",
            "blocks": [
                {
                    "type": "text",
                    "runs": [
                        {
                            "text": "Use the "
                        },
                        {
                            "text": "searchable list recipe",
                            "link": 2
                        },
                        {
                            "text": ". Its row press pushes the detail screen:"
                        }
                    ]
                },
                {
                    "type": "code",
                    "language": "php",
                    "text": "public function openPost(int $id): void\n{\n    $this->navigate('/posts/'.$id);\n}"
                },
                {
                    "type": "text",
                    "runs": [
                        {
                            "text": "navigate()",
                            "code": true
                        },
                        {
                            "text": " pushes. Use "
                        },
                        {
                            "text": "replace()",
                            "code": true
                        },
                        {
                            "text": " to swap the current screen without adding to the stack, and "
                        },
                        {
                            "text": "back()",
                            "code": true
                        },
                        {
                            "text": " to pop it from PHP, for example after saving."
                        }
                    ]
                }
            ]
        },
        "4-write-the-detail-screen": {
            "title": "4. Write the detail screen",
            "blocks": [
                {
                    "type": "code",
                    "language": "php",
                    "text": "<?php\n\nnamespace App\\NativeComponents;\n\nuse App\\Models\\Post;\nuse FirstlightUI\\NativeComponent;\nuse Illuminate\\View\\View;\n\nclass PostScreen extends NativeComponent\n{\n    public Post $post;\n\n    public function navTitle(): string\n    {\n        return $this->post->title;\n    }\n\n    public function render(): View\n    {\n        return view('native.post');\n    }\n}"
                },
                {
                    "type": "text",
                    "runs": [
                        {
                            "text": "NativePHP fills a typed public property from the route parameter with the same name, using Laravel route model binding: "
                        },
                        {
                            "text": "{post}",
                            "code": true
                        },
                        {
                            "text": " becomes a "
                        },
                        {
                            "text": "Post",
                            "code": true
                        },
                        {
                            "text": " loaded by id. No "
                        },
                        {
                            "text": "mount()",
                            "code": true
                        },
                        {
                            "text": " is needed."
                        }
                    ]
                },
                {
                    "type": "text",
                    "runs": [
                        {
                            "text": "Save the view as "
                        },
                        {
                            "text": "resources/views/native/post.blade.php",
                            "code": true
                        },
                        {
                            "text": ":"
                        }
                    ]
                },
                {
                    "type": "code",
                    "language": "blade",
                    "text": "<native:scroll-view class=\"w-full flex-1 bg-theme-background\">\n    <native:column class=\"w-full p-4 gap-3\">\n        <native:text class=\"text-sm text-theme-on-surface-variant\">{{ $post->created_at->diffForHumans() }}</native:text>\n        <native:text class=\"text-base text-theme-on-surface\">{{ $post->body }}</native:text>\n    </native:column>\n</native:scroll-view>"
                }
            ]
        },
        "rules-to-keep": {
            "title": "Rules to keep",
            "blocks": [
                {
                    "type": "item",
                    "marker": "•",
                    "depth": 0,
                    "runs": [
                        {
                            "text": "Return "
                        },
                        {
                            "text": "true",
                            "code": true
                        },
                        {
                            "text": " from "
                        },
                        {
                            "text": "usesNativeChrome()",
                            "code": true
                        },
                        {
                            "text": ". Without it, NativePHP falls back to drawn bars that do not support large titles or the iOS back swipe."
                        }
                    ]
                },
                {
                    "type": "item",
                    "marker": "•",
                    "depth": 0,
                    "runs": [
                        {
                            "text": "Do not add the "
                        },
                        {
                            "text": "custom",
                            "code": true
                        },
                        {
                            "text": " attribute to "
                        },
                        {
                            "text": "<native:top-bar>",
                            "code": true
                        },
                        {
                            "text": " or "
                        },
                        {
                            "text": "<native:bottom-nav>",
                            "code": true
                        },
                        {
                            "text": ". It keeps the drawn bar."
                        }
                    ]
                },
                {
                    "type": "item",
                    "marker": "•",
                    "depth": 0,
                    "text": "Pass stable ids in URLs, never list positions."
                },
                {
                    "type": "item",
                    "marker": "•",
                    "depth": 0,
                    "text": "Let the platform draw the back button. Do not add your own back Button."
                }
            ]
        },
        "known-limits": {
            "title": "Known limits",
            "blocks": [
                {
                    "type": "item",
                    "marker": "•",
                    "depth": 0,
                    "runs": [
                        {
                            "text": "Tabs added with "
                        },
                        {
                            "text": "tabBar()",
                            "code": true
                        },
                        {
                            "text": " share PHP's single stack. Switching tabs replaces the screen, so each tab does not keep its own history."
                        }
                    ]
                },
                {
                    "type": "item",
                    "marker": "•",
                    "depth": 0,
                    "text": "Android receives back only when the gesture completes. It does not show the predictive-back preview while the user drags."
                }
            ]
        }
    },
