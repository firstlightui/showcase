{
    "id": "getting-started/first-component",
    "title": "Add your first Firstlight component",
    "description": "Add a Segmented control whose selected value is managed by PHP.",
    "group": "Getting started",
    "anchors": {
        "add-your-first-firstlight-component": "overview",
        "define-the-state": "define-the-state",
        "render-the-control": "render-the-control",
        "handle-a-selection-explicitly": "handle-a-selection-explicitly"
    },
    "chapters": {
        "overview": {
            "title": "Overview",
            "blocks": [
                {
                    "type": "text",
                    "text": "This tutorial adds a native Segmented control for choosing a queue. The same EDGE markup renders as a platform-appropriate control on iOS and Android."
                }
            ]
        },
        "define-the-state": {
            "title": "Define the state",
            "blocks": [
                {
                    "type": "text",
                    "text": "Extend Firstlight's base for your screen, rather than the upstream EDGE base:"
                },
                {
                    "type": "code",
                    "language": "php",
                    "text": "use FirstlightUI\\NativeComponent;\n\nclass QueueScreen extends NativeComponent\n{\n    // Add the state below; use your normal Blade view.\n}"
                },
                {
                    "type": "text",
                    "runs": [
                        {
                            "text": "Normal Blade renders (a global "
                        },
                        {
                            "text": "View",
                            "code": true
                        },
                        {
                            "text": " returned from "
                        },
                        {
                            "text": "render()",
                            "code": true
                        },
                        {
                            "text": ", "
                        },
                        {
                            "text": "$this->view()",
                            "code": true
                        },
                        {
                            "text": ", or an inferred view) automatically receive normal chrome and a root response revision. For a hand-built Element root, return "
                        },
                        {
                            "text": "$this->response($element)",
                            "code": true
                        },
                        {
                            "text": " from "
                        },
                        {
                            "text": "render()",
                            "code": true
                        },
                        {
                            "text": " instead of returning the Element directly. Nested children are untouched and partials are unstamped. Streaming is disabled and cannot be opted into. See the "
                        },
                        {
                            "text": "full contract and limits",
                            "link": 0
                        },
                        {
                            "text": "."
                        }
                    ]
                },
                {
                    "type": "text",
                    "text": "Add the selected value and stable value-to-label options to your component:"
                },
                {
                    "type": "code",
                    "language": "php",
                    "text": "public string $queue = 'mine';\n\npublic array $queueOptions = [\n    'mine' => 'Mine',\n    'all' => 'All',\n];"
                },
                {
                    "type": "text",
                    "runs": [
                        {
                            "text": "The array keys are the public values stored in "
                        },
                        {
                            "text": "$queue",
                            "code": true
                        },
                        {
                            "text": "; the labels are display text."
                        }
                    ]
                }
            ]
        },
        "render-the-control": {
            "title": "Render the control",
            "blocks": [
                {
                    "type": "text",
                    "runs": [
                        {
                            "text": "Bind the property with "
                        },
                        {
                            "text": "native:model",
                            "code": true
                        },
                        {
                            "text": ":"
                        }
                    ]
                },
                {
                    "type": "code",
                    "language": "blade",
                    "text": "<firstlight:segmented\n    :options=\"$queueOptions\"\n    native:model=\"queue\"\n    label=\"Queue\"\n    helper=\"Choose the active queue.\"\n/>"
                },
                {
                    "type": "text",
                    "runs": [
                        {
                            "text": "Run the application natively. A selection emits its stable value to PHP, and the published "
                        },
                        {
                            "text": "$queue",
                            "code": true
                        },
                        {
                            "text": " value determines the visible selection."
                        }
                    ]
                }
            ]
        },
        "handle-a-selection-explicitly": {
            "title": "Handle a selection explicitly",
            "blocks": [
                {
                    "type": "text",
                    "runs": [
                        {
                            "text": "Use "
                        },
                        {
                            "text": "@change",
                            "code": true
                        },
                        {
                            "text": " when the selection should call a method instead of directly synchronising a property:"
                        }
                    ]
                },
                {
                    "type": "code",
                    "language": "blade",
                    "text": "<firstlight:segmented\n    :options=\"$queueOptions\"\n    :value=\"$queue\"\n    @change=\"selectQueue\"\n    label=\"Queue\"\n/>"
                },
                {
                    "type": "text",
                    "runs": [
                        {
                            "text": "The method receives the selected string value. See the "
                        },
                        {
                            "text": "Segmented reference",
                            "link": 1
                        },
                        {
                            "text": " for integer values, disabled choices, accessibility, and validation rules. When the screen should show Laravel messages on Firstlight fields, follow "
                        },
                        {
                            "text": "Validate fields",
                            "link": 2
                        },
                        {
                            "text": "."
                        }
                    ]
                }
            ]
        }
    },
    "links": [
        {
