{
    "id": "getting-started/installation",
    "title": "Install Firstlight UI",
    "description": "Install Firstlight and Laravel Boost, register the NativePHP plugin, and rebuild the native projects.",
    "group": "Getting started",
    "anchors": {
        "install-firstlight-ui": "overview",
        "requirements": "requirements",
        "install-and-register-the-plugin": "install-and-register-the-plugin",
        "rebuild-the-native-projects": "rebuild-the-native-projects",
        "give-your-coding-agent-the-firstlight-guideline": "give-your-coding-agent-the-firstlight-guideline",
        "next-step": "next-step"
    },
    "chapters": {
        "overview": {
            "title": "Overview",
            "blocks": [
                {
                    "type": "text",
                    "text": "Firstlight is the app-shell layer for NativePHP. After these steps your app, and your coding agent, can build lists and detail, search, forms with Laravel validation, settings, sheets and dialogs, and feedback from genuine SwiftUI and Jetpack Compose controls."
                }
            ]
        },
        "requirements": {
            "title": "Requirements",
            "blocks": [
                {
                    "type": "text",
                    "runs": [
                        {
                            "text": "Start with a NativePHP Mobile 4 application that meets the "
                        },
                        {
                            "text": "current compatibility requirements",
                            "link": 0
                        },
                        {
                            "text": "."
                        }
                    ]
                },
                {
                    "type": "text",
                    "runs": [
                        {
                            "text": "Use NativePHP Mobile "
                        },
                        {
                            "text": "^4.7.0",
                            "code": true
                        },
                        {
                            "text": " and Mobile UI "
                        },
                        {
                            "text": "^0.9.0",
                            "code": true
                        },
                        {
                            "text": ", with iOS 18.2+ or Android API 29+. Firstlight screens must extend "
                        },
                        {
                            "text": "FirstlightUI\\NativeComponent",
                            "code": true
                        },
                        {
                            "text": " for the "
                        },
                        {
                            "text": "response-revision contract",
                            "link": 1
                        },
                        {
                            "text": "."
                        }
                    ]
                }
            ]
        },
        "install-and-register-the-plugin": {
            "title": "Install and register the plugin",
            "blocks": [
                {
                    "type": "text",
                    "text": "Install Firstlight as a normal Composer dependency:"
                },
                {
                    "type": "code",
                    "language": "bash",
                    "text": "composer require firstlightui/nativephp"
                },
                {
                    "type": "text",
                    "runs": [
                        {
                            "text": "Laravel discovers "
                        },
                        {
                            "text": "FirstlightUI\\FirstlightServiceProvider",
                            "code": true
                        },
                        {
                            "text": " from the package metadata. Register the native plugin explicitly so NativePHP adds the renderers declared in "
                        },
                        {
                            "text": "nativephp.json",
                            "code": true
                        },
                        {
                            "text": " to the application:"
                        }
                    ]
                },
                {
                    "type": "code",
                    "language": "bash",
                    "text": "php artisan native:plugin:register"
                },
                {
                    "type": "text",
                    "runs": [
                        {
                            "text": "The command discovers unregistered plugins. If your application disables Laravel package discovery, register "
                        },
                        {
                            "text": "FirstlightUI\\FirstlightServiceProvider",
                            "code": true
                        },
                        {
                            "text": " through the application's normal provider configuration as well."
                        }
                    ]
                }
            ]
        },
        "rebuild-the-native-projects": {
            "title": "Rebuild the native projects",
            "blocks": [
                {
                    "type": "text",
                    "text": "Native renderer source is compiled into the host application. Regenerate the native projects after installing or updating Firstlight:"
                },
                {
                    "type": "code",
                    "language": "bash",
                    "text": "php artisan native:install --force"
                },
                {
                    "type": "text",
                    "runs": [
                        {
                            "text": "Build and run the application through your normal NativePHP workflow. Firstlight's "
                        },
                        {
                            "text": "<firstlight:...>",
                            "code": true
                        },
                        {
                            "text": " tags are collected as native elements only in a native render; an ordinary web render leaves them unchanged."
                        }
                    ]
                }
            ]
        },
        "give-your-coding-agent-the-firstlight-guideline": {
            "title": "Give your coding agent the Firstlight guideline",
            "blocks": [
                {
                    "type": "text",
                    "text": "Firstlight ships a Laravel Boost guideline and two skills. Install Boost so your coding agent builds screens from the Firstlight recipes:"
                },
                {
                    "type": "code",
                    "language": "bash",
                    "text": "composer require laravel/boost --dev\nphp artisan boost:install"
                },
                {
                    "type": "text",
                    "runs": [
                        {
                            "text": "If Boost is already installed, run "
                        },
                        {
                            "text": "php artisan boost:update --discover",
                            "code": true
                        },
                        {
                            "text": " instead. See "
                        },
                        {
                            "text": "Build with a coding agent",
                            "link": 2
                        },
                        {
                            "text": " for what the agent receives."
                        }
                    ]
                }
            ]
        },
        "next-step": {
            "title": "Next step",
            "blocks": [
                {
                    "type": "text",
                    "runs": [
                        {
                            "text": "Build the app shell with the "
                        },
                        {
                            "text": "list and detail recipe",
                            "link": 3
                        },
                        {
                            "text": ", then add the "
                        },
                        {
                            "text": "searchable list",
                            "link": 4
                        },
                        {
                            "text": ", "
                        },
                        {
                            "text": "form",
                            "link": 5
                        },
                        {
                            "text": ", and "
                        },
                        {
                            "text": "settings",
                            "link": 6
                        },
                        {
                            "text": " screens your app needs. To learn one control at a time instead, add "
                        },
                        {
                            "text": "your first Firstlight component",
                            "link": 7
                        },
                        {
                            "text": "."
                        }
                    ]
                }
            ]
        }
    },
