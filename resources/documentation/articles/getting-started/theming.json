{
    "id": "getting-started/theming",
    "title": "Theme Firstlight components",
    "description": "Configure the semantic NativePHP theme tokens that Firstlight components inherit on iOS and Android.",
    "group": "Getting started",
    "anchors": {
        "theme-firstlight-components": "overview",
        "publish-the-theme-configuration": "publish-the-theme-configuration",
        "set-the-brand-colour-pairs": "set-the-brand-colour-pairs",
        "set-warning-colours": "set-warning-colours",
        "use-theme-tokens-in-surrounding-native-ui": "use-theme-tokens-in-surrounding-native-ui",
        "apply-a-runtime-brand": "apply-a-runtime-brand"
    },
    "chapters": {
        "overview": {
            "title": "Overview",
            "blocks": [
                {
                    "type": "text",
                    "runs": [
                        {
                            "text": "Firstlight components inherit the semantic theme from "
                        },
                        {
                            "text": "nativephp/mobile-ui",
                            "code": true
                        },
                        {
                            "text": ". There is no separate Firstlight theme file: configure the host application once, and the same tokens reach the native SwiftUI and Jetpack Compose renderers."
                        }
                    ]
                },
                {
                    "type": "text",
                    "text": "The theme changes colour and typography while each platform retains its native geometry, motion, and interaction."
                }
            ]
        },
        "publish-the-theme-configuration": {
            "title": "Publish the theme configuration",
            "blocks": [
                {
                    "type": "text",
                    "runs": [
                        {
                            "text": "Publish "
                        },
                        {
                            "text": "config/native-ui.php",
                            "code": true
                        },
                        {
                            "text": " into the application:"
                        }
                    ]
                },
                {
                    "type": "code",
                    "language": "shell",
                    "text": "php artisan vendor:publish --tag=native-ui-config"
                }
            ]
        },
        "set-the-brand-colour-pairs": {
            "title": "Set the brand colour pairs",
            "blocks": [
                {
                    "type": "text",
                    "runs": [
                        {
                            "text": "Set both the background token and its "
                        },
                        {
                            "text": "on-*",
                            "code": true
                        },
                        {
                            "text": " content token. This example uses the Firstlight showcase palette; replace the values with accessible pairs from your own brand:"
                        }
                    ]
                },
                {
                    "type": "code",
                    "language": "php",
                    "text": "'theme' => [\n    'light' => [\n        'primary' => '#AE1515',\n        'on-primary' => '#FFF5EA',\n    ],\n    'dark' => [\n        'primary' => '#ED4E0C',\n        'on-primary' => '#110805',\n    ],\n],"
                },
                {
                    "type": "text",
                    "runs": [
                        {
                            "text": "The "
                        },
                        {
                            "text": "primary",
                            "code": true
                        },
                        {
                            "text": " pair colours filled actions, selected states, and key accents. Surface, outline, destructive, success, accent, and disabled-state colours use their corresponding semantic tokens from the published configuration."
                        }
                    ]
                },
                {
                    "type": "text",
                    "text": "Dark values are optional because NativePHP can derive them from the light theme. Define explicit dark overrides when brand perception or contrast needs a tuned pair. Keep text and icons at a contrast ratio of at least 4.5:1 against their background token."
                },
                {
                    "type": "text",
                    "runs": [
                        {
                            "text": "Theme colours accept CSS hex values, Tailwind palette names such as "
                        },
                        {
                            "text": "violet-600",
                            "code": true
                        },
                        {
                            "text": ", and opacity modifiers such as "
                        },
                        {
                            "text": "violet-600/15",
                            "code": true
                        },
                        {
                            "text": "."
                        }
                    ]
                }
            ]
        },
        "set-warning-colours": {
            "title": "Set warning colours",
            "blocks": [
                {
                    "type": "text",
                    "runs": [
                        {
                            "text": "Status Label, Badge, Callout, and Transient Feedback share the "
                        },
                        {
                            "text": "warning",
                            "code": true
                        },
                        {
                            "text": " / "
                        },
                        {
                            "text": "on-warning",
                            "code": true
                        },
                        {
                            "text": " pair on both platforms, independently of the brand "
                        },
                        {
                            "text": "accent",
                            "code": true
                        },
                        {
                            "text": " pair. Add these keys to the same theme blocks:"
                        }
                    ]
                },
                {
                    "type": "code",
                    "language": "php",
                    "text": "'light' => ['warning' => '#B45309', 'on-warning' => '#FFFFFF'],\n'dark' => ['warning' => '#FBBF24', 'on-warning' => '#1C1917'],"
                },
                {
                    "type": "text",
                    "runs": [
                        {
                            "text": "These are also the fallback pairs when the effective theme has no corresponding warning token. NativePHP can derive dark values from configured light values; explicit dark overrides keep the intended amber presentation. All four surfaces share contrast-safe black/white text correction for inaccessible authored pairs. List Item's "
                        },
                        {
                            "text": "leading-icon-tone=\"warning\"",
                            "code": true
                        },
                        {
                            "text": " and "
                        },
                        {
                            "text": "trailing-icon-tone=\"warning\"",
                            "code": true
                        },
                        {
                            "text": " use the same warning colour in the active appearance."
                        }
                    ]
                },
                {
                    "type": "text",
                    "runs": [
                        {
                            "text": "Firstlight resolves these open-ended theme keys in PHP and publishes them with each component tree, because the native theme token structs do not retain custom keys. After a runtime "
                        },
                        {
                            "text": "Theme::merge()",
                            "code": true
                        },
                        {
                            "text": ", republish the component tree to update warning colours. The light/dark pair already in that tree switches immediately with the native appearance."
                        }
                    ]
                }
            ]
        },
        "use-theme-tokens-in-surrounding-native-ui": {
            "title": "Use theme tokens in surrounding native UI",
            "blocks": [
                {
                    "type": "text",
                    "runs": [
                        {
                            "text": "Firstlight controls consume the tokens automatically. Use the same tokens for surrounding "
                        },
                        {
                            "text": "nativephp/mobile-ui",
                            "code": true
                        },
                        {
                            "text": " elements with theme-aware utility classes:"
                        }
                    ]
                },
                {
                    "type": "code",
                    "language": "blade",
                    "text": "<native:column class=\"bg-theme-surface border border-theme-outline rounded-2xl p-4\">\n    <native:text class=\"text-theme-on-surface text-lg font-bold\">\n        Account\n    </native:text>\n\n    <firstlight:text-field\n        label=\"Email\"\n        native:model=\"email\"\n    />\n</native:column>"
                }
            ]
        },
        "apply-a-runtime-brand": {
            "title": "Apply a runtime brand",
            "blocks": [
                {
                    "type": "text",
                    "text": "For tenant or user-specific branding, merge only the tokens that change from a service provider:"
                },
                {
                    "type": "code",
                    "language": "php",
                    "text": "use Native\\Mobile\\UI\\Theme;\n\npublic function boot(): void\n{\n    Theme::merge([\n        'light' => [\n            'primary' => '#AE1515',\n            'on-primary' => '#FFF5EA',\n        ],\n        'dark' => [\n            'primary' => '#ED4E0C',\n            'on-primary' => '#110805',\n        ],\n    ]);\n}"
                },
                {
                    "type": "text",
                    "runs": [
                        {
                            "text": "Theme::merge()",
                            "code": true
                        },
                        {
                            "text": " deep-merges the new values, synchronises the effective Laravel configuration, and publishes the updated tokens to the native renderers."
                        }
                    ]
                }
            ]
        }
    },
    "links": []
}
