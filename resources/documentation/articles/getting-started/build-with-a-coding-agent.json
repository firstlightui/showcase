{
    "id": "getting-started/build-with-a-coding-agent",
    "title": "Build with a coding agent",
    "description": "What the Boost guideline, the firstlight-init and building-firstlight-screens skills, and llms.txt give your coding agent, and how to set them up.",
    "group": "Getting started",
    "anchors": {
        "build-with-a-coding-agent": "overview",
        "set-up-boost": "set-up-boost",
        "what-your-agent-gets": "what-your-agent-gets",
        "the-guidelines-rules": "what-your-agent-gets",
        "ask-for-an-app": "ask-for-an-app",
        "what-still-needs-a-person": "what-still-needs-a-person"
    },
    "chapters": {
        "overview": {
            "title": "Overview",
            "blocks": [
                {
                    "type": "text",
                    "runs": [
                        {
                            "text": "Firstlight is written to be built with by coding agents. The package ships a "
                        },
                        {
                            "text": "Laravel Boost",
                            "link": 0
                        },
                        {
                            "text": " guideline and two Boost skills, and its documentation is published as "
                        },
                        {
                            "text": "llms.txt",
                            "code": true
                        },
                        {
                            "text": " and "
                        },
                        {
                            "text": "llms-full.txt",
                            "code": true
                        },
                        {
                            "text": ". Together they tell an agent which screens to build from which recipe, which control to use for each value, and which mistakes to avoid."
                        }
                    ]
                }
            ]
        },
        "set-up-boost": {
            "title": "Set up Boost",
            "blocks": [
                {
                    "type": "text",
                    "runs": [
                        {
                            "text": "Install Firstlight as described in "
                        },
                        {
                            "text": "Installation",
                            "link": 1
                        },
                        {
                            "text": ", then add Laravel Boost to the application and run its installer:"
                        }
                    ]
                },
                {
                    "type": "code",
                    "language": "bash",
                    "text": "composer require laravel/boost --dev\nphp artisan boost:install"
                },
                {
                    "type": "text",
                    "runs": [
                        {
                            "text": "Boost finds the guideline and skills in Firstlight's "
                        },
                        {
                            "text": "resources/boost",
                            "code": true
                        },
                        {
                            "text": " directory and writes them into your agent's files, such as "
                        },
                        {
                            "text": "AGENTS.md",
                            "code": true
                        },
                        {
                            "text": ", "
                        },
                        {
                            "text": "CLAUDE.md",
                            "code": true
                        },
                        {
                            "text": ", and its skills directory. If Boost is already installed, pick up Firstlight with:"
                        }
                    ]
                },
                {
                    "type": "code",
                    "language": "bash",
                    "text": "php artisan boost:update --discover"
                },
                {
                    "type": "text",
                    "runs": [
                        {
                            "text": "Run "
                        },
                        {
                            "text": "php artisan boost:update",
                            "code": true
                        },
                        {
                            "text": " after each Firstlight update so the guideline and skills match the installed version."
                        }
                    ]
                }
            ]
        },
        "what-your-agent-gets": {
            "title": "What your agent gets",
            "blocks": [
                {
                    "type": "definition",
                    "term": {
                        "text": "Guideline"
                    },
                    "items": [
                        {
                            "label": "When the agent reads it",
                            "text": "Always, as part of the agent's instructions"
                        },
                        {
                            "label": "What it contains",
                            "text": "The rules every Firstlight screen follows, the four recipes, the screen generator, and a tested example"
                        }
                    ]
                },
                {
                    "type": "definition",
                    "term": {
                        "runs": [
                            {
                                "text": "firstlight-init",
                                "code": true
                            },
                            {
                                "text": " skill"
                            }
                        ]
                    },
                    "items": [
                        {
                            "label": "When the agent reads it",
                            "text": "When asked to set up or scaffold a Firstlight app"
                        },
                        {
                            "label": "What it contains",
                            "text": "An interview, an install check, the theme, the native-chrome layout, and the chosen recipe screens with tests"
                        }
                    ]
                },
                {
                    "type": "definition",
                    "term": {
                        "runs": [
                            {
                                "text": "building-firstlight-screens",
                                "code": true
                            },
                            {
                                "text": " skill"
                            }
                        ]
                    },
                    "items": [
                        {
                            "label": "When the agent reads it",
                            "text": "When adding or changing a screen, form, list, or settings page"
                        },
                        {
                            "label": "What it contains",
                            "text": "Which recipe to start from, which control fits each value, the workflow, and what never to do"
                        }
                    ]
                },
                {
                    "type": "definition",
                    "term": {
                        "runs": [
                            {
                                "text": "llms.txt",
                                "link": 2,
                                "code": true
                            }
                        ]
                    },
                    "items": [
                        {
                            "label": "When the agent reads it",
                            "text": "When the agent needs a page"
                        },
                        {
                            "label": "What it contains",
                            "text": "Every documentation page with a one-line summary"
                        }
                    ]
                },
                {
                    "type": "definition",
                    "term": {
                        "runs": [
                            {
                                "text": "llms-full.txt",
                                "link": 3,
                                "code": true
                            }
                        ]
                    },
                    "items": [
                        {
                            "label": "When the agent reads it",
                            "text": "When the agent needs the whole reference"
                        },
                        {
                            "label": "What it contains",
                            "text": "The full text of every documentation page in one file"
                        }
                    ]
                },
                {
                    "type": "text",
                    "runs": [
                        {
                            "text": "The package also includes "
                        },
                        {
                            "text": "llms-full.txt",
                            "code": true
                        },
                        {
                            "text": " at "
                        },
                        {
                            "text": "vendor/firstlightui/nativephp/llms-full.txt",
                            "code": true
                        },
                        {
                            "text": ", so an agent can read the reference for the installed version without network access."
                        }
                    ]
                },
                {
                    "type": "heading",
                    "text": "The guideline's rules"
                },
                {
                    "type": "text",
                    "text": "The guideline keeps an agent on the same path as the recipes:"
                },
                {
                    "type": "item",
                    "marker": "•",
                    "depth": 0,
                    "runs": [
                        {
                            "text": "Screens extend "
                        },
                        {
                            "text": "FirstlightUI\\NativeComponent",
                            "code": true
                        },
                        {
                            "text": "."
                        }
                    ]
                },
                {
                    "type": "item",
                    "marker": "•",
                    "depth": 0,
                    "runs": [
                        {
                            "text": "Controls are "
                        },
                        {
                            "text": "<firstlight:*>",
                            "code": true
                        },
                        {
                            "text": " tags, with one Blade view for both platforms."
                        }
                    ]
                },
                {
                    "type": "item",
                    "marker": "•",
                    "depth": 0,
                    "runs": [
                        {
                            "text": "Navigation chrome comes from NativePHP: layouts return "
                        },
                        {
                            "text": "true",
                            "code": true
                        },
                        {
                            "text": " from "
                        },
                        {
                            "text": "usesNativeChrome()",
                            "code": true
                        },
                        {
                            "text": ". No custom-drawn tab bars, drawers, charts, or carousels."
                        }
                    ]
                },
                {
                    "type": "item",
                    "marker": "•",
                    "depth": 0,
                    "runs": [
                        {
                            "text": "Validation is Laravel validation, with "
                        },
                        {
                            "text": "$rules",
                            "code": true
                        },
                        {
                            "text": " or a Form Request passed to "
                        },
                        {
                            "text": "$this->validate()",
                            "code": true
                        },
                        {
                            "text": ". Fields show their own errors."
                        }
                    ]
                },
                {
                    "type": "item",
                    "marker": "•",
                    "depth": 0,
                    "text": "Destructive actions open a Confirmation Dialog and authorize in PHP."
                },
                {
                    "type": "item",
                    "marker": "•",
                    "depth": 0,
                    "text": "Colours come from the NativePHP theme, not from markup."
                }
            ]
        },
        "ask-for-an-app": {
            "title": "Ask for an app",
            "blocks": [
                {
                    "type": "text",
                    "text": "With Boost installed, describe the app rather than the controls. For example:"
                },
                {
                    "type": "text",
                    "text": "Set up this app with Firstlight. The main record is a job. I want a searchable list of jobs, a form to create one, and a settings screen."
                },
                {
                    "type": "text",
                    "runs": [
                        {
                            "text": "The "
                        },
                        {
                            "text": "firstlight-init",
                            "code": true
                        },
                        {
                            "text": " skill asks about the record, the recipes, brand colours, tabs, deletion rules, and locale one question at a time, and makes no change you have not agreed to. It then scaffolds each chosen "
                        },
                        {
                            "text": "recipe",
                            "link": 4
                        },
                        {
                            "text": " with a Pest test and runs the test suite."
                        }
                    ]
                },
                {
                    "type": "text",
                    "runs": [
                        {
                            "text": "For later screens, ask for the outcome, such as \"add a screen to edit a job\". The "
                        },
                        {
                            "text": "building-firstlight-screens",
                            "code": true
                        },
                        {
                            "text": " skill picks the matching recipe, or starts from the generator:"
                        }
                    ]
                },
                {
                    "type": "code",
                    "language": "bash",
                    "text": "php artisan make:firstlight-screen EditJob --form --test"
                }
            ]
        },
        "what-still-needs-a-person": {
            "title": "What still needs a person",
            "blocks": [
                {
                    "type": "text",
                    "runs": [
                        {
                            "text": "An agent can write screens and run their Pest tests. It cannot see the app on a device. Both skills end by asking you to run the app on an iOS simulator and an Android emulator and check navigation, field errors, and deletion on both. Check accessibility too. See "
                        },
                        {
                            "text": "Accessibility",
                            "link": 5
                        },
                        {
                            "text": " for what Firstlight covers and what your app still owns."
                        }
                    ]
                }
            ]
        }
    },
